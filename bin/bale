# Ensure the sibling bin/ directory is on the import path even when bale is
# invoked via a symlink (e.g. ~/.local/bin/bale → ~/bale/bin/bale). The default
# sys.path[0] is the directory of sys.argv[0], which for a symlinked invocation
# is the symlink's parent (~/.local/bin/) — NOT where bale_config.py lives.
# Path(__file__).resolve() follows the symlink to the real bin/bale, so its
# parent is the real bin/ directory.
sys.path.insert(0, str(Path(__file__).resolve().parent))
import bale_config  # noqa: E402 — sys.path tweak above is load-bearing


# ---------------------------------------------------------------------------
# 1. Imports + constants
# ---------------------------------------------------------------------------

VERSION = "0.0.10"

# bin/bale is at <install>/bin/bale; docs are siblings at <install>/docs/.
# Path(__file__).resolve() follows symlinks, so a symlinked bale on PATH
# still finds the real docs directory next to the real bin/.
INSTALL_ROOT = Path(__file__).resolve().parent.parent
DOCS_DIR = INSTALL_ROOT / "docs"
GLOBAL_DOCS = ("CLAUDE.md", "TARBALL.md", "DOCS.md", "CODE.md")

# Baked-in exclusions for pack. From BALE.md section 6.4.
# Directory names (matched by basename at any depth).
BAKED_IN_EXCLUDE_DIRS = {
    # Bale and git internals
    ".git", ".bale",
    # Common big-build dirs
    "node_modules", "__pycache__", ".venv", "target", "dist",
    "build", ".next", ".nuxt", "out", ".cache",
}

# Filename glob patterns (matched by basename).
SECRET_PATTERNS = (
    ".env", ".env.*",
    "*.pem", "*.key",
    "*_rsa", "*_dsa",
    "*.p12", "*.pfx",
    "id_rsa", "id_dsa",
    ".pypirc",
)

# Full relative paths from repo root that are always excluded.
SECRET_PATH_EXCLUDES = (
    ".aws/credentials",
)

# Filename for the per-repo user-managed exclusion list (BALE.md §6.4).
# Lives at the repo root only — bale does not walk for per-directory
# .baleignore files. Gitignore-style syntax (subset; see BaleignoreMatcher
# in section 10). The wizard in bale_config.walkthrough_baleignore is
# the canonical writer; hand-edits work too.
BALEIGNORE_FILE = ".baleignore"

# Configurables (the bale.toml file name, the per-install user/ directory,
# hook names, and apply-section value keys) moved to bin/bale_config.py
# in v0.0.4. The two surfaces in this file that still touch them — run_hook
# (section 23) and the `config init` subparser wiring (section 24) — reach
# them through bale_config.* module-level attributes.

# Path-location refusals. From BALE.md section 7.1.
SYSTEM_DIRS = (
    "/", "/home", "/Users", "/usr", "/var", "/etc", "/bin",
    "/sbin", "/lib", "/lib64", "/opt", "/srv", "/proc", "/sys",
    "/dev", "/tmp", "/var/tmp", "/private/tmp",
)

# Pack threshold caps. From BALE.md section 7.4.
# Soft caps drive the interactive prompt / piped warning. Hard caps drive
# refusal (interactive + piped both refuse). Depth is hard-only — there's
# no realistic case where "uh, 19 directories deep is fine but 20 is iffy"
# is the right product gesture; deep paths are either fine or pathological.
# Sizes are 1024-based (a "GB" here means 2^30 bytes), matching how every
# OS-shaped tool quotes them.
PACK_MAX_FILES_SOFT = 10_000
PACK_MAX_FILES_HARD = 100_000
PACK_MAX_SIZE_SOFT = 100 * 1024 * 1024            # 100 MB
PACK_MAX_SIZE_HARD = 1 * 1024 * 1024 * 1024       # 1 GB
PACK_MAX_DEPTH = 20

# How many entries to show in the "largest directories" report on a soft
# breach. Keep this small — the prompt is meant to point at obvious
# offenders, not survey the whole tree.
PACK_LARGEST_DIRS_TOPN = 5


# ---------------------------------------------------------------------------
# 2. Logging
# ---------------------------------------------------------------------------
#
# v0.0.1 logs to stdout with a [bale] prefix. When a session is open we
# also append to .bale/logs/<sid>.log. Structured logging proper lands
# in v0.1.

_log_file: Optional[Path] = None

# Pending log lines, replayed into the session log the first time set_log_file
# opens one. The pack pipeline emits --force override notes (home-directory
# refusal bypass, threshold-cap bypass) before the session ID is allocated and
# the per-session log file exists. Per the constraint that override events
# must reach the session log "prominently," log(..., force=True) routes
# through this buffer when no log file is open yet, and set_log_file() drains
# it on first attach. Buffer-on-stdout-only callers (the regular log() path)
# don't queue anything: a normal `[bale] foo` line emitted with no log file
# open is already visible on stdout and isn't worth journaling retroactively.
_pending_log_lines: list[str] = []


def set_log_file(p: Optional[Path]) -> None:
    """Set (or clear) the session log file. On first attach with a non-None
    path, drain any buffered --force lines into it so the session log has the
    override events even though they preceded sid allocation. A failed drain
    surfaces on stderr but does not raise — logging must never break pack."""
    global _log_file
    _log_file = p
    if p is None or not _pending_log_lines:
        return
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        with p.open("a", encoding="utf-8") as f:
            for line in _pending_log_lines:
                ts = datetime.now(timezone.utc).isoformat(timespec="seconds")
                f.write(f"{ts} {line}\n")
    except OSError as e:
        # Same shape as log()'s defensive path: surface and continue.
        print(f"[bale] (log-write failed: {e})", file=sys.stderr)
    _pending_log_lines.clear()


def log(msg: str, *, force: bool = False) -> None:
    """Emit a [bale] line to stdout, and (if a session log is open) journal it.

    `force=True` formats the line as a prominent FORCE: prefix and, if no
    session log is open yet, queues the line for replay once one is. Use it
    only for --force-override events (home-dir, threshold caps) where the
    journal entry is the audit trail; ordinary informational logs leave
    `force=False` so they don't clutter the FORCE: prefix or queue."""
    prefix = "[bale] FORCE: " if force else "[bale] "
    line = f"{prefix}{msg}"
    print(line)
    if _log_file is not None:
        try:
            _log_file.parent.mkdir(parents=True, exist_ok=True)
            with _log_file.open("a", encoding="utf-8") as f:
                ts = datetime.now(timezone.utc).isoformat(timespec="seconds")
                f.write(f"{ts} {line}\n")
        except OSError as e:
            # Logging must never raise; surface and continue.
            print(f"[bale] (log-write failed: {e})", file=sys.stderr)
    elif force:
        # No session log yet — buffer for replay when set_log_file() opens one.
        _pending_log_lines.append(line)


def fail(msg: str, code: int = 1) -> None:
    """Print a [bale] error to stderr, log it if a session is open, exit."""
    line = f"[bale] error: {msg}"
    print(line, file=sys.stderr)
    if _log_file is not None:
        try:
            _log_file.parent.mkdir(parents=True, exist_ok=True)
            with _log_file.open("a", encoding="utf-8") as f:
                ts = datetime.now(timezone.utc).isoformat(timespec="seconds")
                f.write(f"{ts} {line}\n")
        except OSError as e:
            # Logging must never raise; surface and continue (matches log()).
            # The primary error has already gone to stderr above; this second
            # line tells the user their fail wasn't journaled, which is the
            # kind of fact they'd want when debugging *why* bale broke.
            print(f"[bale] (log-write failed: {e})", file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------------------
# 3. Shell / git helpers
# ---------------------------------------------------------------------------

def run(cmd: list[str], *, cwd: Optional[Path] = None,
        check: bool = True, capture: bool = True) -> subprocess.CompletedProcess:
    """Wrapper around subprocess.run with consistent defaults.

    Captures stdout/stderr as text by default. Raises CalledProcessError
    on non-zero when check=True.
    """
    return subprocess.run(
        cmd,
        cwd=str(cwd) if cwd is not None else None,
        check=check,
        capture_output=capture,
        text=True,
    )


def git(args: list[str], *, cwd: Path,
        check: bool = True) -> subprocess.CompletedProcess:
    return run(["git", *args], cwd=cwd, check=check)


def repo_root(cwd: Path) -> Optional[Path]:
    """Return the repo root containing cwd, or None if not in a repo."""
    try:
        r = run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=cwd, check=True, capture=True,
        )
    except subprocess.CalledProcessError:
        return None
    except FileNotFoundError:
        fail("git not found on PATH; bale requires git.")
    return Path(r.stdout.strip())


# ---------------------------------------------------------------------------
# 4. Hashing
# ---------------------------------------------------------------------------

def sha256_file(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def sha256_bytes(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


# ---------------------------------------------------------------------------
# 5. Session IDs and the per-day counter
# ---------------------------------------------------------------------------
#
# Session ID format (TARBALL.md section 1): YYYY-MM-DD-<slug>-NNN
# where NNN is a per-day monotonic counter maintained in
# .bale/counter-YYYY-MM-DD.

def next_session_id(repo: Path, slug: str, today: Optional[date] = None) -> str:
    today = today or date.today()
    day = today.isoformat()
    counter_path = repo / ".bale" / f"counter-{day}"
    counter_path.parent.mkdir(parents=True, exist_ok=True)
    if counter_path.exists():
        try:
            n = int(counter_path.read_text().strip()) + 1
        except (OSError, ValueError):
            n = 1
    else:
        n = 1
    counter_path.write_text(f"{n}\n")
    return f"{day}-{slug}-{n:03d}"


def parse_session_id(sid: str) -> tuple[str, str, str]:
    """Split a session id into (date, slug, nnn). Inverse of next_session_id's
    formatter. Raises ValueError on a malformed input.

    Used by `bale handoff` to lift the slug off a bailout response's
    session_id so the follow-up session preserves it (TARBALL.md §1's
    format plus the explicit constraint from prior session that handoff
    keeps the slug, mints a new date+NNN).

    Format reminder: 'YYYY-MM-DD-<slug>-NNN' — date is fixed 10 chars,
    NNN is fixed 3 digits, slug is whatever sits in between (kebab-case,
    may itself contain hyphens). Splitting from the ends, not by
    rsplit('-'), is the way to handle slugs with hyphens correctly.
    """
    if len(sid) < 11 + 4:
        raise ValueError(f"session id too short: {sid!r}")
    date_part = sid[:10]
    if sid[10] != "-":
        raise ValueError(f"session id missing date separator: {sid!r}")
    if sid[-4] != "-":
        raise ValueError(f"session id missing NNN separator: {sid!r}")
    nnn = sid[-3:]
    if not nnn.isdigit():
        raise ValueError(f"session id NNN must be 3 digits: {sid!r}")
    slug = sid[11:-4]
    try:
        date.fromisoformat(date_part)
    except ValueError as e:
        raise ValueError(f"session id date is not ISO YYYY-MM-DD: {date_part!r} ({e})")
    if not is_valid_slug(slug):
        raise ValueError(f"session id slug is not kebab-case: {slug!r}")
    return date_part, slug, nnn


# ---------------------------------------------------------------------------
# 6. Lock handling
# ---------------------------------------------------------------------------
#
# .bale/current_session holds the open sid, or is empty when no session
# is active. See BALE.md section 3.4 and section 9.5.

def lock_path(repo: Path) -> Path:
    return repo / ".bale" / "current_session"


def read_lock(repo: Path) -> Optional[str]:
    p = lock_path(repo)
    if not p.exists():
        return None
    s = p.read_text().strip()
    return s or None


def write_lock(repo: Path, sid: str) -> None:
    p = lock_path(repo)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(f"{sid}\n")


def clear_lock(repo: Path) -> None:
    p = lock_path(repo)
    if p.exists():
        p.write_text("")


# ---------------------------------------------------------------------------
# 7. .gitignore handling for the .bale/ directory
# ---------------------------------------------------------------------------

def ensure_bale_gitignored(repo: Path) -> bool:
    """Append .bale/ to repo's .gitignore if it isn't already there.

    Returns True if the file was modified (so the caller can decide whether
    to auto-commit), False if no change was needed.

    Per BALE.md section 7.1 step 6. v0.0.1 appends silently with a log line;
    the interactive confirmation lands in v0.1.
    """
    gi = repo / ".gitignore"
    needle = ".bale/"
    if gi.exists():
        lines = [ln.rstrip("\n") for ln in gi.read_text().splitlines()]
        if needle in lines or ".bale" in lines:
            return False
        with gi.open("a", encoding="utf-8") as f:
            if lines and lines[-1] != "":
                f.write("\n")
            f.write(f"{needle}\n")
        log(f"appended '{needle}' to {gi}.")
    else:
        gi.write_text(f"{needle}\n")
        log(f"created {gi} with '{needle}'.")
    return True


# ---------------------------------------------------------------------------
# 8. Path-safety checks
# ---------------------------------------------------------------------------

def refuse_system_dir(p: Path, *, force: bool = False) -> None:
    """Per BALE.md section 7.1 steps 1-2.

    Step 1 (SYSTEM_DIRS) has no override flag — `bale pack` at `/` is almost
    certainly a typo, and the spec is explicit that there's no escape hatch.
    Step 2 ($HOME) supports `--force` for the legitimate dotfiles-repo case.
    When forced, the bypass is logged prominently via log(force=True) so the
    session journal records it; the log-line is buffered until the session
    log file exists, since this check fires before sid allocation."""
    resolved = p.resolve()
    if str(resolved) in SYSTEM_DIRS:
        # No override here, by design (BALE.md §7.1 step 1).
        fail(
            f"refusing to operate at system directory {resolved}. "
            f"cd into a project directory and retry."
        )
    home = Path.home().resolve()
    if resolved == home:
        if force:
            log(
                f"bypassing home-directory refusal at {resolved} "
                f"(legitimate use: dotfiles repo)",
                force=True,
            )
            return
        fail(
            f"refusing to operate at $HOME ({resolved}). "
            f"Re-run with --force if this is a dotfiles repo and you know "
            f"what you're doing; otherwise cd into a subdirectory."
        )


def is_path_safe(rel: str) -> bool:
    """Reject path-traversal, absolute paths, and reserved prefixes."""
    if rel.startswith("/"):
        return False
    parts = Path(rel).parts
    if ".." in parts:
        return False
    if parts and parts[0] in (".git", ".bale"):
        return False
    return True


# ---------------------------------------------------------------------------
# 9. Editor invocation
# ---------------------------------------------------------------------------

def open_in_editor(initial_text: str, *, abort_hint: str = "") -> str:
    """Open $EDITOR on a temporary .md file pre-populated with initial_text;
    return the user's edited contents stripped of trailing whitespace.

    Honors $EDITOR, falls back to $VISUAL, then to /usr/bin/editor (Debian
    convention; the alternatives system points at the user's selected editor
    on Debian/Ubuntu, which catches most no-EDITOR-set installs). $EDITOR
    may be a multi-word command (`code --wait`); we split with shlex but
    don't validate further — the same trust-the-user posture the rest of
    bale takes with subprocess invocations. A non-zero exit from the editor
    is logged but not fatal: the user may have :q'd deliberately to abort
    while still wanting whatever's in the buffer.

    Empty return is allowed: the caller decides whether empty means
    "abort" (cmd_handoff's --edit-goal) or "skip the optional artifact"
    (pack wizard's README step). The abort_hint string, when set, is
    appended to the no-editor-available fail() message so the user gets a
    caller-specific suggestion on what to do instead (e.g. "drop
    --edit-goal" or "answer 'n' to the README prompt").
    """
    editor_env = os.environ.get("EDITOR") or os.environ.get("VISUAL")
    if not editor_env:
        debian_alt = "/usr/bin/editor"
        if Path(debian_alt).exists():
            editor_env = debian_alt
        else:
            msg = (
                "$EDITOR is not set and /usr/bin/editor is not available. "
                "Set EDITOR (e.g. `export EDITOR=vim`) and retry"
            )
            if abort_hint:
                msg += f", or {abort_hint}"
            msg += "."
            fail(msg)

    with tempfile.NamedTemporaryFile(
        mode="w+", suffix=".md", delete=False, encoding="utf-8",
    ) as tf:
        tf.write(initial_text)
        if not initial_text.endswith("\n"):
            tf.write("\n")
        tmp_path = Path(tf.name)

    try:
        cmd = shlex.split(editor_env) + [str(tmp_path)]
        result = subprocess.run(cmd, check=False)
        if result.returncode != 0:
            log(f"$EDITOR ({editor_env!r}) exited {result.returncode}; "
                f"using whatever the file holds now")
        return tmp_path.read_text(encoding="utf-8").strip()
    finally:
        try:
            tmp_path.unlink()
        except OSError:
            pass


# ---------------------------------------------------------------------------
# 10. Pack: file enumeration and filtering
# ---------------------------------------------------------------------------

def list_git_files(repo: Path) -> list[str]:
    """All tracked + untracked-not-ignored files in the repo, repo-relative.

    Uses `git ls-files --cached --others --exclude-standard`, which honors
    .gitignore at every level plus .git/info/exclude. This is bale's default
    way of respecting .gitignore (BALE.md section 6.4). v0.0.1 has no
    `--no-gitignore` escape hatch; that lands in v0.1.
    """
    r = run(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard"],
        cwd=repo, check=True,
    )
    return [line for line in r.stdout.splitlines() if line]


def is_under_excluded_dir(rel: str) -> bool:
    """Any path component matches a baked-in excluded directory name."""
    for part in Path(rel).parts:
        if part in BAKED_IN_EXCLUDE_DIRS:
            return True
    return False


def matches_secret_pattern(rel: str) -> bool:
    """Basename matches a secret glob, or full path matches a secret-path entry."""
    base = Path(rel).name
    for pat in SECRET_PATTERNS:
        if fnmatch.fnmatchcase(base, pat):
            return True
    for full in SECRET_PATH_EXCLUDES:
        if rel == full or rel.endswith("/" + full):
            return True
    return False


def npmrc_has_authtoken(file_path: Path) -> bool:
    """`.npmrc` is excluded only when it contains _authToken (BALE.md 6.4)."""
    try:
        content = file_path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False
    return "_authToken" in content


def is_secret_excluded(rel: str, repo: Path) -> bool:
    if matches_secret_pattern(rel):
        return True
    if Path(rel).name == ".npmrc":
        return npmrc_has_authtoken(repo / rel)
    return False


def is_under_include(rel: str, includes: list[str]) -> bool:
    """No includes = include everything. Otherwise must be under one of them."""
    if not includes:
        return True
    rel_p = Path(rel)
    for inc in includes:
        inc_p = Path(inc)
        if rel_p == inc_p:
            return True
        try:
            rel_p.relative_to(inc_p)
            return True
        except ValueError:
            continue
    return False


# --- .baleignore (BALE.md §6.4) ---------------------------------------------
#
# `.baleignore` lives at the repo root and lets users add project-specific
# permanent exclusions on top of the baked-in dir/secret patterns and
# `.gitignore`. Used at both pack (filter chain) and apply (rule 14: a
# response cannot declare a path that matches `.baleignore`).
#
# Syntax: a documented subset of gitignore. Each non-blank, non-comment
# line is a pattern, normalized as follows:
#
#   - Leading `#` (after lstrip) → comment, skipped.
#   - Trailing `/` → directory-only: matches when any path component
#     equals the pattern's body (slash-less anchored variant matches the
#     leading component only).
#   - Leading `/` → anchored to repo root: pattern (minus the leading
#     slash) is matched against the full relative path.
#   - No slash → basename match against any path component (so `data`
#     excludes both `data/x.csv` and `nested/data/x.csv`).
#   - Slash in the middle → match against the full relative path
#     (anchored), with `fnmatch`-style globbing inside each segment.
#   - Leading `!` → unsupported at v0.1; load_baleignore raises with a
#     helpful message. Negation has outsized semantic cost (multi-pass
#     evaluation, ordering matters) for limited real-world need; users
#     wanting it can narrow `--include` instead.
#
# Globs use `fnmatch.fnmatchcase` (case-sensitive — matches gitignore
# behavior on POSIX filesystems; Windows-case-insensitive variants would
# need their own flag). `**` is NOT a special token in the subset; treat
# it as a literal sequence of two stars, which won't match anything
# normal. If recursive matching is wanted, omit the slash entirely
# (basename match runs at every depth) or use multiple patterns.

class BaleignoreMatcher:
    """A loaded `.baleignore` pattern set. Stateless after construction;
    callers pre-build one matcher and run many paths through it.

    Constructed by `load_baleignore(repo)` from the on-disk file, or
    `BaleignoreMatcher.from_lines(lines)` for in-memory composition (the
    pack pipeline composes file patterns with session-extra patterns via
    `build_pack_matcher`).

    Pattern compilation is one-time at construction so per-path `matches`
    is a tight loop over pre-classified entries. Each entry is one of
    three shapes:

      - ("basename", body)      — match body against any single path
        component. Used for unanchored patterns with no slash in body
        (regardless of trailing slash). Covers `data`, `data/`, `*.csv`.
        Files-at-depth and dirs-at-depth both match because path
        components are checked at every depth — matches how gitignore
        treats a no-slash pattern as a basename-anywhere pattern that
        implicitly subtree-excludes matched directories.
      - ("path_or_under", body) — segment-wise fnmatch with subtree:
        matches when len(parts) >= len(body_segs) AND each body_segs[i]
        fnmatches parts[i]. Used for dir-only patterns (trailing slash)
        and for anchored bare names (`/build`). `/build/` matches both
        `build` and `build/x`; `src/legacy/` matches `src/legacy` and
        `src/legacy/sub/Bar.vue`.
      - ("path_exact",    body) — segment-wise fnmatch, strict: matches
        when len(parts) == len(body_segs) AND each segment fnmatches.
        Used for non-dir-only patterns containing an internal slash,
        like `src/legacy/*.vue`. The strict-depth rule is what stops
        `*.vue` from being greedy across slashes (Python's stdlib
        `fnmatch` itself does not respect `/` boundaries — `*` matches
        slashes — so segment-wise matching is how we restore the
        gitignore-style anchored-per-component semantics).

    The empty matcher (no patterns) returns False for every path.
    `load_baleignore` returns None on absent file specifically so callers
    can branch on "no matcher loaded" rather than always constructing
    an empty one — micro-optimization on the hot pack walk where most
    repos have no `.baleignore`.
    """

    __slots__ = ("_entries", "_patterns")

    def __init__(self, entries: list[tuple], patterns: list[str]):
        # entries: classified pattern list for matching. Each entry is
        # ("basename", body) or ("path_or_under"|"path_exact", body, segs)
        # where segs is body.split("/") pre-computed.
        # patterns: the raw normalized pattern lines, preserved so error
        # messages can name "which pattern matched" verbatim (apply rule 14
        # gives a much clearer rejection when it can echo the actual line).
        self._entries = entries
        self._patterns = patterns

    @classmethod
    def from_lines(cls, lines: list[str]) -> "BaleignoreMatcher":
        """Build a matcher from a list of pattern lines. Lines may include
        comments and blanks; they're stripped here. Raises ValueError on
        leading `!` (negation, unsupported at v0.1) so the caller can fail
        with file context."""
        entries: list[tuple] = []
        patterns: list[str] = []
        for raw in lines:
            stripped = raw.strip()
            if not stripped or stripped.startswith("#"):
                continue
            if stripped.startswith("!"):
                raise ValueError(
                    f"negation patterns (lines starting with '!') are not "
                    f"supported in .baleignore at v0.1. Offending line: "
                    f"{stripped!r}. Narrow `--include` paths or remove "
                    f"the conflicting positive pattern instead."
                )
            patterns.append(stripped)

            # Directory-only marker (trailing slash).
            is_dir_only = stripped.endswith("/")
            body = stripped[:-1] if is_dir_only else stripped

            # Anchored to repo root (leading slash).
            anchored = body.startswith("/")
            if anchored:
                body = body[1:]
            if not body:
                # Pathological pattern like "/" or "//" — skip rather
                # than crash. A bare anchor matches nothing meaningful.
                continue

            has_slash = "/" in body

            # Classification:
            #
            # - Unanchored AND no slash in body → basename-anywhere.
            #   Covers `data`, `data/`, `*.csv`. Trailing-slash variant
            #   collapses into basename because the basename-anywhere
            #   rule already matches both the dir and everything under it
            #   (each component is checked, so `data` in parts wins for
            #   both `data` and `data/x`).
            #
            # - Dir-only (trailing slash) OR anchored-with-no-internal-
            #   slash → path_or_under. The former covers `src/legacy/`
            #   (which should subtree-match); the latter covers `/build`
            #   and `/build/` (where the bare anchored name conventionally
            #   excludes the named dir's whole subtree).
            #
            # - Else (non-dir-only with slash inside) → path_exact. This
            #   is the strict glob-at-fixed-depth case: `src/legacy/
            #   *.vue` matches only at depth 3, not deeper. Users wanting
            #   subtree from a glob-bearing path should add a trailing
            #   slash to make the intent explicit.
            if not anchored and not has_slash:
                entries.append(("basename", body))
            elif is_dir_only or (anchored and not has_slash):
                entries.append(("path_or_under", body, body.split("/")))
            else:
                entries.append(("path_exact", body, body.split("/")))
        return cls(entries, patterns)

    @property
    def patterns(self) -> list[str]:
        """The normalized pattern lines, for display in error messages and
        the wizard's preview. Returned as a fresh list — callers are free
        to mutate without affecting the matcher."""
        return list(self._patterns)

    def __bool__(self) -> bool:
        # Truthy when there's at least one effective pattern. The empty
        # matcher is falsy, which lets callers do `if matcher: ...`
        # to skip the per-path check when nothing was loaded.
        return bool(self._entries)

    @staticmethod
    def _matches_one(parts: list[str], entry: tuple) -> bool:
        """Single-entry match — extracted so matches() and first_match()
        share the per-entry logic. parts is rel.split('/') (passed in to
        avoid re-splitting on every entry)."""
        tag = entry[0]
        if tag == "basename":
            body = entry[1]
            for part in parts:
                if fnmatch.fnmatchcase(part, body):
                    return True
            return False
        # path_or_under or path_exact
        body_segs = entry[2]
        if tag == "path_exact":
            if len(parts) != len(body_segs):
                return False
        else:  # path_or_under
            if len(parts) < len(body_segs):
                return False
        for i, seg in enumerate(body_segs):
            if not fnmatch.fnmatchcase(parts[i], seg):
                return False
        return True

    def matches(self, rel: str) -> bool:
        """True if rel is matched by any pattern. rel is a repo-relative,
        forward-slash-separated path (matching git's convention). Always
        False for the empty matcher."""
        if not self._entries:
            return False
        parts = rel.split("/") if rel else []
        for entry in self._entries:
            if self._matches_one(parts, entry):
                return True
        return False

    def first_match(self, rel: str) -> Optional[str]:
        """The first pattern that matches rel, or None. Used by error
        messages that want to name which pattern caused a rejection (the
        apply-side rule-14 reject in particular reads better when it can
        echo the pattern verbatim)."""
        if not self._entries:
            return None
        parts = rel.split("/") if rel else []
        for entry, pat in zip(self._entries, self._patterns):
            if self._matches_one(parts, entry):
                return pat
        return None


def load_baleignore(repo: Path) -> Optional[BaleignoreMatcher]:
    """Load `<repo>/.baleignore` into a matcher, or return None if the file
    is absent. A present-but-empty file (only comments and blanks) returns
    an empty matcher, distinguishable from None — useful in messaging
    ("you have a .baleignore but it's empty") without re-stat'ing the file.

    Malformed patterns (negation at v0.1) fail loudly: the file is the
    user's source of truth, and silently dropping unsupported syntax
    would mean Claude responses get apply-rejected for reasons that
    look correct on the page.
    """
    f = repo / BALEIGNORE_FILE
    if not f.is_file():
        return None
    try:
        text = f.read_text(encoding="utf-8")
    except OSError as e:
        fail(f"could not read {f}: {e}")
    try:
        return BaleignoreMatcher.from_lines(text.splitlines())
    except ValueError as e:
        fail(f"{f}: {e}")


def build_pack_matcher(
    repo: Path, session_excludes: list[str],
) -> Optional[BaleignoreMatcher]:
    """Compose `.baleignore` lines with this session's extra exclude
    patterns into a single matcher. Returns None when there's neither a
    file nor any session patterns, so the pack walk can skip the per-path
    check entirely in the common case.

    The session-excludes pass through the same parser as the file
    contents — same syntax, same semantics, same negation rejection.
    `walk_for_pack` accepts the combined matcher; it does not need to
    know which patterns came from which source. The wizard previews the
    file contents separately so the user still understands what's
    persistent vs session-scoped, but at walk time they're the same set.
    """
    file_lines: list[str] = []
    f = repo / BALEIGNORE_FILE
    if f.is_file():
        try:
            file_lines = f.read_text(encoding="utf-8").splitlines()
        except OSError as e:
            fail(f"could not read {f}: {e}")
    combined = file_lines + list(session_excludes)
    if not any(ln.strip() and not ln.strip().startswith("#")
               for ln in combined):
        return None
    try:
        return BaleignoreMatcher.from_lines(combined)
    except ValueError as e:
        # `.baleignore` was already validated by load_baleignore in any
        # surface that called it; this branch fires when a session-extra
        # pattern triggered the negation guard. Include the offending
        # pattern in the message — the user typed it.
        fail(f"invalid session exclude pattern: {e}")


def is_baleignore_match(rel: str, matcher: Optional[BaleignoreMatcher]) -> bool:
    """Convenience for apply-side rule 14: True when `rel` is matched.
    None matcher (no `.baleignore`) returns False. Kept as a free function
    so apply-side code reads as `is_baleignore_match(p, matcher)` parallel
    to `is_path_safe(p)`."""
    if matcher is None:
        return False
    return matcher.matches(rel)


def gather_files_for_pack(repo: Path, includes: list[str]) -> list[str]:
    """Return repo-relative paths that should land in the request's context/,
    with no threshold caps engaged. Thin wrapper over walk_for_pack — kept
    as a named entry point because the filter chain (BALE.md sections 6.4
    and 7.5 step 5) is conceptually distinct from the threshold projection
    and a future caller (e.g. a `bale debug filter` introspection command)
    will want just the list, not the projection. cmd_pack itself uses
    walk_for_pack directly so it gets the projection in the same pass.

    Honors `.baleignore` at the repo root (build_pack_matcher loads it) but
    has no surface for session-scoped excludes — those are wizard/CLI-driven
    and `cmd_pack` plumbs them through directly. A debug caller that wants
    to test session excludes can use walk_for_pack with a pre-built matcher
    rather than going through this convenience entry point."""
    matcher = build_pack_matcher(repo, [])
    return walk_for_pack(
        repo, includes, caps=PackCaps(), force=True, matcher=matcher,
    ).files


# ---------------------------------------------------------------------------
# 11. Pack: scope projection + threshold caps (BALE.md section 7.4)
# ---------------------------------------------------------------------------

@dataclass(frozen=True)
class PackCaps:
    """Threshold caps for a pack walk. The hard caps are the only knobs
    --max-* exposes; the soft caps are deliberately not user-tunable, since
    their job is to nudge the user toward thinking about scope before pack
    proceeds, not to be a second tuning surface."""
    max_files_soft: int = PACK_MAX_FILES_SOFT
    max_files_hard: int = PACK_MAX_FILES_HARD
    max_size_soft: int = PACK_MAX_SIZE_SOFT
    max_size_hard: int = PACK_MAX_SIZE_HARD
    max_depth: int = PACK_MAX_DEPTH


@dataclass
class PackProjection:
    """Result of walk_for_pack: the surviving file list plus the numbers the
    threshold-breach prompt and the refusal message both want to display.

    `files` is sorted on return — matches the old gather_files_for_pack
    contract. On a hard breach `files` holds the *partial* list collected
    up to the short-circuit; the caller should treat it as diagnostic, not
    as the set to pack. `largest_dirs` is sorted descending by bytes, capped
    at PACK_LARGEST_DIRS_TOPN — designed for the prompt's brief overview,
    not for surveying the whole tree. `hard_breach` is the cap that
    triggered short-circuit (only set when force=False); it's the field
    cmd_pack reads to decide refusal. `hard_breaches_seen` is the full set
    of hard caps the final totals exceed — populated only under --force,
    where the walk doesn't short-circuit, so the FORCE audit log can name
    every cap that was bypassed instead of just the first."""
    files: list[str]
    total_bytes: int
    max_depth_seen: int
    # (top-level-dir-name, total_bytes_in_dir, file_count_in_dir), descending by bytes.
    largest_dirs: list[tuple[str, int, int]]
    # Human-readable description of the cap that tripped short-circuit, or None.
    hard_breach: Optional[str] = None
    # Hard caps the final totals exceed (populated only under --force).
    hard_breaches_seen: list[str] = field(default_factory=list)
    # Soft caps exceeded by final totals (only when no hard breach was seen).
    soft_breaches: list[str] = field(default_factory=list)


def walk_for_pack(
    repo: Path,
    includes: list[str],
    *,
    caps: PackCaps,
    force: bool,
    matcher: Optional[BaleignoreMatcher] = None,
) -> PackProjection:
    """Enumerate files for pack, applying the filter chain, while accumulating
    file count, total size, max depth, and per-top-level-dir totals.

    Filter chain (BALE.md sections 6.4, 7.5 step 5): git ls-files → drop
    non-files → drop baked-in excluded dirs → drop secrets → drop paths
    matched by the .baleignore-plus-session matcher (if any) → keep only
    paths under --include. Order matches the v0.0.9 function's filter chain
    with the matcher slotted before --include — same reasoning as the
    other exclude filters: cheaper to drop matched paths early than to
    run them through the --include pruner.

    `matcher` is the combined `.baleignore`-plus-session-excludes matcher
    built by `build_pack_matcher`. None (the common case for repos without
    a `.baleignore` and a no-CLI-exclude session) skips the per-path
    matcher check entirely.

    Short-circuit (BALE.md §7.4): when `force` is False, the walk stops the
    moment a hard cap is exceeded, reporting which cap triggered in
    `hard_breach`. When `force` is True, the walk runs to completion with
    no breach detection — --force callers want the full set, not a count
    of what they're bypassing. Soft breaches are computed only when no
    hard breach tripped, since a hard breach already obviates the prompt.

    Depth semantics: `depth` is the number of directory components above
    the file ('foo.txt' is depth 0, 'a/b/foo.txt' is depth 2). A cap of
    20 means files up to 20 directories deep are allowed; the 21st-level
    file trips the cap. Files at depth 0 are bucketed under '(root)' in
    largest_dirs so root-level files don't disappear from the report."""
    files: list[str] = []
    total_bytes = 0
    max_depth_seen = 0
    dir_bytes: dict[str, int] = {}
    dir_counts: dict[str, int] = {}
    hard_breach: Optional[str] = None

    for rel in list_git_files(repo):
        # Filter chain — matches gather_files_for_pack's body so the
        # surviving set on a no-cap run is consistent across entry points.
        if not (repo / rel).is_file():
            continue
        if is_under_excluded_dir(rel):
            continue
        if is_secret_excluded(rel, repo):
            continue
        if matcher is not None and matcher.matches(rel):
            continue
        if not is_under_include(rel, includes):
            continue

        # File survives. Account for it before the cap check, so the
        # breach message can name the file count and size that *include*
        # the offending entry — clearer than "you were at 99,999 and the
        # next file would have been #100,000".
        try:
            size = (repo / rel).stat().st_size
        except OSError:
            # Secrets-and-perms gaps shouldn't crash the walk. Treat
            # unreadable as 0 bytes; the file's still in the surviving
            # set per the filter chain.
            size = 0

        parts = Path(rel).parts
        depth = len(parts) - 1
        top = parts[0] if depth > 0 else "(root)"

        files.append(rel)
        total_bytes += size
        if depth > max_depth_seen:
            max_depth_seen = depth
        dir_bytes[top] = dir_bytes.get(top, 0) + size
        dir_counts[top] = dir_counts.get(top, 0) + 1

        # Hard-cap short-circuit — only when not --force. The order
        # (files → size → depth) is the order the messages will read
        # most naturally if multiple caps would have tripped, since
        # only the first one is reported.
        if not force:
            if len(files) >= caps.max_files_hard + 1:
                hard_breach = (
                    f"file count {len(files):,} exceeds hard cap "
                    f"{caps.max_files_hard:,}"
                )
                break
            if total_bytes > caps.max_size_hard:
                hard_breach = (
                    f"total size {format_bytes(total_bytes)} exceeds hard cap "
                    f"{format_bytes(caps.max_size_hard)}"
                )
                break
            if depth > caps.max_depth:
                hard_breach = (
                    f"path depth {depth} exceeds hard cap {caps.max_depth} "
                    f"(at {rel})"
                )
                break

    # Largest-directories report. Only meaningful when there's something to
    # report — root-only walks just have ('(root)', ...) which is still useful.
    largest = sorted(
        ((d, dir_bytes[d], dir_counts[d]) for d in dir_bytes),
        key=lambda t: t[1],
        reverse=True,
    )[:PACK_LARGEST_DIRS_TOPN]

    # Post-walk breach detection.
    #
    # `hard_breach` is set inside the loop only when the loop short-circuited,
    # which only happens when force=False. So:
    #   - force=False, no breach: hard_breach=None, hard_breaches_seen=[],
    #                             may set soft_breaches
    #   - force=False, breach:    hard_breach="…", hard_breaches_seen=[],
    #                             soft_breaches=[] (we never get past the break)
    #   - force=True, breach:     hard_breach=None, walk ran to completion;
    #                             compute hard_breaches_seen + soft_breaches
    #                             against final totals so the FORCE audit log
    #                             can name every cap that was bypassed.
    #
    # The soft/hard separation in the audit case: list soft breaches only when
    # no hard breach is seen, otherwise the soft list is redundant noise —
    # exceeding the hard cap necessarily exceeds the soft cap of the same kind.
    hard_breaches_seen: list[str] = []
    soft_breaches: list[str] = []
    if hard_breach is None:
        if len(files) > caps.max_files_hard:
            hard_breaches_seen.append(
                f"file count {len(files):,} exceeds hard cap "
                f"{caps.max_files_hard:,}"
            )
        if total_bytes > caps.max_size_hard:
            hard_breaches_seen.append(
                f"total size {format_bytes(total_bytes)} exceeds hard cap "
                f"{format_bytes(caps.max_size_hard)}"
            )
        if max_depth_seen > caps.max_depth:
            hard_breaches_seen.append(
                f"path depth {max_depth_seen} exceeds hard cap "
                f"{caps.max_depth}"
            )
        if not hard_breaches_seen:
            if len(files) > caps.max_files_soft:
                soft_breaches.append(
                    f"file count {len(files):,} exceeds soft cap "
                    f"{caps.max_files_soft:,}"
                )
            if total_bytes > caps.max_size_soft:
                soft_breaches.append(
                    f"total size {format_bytes(total_bytes)} exceeds soft cap "
                    f"{format_bytes(caps.max_size_soft)}"
                )

    return PackProjection(
        files=sorted(files),
        total_bytes=total_bytes,
        max_depth_seen=max_depth_seen,
        largest_dirs=largest,
        hard_breach=hard_breach,
        hard_breaches_seen=hard_breaches_seen,
        soft_breaches=soft_breaches,
    )


def parse_size_arg(s: str) -> int:
    """Parse a --max-size value. Accepts a bare byte count ('5000000'), or
    an integer suffixed with K/M/G (case-insensitive; KB/MB/GB also accepted).
    Multiplier is 1024-based, matching the OS-style 'M' = 2^20 convention
    bale uses throughout (see PACK_MAX_SIZE_* and format_bytes). Raises
    ValueError with a user-facing message on a malformed input — callers
    surface that via fail()."""
    s = (s or "").strip()
    if not s:
        raise ValueError("empty size value")
    # Try the two-char suffixes first ('KB', 'MB', 'GB') so '100MB' doesn't
    # get tail-stripped as '100M' + leftover 'B' on the int parse.
    mults = {"K": 1024, "M": 1024**2, "G": 1024**3}
    upper = s.upper()
    if len(upper) >= 2 and upper[-2:] in ("KB", "MB", "GB"):
        try:
            return int(upper[:-2]) * mults[upper[-2]]
        except ValueError:
            raise ValueError(f"invalid size value: {s!r}")
    if upper[-1] in mults:
        try:
            return int(upper[:-1]) * mults[upper[-1]]
        except ValueError:
            raise ValueError(f"invalid size value: {s!r}")
    try:
        return int(s)
    except ValueError:
        raise ValueError(
            f"invalid size value: {s!r} (expected bytes, or a number with "
            f"K/M/G suffix, e.g. '500M', '1G')"
        )


def format_bytes(n: int) -> str:
    """Pretty-print a byte count using 1024-based units (KB = 2^10, etc.).
    Mirrors the convention used in BALE.md's example projection block and
    in the soft-breach prompt — sticking to one unit family across all
    bale output."""
    if n < 1024:
        return f"{n} B"
    if n < 1024**2:
        return f"{n / 1024:.1f} KB"
    if n < 1024**3:
        return f"{n / (1024**2):.1f} MB"
    return f"{n / (1024**3):.2f} GB"


def format_projection_block(projection: PackProjection) -> str:
    """Render the human-readable projection block per BALE.md §7.4. Shown to
    the user before the y/N prompt on a soft breach, on stderr as the
    'warn and proceed' message in piped mode, and inside the hard-breach
    refusal message — same content in all three places, single source of
    truth."""
    lines = [
        "This pack would include:",
        f"  Files:      {len(projection.files):,}",
        f"  Size:       {format_bytes(projection.total_bytes)}",
        f"  Max depth:  {projection.max_depth_seen} levels",
    ]
    if projection.largest_dirs:
        lines.append("")
        lines.append("Largest directories:")
        for d, b, c in projection.largest_dirs:
            label = d if d == "(root)" else f"{d}/"
            lines.append(f"  {label:<14} {format_bytes(b):>10}   {c:>6,} files")
    return "\n".join(lines)


# ---------------------------------------------------------------------------
# 12. Pack: slug validation
# ---------------------------------------------------------------------------

def is_valid_slug(s: str) -> bool:
    """Kebab-case: lowercase letters, digits, and single hyphens between them."""
    if not s:
        return False
    if s.startswith("-") or s.endswith("-") or "--" in s:
        return False
    return all(c.islower() or c.isdigit() or c == "-" for c in s)


# ---------------------------------------------------------------------------
# 13. Pack: manifest and tarball construction
# ---------------------------------------------------------------------------

def build_request_manifest(
    sid: str,
    project_name: str,
    goal: str,
    constraints: list[str],
    out_of_scope: list[str],
    expects_probe: str,
    context_paths: list[str],
    depends_on: Optional[dict] = None,
) -> dict:
    """Per TARBALL.md section 3.2. `depends_on` defaults to the v0.0.1 shape
    ({previous_response: None, previous_probe: None}); `bale handoff` passes
    a populated dict pointing at the bailout it's continuing from, which is
    the only path that sets `previous_response` non-null in v0.0.6."""
    if depends_on is None:
        depends_on = {
            "previous_response": None,
            "previous_probe": None,
        }
    return {
        "session_id": sid,
        "project": project_name,
        "goal": goal,
        "depends_on": depends_on,
        "constraints": constraints,
        "out_of_scope": out_of_scope,
        "expects_probe": expects_probe,
        "context_included": [f"context/{p}" for p in context_paths],
    }


def build_request_tarball(
    sid: str,
    context_entries: list[tuple[str, Path]],
    manifest: dict,
    out_path: Path,
    *,
    readme_body: Optional[str] = None,
) -> None:
    """Write the request tarball to out_path. Layout per TARBALL.md section 3.1.

    `context_entries` is a list of (context_relative_path, source_absolute_path)
    tuples. For `bale pack` the tuples are (rel, repo / rel) for each repo-
    relative file the scope selected. For `bale handoff` there's exactly one
    tuple — ("handoff.md", <extracted bailout dir>/handoff.md) — because the
    source lives outside the project's repo. Decoupling the context-relative
    path from the source path is what makes both call sites work without one
    pretending to be the other.

    `readme_body` is the §7.3 wizard's optional prose: written as `README.md`
    at the top of the request tarball when set, omitted entirely when None.
    Per TARBALL.md §3.1 (and the wizard's "empty buffer = skip" contract in
    BALE.md §7.3), absence is the canonical signal that the manifest's
    structured fields are the whole story.

    The caller is responsible for path safety on each entry's
    context_relative_path (no traversal, no absolute, no .bale/.git prefix);
    both current callers feed already-filtered inputs.
    """
    nnn = sid[-3:]
    out_path.parent.mkdir(parents=True, exist_ok=True)

    with tempfile.TemporaryDirectory() as tmp:
        request_dir = Path(tmp) / f"request-{nnn}"
        request_dir.mkdir()

        # Inject the global docs from the bale installation. copy2 +
        # follow_symlinks=False preserves mode bits — see the context-files
        # copy below for why that matters for the rest of the tarball.
        for doc in GLOBAL_DOCS:
            shutil.copy2(DOCS_DIR / doc, request_dir / doc, follow_symlinks=False)

        # manifest.json.
        (request_dir / "manifest.json").write_text(
            json.dumps(manifest, indent=2) + "\n", encoding="utf-8",
        )

        # Optional README.md. Written when the wizard collected non-empty
        # prose; omitted otherwise. Trailing newline is normalized so the
        # tarball doesn't ship the rare buffer that ends mid-line.
        if readme_body is not None:
            text = readme_body if readme_body.endswith("\n") else readme_body + "\n"
            (request_dir / "README.md").write_text(text, encoding="utf-8")

        # context/<files>. copy2 + follow_symlinks=False preserves mode bits
        # so an executable script in the project arrives in context/ still
        # executable, matching what stage_response does for files/ in
        # response tarballs.
        context_dir = request_dir / "context"
        context_dir.mkdir()
        for rel, src in context_entries:
            dst = context_dir / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst, follow_symlinks=False)

        # Tar with arcname so the archive's top-level entry is `request-NNN/`,
        # independent of the temp directory's filesystem path.
        with tarfile.open(out_path, "w:gz") as tf:
            tf.add(str(request_dir), arcname=f"request-{nnn}")


def persist_pack_session(repo: Path, sid: str, manifest: dict) -> None:
    """Write per-session metadata. Called AFTER tarball is built but BEFORE
    the lock — see BALE.md section 7.6."""
    sessions_dir = repo / ".bale" / "sessions" / sid
    sessions_dir.mkdir(parents=True, exist_ok=True)
    (sessions_dir / "manifest.json").write_text(
        json.dumps(manifest, indent=2) + "\n", encoding="utf-8",
    )


# ---------------------------------------------------------------------------
# 14. Pack: wizard
# ---------------------------------------------------------------------------
#
# Interactive prompts for the BALE.md §7.3 wizard. Wizard mode engages
# when `bale pack` is invoked without enough on the command line to skip
# it — specifically when either the goal positional or --slug is missing.
# Once engaged, the wizard walks the optionals (excludes, constraints,
# out_of_scope, README) too, prompting only for fields the CLI didn't
# already provide.
#
# Pattern visibility: the wizard previews any `.baleignore` patterns
# already at the repo root before prompting for session-scoped additions.
# Session excludes do NOT persist — they shape this pack only and vanish
# afterward. Persistence lives in `bale config init`'s .baleignore step
# (bale_config.walkthrough_baleignore), so the two surfaces stay
# separable: ad-hoc filtering at pack, durable filtering at config init.
#
# These helpers are pack-specific (single caller — cmd_pack). They live
# in their own section because the wizard is a coherent enough subject
# that grouping the prompts under a banner is cheaper than letting them
# sprawl across cmd_pack's prologue, and parallel to the other "Pack:
# <aspect>" sections already in the file.

# README scaffold template (BALE.md §7.3). Saved as a constant so the
# wizard test can read it back and compare. The braces are replaced by
# the wizard's collected answers; the comment text instructs the user
# how to skip the file (empty buffer omits per BALE.md §7.3).
_PACK_README_SCAFFOLD = """\
# {goal}

<!--
This README is OPTIONAL — extra prose context beyond what the manifest's
structured fields carry. The manifest will already include:

  goal:         {goal}
  constraints:  {constraints}
  out_of_scope: {out_of_scope}

Add prose below this comment that doesn't fit those fields (e.g. a
short story of why the session exists, links to context the architect
wants Claude to read first, a list of files-of-interest with reasons).
Save an empty buffer to omit this README entirely; the structured
fields above will still ship in the manifest either way.
-->

"""


def _wizard_input_required(prompt: str, *, validator=None,
                           validator_hint: str = "") -> str:
    """Single-line prompt, loops until the user gives a non-empty value
    that passes `validator` (if supplied). EOF/^C aborts the whole pack.
    Used for the required wizard fields (goal, slug)."""
    while True:
        try:
            raw = input(prompt).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            fail("aborted at wizard prompt")
        if not raw:
            print("  (cannot be empty)")
            continue
        if validator is not None and not validator(raw):
            print(f"  ({validator_hint})")
            continue
        return raw


def _wizard_input_list(label: str) -> list[str]:
    """Multi-line prompt; one item per line, blank line ends collection.
    Used for the optional list fields (constraints, out_of_scope). EOF/^C
    aborts the whole pack (consistent with the required prompts — a user
    bailing out partway through has signalled they don't want this
    session, not "ship what's collected so far")."""
    print(label)
    items: list[str] = []
    while True:
        try:
            raw = input("> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            fail("aborted at wizard prompt")
        if not raw:
            return items
        items.append(raw)


def _wizard_input_excludes(repo: Path) -> list[str]:
    """The §7.3 'anything to exclude' prompt. Previews any persisted
    `.baleignore` patterns so the user knows what's already filtered before
    adding session-only ones. Returns the session-scoped additions; the
    caller composes them with `.baleignore` via `build_pack_matcher`.

    The preview uses the matcher's own normalized form, not raw file
    bytes — comment lines and blanks are already stripped, so what the
    user sees is what the walk applies. A present-but-empty file shows
    `(no patterns)` rather than nothing, to distinguish 'file exists,
    has no effect' from 'no file'.

    Each pattern goes through BaleignoreMatcher's validator (negation
    rejected, etc.) at compose time in `build_pack_matcher`, so the
    wizard doesn't second-guess syntax here — bad patterns surface as
    fail() inside the pack pipeline a few steps later, with the same
    error wording the file-load path uses."""
    matcher = load_baleignore(repo)
    if matcher is None:
        print(
            "No .baleignore at the repo root. (Set durable patterns via "
            "`bale config init` later if you want them; for now, list "
            "anything to skip just for this pack — gitignore-style "
            "patterns, e.g. data/, *.parquet, /build/.)"
        )
    else:
        persisted = matcher.patterns
        if persisted:
            print("Current .baleignore (already filtered out):")
            for p in persisted:
                print(f"  {p}")
        else:
            print(".baleignore is present but contains no patterns.")
        print(
            "Anything else to exclude just for this pack? "
            "(one per line, blank to finish)"
        )
    return _wizard_input_list("> ")


def _prompt_soft_breach_action() -> str:
    """The §7.4 soft-cap [y]/[e]/[n] prompt. Returns 'y', 'e', or 'n'.

    Re-prompts on unrecognized input rather than picking a default for a
    typo — the choice between 'continue with this scope', 'add filters
    and re-walk', and 'abort the whole pack' is large enough that a
    silent default would surprise the user. EOF/^C is treated as 'n'
    (abort) — consistent with how the rest of the wizard treats those
    signals (a bail-out, not a confirm)."""
    print()
    print("[y] continue with this pack")
    print("[e] edit excludes (add session-only patterns and re-walk)")
    print("[n] abort")
    while True:
        try:
            raw = input("> ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return "n"
        if raw in ("y", "yes"):
            return "y"
        if raw in ("e", "edit"):
            return "e"
        if raw in ("n", "no", ""):
            # Empty input falls through to 'n' — the prompt's whole job
            # is making the user pick, and bare Enter on a scope-breach
            # prompt should be the safe choice.
            return "n"
        print(f"  (didn't recognize {raw!r}; type y, e, or n)")


def _wizard_readme_body(goal: str, constraints: list[str],
                        out_of_scope: list[str], *,
                        no_edit: bool) -> Optional[str]:
    """The README step of the §7.3 wizard. Returns the README content
    (non-empty) or None to omit the file.

    `--no-edit` short-circuits to None without prompting (per §7.3:
    "--no-edit forces skip regardless"). Otherwise: y/N prompt; on y,
    $EDITOR opens with a scaffold pre-populated from the wizard answers.
    An empty buffer after editing also yields None (per §7.3: "Saving
    an empty buffer omits the file")."""
    if no_edit:
        return None
    if not confirm_yn("Add a README with prose context?", default_no=True):
        return None
    scaffold = _PACK_README_SCAFFOLD.format(
        goal=goal,
        constraints=", ".join(constraints) if constraints else "(none)",
        out_of_scope=", ".join(out_of_scope) if out_of_scope else "(none)",
    )
    body = open_in_editor(
        scaffold,
        abort_hint="answer 'n' at the README prompt to skip it",
    )
    return body if body else None


def _wizard_fill_args(args: argparse.Namespace, repo: Path) -> None:
    """Run the §7.3 wizard, populating any args.* fields the CLI left
    unset. Mutates args in place; does not return. Caller has already
    verified stdin is a TTY.

    Prompt order matches the §7.3 example: goal → slug → exclude →
    constraints → out_of_scope → README. Each prompt is skipped if its
    CLI counterpart was already supplied — a user who ran `bale pack
    "my goal" --constraint foo` only sees the slug/exclude/out_of_scope/
    README prompts. The exclude prompt previews any persisted
    `.baleignore` so the user sees what's already filtered before adding
    session-only patterns; persistence happens via `bale config init`,
    not here."""
    print("[bale pack] interactive mode — fill missing fields. ^C to abort.")
    print()

    if args.goal is None:
        args.goal = _wizard_input_required("Goal (one sentence)? > ")

    if args.slug is None:
        args.slug = _wizard_input_required(
            "Short slug (kebab-case)? > ",
            validator=is_valid_slug,
            validator_hint=(
                "must be kebab-case: lowercase letters, digits, hyphens; "
                "no leading/trailing/double hyphens"
            ),
        )

    # Session excludes — skipped when --exclude was already provided on
    # the CLI (parallel to --constraint / --out-of-scope). The §7.3 prompt
    # order puts this between slug and constraints; if the CLI pre-filled
    # it, we silently skip and proceed.
    if not args.exclude:
        args.exclude = _wizard_input_excludes(repo)

    if not args.constraint:
        args.constraint = _wizard_input_list(
            "Any constraints? (one per line, blank to finish)"
        )

    if not args.out_of_scope:
        args.out_of_scope = _wizard_input_list(
            "Any out-of-scope concerns? (one per line, blank to finish)"
        )

    # README is the last step and is what threads $EDITOR into pack. It
    # has no CLI equivalent (the wizard's y/N prompt is the only way to
    # produce a request-tarball README), so it always runs when the
    # wizard is engaged — unless --no-edit suppresses it.
    args._readme_body = _wizard_readme_body(
        args.goal, list(args.constraint), list(args.out_of_scope),
        no_edit=args.no_edit,
    )


# ---------------------------------------------------------------------------
# 15. Pack
# ---------------------------------------------------------------------------

# --- Git-init walkthrough (BALE.md §10) --------------------------------------

# The .gitignore body the walkthrough drops on a fresh init. Sourced from
# BALE.md §6.4's baked-in exclusion set — kept in parallel with the
# pack-side constants above (BAKED_IN_EXCLUDE_DIRS / SECRET_PATTERNS /
# SECRET_PATH_EXCLUDES) rather than reconstructed from them. Two reasons
# the duplication is the right call here: pack consumes those tuples
# programmatically (basename matching, plus npmrc_has_authtoken content
# inspection), and .gitignore needs a verbatim text body with grouping
# comments — reconstructing one from the other would either drop the
# comments or re-introduce the conditional-npmrc logic git can't express.
# validation.sh asserts the literal patterns are present so the two
# surfaces don't silently diverge.
_INITIAL_GITIGNORE_BODY = """\
# bale: default exclusion set (BALE.md §6.4)
# Created by the git-init walkthrough. Edit freely; bale won't rewrite this.

# Bale and git internals
.bale/
.git/

# Common big-build dirs
node_modules/
__pycache__/
.venv/
target/
dist/
build/
.next/
.nuxt/
out/
.cache/

# Common secret patterns.
# Pack's filter only excludes .npmrc when its content matches `_authToken`
# (see npmrc_has_authtoken). .gitignore can't express a content-conditional,
# so this list ignores .npmrc unconditionally — un-ignore with `!.npmrc`
# if your project's .npmrc is genuinely public (registry config only).
.env
.env.*
*.pem
*.key
*_rsa
*_dsa
*.p12
*.pfx
id_rsa
id_dsa
.aws/credentials
.npmrc
.pypirc
"""


def _write_initial_gitignore(cwd: Path) -> None:
    """Create or append the §6.4 baked-in exclusion set to .gitignore.

    On a fresh init the file is usually absent — write _INITIAL_GITIGNORE_BODY
    directly. If a .gitignore already exists (e.g., the user ran a project
    scaffolder like `npx create-foo` before `bale pack`), append the block
    while skipping any pattern lines already present so re-runs and partial
    overlaps don't accumulate duplicates. Comment and blank lines are always
    re-emitted: their job is grouping the appended block, not preserving
    uniqueness.
    """
    gi = cwd / ".gitignore"
    if not gi.exists():
        gi.write_text(_INITIAL_GITIGNORE_BODY, encoding="utf-8")
        return

    existing = gi.read_text(encoding="utf-8")
    existing_patterns = {
        ln.strip()
        for ln in existing.splitlines()
        if ln.strip() and not ln.strip().startswith("#")
    }

    block_lines: list[str] = []
    for raw in _INITIAL_GITIGNORE_BODY.splitlines():
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            block_lines.append(raw)
            continue
        if stripped in existing_patterns:
            continue
        block_lines.append(raw)

    # Ensure a blank line separates pre-existing content from the appended
    # block. If the file already ended in a blank, no extra separator is
    # needed; if it ended with content (with or without a trailing newline),
    # add enough newlines to land the block at column 0 after one blank.
    if existing.endswith("\n\n") or existing == "":
        sep = ""
    elif existing.endswith("\n"):
        sep = "\n"
    else:
        sep = "\n\n"
    with gi.open("a", encoding="utf-8") as f:
        f.write(sep + "\n".join(block_lines) + "\n")


def git_init_walkthrough(cwd: Path, *, force: bool) -> Path:
    """Per BALE.md §10. Offer to initialize a git repo at cwd.

    On accept: run `git init`, prompt for any missing git identity via
    bale_config.walkthrough_git_identity (per the manifest constraint to
    reuse that helper rather than reimplement), write a .gitignore with
    the §6.4 baked-in exclusion set, and record the initial commit. Returns
    the new repo root (== cwd) on success.

    On decline: print the spec'd "bale requires a git repo" one-liner and
    sys.exit(0). Per §10 the decline path is exit 0 — declining isn't an
    error, it's a user choice.

    Defense-in-depth: re-applies the §7.1 step 1-2 refusals before
    initializing even though cmd_pack already called refuse_system_dir on
    cwd. The inner re-check protects future callers (or future direct
    entry points to the walkthrough) from accidentally `git init`-ing at
    `/` or `$HOME`. The home-directory refusal is `--force`-overridable
    per the spec; the system-dir refusal has no override at all.

    Flow ordering note: BALE.md §10 documents the step order as
    init → identity → gitignore → commit. `git init` runs first so the
    identity prompt has a repo to write into; walkthrough_git_identity
    writes the prompted values to repo-local git config (per its own
    constraint — "never --global"), which requires an existing repo.
    The display matches that order.
    """
    print()
    print("This directory isn't a git repository. Bale needs git for branch")
    print("staging and the rollback story.")
    print()

    # Piped / non-interactive mode: there's no way to confirm intent and no
    # way to prompt for identity. Fail loudly rather than auto-initializing
    # a repo somewhere unexpected.
    if not sys.stdin.isatty():
        fail(
            "not in a git repo; the walkthrough needs a TTY (it prompts for "
            "confirmation and git identity). Re-run from an interactive "
            "shell, or run `git init && git add -A && git commit -m initial` "
            "yourself, then retry."
        )

    if not confirm_yn("Would you like me to set it up?", default_no=False):
        print()
        print(
            "bale requires a git repo. Re-run after `git init` or accept "
            "the walkthrough."
        )
        sys.exit(0)

    # Defense in depth — see docstring. cmd_pack already refused at this
    # cwd before calling us; the inner re-check exists in case a future
    # caller forgets that step.
    refuse_system_dir(cwd, force=force)

    print()
    print("Initializing repository...")
    try:
        git(["init"], cwd=cwd)
    except subprocess.CalledProcessError as e:
        fail(
            f"git init at {cwd} failed (exit {e.returncode}). Check "
            f"directory permissions and retry."
        )
    log(f"git init at {cwd}")
    print("  ✓ git init")

    # Identity prompts via the shared helper. It checks repo-local + global
    # scope, reports any already-set values, and prompts only for the
    # unset ones — writing to repo-local (never --global). Prints its own
    # header block, so no preamble line is needed here.
    bale_config.walkthrough_git_identity(cwd)

    _write_initial_gitignore(cwd)
    log("wrote initial .gitignore with §6.4 baked-in exclusion set")
    print("  ✓ Created .gitignore with bale's default exclusion set")

    try:
        git(["add", "-A"], cwd=cwd)
    except subprocess.CalledProcessError as e:
        fail(
            f"git add -A failed (exit {e.returncode}). Inspect the repo "
            f"and re-run `bale pack` after recovering."
        )
    print("  ✓ Staging all files in this directory")

    try:
        git(["commit", "-m", "Initial commit (bale)"], cwd=cwd)
    except subprocess.CalledProcessError as e:
        # Most likely cause: every file in cwd was matched by the new
        # .gitignore (e.g. a directory of nothing but .env files). The
        # spec asks for a real baseline commit, not --allow-empty; fail
        # explicitly so the user understands the directory needs at
        # least one trackable file. The repo is left in the "init'd but
        # uncommitted" state — `bale pack` retried after adding a file
        # will pick up via repo_root and not re-run the walkthrough.
        fail(
            f"initial commit failed (exit {e.returncode}). If the "
            f"directory contains only files matched by the new "
            f".gitignore, add a tracked file (e.g. README.md) and retry. "
            f"The repo is initialized but has no baseline commit yet."
        )
    log("recorded initial commit: 'Initial commit (bale)'")
    print('  ✓ Initial commit: "Initial commit (bale)"')

    print()
    print("Done. Continuing with bale pack...")
    print()
    return cwd


# --- cmd_pack ----------------------------------------------------------------

def cmd_pack(args: argparse.Namespace) -> int:
    cwd = Path.cwd().resolve()
    refuse_system_dir(cwd, force=args.force)

    repo = repo_root(cwd)
    if repo is None:
        # BALE.md §7.1 step 4 / §10: not in a repo → run the walkthrough.
        # The walkthrough re-applies refuse_system_dir as defense in depth
        # (the constraint that motivated separating it from cmd_pack), then
        # `git init`s here, prompts for any missing git identity, writes a
        # .gitignore with the §6.4 baked-in exclusion set, and records the
        # initial commit. On user decline it prints the spec'd one-liner
        # and exits 0; on accept it returns the new repo root (== cwd).
        repo = git_init_walkthrough(cwd, force=args.force)
    refuse_system_dir(repo, force=args.force)

    # Lock check (BALE.md 7.1 step 5).
    existing = read_lock(repo)
    if existing:
        fail(
            f"a session is already open: {existing}. "
            f"Apply its response with `bale apply <tarball>`, or run "
            f"`bale unlock` if the session was abandoned."
        )

    # Wizard entry (BALE.md §7.3). Engaged when either of the required
    # fields (goal positional, --slug) is missing AND stdin is a TTY.
    # The wizard fills in the missing fields plus walks the optionals
    # (excludes, constraints, out_of_scope, README), skipping any field
    # already supplied on the command line. _readme_body is attached to
    # args by the wizard so the build step can pick it up downstream;
    # the non-wizard path leaves it None.
    args._readme_body = None
    if args.goal is None or args.slug is None:
        if not sys.stdin.isatty():
            missing = []
            if args.goal is None:
                missing.append("goal")
            if args.slug is None:
                missing.append("--slug")
            fail(
                f"missing required arg(s) ({', '.join(missing)}) and stdin "
                f"is not a TTY; cannot prompt interactively. Provide them "
                f"on the command line and re-run."
            )
        _wizard_fill_args(args, repo)

    # Input validation.
    if not is_valid_slug(args.slug):
        fail(
            f"--slug must be kebab-case (lowercase letters, digits, "
            f"hyphens; no leading/trailing/double hyphens): got {args.slug!r}"
        )
    goal = args.goal.strip()
    if not goal:
        fail("goal must be non-empty.")
    for inc in args.include:
        if not (repo / inc).exists():
            fail(f"--include path does not exist: {inc}")

    # Pack threshold caps (BALE.md §7.4). The --max-* flags override only
    # the hard caps; the soft caps stay at PACK_MAX_*_SOFT so the prompt
    # still fires at the same scope-sanity threshold regardless of how the
    # user tuned the hard refusal point.
    caps_kwargs: dict = {}
    if args.max_files is not None:
        if args.max_files < 1:
            fail(f"--max-files must be >= 1; got {args.max_files}")
        caps_kwargs["max_files_hard"] = args.max_files
    if args.max_size is not None:
        try:
            caps_kwargs["max_size_hard"] = parse_size_arg(args.max_size)
        except ValueError as e:
            fail(str(e))
    if args.max_depth is not None:
        if args.max_depth < 0:
            fail(f"--max-depth must be >= 0; got {args.max_depth}")
        caps_kwargs["max_depth"] = args.max_depth
    caps = PackCaps(**caps_kwargs)

    # Ensure .bale/ is in .gitignore before we start writing under it. If we
    # had to modify .gitignore and the tree is otherwise clean, auto-commit
    # the change so `bale apply` doesn't trip on the dirty tree later. If
    # the tree is dirty for other reasons, just warn — the user is mid-WIP
    # and we shouldn't entangle our setup commit with their work.
    gitignore_changed = ensure_bale_gitignored(repo)
    if gitignore_changed:
        r = git(["status", "--porcelain"], cwd=repo)
        other_dirty = [
            ln for ln in r.stdout.splitlines()
            if ln and not ln.endswith(" .gitignore")
        ]
        if other_dirty:
            log("note: working tree has other uncommitted changes; "
                ".gitignore was modified but not auto-committed. "
                "Commit it before `bale apply` or apply will refuse.")
        else:
            git(["add", ".gitignore"], cwd=repo)
            git(["commit", "-m", "bale: ignore .bale/"], cwd=repo)
            log("auto-committed the .gitignore change")

    # Build the .baleignore + session-excludes matcher (BALE.md §6.4).
    # None when the repo has no .baleignore AND the session has no extra
    # excludes — walk_for_pack skips the per-path matcher check in that
    # case. The matcher is rebuilt on each iteration of the soft-cap
    # [e] loop below, since adding patterns mid-prompt has to take
    # effect on the re-walk.
    session_excludes: list[str] = list(args.exclude)
    matcher = build_pack_matcher(repo, session_excludes)

    # Walk + project, with the soft-breach edit-excludes loop wrapped
    # around it. The loop's body is:
    #   1. walk_for_pack with the current matcher.
    #   2. Hard breach → refuse (or --force-log-and-proceed).
    #   3. Soft breach → prompt y/e/n.
    #      - y: break out of loop, proceed.
    #      - e: collect more session-exclude patterns, rebuild matcher,
    #           re-walk (this iteration).
    #      - n: abort.
    #   4. No breach → break out of loop, proceed.
    # The loop terminates either via `break` (continue/abort decision
    # made) or via `fail()` (hard breach without --force, or user abort).
    # Piped mode never enters [e] — the warn-and-proceed branch breaks
    # immediately. --force also bypasses the prompt entirely.
    while True:
        projection = walk_for_pack(
            repo, args.include, caps=caps, force=args.force, matcher=matcher,
        )
        files = projection.files
        if not files:
            fail(
                "no files would be included after exclusions; widen "
                "--include or relax .baleignore / --exclude patterns."
            )

        # Breach handling (BALE.md §7.4).
        # Order: hard breach refuses (or --force bypasses with a FORCE log);
        # then soft breach prompts (TTY) or warns (piped) — unless --force,
        # which logs the bypass and proceeds.
        if projection.hard_breach is not None:
            # walk_for_pack only sets hard_breach when force=False; this
            # branch is unreachable under --force by construction.
            sys.stderr.write(format_projection_block(projection) + "\n\n")
            fail(
                f"hard threshold breach: {projection.hard_breach}. "
                f"Walk stopped at the breach (BALE.md §7.4). Re-run with the "
                f"appropriate --max-* flag to raise the cap, or with --force "
                f"to bypass all caps."
            )
        elif args.force:
            # --force is active. Name every cap that would have tripped so the
            # audit log records exactly what was bypassed. hard_breaches_seen
            # is populated even though walk_for_pack didn't short-circuit, and
            # soft_breaches is populated only when no hard breach is seen. An
            # empty union means the user passed --force but nothing tripped —
            # still log the event so the audit trail records the user's intent.
            # The home-dir override (if it fired) was already logged inside
            # refuse_system_dir; this line covers the threshold-cap side.
            all_bypassed = projection.hard_breaches_seen + projection.soft_breaches
            if all_bypassed:
                log(
                    "bypassing threshold breach(es): "
                    + "; ".join(all_bypassed)
                    + f". Final scope: {len(files):,} files, "
                    + f"{format_bytes(projection.total_bytes)}, "
                    + f"max depth {projection.max_depth_seen}.",
                    force=True,
                )
            else:
                log(
                    f"--force active; no thresholds tripped. Final scope: "
                    f"{len(files):,} files, "
                    f"{format_bytes(projection.total_bytes)}, "
                    f"max depth {projection.max_depth_seen}.",
                    force=True,
                )
            break
        elif projection.soft_breaches:
            # Soft breach without --force. Print the projection block to stderr
            # in both modes — it's diagnostic context, not the pack's output —
            # then either prompt (TTY, y/e/n) or warn-and-proceed (piped).
            sys.stderr.write(format_projection_block(projection) + "\n\n")
            sys.stderr.write(
                "Soft threshold breach: "
                + "; ".join(projection.soft_breaches)
                + ".\n"
            )
            if sys.stdin.isatty():
                # [y] continue, [e] edit excludes, [n] abort. Default is
                # abort on bare Enter so an accidental keystroke doesn't
                # pack a 200MB tarball. The prompt repeats on unrecognized
                # input rather than picking a default — better to ask
                # again than to mis-route on a typo.
                action = _prompt_soft_breach_action()
                if action == "n":
                    # No sid allocated yet, no log file open — clean abort.
                    print("[bale] aborted at threshold prompt",
                          file=sys.stderr)
                    return 1
                if action == "e":
                    # Collect more session-only patterns, rebuild matcher,
                    # re-walk. The new patterns stack on top of whatever
                    # was already in session_excludes — pressing `e`
                    # repeatedly is additive, not replace-all.
                    print()
                    print("Adding session-only exclusions. These do NOT")
                    print("modify .baleignore (use `bale config init`")
                    print("for that). Patterns are gitignore-style; one")
                    print("per line, blank to finish:")
                    additions = _wizard_input_list("> ")
                    if not additions:
                        # User pressed Enter immediately — no new patterns
                        # to apply. Re-walk would be identical; just
                        # re-prompt for the breach decision.
                        sys.stderr.write(
                            "[bale] no patterns added; re-prompting.\n"
                        )
                        continue
                    session_excludes.extend(additions)
                    matcher = build_pack_matcher(repo, session_excludes)
                    print()
                    print(f"Added {len(additions)} pattern(s); re-walking...")
                    print()
                    continue
                # action == "y" — proceed past the breach.
                break
            else:
                # Piped mode: the warning already went to stderr above; proceed.
                sys.stderr.write("[bale] piped mode: proceeding past soft breach.\n")
                break
        else:
            # No breach. Proceed.
            break

    # `.baleignore` is force-included in context/ when it exists. The
    # filter chain above would have skipped it only if a baked-in or
    # secret pattern matched (none do — `.baleignore` isn't a secret and
    # isn't under a baked-in excluded dir), but the file may not be
    # tracked yet on a fresh repo, in which case `git ls-files
    # --exclude-standard` already picks it up via the --others branch.
    # The append-if-missing here is defense in depth for the case where
    # a user adds `.baleignore` to their `.gitignore` (which would be
    # odd, but is permitted and Claude shouldn't be blind to the file
    # just because its owning user chose to gitignore it). Inserted as
    # a relative path so it lines up with the other entries the walker
    # produced, and only when it actually exists on disk.
    if (repo / BALEIGNORE_FILE).is_file() and BALEIGNORE_FILE not in files:
        files = sorted(files + [BALEIGNORE_FILE])
        log(f"force-included {BALEIGNORE_FILE} in context (was not in "
            f"git-tracked set)")

    log(f"selected {len(files)} files for context/ "
        f"({format_bytes(projection.total_bytes)}, "
        f"max depth {projection.max_depth_seen})"
        + (f" [session excludes: {len(session_excludes)}]"
           if session_excludes else ""))

    # Allocate session ID and switch logging to the per-session file. The
    # set_log_file() call drains any buffered --force lines from
    # refuse_system_dir / the threshold check above into the new log file,
    # so the session journal has the override events even though they
    # preceded sid allocation.
    sid = next_session_id(repo, args.slug)
    set_log_file(repo / ".bale" / "logs" / f"{sid}.log")
    log(f"session id: {sid}")

    # Manifest.
    manifest = build_request_manifest(
        sid=sid,
        project_name=repo.name,
        goal=goal,
        constraints=list(args.constraint),
        out_of_scope=list(args.out_of_scope),
        expects_probe=args.expects_probe,
        context_paths=files,
    )

    # Build tarball. Pack's context is just repo-relative paths picked by
    # the filter chain; bale handoff builds (rel, source) tuples differently
    # since handoff.md doesn't live in the repo. The wizard's optional
    # README, when the user opted in via the §7.3 prompt, rides along here.
    tarball_path = repo / ".bale" / "outbox" / f"request-{sid}.tar.gz"
    context_entries = [(rel, repo / rel) for rel in files]
    try:
        build_request_tarball(
            sid, context_entries, manifest, tarball_path,
            readme_body=args._readme_body,
        )
    except Exception as e:
        if tarball_path.exists():
            tarball_path.unlink()
        fail(f"failed to build request tarball: {e}")
    log(f"wrote {tarball_path}")

    # Persist session, then acquire the lock LAST (BALE.md 7.6).
    persist_pack_session(repo, sid, manifest)
    write_lock(repo, sid)
    log(f"acquired session lock")

    # post_pack hook. Silent no-op when not configured. Fires after the
    # tarball is on disk AND the session is locked — i.e. after every
    # state change pack performs has succeeded, mirroring the
    # post_apply_pass placement (after merge + tag + lock-clear). A
    # hook-side failure logs but does not unwind pack; the tarball is
    # already where the user needs it.
    #
    # merged_config layers global under project so a single config call covers
    # both `<install>/user/bale.toml` and `<repo>/bale.toml`.
    run_hook(repo, bale_config.merged_config(repo), "post_pack", sid)

    # User-facing summary.
    print()
    print(f"  session id: {sid}")
    print(f"  tarball:    {tarball_path}")
    print(f"  files:      {len(files)} in context/")
    print()
    print("Send the tarball to Claude. When the response tarball comes back,")
    print("run: bale apply <response-tarball>")
    return 0


# ---------------------------------------------------------------------------
# 16. Apply: helpers
# ---------------------------------------------------------------------------

def current_branch(repo: Path) -> str:
    """Return the current branch name (or 'HEAD' if detached — caller decides)."""
    r = git(["rev-parse", "--abbrev-ref", "HEAD"], cwd=repo)
    return r.stdout.strip()


def working_tree_clean(repo: Path) -> tuple[bool, str]:
    """Return (clean, status_output). Clean means git status --porcelain is empty."""
    r = git(["status", "--porcelain"], cwd=repo)
    return (not r.stdout.strip(), r.stdout)


# Allowed top-level keys in a response manifest (TARBALL.md section 5.2).
# `response_kind` is optional (defaults to "normal"); the rest are required.
_REQUIRED_RESPONSE_MANIFEST_KEYS = {
    "session_id", "responds_to", "corrects", "summary",
    "changes", "deferred", "validation_will_run", "claims",
}
_OPTIONAL_RESPONSE_MANIFEST_KEYS = {"response_kind"}
_ALLOWED_RESPONSE_MANIFEST_KEYS = (
    _REQUIRED_RESPONSE_MANIFEST_KEYS | _OPTIONAL_RESPONSE_MANIFEST_KEYS
)
_VALID_ACTIONS = {"created", "modified", "deleted"}
_VALID_CLAIM_VALUES = {"pass", "fail", "untested", "unknown"}
_VALID_RESPONSE_KINDS = {"normal", "bailout"}


def check_response_shell_syntax(response_dir: Path) -> None:
    """Pre-flight `bash -n` on the response's apply.sh and validation.sh.

    Both are required deliverables in every response tarball (TARBALL.md
    section 5.1) and both get staged and invoked by bale — apply.sh as
    part of building the staging tree (BALE.md 8.3 step 4), validation.sh
    after the post-apply reconciliation passes (8.5). Without this pre-
    flight a syntax error in either would surface mid-pipeline after
    expensive cp work. This closes that gap and fails fast for both files.

    Runs against the extracted response tree, not the staging tree, so
    it sees exactly what the tarball shipped.

    The required-files check upstream guarantees both files exist by
    the time this runs.
    """
    for name in ("apply.sh", "validation.sh"):
        path = response_dir / name
        r = subprocess.run(
            ["bash", "-n", str(path)],
            capture_output=True, text=True, check=False,
        )
        if r.returncode != 0:
            msg = (r.stderr or r.stdout or "").strip() or "syntax error"
            fail(f"{name} has bash syntax errors: {msg}")


def validate_response_manifest(manifest: dict) -> None:
    """Per TARBALL.md section 5.2 and BALE.md section 8.1 step 3.

    Strict: every required key present, no unknown keys, every changes[]
    entry complete with non-empty reason.

    `response_kind` (TARBALL.md §5.2, added in v0.0.6) is optional and
    defaults to "normal" if absent — old-shape manifests pass through
    untouched. When present, it must be in `_VALID_RESPONSE_KINDS`.
    For "bailout", §5.6.2 mandates empty `changes`, `deferred`,
    `validation_will_run`, and `claims`; we enforce that here so an
    out-of-shape bailout is rejected before staging.
    """
    if not isinstance(manifest, dict):
        fail("manifest is not a JSON object")

    keys = set(manifest.keys())
    missing = _REQUIRED_RESPONSE_MANIFEST_KEYS - keys
    extra = keys - _ALLOWED_RESPONSE_MANIFEST_KEYS
    if missing:
        fail(f"manifest missing required keys: {sorted(missing)}")
    if extra:
        fail(f"manifest has unknown keys: {sorted(extra)}")

    if not isinstance(manifest["session_id"], str) or not manifest["session_id"]:
        fail("manifest.session_id must be a non-empty string")
    if not isinstance(manifest["responds_to"], str) or not manifest["responds_to"]:
        fail("manifest.responds_to must be a non-empty string")
    if manifest["corrects"] is not None and not isinstance(manifest["corrects"], str):
        fail("manifest.corrects must be a string or null")
    if not isinstance(manifest["summary"], str) or not manifest["summary"].strip():
        fail("manifest.summary must be a non-empty string")

    response_kind = manifest.get("response_kind", "normal")
    if response_kind not in _VALID_RESPONSE_KINDS:
        fail(f"manifest.response_kind must be one of "
             f"{sorted(_VALID_RESPONSE_KINDS)}, got {response_kind!r}")

    if not isinstance(manifest["changes"], list):
        fail("manifest.changes must be a list")
    for i, change in enumerate(manifest["changes"]):
        if not isinstance(change, dict):
            fail(f"manifest.changes[{i}] must be an object")
        change_keys = set(change.keys())
        required = {"path", "action", "reason", "size_bytes", "sha256"}
        cm = required - change_keys
        cx = change_keys - required
        if cm:
            fail(f"manifest.changes[{i}] missing keys: {sorted(cm)}")
        if cx:
            fail(f"manifest.changes[{i}] has unknown keys: {sorted(cx)}")
        if not isinstance(change["path"], str) or not change["path"]:
            fail(f"manifest.changes[{i}].path must be a non-empty string")
        if change["action"] not in _VALID_ACTIONS:
            fail(f"manifest.changes[{i}].action must be one of "
                 f"{sorted(_VALID_ACTIONS)}, got {change['action']!r}")
        if not isinstance(change["reason"], str) or not change["reason"].strip():
            fail(f"manifest.changes[{i}].reason must be non-empty "
                 f"(path={change['path']!r})")
        if not isinstance(change["size_bytes"], int) or change["size_bytes"] < 0:
            fail(f"manifest.changes[{i}].size_bytes must be a non-negative int")
        if change["action"] == "deleted":
            if change["sha256"] is not None:
                fail(f"manifest.changes[{i}]: deleted entries must have sha256=null")
        else:
            if not isinstance(change["sha256"], str) or not change["sha256"]:
                fail(f"manifest.changes[{i}].sha256 required for {change['action']}")

    if not isinstance(manifest["deferred"], list):
        fail("manifest.deferred must be a list")
    for i, d in enumerate(manifest["deferred"]):
        if not isinstance(d, dict):
            fail(f"manifest.deferred[{i}] must be an object")
        if set(d.keys()) != {"what", "why"}:
            fail(f"manifest.deferred[{i}] must have keys {{'what','why'}}, "
                 f"got {sorted(d.keys())}")
        for k in ("what", "why"):
            if not isinstance(d[k], str) or not d[k].strip():
                fail(f"manifest.deferred[{i}].{k} must be a non-empty string")

    if not isinstance(manifest["validation_will_run"], list):
        fail("manifest.validation_will_run must be a list")
    if not all(isinstance(s, str) for s in manifest["validation_will_run"]):
        fail("manifest.validation_will_run entries must be strings")

    if not isinstance(manifest["claims"], dict):
        fail("manifest.claims must be an object")
    for k, v in manifest["claims"].items():
        if v not in _VALID_CLAIM_VALUES:
            fail(f"manifest.claims[{k!r}] must be one of "
                 f"{sorted(_VALID_CLAIM_VALUES)}, got {v!r}")

    # claims keys must be a subset of validation_will_run (BALE.md 8.1 step 10).
    will_run = set(manifest["validation_will_run"])
    claim_keys = set(manifest["claims"].keys())
    extra_claims = claim_keys - will_run
    if extra_claims:
        fail(f"manifest.claims has keys not in validation_will_run: "
             f"{sorted(extra_claims)}")

    # Bailout-shape rules (TARBALL.md §5.6.2). The bailout's apply path
    # skips staging/validation entirely, so an out-of-shape bailout —
    # claiming changes, deferrals, or check predictions — is a contract
    # violation worth rejecting here rather than letting a stale field
    # quietly mislead a reader of the session log later.
    if response_kind == "bailout":
        if manifest["changes"]:
            fail("manifest.response_kind=bailout requires changes[] to be empty "
                 "(TARBALL.md §5.6.2): no files are applied for a bailout")
        if manifest["deferred"]:
            fail("manifest.response_kind=bailout requires deferred[] to be empty "
                 "(TARBALL.md §5.6.2): deferrals live in handoff.md, not the manifest")
        if manifest["validation_will_run"]:
            fail("manifest.response_kind=bailout requires validation_will_run[] "
                 "to be empty (TARBALL.md §5.6.2): no validation runs")
        if manifest["claims"]:
            fail("manifest.response_kind=bailout requires claims{} to be empty "
                 "(TARBALL.md §5.6.2): no validation runs, so nothing to claim")


def verify_files_against_manifest(
    repo: Path, response_dir: Path, manifest: dict,
) -> None:
    """BALE.md 8.1 steps 7, 8, 9. All path-safety + presence + sha256 checks.

    `repo` is the apply target — required since v0.0.10 because step 9's
    path-safety now includes the `.baleignore` match per BALE.md §11
    rule 14: a response cannot declare a path the project's user-managed
    exclusion file says shouldn't ride through bale. The matcher is
    loaded once and reused across all change entries; load failure
    propagates as `fail()` so the apply rejects with the same error
    wording pack uses for the same file.
    """
    files_dir = response_dir / "files"
    baleignore = load_baleignore(repo)

    # 9: path safety on every changes[].path. Two independent gates —
    # is_path_safe rejects path-traversal and reserved prefixes; the
    # .baleignore check (rule 14) rejects paths the user said shouldn't
    # flow through bale. Distinct messages so the user knows which gate
    # tripped and how to recover (fix the manifest vs edit .baleignore).
    for change in manifest["changes"]:
        if not is_path_safe(change["path"]):
            fail(f"unsafe path in manifest: {change['path']}")
        if is_baleignore_match(change["path"], baleignore):
            # baleignore is non-None here (is_baleignore_match returns
            # False on None) so first_match is safe.
            pat = baleignore.first_match(change["path"])
            fail(
                f"manifest declares {change['path']!r} but it matches "
                f".baleignore pattern {pat!r}. The response is rejected "
                f"per BALE.md §11 rule 14. Either edit `.baleignore` to "
                f"allow this path (then re-run apply) or use `bale retry` "
                f"with a corrected response."
            )

    # 7: presence per action.
    for change in manifest["changes"]:
        path = change["path"]
        action = change["action"]
        f = files_dir / path
        if action in ("created", "modified"):
            if not f.is_file():
                fail(f"manifest declares {action} {path} but files/{path} "
                     f"is missing in the tarball")
        else:  # deleted
            if f.exists():
                fail(f"manifest declares deleted {path} but files/{path} "
                     f"is present in the tarball (deletes must not ship a file)")

    # 7 (other direction): every file in files/ is declared.
    declared = {c["path"] for c in manifest["changes"]
                if c["action"] in ("created", "modified")}
    if files_dir.exists():
        for f in files_dir.rglob("*"):
            if f.is_file():
                rel = f.relative_to(files_dir).as_posix()
                if rel not in declared:
                    fail(f"file in tarball not declared in manifest: files/{rel}")

    # 8: sha256 matches for created/modified.
    for change in manifest["changes"]:
        if change["action"] in ("created", "modified"):
            actual = sha256_file(files_dir / change["path"])
            if actual != change["sha256"]:
                fail(f"sha256 mismatch for {change['path']}: "
                     f"manifest={change['sha256'][:12]}..., "
                     f"actual={actual[:12]}...")


def stage_response(repo: Path, response_dir: Path, staging: Path) -> None:
    """Build the staging tree: cp project, overlay files/, run apply.sh.

    BALE.md section 8.3. After cp-overlay, apply.sh runs from response_dir
    with cwd=staging — it handles deletes and any other manifest-declared
    file operations the cp mirror can't express. The post-stage
    reconciliation in reconcile_staging_against_manifest() (BALE.md §8.4,
    §11 rule 18) verifies the resulting tree matches the manifest exactly,
    so apply.sh can't quietly touch undeclared files.

    Raises RuntimeError on apply.sh non-zero exit (BALE.md §11 rule 17).
    The caller wipes staging and rejects the tarball — no git side
    effects, no reconciliation attempted.

    Precondition: `staging` must not exist. `_apply_pipeline` checks
    and removes a stale default-path staging before calling this; the
    explicit --staging-dir path errors out upstream when staging exists.
    The bare `staging.mkdir(parents=True)` below (no `exist_ok=True`) is
    intentional — a violation of the precondition should surface as a
    FileExistsError, not a silent overlay onto someone else's directory.
    """
    staging.mkdir(parents=True)
    staging_resolved = staging.resolve()

    # cp project state into staging, minus .bale/ (BALE.md 8.3 step 2 spec).
    # Also skip the staging directory itself if it lives inside the repo —
    # otherwise iterdir() yields it (we just created it) and we'd copy it
    # into itself.
    for item in repo.iterdir():
        if item.name == ".bale":
            continue
        if item.resolve() == staging_resolved:
            continue
        dst = staging / item.name
        if item.is_dir():
            shutil.copytree(item, dst, symlinks=True)
        else:
            shutil.copy2(item, dst, follow_symlinks=False)

    # Overlay files/ from the response (BALE.md 8.3 step 3).
    files_dir = response_dir / "files"
    if files_dir.exists():
        for src in files_dir.rglob("*"):
            if src.is_file():
                rel = src.relative_to(files_dir)
                dst = staging / rel
                dst.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src, dst, follow_symlinks=False)

    # Run apply.sh from the extracted response dir with cwd=staging
    # (BALE.md 8.3 step 4). Running from response_dir rather than copying
    # apply.sh into staging keeps the staging tree clean for the
    # post-apply reconciliation — reconciliation compares staging against
    # the pre-apply project state and anything extra at the staging root
    # would surface as undeclared. Output is logged in full; on non-zero
    # exit we raise so the caller wipes staging and rejects the tarball.
    apply_sh = response_dir / "apply.sh"
    log("running apply.sh in staging...")
    result = subprocess.run(
        ["bash", str(apply_sh)],
        cwd=str(staging),
        capture_output=True,
        text=True,
    )
    if result.stdout:
        log(f"apply.sh stdout:\n{result.stdout.rstrip()}")
    if result.stderr:
        log(f"apply.sh stderr:\n{result.stderr.rstrip()}")
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip() or "(no output)"
        raise RuntimeError(
            f"apply.sh exited {result.returncode} in staging: {detail}"
        )
    log(f"apply.sh exited 0")


def _walk_tree_sha256(root: Path, skip_paths: set[Path]) -> dict[str, str]:
    """Compute {posix_relative_path: sha256_hex} for every regular file under
    `root`, pruning any directory whose resolved path appears in `skip_paths`.

    Used by reconcile_staging_against_manifest to take symmetric snapshots
    of the pre-apply project tree and the post-apply staging tree. `os.walk`
    with in-place mutation of `dirnames` prevents descending into pruned
    subtrees (e.g. `.bale/` or a staging dir nested inside the repo) so
    large pruned paths aren't even iterated.

    `Path.is_file()` returns False for broken symlinks, which is what we
    want — a dangling symlink shouldn't count toward the diff either way,
    and the cp-overlay path in stage_response wouldn't materialize one as
    a regular file anyway.
    """
    skip_resolved: set[Path] = set()
    for p in skip_paths:
        try:
            skip_resolved.add(p.resolve())
        except OSError:
            # A skip target that doesn't resolve (e.g. --staging-dir under a
            # broken parent) can't match anything we'd walk; drop it.
            continue
    out: dict[str, str] = {}
    for dirpath, dirnames, filenames in os.walk(root):
        d = Path(dirpath)
        # Prune subdirs whose resolved path is in skip_resolved. Mutating
        # dirnames in place is the os.walk-supported way to prevent descent.
        dirnames[:] = [
            name for name in dirnames
            if (d / name).resolve() not in skip_resolved
        ]
        for fn in filenames:
            fp = d / fn
            if fp.is_file():
                rel = fp.relative_to(root).as_posix()
                out[rel] = sha256_file(fp)
    return out


def reconcile_staging_against_manifest(repo: Path, staging: Path,
                                       manifest: dict) -> None:
    """Verify the post-apply.sh staging tree matches the manifest exactly.

    BALE.md §8.4 and §11 rule 18: every created/deleted/modified path in
    staging vs the pre-apply project state must correspond to a manifest
    entry of the matching action and sha256, with no undeclared writes,
    deletes, or modifications. Fails with a clear message naming every
    discrepancy so the user can find them.

    Pre-apply state is the project tree itself, skipping `.bale/` (per
    BALE.md 8.3 step 2 — never copied into staging) and the staging dir
    if it lives inside the repo (the user-set `--staging-dir` case;
    default `<repo>/.bale/staging/` is already covered by the `.bale/`
    skip). Both walks also skip `.git/`: the path-safety rule (§11 rule
    14) already prohibits `.git/`-prefixed paths in the manifest, so
    anything there can't be declared anyway, and the cp preserves it
    byte-for-byte — walking it just costs sha256 time on every apply
    against a mature repo. The two snapshots use the same walk function
    so the baseline is symmetric with what stage_response actually
    copied (modulo the symmetric `.git/` skip).

    Reasoning per action:
      - created: must be absent from project, present in staging, with
        sha256 matching the manifest (which already matched files/ at
        pre-flight).
      - deleted: must be present in project, absent from staging after
        apply.sh ran.
      - modified: must be present in both, with staging's sha256 matching
        the manifest and differing from project (otherwise the manifest's
        action is wrong — modified-with-no-actual-change is a contract
        violation worth surfacing).

    Anything that changed in staging but isn't declared in the manifest
    is an apply.sh violation — the script touched a file it wasn't
    authorized to touch.
    """
    # Build symmetric snapshots. Skip `.bale/` in the project (never copied
    # into staging) and the staging dir itself if it's inside the repo.
    # Skip `.git/` in both — see the docstring rationale (rule 14 prohibits
    # `.git/` paths in the manifest, the cp preserves it byte-for-byte).
    project_state = _walk_tree_sha256(
        repo, {repo / ".bale", repo / ".git", staging}
    )
    staging_state = _walk_tree_sha256(staging, {staging / ".git"})

    project_paths = set(project_state)
    staging_paths = set(staging_state)
    actual_created = staging_paths - project_paths
    actual_deleted = project_paths - staging_paths
    actual_modified = {
        p for p in (project_paths & staging_paths)
        if project_state[p] != staging_state[p]
    }

    problems: list[str] = []

    # For each manifest entry, verify the actual transition matches.
    declared_paths: set[str] = set()
    for change in manifest["changes"]:
        path = change["path"]
        action = change["action"]
        declared_paths.add(path)
        in_project = path in project_state
        in_staging = path in staging_state

        if action == "created":
            if in_project:
                problems.append(
                    f"declared created but existed pre-apply: {path}"
                )
            elif not in_staging:
                problems.append(
                    f"declared created but absent from staging: {path}"
                )
            elif staging_state[path] != change["sha256"]:
                problems.append(
                    f"created {path}: staging sha256={staging_state[path][:12]}..."
                    f" manifest={change['sha256'][:12]}..."
                )
        elif action == "deleted":
            if not in_project:
                problems.append(
                    f"declared deleted but absent pre-apply: {path}"
                )
            elif in_staging:
                problems.append(
                    f"declared deleted but still in staging after apply.sh: {path}"
                )
        elif action == "modified":
            if not in_project:
                problems.append(
                    f"declared modified but absent pre-apply: {path}"
                )
            elif not in_staging:
                problems.append(
                    f"declared modified but absent from staging: {path}"
                )
            elif staging_state[path] != change["sha256"]:
                problems.append(
                    f"modified {path}: staging sha256={staging_state[path][:12]}..."
                    f" manifest={change['sha256'][:12]}..."
                )
            elif project_state[path] == staging_state[path]:
                problems.append(
                    f"declared modified but staging matches project (no change): {path}"
                )

    # Catch undeclared changes — apply.sh touched something the manifest
    # didn't authorize. The .bale-manifest.json that run_validation_sh
    # writes is placed AFTER reconciliation (in step 8.5), so it doesn't
    # appear here as a false positive.
    for path in sorted(actual_created - declared_paths):
        problems.append(f"undeclared created in staging: {path}")
    for path in sorted(actual_deleted - declared_paths):
        problems.append(f"undeclared deleted from staging: {path}")
    for path in sorted(actual_modified - declared_paths):
        problems.append(f"undeclared modified in staging: {path}")

    if problems:
        detail = "\n  ".join(problems)
        raise RuntimeError(
            "post-apply.sh staging does not match manifest "
            f"(BALE.md §11 rule 18):\n  {detail}"
        )

    log(
        f"reconciled staging against manifest: "
        f"{len(actual_created)} created, "
        f"{len(actual_deleted)} deleted, "
        f"{len(actual_modified)} modified"
    )


def run_validation_sh(repo: Path, response_dir: Path, staging: Path,
                      manifest: dict, sid: str) -> int:
    """Copy validation.sh into staging, place .bale-manifest.json for claims
    access, run it, log output, return exit code."""
    val_dst = staging / "validation.sh"
    shutil.copy2(response_dir / "validation.sh", val_dst, follow_symlinks=False)
    val_dst.chmod(0o755)

    # Per BALE.md 7.3 — validation.sh reads claims here.
    (staging / ".bale-manifest.json").write_text(
        json.dumps(manifest, indent=2) + "\n", encoding="utf-8",
    )

    log("running validation.sh in staging...")
    result = subprocess.run(
        ["bash", "validation.sh"],
        cwd=str(staging),
        capture_output=True,
        text=True,
    )

    if result.stdout:
        print(result.stdout, end="")
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)

    log_file = repo / ".bale" / "logs" / f"{sid}.log"
    log_file.parent.mkdir(parents=True, exist_ok=True)
    with log_file.open("a", encoding="utf-8") as f:
        f.write(f"\n--- validation.sh stdout ({sid}) ---\n")
        f.write(result.stdout)
        if result.stderr:
            f.write(f"\n--- validation.sh stderr ---\n")
            f.write(result.stderr)
        f.write(f"\n--- validation.sh exit code: {result.returncode} ---\n")

    return result.returncode


def apply_changes_to_worktree(repo: Path, staging: Path, manifest: dict) -> None:
    """Apply each manifest entry to the working tree. Used by both PASS and HOLD;
    the caller decides whether to commit afterward.
    """
    for change in manifest["changes"]:
        path = change["path"]
        action = change["action"]
        if action in ("created", "modified"):
            src = staging / path
            dst = repo / path
            dst.parent.mkdir(parents=True, exist_ok=True)
            # copy2 + follow_symlinks=False preserves the staging copy's mode
            # bits so an executable file from files/ lands in the worktree
            # still executable. stage_response already preserves mode bits
            # going into staging; this is the matching half on the way out.
            shutil.copy2(src, dst, follow_symlinks=False)
            git(["add", path], cwd=repo)
        elif action == "deleted":
            # `git rm` removes from working tree AND stages the deletion.
            # If the file is already absent from the working tree (e.g. someone
            # deleted it manually), --ignore-unmatch keeps us from erroring.
            git(["rm", "-f", "--ignore-unmatch", path], cwd=repo)


# --- Apply walkthrough (BALE.md §8.7) ----------------------------------------
#
# The walkthrough is the interactive step that resolves a freshly-applied bale
# branch into a terminal git state. Both validation outcomes (PASS, HOLD) print
# the same summary block and then prompt for an action; the action set differs
# per state. Factored into helpers so the summary can be re-built/inspected
# without re-running the apply pipeline (a v0.3 polish item) and so the
# prompt's TTY/EOF handling stays out of _apply_pipeline's already-long body.

def format_walkthrough_summary(
    *,
    sid: str,
    origin_branch: str,
    sid_branch: str,
    state: str,
    exit_code: int,
    manifest: dict,
    response_dir: Path,
    staging: Path,
    repo: Path,
) -> str:
    """Build the BALE.md §8.7 walkthrough summary block as a single string.

    `state` is "PASS" or "HOLD". Pure aside from one `git diff --stat` call
    against the live repo (which is the cheapest way to get an accurate
    origin..sid_branch diffstat and matches the inspection command we tell
    the user to run). The caller prints the returned string.
    """
    lines: list[str] = [""]
    lines.append(f"  [{state}] {sid}")
    lines.append(f"  origin:  {origin_branch}")
    if state == "PASS":
        lines.append(f"  branch:  {sid_branch} (committed; ready to merge)")
    else:
        lines.append(f"  branch:  {sid_branch} (uncommitted; staged changes held)")
    lines.append(f"  summary: {manifest.get('summary', '(no summary)')}")

    # Claims block per TARBALL.md §5.3. The actual claim-vs-verdict
    # reconciliation lives in validation.sh's output (already streamed to the
    # log file before this point); we surface the claims side here so the
    # walkthrough is self-contained for review.
    claims = manifest.get("claims", {}) or {}
    if claims:
        lines.append("")
        lines.append("  claims (verdict in .bale/logs/{}.log):".format(sid))
        width = max(len(k) for k in claims) if claims else 0
        for check, claim in claims.items():
            lines.append(f"    {check:<{width}}  claim={claim}")
        lines.append(f"  validation exit code: {exit_code}")
    else:
        lines.append(f"  validation: exit={exit_code} (no project-level claims)")

    # Diffstat between origin and the bale branch. On the HOLD path the bale
    # branch's HEAD is identical to origin's HEAD (no commit was made), so
    # the rev-range diff is empty; in that case run a diff against the index
    # so the user still sees what's staged. PASS path always has a commit.
    if state == "PASS":
        diff_args = ["diff", "--stat", f"{origin_branch}..{sid_branch}"]
        diff_label = f"origin..{sid_branch}"
    else:
        diff_args = ["diff", "--stat", "--cached"]
        diff_label = "staged (uncommitted)"
    try:
        diffstat = git(diff_args, cwd=repo, check=False).stdout.rstrip()
    except subprocess.CalledProcessError as e:
        diffstat = f"(diffstat unavailable: {e.stderr or e})"
    lines.append("")
    lines.append(f"  diffstat ({diff_label}):")
    if diffstat:
        for ln in diffstat.splitlines():
            lines.append(f"    {ln}")
    else:
        lines.append("    (empty)")

    # notes.md and next-prompt.md from the response — surfaced inline per
    # BALE.md §8.7. Silent skip when absent; absence is the canonical signal
    # of "nothing extra to surface" (TARBALL.md §5.1, §5.4, §5.5).
    for fname in ("notes.md", "next-prompt.md"):
        fpath = response_dir / fname
        if not fpath.is_file():
            continue
        try:
            body = fpath.read_text(encoding="utf-8").rstrip()
        except OSError as e:
            lines.append("")
            lines.append(f"  --- {fname} (unreadable: {e}) ---")
            continue
        if not body:
            continue  # present but empty — treat as silent skip
        lines.append("")
        lines.append(f"  --- {fname} ---")
        for ln in body.splitlines():
            lines.append(f"  {ln}" if ln else "")
        lines.append(f"  --- end {fname} ---")

    # Inspection commands. The user runs these manually if they want to dig
    # past the summary; we don't shell out, just print the commands.
    lines.append("")
    lines.append("  inspect:")
    lines.append(f"    git diff {origin_branch}..{sid_branch}")
    lines.append(f"    git log {sid_branch}")
    lines.append(f"    cat .bale/logs/{sid}.log")
    lines.append(f"    ls {staging}/")
    lines.append("")
    return "\n".join(lines)


def prompt_walkthrough_action(state: str) -> str:
    """Prompt the user for the terminal walkthrough action.

    Returns one of "merge" (PASS only), "inspect" (HOLD only), or "revert"
    (both states). The default selected on Enter / EOF / non-TTY matches
    BALE.md §8.7's piped-mode contract:

      - PASS path → default "merge" (auto-merge into origin).
      - HOLD path → default "inspect" (exit non-zero with branch held).

    `state` is "PASS" or "HOLD"; any other value is a caller bug.
    """
    if state not in ("PASS", "HOLD"):
        raise ValueError(f"prompt_walkthrough_action: bad state {state!r}")
    default = "merge" if state == "PASS" else "inspect"

    if not sys.stdin.isatty():
        # Piped/non-interactive: take the default silently. The summary
        # already printed above carries the context the user needs to
        # interpret the exit code.
        return default

    if state == "PASS":
        print(
            "  [Enter/m] merge into origin (default)   "
            "[r] revert — discard branch"
        )
    else:
        print(
            "  [Enter/i] inspect — hold for review (default)   "
            "[r] revert — discard branch"
        )
    try:
        ans = input("  > ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        # ^C or stdin closed mid-prompt: treat as default. Don't fail the
        # whole apply for an interrupted prompt; the user can re-run.
        print()
        return default

    if ans == "":
        return default
    if ans in ("r", "revert"):
        return "revert"
    if state == "PASS" and ans in ("m", "merge"):
        return "merge"
    if state == "HOLD" and ans in ("i", "inspect"):
        return "inspect"
    # Unrecognized inputs fall back to the default rather than re-prompting.
    # The user can ^C and re-run apply if they typo'd; re-prompt loops in a
    # 2-option surface add code without much benefit.
    print(f"  (unrecognized {ans!r}; defaulting to {default})")
    return default


def resolve_tarball_path(arg: str, cwd: Path, search_paths: list[str]) -> Path:
    """Resolve a CLI tarball argument against `apply.search_paths`.

    Used by `bale apply` and `bale retry`. The semantics are layered so that
    a user with no search_paths configured sees identical behavior to the
    pre-search-paths era:

      1. Absolute path → returned as-is. Search is bypassed entirely (per
         the bale.toml contract). The caller checks existence and emits
         its normal "tarball not found" error if the path doesn't exist.
      2. Relative path AND no search_paths configured → resolved against
         cwd. Same behavior as the original `Path(arg).resolve()` plus
         the caller's existence check.
      3. Relative path AND search_paths configured → cwd first, then each
         configured search path in order. First existing file wins. If
         none match, fail() here with a multi-line message naming every
         directory consulted (cwd plus each search path). Cwd is part
         of the search even though the user didn't configure it — a bare
         filename should still resolve from where the user invoked bale.

    Tilde and env var expansion on search_paths entries is handled upstream
    by get_apply_search_paths; entries arrive here already expanded. The
    cli-supplied `arg` itself is NOT expanded — the shell already does
    that, and a quoted `~/foo` arg almost certainly means the user
    explicitly didn't want expansion.
    """
    p = Path(arg)
    if p.is_absolute():
        return p
    if not search_paths:
        # No search configured — preserve pre-feature behavior verbatim.
        return (cwd / arg).resolve()

    cwd_candidate = cwd / arg
    if cwd_candidate.is_file():
        return cwd_candidate.resolve()
    for sp in search_paths:
        candidate = Path(sp) / arg
        if candidate.is_file():
            return candidate.resolve()

    # Nothing matched. The error names every directory that was searched —
    # per the explicit constraint, the user should never be left guessing
    # which paths bale consulted.
    lines = [f"tarball not found: {arg}", "  searched:"]
    lines.append(f"    {cwd}  (cwd)")
    for sp in search_paths:
        lines.append(f"    {sp}")
    fail("\n".join(lines))
    # fail() does sys.exit; this return is unreachable but keeps mypy happy.
    return cwd_candidate  # pragma: no cover


def first_section_of_handoff(handoff_md_text: str) -> str:
    """Return the first '## …' section of a handoff.md document, header line
    included, up to (but not including) the next '## …' heading or EOF.

    TARBALL.md §5.7 mandates a fixed section order in handoff.md, and the
    first one is `## Original goal`. §5.6.3 requires this section be
    printed at apply time so the architect sees the goal that bailed out
    without opening the tarball. Returns "" if no `## ` heading is found —
    the apply path treats that as an empty banner section rather than a
    fatal error, because the §5.6.3 contract is "print the first section"
    and a missing one is content-level, not a tarball-shape violation.
    """
    lines = handoff_md_text.splitlines(keepends=True)
    start = None
    for i, line in enumerate(lines):
        if line.startswith("## "):
            start = i
            break
    if start is None:
        return ""
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if lines[j].startswith("## "):
            end = j
            break
    return "".join(lines[start:end]).rstrip("\n")


def reading_plan_section(handoff_md_text: str) -> str:
    """Return the text of handoff.md's `## Reading plan for the next session`
    section, header line included, up to (but not including) the next `## `
    heading or EOF. Returns "" if no matching section is found.

    Mirrors first_section_of_handoff in shape — both slice the same document
    by `##` heading. Kept separate rather than parameterized because the
    callers want different things from the same text (the bailout banner
    wants whichever section is first; `bale handoff` wants the specific
    reading-plan section), and the section title is locked by TARBALL.md
    §5.7. If a third heading-scoped extractor lands, a shared helper
    earns its place.
    """
    target = "## Reading plan for the next session"
    lines = handoff_md_text.splitlines(keepends=True)
    start = None
    for i, line in enumerate(lines):
        if line.rstrip("\n") == target:
            start = i
            break
    if start is None:
        return ""
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if lines[j].startswith("## "):
            end = j
            break
    return "".join(lines[start:end]).rstrip("\n")


# Regex for backtick-wrapped inline tokens. Single-backtick spans only:
# `\`([^`\n]+)\`` — content between two backticks on the same line, content
# non-empty, no embedded backticks. Triple-backticks (fenced code blocks)
# and double-backticks (rare) are intentionally NOT matched — reading plans
# cite files as inline-code spans, the markdown convention for paths.
_BACKTICK_INLINE = re.compile(r"`([^`\n]+)`")

# Extensions we treat as "path-shaped" when a token has no slash. Without
# this set, a backtick-wrapped bare filename like `BALE.md` would be
# rejected for lacking a slash — but it's a real path in a flat repo
# root. Conversely, a backtick-wrapped English word like `pass` has
# neither slash nor known extension and is correctly skipped. The set is
# permissive on purpose; the asymmetry in extract_paths_from_reading_plan's
# docstring justifies inclusion over precision.
_PATH_LIKE_EXTENSIONS = frozenset((
    ".md", ".py", ".toml", ".json", ".yml", ".yaml", ".sh", ".bash",
    ".txt", ".html", ".css", ".js", ".ts", ".jsx", ".tsx", ".vue",
    ".rs", ".go", ".rb", ".java", ".c", ".cc", ".cpp", ".h", ".hpp",
))


def extract_paths_from_reading_plan(plan_text: str) -> list[str]:
    """Pull repo-relative file paths out of a reading-plan markdown section.

    Heuristic: scan every backtick-inline span (`like-this`), keep the first
    whitespace-delimited token, strip a trailing `:NNN` line-reference, and
    accept the token as a candidate path when (a) it contains `/` OR has a
    known code/doc extension (per _PATH_LIKE_EXTENSIONS), AND (b) it is
    path-safe per is_path_safe (no leading `/`, no `..`, no `.git/` /
    `.bale/` prefix). The four bale-injected global docs are filtered out
    here too — they ship at the request's top level on every pack, so a
    duplicate under context/ would be noise.

    Output preserves first-appearance order and is deduped. No filesystem
    access — that's gather_files_for_pack's job downstream.

    Deliberately permissive: a false positive becomes a tracked file the
    next session sees unnecessarily (cheap — gather_files_for_pack's
    own filters will drop it if it doesn't exist or matches an exclusion);
    a false negative becomes a file the next session has to ask for
    (expensive — the friction the pre-pack is meant to remove). The
    asymmetry argues for inclusion.
    """
    seen: set[str] = set()
    out: list[str] = []
    for match in _BACKTICK_INLINE.finditer(plan_text):
        # First whitespace-delimited token. A backtick span like
        # `BALE.md §8.7` yields `BALE.md`; the section ref is dropped.
        token = match.group(1).strip().split(None, 1)
        if not token:
            continue
        token = token[0]
        # Strip a `:NNN` line-ref suffix (e.g. `bin/bale:2296` -> `bin/bale`).
        # File paths don't legitimately contain `:` in this project's
        # conventions; if a future filename does, the split needs
        # reworking.
        if ":" in token:
            token = token.split(":", 1)[0]
        if not token:
            continue
        has_slash = "/" in token
        ext = Path(token).suffix.lower()
        if not has_slash and ext not in _PATH_LIKE_EXTENSIONS:
            continue
        if not is_path_safe(token):
            continue
        # Filter out bale-injected global docs (bare-filename match against
        # GLOBAL_DOCS). A reading plan that says "re-read `BALE.md` §8.7"
        # is informational; bale already ships BALE.md at the top level.
        if Path(token).name in GLOBAL_DOCS:
            continue
        if token in seen:
            continue
        seen.add(token)
        out.append(token)
    return out


def print_bailout_banner(manifest: dict, handoff_path: Path,
                         tarball_basename: str) -> None:
    """Per TARBALL.md §5.6.3 steps 1-3: a clear banner identifying the
    response as a bailout, the manifest.summary, the first section of
    handoff.md, and the explicit next-step instruction.

    Output style mirrors the existing PASS / HOLD banners in
    _apply_pipeline — leading blank line, label-value pairs with two-space
    indent — so the eye lands on `[BAILOUT]` the same way it lands on
    `[PASS]` and `[HOLD]`. The multi-line summary and handoff section are
    bracketed by `--- … ---` separators since they don't fit the label-
    value shape.
    """
    try:
        handoff_text = handoff_path.read_text(encoding="utf-8")
    except OSError as e:
        # handoff.md was present at the file-existence check in
        # _apply_bailout; an unreadable file here is a real surprise.
        # Surface and bail.
        fail(f"could not read handoff.md: {e}")
    first_section = first_section_of_handoff(handoff_text)

    print()
    print(f"  [BAILOUT] {manifest['session_id']}")
    print(f"  No changes applied. apply.sh and validation.sh were not run.")
    print()
    print(f"  --- summary ---")
    for line in manifest["summary"].splitlines() or [""]:
        print(f"  {line}")
    print()
    print(f"  --- handoff (first section) ---")
    if first_section:
        for line in first_section.splitlines():
            print(f"  {line}")
    else:
        print(f"  (handoff.md has no `## ` section; check the file directly)")
    print()
    print(f"  Next step:")
    print(f"    bale handoff {tarball_basename}")
    print()


def _apply_bailout(repo: Path, response_dir: Path, manifest: dict, sid: str,
                   tarball_basename: str) -> int:
    """Apply-time handler for `response_kind: "bailout"` per TARBALL.md §5.6.3.

    This is the branch _apply_pipeline takes when the manifest declares a
    bailout. We:

      1. Verify the bailout's mandatory artifacts (handoff.md and
         diagnostics.json) — §5.6.1.
      2. Preserve manifest + handoff.md + diagnostics.json under
         `.bale/sessions/<sid>/` so `bale handoff`'s lineage chase can
         find them later. (Normal-PASS sessions wipe their session dir;
         bailouts keep theirs, since the next handoff session may chase
         this one for repeat-bailout warning.)
      3. Print the §5.6.3 banner (`print_bailout_banner` does the layout).
      4. Clear the lock — the session is consumed. The user's explicit
         next action is `bale handoff <tarball>`, which acquires a fresh
         lock against a new sid.
      5. Return 0. No `apply.sh`, no staging, no validation, no branch.

    No `git_head_at_apply` / `origin_branch` / `staging_path` metadata is
    written — no branch is created so there's nothing for `bale revert`
    to chase. (`bale revert` against a bailout sid will fall through the
    `no branch` guard, which is correct: a bailout has nothing to
    revert.)
    """
    handoff_path = response_dir / "handoff.md"
    diagnostics_path = response_dir / "diagnostics.json"
    if not handoff_path.is_file():
        fail("bailout response is missing handoff.md (TARBALL.md §5.6.1 — "
             "required when response_kind=bailout)")
    if not diagnostics_path.is_file():
        fail("bailout response is missing diagnostics.json (TARBALL.md §5.6.1 — "
             "required when response_kind=bailout)")

    # JSON sanity on diagnostics. The schema is intentionally loose
    # (TARBALL.md §5.8), but it must parse — an unparseable file is the
    # kind of thing aggregation tooling later would silently skip, which
    # is worse than failing here.
    try:
        json.loads(diagnostics_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as e:
        fail(f"diagnostics.json is not valid JSON: {e}")

    # Preserve artifacts for the lineage chase + later inspection.
    sessions_dir = repo / ".bale" / "sessions" / sid
    sessions_dir.mkdir(parents=True, exist_ok=True)
    (sessions_dir / "response-manifest.json").write_text(
        json.dumps(manifest, indent=2) + "\n", encoding="utf-8",
    )
    shutil.copy2(handoff_path, sessions_dir / "handoff.md", follow_symlinks=False)
    shutil.copy2(diagnostics_path, sessions_dir / "diagnostics.json",
                 follow_symlinks=False)
    log(f"bailout artifacts preserved under {sessions_dir}")

    print_bailout_banner(manifest, handoff_path, tarball_basename)

    # Lock release. The bailed session is consumed; the next user action is
    # `bale handoff <tarball>` (which itself does the pack-style lock
    # acquisition for the follow-up session). The bailout's session dir
    # stays in place — small, valuable for the chase, easy to remove by
    # hand if the user decides the lineage is done.
    clear_lock(repo)
    log(f"bailout {sid}: lock cleared")
    return 0


# ---------------------------------------------------------------------------
# 17. Apply: pipeline
# ---------------------------------------------------------------------------

def _apply_pipeline(repo: Path, tarball_path: Path, locked_sid: str,
                    staging_override: Optional[str]) -> int:
    """The apply pipeline proper: extract, validate, stage, run
    validation.sh, commit-or-hold. Shared between cmd_apply (after lock
    + clean-tree guards) and cmd_retry (after _discard_hold_state has
    cleaned up a HOLDed attempt).

    Expects, on entry:
      - lock held on `locked_sid`
      - working tree clean
      - no bale/<sid> branch (revert/retry deleted it if needed)
      - logging already wired to the session log file

    Returns the apply exit code: 0 on PASS, 1 on HOLD.
    """
    # Extract and validate the tarball into a temp dir.
    with tempfile.TemporaryDirectory() as tmpdir:
        # 8.1 step 1: tar integrity.
        try:
            tf = tarfile.open(tarball_path, "r:gz")
        except (tarfile.TarError, OSError) as e:
            fail(f"tarball is unreadable: {e}")

        try:
            # Defensive scan for unsafe paths inside the archive itself.
            for member in tf.getmembers():
                name = member.name
                if name.startswith("/") or ".." in Path(name).parts:
                    fail(f"tarball contains unsafe path: {name}")
            # 8.1 step 2: extract.
            tf.extractall(tmpdir)
        finally:
            tf.close()

        # The archive must have exactly one top-level response-NNN/ directory.
        entries = [p for p in Path(tmpdir).iterdir()]
        if len(entries) != 1 or not entries[0].is_dir():
            fail(f"tarball must contain exactly one top-level directory; "
                 f"found {[e.name for e in entries]}")
        response_dir = entries[0]
        if not response_dir.name.startswith("response-"):
            fail(f"top-level directory must be named response-NNN/, "
                 f"got {response_dir.name}/")

        # 8.1 step 11: required files present.
        for required in ("manifest.json", "apply.sh", "validation.sh"):
            if not (response_dir / required).is_file():
                fail(f"missing required file in tarball: {required}")

        # Pre-flight syntax check on the response's shell deliverables.
        # The required-files check above guarantees they exist.
        check_response_shell_syntax(response_dir)
        log("apply.sh and validation.sh syntax checks passed")

        # 8.1 step 3: read and schema-validate the manifest.
        try:
            manifest = json.loads((response_dir / "manifest.json").read_text())
        except (OSError, json.JSONDecodeError) as e:
            fail(f"manifest.json is not valid JSON: {e}")
        validate_response_manifest(manifest)
        log("manifest schema validation passed")

        # 8.1 step 6: responds_to matches the locked sid.
        if manifest["responds_to"] != locked_sid:
            fail(f"manifest.responds_to={manifest['responds_to']!r} does not "
                 f"match locked session {locked_sid!r}")

        # Bailout fork — TARBALL.md §5.6.3. response_kind="bailout" means no
        # files, no apply.sh effect, no validation.sh run; the response is a
        # signal to package a fresh session via `bale handoff <tarball>`.
        # _apply_bailout owns the artifact checks, the session-dir
        # preservation, the §5.6.3 banner, and the lock release. The early
        # branch is what keeps the bailout path free of staging side
        # effects — by the time the normal path's verify_files / stage /
        # reconcile runs, response_kind=="normal" is guaranteed.
        #
        # The `.get(..., "normal")` default keeps v0.0.5-shaped manifests
        # (the ones without a response_kind key — including this very CLI
        # session's own response) on the normal path. Validation upstream
        # guarantees the value is in _VALID_RESPONSE_KINDS when present.
        if manifest.get("response_kind", "normal") == "bailout":
            return _apply_bailout(
                repo, response_dir, manifest, locked_sid, tarball_path.name,
            )

        # 8.1 steps 7, 8, 9: file presence, sha256, path safety (incl.
        # .baleignore match per BALE.md §11 rule 14).
        verify_files_against_manifest(repo, response_dir, manifest)
        log("file presence, sha256, and path safety verified")

        # 8.2 stamp session.
        sessions_dir = repo / ".bale" / "sessions" / locked_sid
        sessions_dir.mkdir(parents=True, exist_ok=True)
        head = git(["rev-parse", "HEAD"], cwd=repo).stdout.strip()
        origin_branch = current_branch(repo)
        (sessions_dir / "git_head_at_apply").write_text(head + "\n")
        (sessions_dir / "origin_branch").write_text(origin_branch + "\n")
        (sessions_dir / "response-manifest.json").write_text(
            json.dumps(manifest, indent=2) + "\n", encoding="utf-8",
        )

        # 8.3 stage. Default is <repo>/.bale/staging so the tree lives
        # inside the already-gitignored .bale/ directory; --staging-dir
        # overrides and resolves relative to cwd as before.
        if staging_override is None:
            staging = repo / ".bale" / "staging"
        else:
            staging = Path(staging_override).resolve()
        if staging.exists():
            # Default-path staging from a prior session is unambiguously stale
            # at this point: either the previous session PASSed (its session
            # dir has already been removed by the PASS path below, with the
            # merge commit plus applied/<sid> tag as the durable record), or this is a
            # retry of an apply that errored mid-stage (rebuilding identical
            # staging from inputs is correct), or it's a HOLD the user has
            # decided to move past (re-invoking apply is the signal). The
            # `bale revert` path has its own staging cleanup. A user-specified
            # --staging-dir, by contrast, is the user's directory and we
            # refuse rather than nuke it.
            if staging_override is None:
                log(f"removing stale staging at {staging}")
                try:
                    shutil.rmtree(staging)
                except OSError as e:
                    fail(f"could not remove stale staging at {staging}: {e}")
            else:
                fail(f"staging directory already exists: {staging}. "
                     f"Remove it or pass a different --staging-dir.")
        # Record staging path under the session dir so `bale revert` can
        # clean it up later. Written before stage_response so a partial
        # stage that errors out still leaves a trail for revert to follow.
        (sessions_dir / "staging_path").write_text(str(staging) + "\n")
        try:
            stage_response(repo, response_dir, staging)
        except Exception as e:
            shutil.rmtree(staging, ignore_errors=True)
            fail(f"failed to stage response: {e}")
        log(f"staged into {staging}")

        # 8.4 reconcile the post-apply.sh staging tree against the manifest
        # (BALE.md §11 rule 18). Runs before branch creation so a failure
        # leaves no git side effects — wipe staging, exit non-zero.
        try:
            reconcile_staging_against_manifest(repo, staging, manifest)
        except Exception as e:
            shutil.rmtree(staging, ignore_errors=True)
            fail(str(e))

        # 8.5: create bale/<sid> branch at HEAD (don't check out yet).
        sid_branch = f"bale/{locked_sid}"
        try:
            git(["branch", sid_branch, "HEAD"], cwd=repo)
        except subprocess.CalledProcessError as e:
            fail(f"could not create branch {sid_branch}: "
                 f"{e.stderr or e.stdout or e}")
        log(f"created branch {sid_branch} at HEAD ({head[:7]})")

        # Run validation.sh in staging.
        exit_code = run_validation_sh(repo, response_dir, staging, manifest, locked_sid)
        log(f"validation.sh exit code: {exit_code}")

        # 8.6 commit-or-hold + 8.7 walkthrough. Both validation outcomes
        # check out bale/<sid> and apply the manifest's changes to the
        # working tree; PASS additionally commits so the branch carries a
        # merge-ready commit before the walkthrough prompts. HOLD leaves the
        # changes staged but uncommitted, matching BALE.md §8.6 step 2 of
        # the HOLD path.
        git(["checkout", sid_branch], cwd=repo)
        apply_changes_to_worktree(repo, staging, manifest)
        state = "PASS" if exit_code == 0 else "HOLD"
        if state == "PASS":
            commit_msg = f"[bale {locked_sid}] {manifest['summary']}"
            git(["commit", "-m", commit_msg], cwd=repo)
            log(f"committed changes to {sid_branch}")
        else:
            log(f"validation FAILED (exit={exit_code}); held on {sid_branch} "
                f"with staged uncommitted changes")

        # 8.7 walkthrough — print summary, prompt for terminal action.
        # Both PASS and HOLD go through the same summary path so the user
        # sees the same shape regardless of outcome (only the prompt
        # action set and the default differ).
        print(format_walkthrough_summary(
            sid=locked_sid,
            origin_branch=origin_branch,
            sid_branch=sid_branch,
            state=state,
            exit_code=exit_code,
            manifest=manifest,
            response_dir=response_dir,
            staging=staging,
            repo=repo,
        ))
        action = prompt_walkthrough_action(state)
        log(f"walkthrough action: {action}")

        # 8.8 terminal actions. Merge (PASS only), inspect (HOLD only),
        # revert (both states; currently stubbed — see below).
        if action == "merge":
            # PASS → merge into origin, tag the applied sid, delete the
            # bale branch, clean up session dir + lock, fire the hook.
            # Order matches the pre-walkthrough PASS path so the hook keeps
            # firing after a durable git state is in place.
            git(["checkout", origin_branch], cwd=repo)
            git(["merge", "--no-ff", sid_branch, "-m",
                 f"Merge bale {locked_sid}"], cwd=repo)
            git(["tag", f"applied/{locked_sid}"], cwd=repo)
            git(["branch", "-d", sid_branch], cwd=repo)
            clear_lock(repo)
            shutil.rmtree(sessions_dir, ignore_errors=True)
            log(f"tagged applied/{locked_sid}, cleared lock, deleted {sid_branch}")

            # post_apply_pass hook. Silent no-op when not configured. Prompts
            # the user before invoking; a decline is logged and silent. The
            # hook runs after the merge so a hook-side failure can't unwind
            # bale's primary work — at this point the session is durably
            # applied and tagged.
            #
            # merged_config layers global under project so a single config
            # call covers both `<install>/user/bale.toml` and `<repo>/bale.toml`.
            run_hook(repo, bale_config.merged_config(repo), "post_apply_pass", locked_sid)

            print()
            print(f"  [PASS] {locked_sid}")
            print(f"  tag:     applied/{locked_sid}")
            print(f"  branch:  {origin_branch} (merged)")
            print(f"  files:   {len(manifest['changes'])} changed")
            print(f"  staging: {staging} (preserved for inspection)")
            return 0

        if action == "inspect":
            # HOLD → leave branch checked out with staged changes for the
            # user to investigate. Exit non-zero per BALE.md §8.7 piped-mode
            # contract; the lock and branch persist until the user retries
            # with a corrected response or reverts.
            print()
            print(f"  [HOLD] {locked_sid}")
            print(f"  validation exited {exit_code}")
            print(f"  branch:  {sid_branch} (uncommitted; "
                  f"`git diff --cached` to inspect)")
            print(f"  log:     .bale/logs/{locked_sid}.log")
            print(f"  staging: {staging} (preserved)")
            print(f"  retry:   bale retry <new-tarball>")
            print(f"  discard: bale revert {locked_sid}")
            return 1

        # action == "revert" — BALE.md §8.8: "Delete the branch (forcefully),
        # wipe .bale/sessions/<sid>/, clear the lock. Same operation
        # regardless of whether validation passed or held." Wired through
        # to _discard_hold_state (section 19) which already does the heavy
        # lifting for `bale revert <sid>` — branch-aware reset/checkout,
        # branch -D, session-dir wipe, recorded-staging wipe. clear_lock
        # is the caller's responsibility per _discard_hold_state's
        # docstring contract.
        #
        # Why this is safe on the PASS path: PASS just committed on
        # bale/<sid>, so sid_sha != origin_sha and _discard_hold_state's
        # ancestor guard recognises this as an unmerged branch (the
        # guard's purpose is to refuse already-merged sessions, which
        # this isn't — origin still points at HEAD-pre-apply). On the
        # HOLD path, sid_sha == origin_sha so the guard's "is_ancestor"
        # branch short-circuits as designed. Either way the cleanup
        # runs.
        #
        # Exit code: 1, matching the stub this replaces. The work did
        # not land in origin; a scripted `bale apply $TARBALL && deploy`
        # caller should short-circuit. The distinction between
        # [HOLD]+inspect (work staged for human review) and
        # [REVERT]+revert (work backed out cleanly) lives in the
        # printed banner, not the exit code — exit code carries the
        # binary "work landed or not" signal only.
        status = _discard_hold_state(repo, locked_sid)
        clear_lock(repo)
        log(f"walkthrough revert: {locked_sid}; lock cleared")

        print()
        print(f"  [REVERT] {locked_sid}")
        print(f"  branch:  {status['origin_branch']} "
              f"({sid_branch} deleted)")
        print(f"  lock:    cleared")
        print(f"  staging: {status['staging_status']}")
        return 1


# ---------------------------------------------------------------------------
# 18. Apply
# ---------------------------------------------------------------------------

def cmd_apply(args: argparse.Namespace) -> int:
    cwd = Path.cwd().resolve()
    refuse_system_dir(cwd)

    repo = repo_root(cwd)
    if repo is None:
        fail("not in a git repo. `bale apply` requires the project repo.")
    refuse_system_dir(repo)

    # Resolve the tarball argument through apply.search_paths. When no
    # search paths are configured at either layer, this is equivalent to
    # Path(arg).resolve() against cwd — preserving the pre-feature behavior
    # verbatim. The config-malformed-path is fatal up front (merged_config
    # delegates to load_config/load_global_config which both validate parsing,
    # and get_apply_search_paths validates the shape) so the user finds out
    # before any session work.
    cfg = bale_config.merged_config(repo)
    search_paths = bale_config.get_apply_search_paths(cfg)
    tarball_path = resolve_tarball_path(args.tarball, cwd, search_paths)
    if not tarball_path.is_file():
        # Only reachable for the absolute-path branch (relative + search
        # paths configured already fails inside the helper); the empty-
        # search-paths relative branch reaches here only if (cwd/arg)
        # doesn't exist. Either way, the existing message is right.
        fail(f"tarball not found: {tarball_path}")

    # 8.1 step 4: lock must exist (a session was opened with `bale pack`).
    locked_sid = read_lock(repo)
    if locked_sid is None:
        fail("no session is open. Run `bale pack` first to open one.")

    # Wire logging to the session log from here on.
    set_log_file(repo / ".bale" / "logs" / f"{locked_sid}.log")
    log(f"applying {tarball_path.name} against session {locked_sid}")

    # 8.1 step 5: working tree clean. (cmd_retry skips this guard because
    # a HOLDed session's worktree is dirty by construction; retry's
    # _discard_hold_state cleans it before calling _apply_pipeline.)
    clean, status = working_tree_clean(repo)
    if not clean:
        fail("working tree is not clean. Commit or stash before applying:\n" + status)

    return _apply_pipeline(repo, tarball_path, locked_sid, args.staging_dir)


# ---------------------------------------------------------------------------
# 19. Revert
# ---------------------------------------------------------------------------

def _discard_hold_state(repo: Path, sid: str) -> dict:
    """Discard the HOLD-applied state for sid.

    Resets uncommitted changes on bale/<sid> if checked out, deletes the
    branch, wipes the session dir, wipes the recorded staging directory.
    Lock is intentionally preserved — callers manage that. cmd_revert
    clears it after calling this helper; cmd_retry leaves it for
    _apply_pipeline.

    fail()s if bale/<sid> is already merged into the recorded origin
    branch: that case means apply already PASSed, and either revert or
    retry would be undoing committed work — the right verb is
    `git revert applied/<sid>` instead.

    Idempotent in the partial-state cases:
      - no bale branch → log and skip branch operations
      - no session dir → log and skip the wipe
      - no recorded staging → log and skip
    These cases arise legitimately from cmd_retry against a session
    that was packed but never applied (no apply attempt = no branch).

    Invariant: if bale/<sid> exists, the session dir's origin_branch
    metadata also exists, because the apply pipeline writes 8.2's
    metadata before creating the branch at 8.5.

    Returns a status dict for caller-side summary output:
        {
            "branch_existed": bool,
            "origin_branch": str | None,
            "staging_status": str,  # "wiped (path)" / "already gone" / "not recorded"
        }
    """
    sessions_dir = repo / ".bale" / "sessions" / sid
    sid_branch = f"bale/{sid}"

    # Read staging path BEFORE wiping sessions_dir so the trail survives.
    recorded_staging: Optional[Path] = None
    staging_path_file = sessions_dir / "staging_path"
    if staging_path_file.is_file():
        s = staging_path_file.read_text().strip()
        if s:
            recorded_staging = Path(s)

    # Branch handling.
    branch_check = git(["rev-parse", "--verify", "--quiet", sid_branch],
                       cwd=repo, check=False)
    branch_existed = branch_check.returncode == 0
    origin_branch: Optional[str] = None

    if branch_existed:
        # Per the invariant above, origin_branch metadata must exist.
        origin_branch_file = sessions_dir / "origin_branch"
        if not origin_branch_file.is_file():
            fail(f"{sid_branch} exists but session metadata at "
                 f"{sessions_dir} is missing. Resolve manually.")
        origin_branch = origin_branch_file.read_text().strip()
        if not origin_branch:
            fail(f"origin_branch file at {origin_branch_file} is empty")

        # Refuse if already merged into origin. Tricky: in a HOLD the bale
        # branch and origin point at the SAME commit (no commit was made
        # on the bale branch), so the literal `is-ancestor` check is
        # trivially true even though nothing was merged. The intent is
        # "merged via a merge commit so deleting the branch would lose
        # history that's threaded through origin" — which only applies
        # when the SHAs differ. So guard the ancestor check accordingly.
        sid_sha = git(["rev-parse", sid_branch], cwd=repo).stdout.strip()
        origin_sha = git(["rev-parse", origin_branch], cwd=repo).stdout.strip()
        if sid_sha != origin_sha:
            ancestor = git(["merge-base", "--is-ancestor", sid_branch, origin_branch],
                           cwd=repo, check=False)
            if ancestor.returncode == 0:
                fail(f"{sid_branch} is already an ancestor of {origin_branch} — "
                     f"this session was already merged. v0.0.1 has no `bale rollback`; "
                     f"use `git revert applied/{sid}` manually.")

        # If on the bale branch, reset HOLD's staged changes and switch to
        # origin. (cmd_revert previously had a --force override note for
        # other dirty-tree cases; we don't touch other branches' WIP
        # because we don't check them out.)
        current = current_branch(repo)
        if current == sid_branch:
            log(f"on {sid_branch}; resetting staged changes and switching to {origin_branch}")
            git(["reset", "--hard", "HEAD"], cwd=repo)
            git(["checkout", origin_branch], cwd=repo)
        elif current != origin_branch:
            log(f"on {current}; deleting {sid_branch} without changing branch")

        # Force-delete the bale branch.
        git(["branch", "-D", sid_branch], cwd=repo)
        log(f"deleted branch {sid_branch}")
    else:
        log(f"no branch {sid_branch} to discard (no prior apply attempt)")

    # Session dir wipe.
    if sessions_dir.exists():
        shutil.rmtree(sessions_dir)
        log(f"wiped {sessions_dir}")

    # Staging cleanup. Idempotent: a missing directory is fine — the user
    # may have already removed it, or the session never made it past the
    # exists() pre-check at apply time. Don't fail the whole operation
    # for an unremovable staging dir; the git side is already reverted.
    if recorded_staging is None:
        staging_status = "not recorded"
        log("no recorded staging path; skipping staging cleanup")
    elif recorded_staging.exists():
        try:
            shutil.rmtree(recorded_staging)
            log(f"wiped staging at {recorded_staging}")
            staging_status = f"wiped ({recorded_staging})"
        except OSError as e:
            log(f"warning: could not remove {recorded_staging}: {e}")
            staging_status = f"left in place ({recorded_staging}: {e})"
    else:
        log(f"staging at {recorded_staging} already gone")
        staging_status = "already gone"

    return {
        "branch_existed": branch_existed,
        "origin_branch": origin_branch,
        "staging_status": staging_status,
    }


def cmd_revert(args: argparse.Namespace) -> int:
    cwd = Path.cwd().resolve()
    refuse_system_dir(cwd)

    repo = repo_root(cwd)
    if repo is None:
        fail("not in a git repo. `bale revert` requires the project repo.")
    refuse_system_dir(repo)

    sid = args.sid
    sid_branch = f"bale/{sid}"
    sessions_dir = repo / ".bale" / "sessions" / sid

    set_log_file(repo / ".bale" / "logs" / f"{sid}.log")
    log(f"revert: {sid}")

    # Revert-specific contract: refuse when there's nothing to revert.
    # cmd_retry is more permissive (it can run against a packed-but-not-
    # applied session) — that policy stays out of _discard_hold_state.

    # 9.1 step 1: metadata must exist.
    if not (sessions_dir / "origin_branch").is_file():
        fail(f"no session metadata for {sid} at {sessions_dir}. Either the "
             f"sid is wrong or the session was already cleaned up.")

    # The bale branch must exist. If it doesn't, the session was already
    # applied (PASS path deletes the branch after merge) — direct the user
    # to git revert, since v0.0.1 has no `bale rollback` yet.
    branch_check = git(["rev-parse", "--verify", "--quiet", sid_branch],
                       cwd=repo, check=False)
    if branch_check.returncode != 0:
        fail(f"no branch {sid_branch}. If the session was already applied, "
             f"v0.0.1 has no `bale rollback` — use `git revert applied/{sid}` "
             f"manually to undo a merged session.")

    # Shared cleanup (9.1 steps 2-6, plus staging cleanup).
    status = _discard_hold_state(repo, sid)

    # 9.1 step 7: clear the lock if this sid is currently locked.
    locked = read_lock(repo)
    lock_cleared = locked == sid
    if lock_cleared:
        clear_lock(repo)
        log(f"cleared lock (was {sid})")

    print()
    print(f"  reverted {sid}")
    print(f"  branch:  {status['origin_branch']}")
    print(f"  lock:    {'cleared' if lock_cleared else 'unchanged'}")
    print(f"  staging: {status['staging_status']}")
    return 0


# ---------------------------------------------------------------------------
# 20. Retry
# ---------------------------------------------------------------------------
#
# Re-attempt a HOLDed session with a corrected response tarball, in the
# same session id. Without this command the user must `bale revert` + re-
# `pack` + `apply`, which mints a fresh sid and forces `corrects` to
# point across sessions even though the intent and goal didn't change.
# Retry preserves the lock so the new apply lands in the same session.

def cmd_retry(args: argparse.Namespace) -> int:
    cwd = Path.cwd().resolve()
    refuse_system_dir(cwd)

    repo = repo_root(cwd)
    if repo is None:
        fail("not in a git repo. `bale retry` requires the project repo.")
    refuse_system_dir(repo)

    # Same search-path resolution as `bale apply` — retry takes a tarball
    # path argument with the same semantics, so it honors the same merged
    # global+project config.
    cfg = bale_config.merged_config(repo)
    search_paths = bale_config.get_apply_search_paths(cfg)
    tarball_path = resolve_tarball_path(args.tarball, cwd, search_paths)
    if not tarball_path.is_file():
        fail(f"tarball not found: {tarball_path}")

    # Retry requires an open session, same as apply. The lock identifies
    # which session this retry is for — no separate <sid> argument.
    locked_sid = read_lock(repo)
    if locked_sid is None:
        fail("no session is open; nothing to retry. `bale retry` is for "
             "re-attempting a packed session. If you have a tarball but "
             "no open session, run `bale pack` first and then `bale apply`.")

    # Wire logging to the same session log apply/revert use.
    set_log_file(repo / ".bale" / "logs" / f"{locked_sid}.log")
    log(f"retrying session {locked_sid} with {tarball_path.name}")

    # Cleanup is no-op if there's no HOLD to discard (e.g. user packed but
    # never tried apply). In that case retry behaves like apply.
    status = _discard_hold_state(repo, locked_sid)
    if not status["branch_existed"]:
        log("no prior apply attempt for this session; retry equivalent to apply")

    return _apply_pipeline(repo, tarball_path, locked_sid, args.staging_dir)


# ---------------------------------------------------------------------------
# 21. Unlock
# ---------------------------------------------------------------------------
#
# Clear an abandoned session lock — the "held, no branch" state from
# BALE.md §9.5 (user ran `bale pack`, never applied, never reverted).
# Cleans `.bale/current_session` and `.bale/sessions/<sid>/` without
# touching git. Refuses on the HOLD-with-branch state (a `bale/<sid>`
# branch exists) — that's `bale revert` territory; `--force` overrides
# the refusal but leaves the branch in place, since deleting branches
# is precisely what `bale revert` exists to do safely. The `--force`
# path is logged with the FORCE: prefix so the override is auditable
# alongside other --force events in the session log.

def cmd_unlock(args: argparse.Namespace) -> int:
    cwd = Path.cwd().resolve()
    refuse_system_dir(cwd)

    repo = repo_root(cwd)
    if repo is None:
        fail("not in a git repo. `bale unlock` requires the project repo.")
    refuse_system_dir(repo)

    # BALE.md §9.3 step 1: read the lock.
    sid = read_lock(repo)

    # BALE.md §9.3 step 2: empty lock → no-op.
    if sid is None:
        print()
        print("  no open session; nothing to unlock.")
        return 0

    # Wire logging into the session log now that we have a sid. The log
    # file at .bale/logs/<sid>.log lives outside .bale/sessions/<sid>/,
    # so wiping the session dir below doesn't disturb the running log.
    set_log_file(repo / ".bale" / "logs" / f"{sid}.log")
    log(f"unlock: {sid}")

    sid_branch = f"bale/{sid}"
    sessions_dir = repo / ".bale" / "sessions" / sid

    # BALE.md §9.3 step 3: refuse if the bale branch exists. The branch's
    # presence means apply ran far enough to create it but didn't reach a
    # terminal state (PASS would have deleted the branch after merge;
    # revert would have force-deleted it). The right command for that
    # state is `bale revert`, which knows about origin_branch metadata and
    # handles the branch + staging cleanup. --force overrides for the
    # unusual cases (corrupted session dir, manually-edited state) where
    # the user wants bale out of the way regardless.
    branch_check = git(["rev-parse", "--verify", "--quiet", sid_branch],
                       cwd=repo, check=False)
    branch_exists = branch_check.returncode == 0

    if branch_exists and not args.force:
        fail(
            f"branch {sid_branch} exists — this session reached HOLD. "
            f"Use `bale revert {sid}` to discard the branch and clear "
            f"the lock together, or `bale unlock --force` to clear only "
            f"the lock (the branch would be left in place for you to "
            f"delete manually)."
        )

    if branch_exists and args.force:
        log(
            f"--force; clearing lock for {sid} while branch {sid_branch} "
            f"still exists. Branch is preserved.",
            force=True,
        )

    # BALE.md §9.3 step 4: clear the lock, wipe the session dir. No git
    # operations — that's the whole point of unlock vs revert.
    clear_lock(repo)
    log(f"cleared lock (was {sid})")

    if sessions_dir.exists():
        shutil.rmtree(sessions_dir)
        log(f"wiped {sessions_dir}")
        session_status = f"wiped ({sessions_dir})"
    else:
        log(f"no session dir at {sessions_dir} to wipe")
        session_status = "not present"

    print()
    print(f"  unlocked {sid}")
    print(f"  lock:    cleared")
    print(f"  session: {session_status}")
    if branch_exists:
        print(
            f"  branch:  {sid_branch} preserved (--force); "
            f"`git branch -D {sid_branch}` to remove"
        )
    return 0


# ---------------------------------------------------------------------------
# 22. Handoff
# ---------------------------------------------------------------------------
#
# `bale handoff <bailout-tarball>` packs a fresh request from a bailed
# session — the safety net for CLAUDE.md §11 context exhaustion. Inherits
# the bailed-on session's goal verbatim, auto-includes handoff.md plus any
# source files extracted from handoff.md's `## Reading plan for the next
# session` section (TARBALL.md §5.7) in the new request's context/, sets
# depends_on.previous_response to the bailout's session_id, and allocates
# a new session id per TARBALL.md §5.6.2: same slug as the bailout,
# today's date, next NNN.
#
# Pre-pack of source files (v0.0.7+): extract_paths_from_reading_plan
# parses backtick-inline tokens from the reading-plan section,
# gather_files_for_pack applies the standard exclusion / .gitignore
# filter chain, and the surviving files are added to context_entries
# alongside handoff.md. An empty / absent reading plan or one that
# cites no path-shaped tokens degrades cleanly to handoff.md-only —
# the v0.0.6 behavior — so existing bailout tarballs keep working.

def edit_goal_in_editor(initial_goal: str) -> str:
    """Open $EDITOR on the inherited goal and return the user's edit, with
    the goal-specific contract that an empty result is fatal.

    Thin wrapper over open_in_editor (section 9). The editor-launch
    mechanics — $EDITOR / $VISUAL / /usr/bin/editor fallback, tempfile,
    shlex, non-zero-exit-but-keep-the-buffer — moved there in v0.0.9
    when the pack wizard's README step became the second caller. The
    only goal-specific behavior is the empty-after-strip check: an empty
    goal would fail the request manifest's goal-must-be-non-empty rule
    downstream, and surfacing that here gives a clearer message.
    """
    edited = open_in_editor(
        initial_goal,
        abort_hint="drop --edit-goal to inherit the goal verbatim",
    )
    if not edited:
        fail("goal is empty after --edit-goal; aborting. "
             "Drop --edit-goal to inherit the original goal verbatim.")
    return edited


def warn_repeat_bailout(repo: Path, responds_to_sid: str) -> None:
    """Warn (no fail) if the bailed-on session was itself packed from a
    prior bailout. Two bailouts in a row is a scoping signal — see
    CLAUDE.md §11.4 — and the next handoff session is unlikely to
    succeed without narrower scope. We do not block: the architect may
    have already narrowed, or may be deliberately trying again.

    Chain walk:
      1. The request manifest of the bailed-on session lives at
         `.bale/sessions/<responds_to_sid>/manifest.json` (written by
         `bale pack` or `bale handoff`).
      2. Its `depends_on.previous_response`, if set, names the prior
         response in the chain. In v0.0.6, only `bale handoff` sets
         this field, so a non-null value strongly implies the prior
         response was a bailout — but we verify by inspecting the
         prior response's manifest under
         `.bale/sessions/<prev_resp_sid>/response-manifest.json`,
         which `_apply_bailout` preserves precisely for this lookup.
      3. If the previous response's `response_kind` is "bailout",
         warn. Silent otherwise.

    Every link in the chain may be missing — the request manifest could
    be cleaned up, the previous response's session dir might have been
    pruned by hand, JSON might be malformed. Any of those cases yield a
    silent skip: warning on incomplete data would be noise. The chase is
    a best-effort comfort signal, not a correctness check.
    """
    req_manifest_path = repo / ".bale" / "sessions" / responds_to_sid / "manifest.json"
    if not req_manifest_path.is_file():
        return
    try:
        req_manifest = json.loads(req_manifest_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return
    prev_resp_sid = (req_manifest.get("depends_on") or {}).get("previous_response")
    if not prev_resp_sid or not isinstance(prev_resp_sid, str):
        return

    prev_resp_manifest_path = (
        repo / ".bale" / "sessions" / prev_resp_sid / "response-manifest.json"
    )
    if not prev_resp_manifest_path.is_file():
        return
    try:
        prev_resp_manifest = json.loads(
            prev_resp_manifest_path.read_text(encoding="utf-8")
        )
    except (OSError, json.JSONDecodeError):
        return
    if prev_resp_manifest.get("response_kind") != "bailout":
        return

    # The previous response in this chain was also a bailout. Warn via
    # log(force=True) so the message lands in stdout AND will be drained
    # to the session log once next_session_id allocates one (force=True
    # buffers when no log file is open).
    log(
        f"repeat bailout in lineage: prior bailout {prev_resp_sid} → "
        f"this bailout's predecessor {responds_to_sid} → current handoff. "
        f"Two bailouts in a row is usually a scoping signal (CLAUDE.md §11.4): "
        f"consider narrowing the goal rather than asking the next session to "
        f"absorb the same scope. Proceeding anyway.",
        force=True,
    )


def cmd_handoff(args: argparse.Namespace) -> int:
    cwd = Path.cwd().resolve()
    refuse_system_dir(cwd, force=args.force)

    repo = repo_root(cwd)
    if repo is None:
        fail("not in a git repo. `bale handoff` requires the project repo.")
    refuse_system_dir(repo, force=args.force)

    # Resolve the bailout tarball through apply.search_paths — same
    # semantics as `bale apply`. The bailout the user just applied is the
    # natural input (handoff's job is precisely to follow up on that
    # application), so re-resolving against the same search paths matches
    # the muscle memory.
    cfg = bale_config.merged_config(repo)
    search_paths = bale_config.get_apply_search_paths(cfg)
    tarball_path = resolve_tarball_path(args.tarball, cwd, search_paths)
    if not tarball_path.is_file():
        fail(f"tarball not found: {tarball_path}")

    # Handoff acquires a new lock; refuse if one is already held.
    # `bale apply` on a bailout already cleared the lock, so the normal
    # workflow doesn't trip this — but a user who skipped apply and
    # invoked handoff directly would, and the failure message points them
    # at the right next step. Matches `bale pack`'s guard verbatim so the
    # two locking surfaces stay symmetric.
    existing = read_lock(repo)
    if existing:
        fail(
            f"a session is already open: {existing}. "
            f"Apply its response with `bale apply <tarball>`, or run "
            f"`bale unlock` if the session was abandoned."
        )

    # Same .bale/ gitignore guard `bale pack` runs. handoff writes under
    # .bale/ before there's any session id, so the directory must already
    # be excluded; otherwise our staging artifacts leak into the user's
    # next commit.
    gitignore_changed = ensure_bale_gitignored(repo)
    if gitignore_changed:
        r = git(["status", "--porcelain"], cwd=repo)
        other_dirty = [
            ln for ln in r.stdout.splitlines()
            if ln and not ln.endswith(" .gitignore")
        ]
        if other_dirty:
            log("note: working tree has other uncommitted changes; "
                ".gitignore was modified but not auto-committed. "
                "Commit it before `bale apply` or apply will refuse.")
        else:
            git(["add", ".gitignore"], cwd=repo)
            git(["commit", "-m", "bale: ignore .bale/"], cwd=repo)
            log("auto-committed the .gitignore change")

    # Extract and validate the bailout tarball. Same tarball-shape and
    # manifest-validation guards as `bale apply` — sharing them keeps the
    # two ingestion surfaces' expectations identical, so the user can't
    # land in a state where apply accepts a tarball that handoff would
    # reject (or vice versa).
    with tempfile.TemporaryDirectory() as tmpdir:
        try:
            tf = tarfile.open(tarball_path, "r:gz")
        except (tarfile.TarError, OSError) as e:
            fail(f"tarball is unreadable: {e}")
        try:
            for member in tf.getmembers():
                name = member.name
                if name.startswith("/") or ".." in Path(name).parts:
                    fail(f"tarball contains unsafe path: {name}")
            tf.extractall(tmpdir)
        finally:
            tf.close()

        entries = [p for p in Path(tmpdir).iterdir()]
        if len(entries) != 1 or not entries[0].is_dir():
            fail(f"tarball must contain exactly one top-level directory; "
                 f"found {[e.name for e in entries]}")
        response_dir = entries[0]
        if not response_dir.name.startswith("response-"):
            fail(f"top-level directory must be named response-NNN/, "
                 f"got {response_dir.name}/")

        try:
            manifest = json.loads(
                (response_dir / "manifest.json").read_text(encoding="utf-8")
            )
        except (OSError, json.JSONDecodeError) as e:
            fail(f"manifest.json is not valid JSON: {e}")
        validate_response_manifest(manifest)

        # Must be a bailout. A normal response doesn't carry handoff.md
        # and there's nothing to "hand off" — direct the user to apply.
        response_kind = manifest.get("response_kind", "normal")
        if response_kind != "bailout":
            fail(
                f"`bale handoff` is for bailout responses only; this "
                f"tarball's manifest has response_kind={response_kind!r}. "
                f"Run `bale apply {tarball_path.name}` instead."
            )

        handoff_path = response_dir / "handoff.md"
        if not handoff_path.is_file():
            fail("bailout response is missing handoff.md (TARBALL.md §5.6.1)")

        bailout_sid = manifest["session_id"]
        responds_to_sid = manifest["responds_to"]

        # Lineage chase — warn if this is a second bailout in the same
        # chain. Best-effort; silent on incomplete data.
        warn_repeat_bailout(repo, responds_to_sid)

        # Derive the new session id per TARBALL.md §5.6.2: same slug as
        # the bailout, today's date, next NNN.
        try:
            _date, slug, _nnn = parse_session_id(bailout_sid)
        except ValueError as e:
            fail(f"could not parse bailout session_id {bailout_sid!r}: {e}")

        # Inherit the bailed-on request's goal verbatim. The request
        # manifest is stored at .bale/sessions/<request-sid>/manifest.json
        # by `bale pack` / `bale handoff` at pack time; we need it here to
        # pick up the original goal so the user doesn't have to retype it.
        request_manifest_path = (
            repo / ".bale" / "sessions" / responds_to_sid / "manifest.json"
        )
        if not request_manifest_path.is_file():
            fail(
                f"cannot inherit goal: request manifest not found at "
                f"{request_manifest_path}. The bailed-on session's record "
                f"may have been cleaned up. Run `bale pack` to start a "
                f"fresh session and re-state the goal manually."
            )
        try:
            request_manifest = json.loads(
                request_manifest_path.read_text(encoding="utf-8")
            )
        except (OSError, json.JSONDecodeError) as e:
            fail(f"could not parse request manifest at "
                 f"{request_manifest_path}: {e}")
        inherited_goal = (request_manifest.get("goal") or "").strip()
        if not inherited_goal:
            fail(f"inherited goal from {request_manifest_path} is empty; "
                 f"cannot proceed.")

        # Optional pre-pack edit. The fail path inside edit_goal_in_editor
        # already covers empty-after-edit, so we trust its return.
        if args.edit_goal:
            inherited_goal = edit_goal_in_editor(inherited_goal)

        # Pre-pack source files from handoff.md's `## Reading plan for the
        # next session` section (TARBALL.md §5.7). The bailing Claude's
        # reading plan typically names the files the next session should
        # read; bundling them in context/ here removes the
        # apply-bailout-then-manually-repack step the architect would
        # otherwise have to run. Three layers of degradation keep this
        # robust:
        #
        #   1. If handoff.md has no reading-plan section, or the section
        #      cites no path-shaped tokens, extract_paths_from_reading_plan
        #      returns []. Fall back to handoff.md-only (the v0.0.6 shape).
        #   2. If a cited path doesn't resolve to a tracked file (typo,
        #      since-renamed, ignored by .gitignore), gather_files_for_pack
        #      silently drops it. The dropped list is logged so the
        #      architect can audit without the handoff failing.
        #   3. If a cited path is unsafe (escape, .git/, .bale/) or matches
        #      a baked-in secret pattern, the same filters drop it. Same
        #      cleanup contract — bale never refuses a handoff over a
        #      single bad reference in a Claude-authored doc.
        #
        # Done before sid allocation so a (hypothetical) error doesn't
        # burn an NNN. The implementation only logs and reads; it cannot
        # fail() at this point.
        try:
            handoff_text = handoff_path.read_text(encoding="utf-8")
        except OSError as e:
            fail(f"could not read handoff.md from bailout tarball: {e}")
        plan_text = reading_plan_section(handoff_text)
        extracted_paths = extract_paths_from_reading_plan(plan_text)
        if extracted_paths:
            included_paths = gather_files_for_pack(repo, extracted_paths)
        else:
            included_paths = []

        # Allocate the new session id NOW (after all the validation
        # gates) so the per-day counter doesn't burn an NNN on a pack
        # that was about to fail anyway. Same staging-then-allocate
        # ordering `bale pack` uses.
        new_sid = next_session_id(repo, slug)
        set_log_file(repo / ".bale" / "logs" / f"{new_sid}.log")
        log(f"handoff from bailout {bailout_sid} -> new session {new_sid}")
        log(f"inherited goal from request {responds_to_sid}")
        # Reading-plan pre-pack accounting goes to the session log so an
        # architect investigating later can see exactly which candidates
        # came out of handoff.md and which survived the filter. Logged
        # AFTER set_log_file so the lines land in the right log file
        # rather than the unbuffered preamble.
        if extracted_paths:
            log(f"reading plan: {len(extracted_paths)} candidate(s) "
                f"extracted, {len(included_paths)} included after filter")
            log(f"  candidates: {extracted_paths}")
            log(f"  included:   {included_paths}")
        else:
            log("reading plan: no path-shaped tokens (section missing, "
                "empty, or cited no files); context = handoff.md only")

        # Build the (context_relative_path, source_absolute_path) entries
        # for build_request_tarball. handoff.md's source lives in the
        # extracted-bailout tmpdir; each pre-packed source file's source
        # lives in the repo. Parallel context_paths list goes into the
        # manifest so the next Claude sees the full inventory in
        # manifest.context_included per TARBALL.md §3.2.
        context_entries: list[tuple[str, Path]] = [
            ("handoff.md", handoff_path),
        ]
        context_paths_for_manifest: list[str] = ["handoff.md"]
        for rel in included_paths:
            context_entries.append((rel, repo / rel))
            context_paths_for_manifest.append(rel)

        # Build the new request manifest. depends_on.previous_response
        # points at the bailout — this is the ONLY path in v0.0.6 that
        # populates previous_response, which is what makes the lineage
        # chase reliable. Constraints/out_of_scope reset to empty; the
        # architect can re-add via a future `bale pack` if needed (no
        # CLI surface for them on handoff yet, deliberately — keeping
        # the command's surface narrow until the use case argues for
        # more).
        new_manifest = build_request_manifest(
            sid=new_sid,
            project_name=repo.name,
            goal=inherited_goal,
            constraints=[],
            out_of_scope=[],
            expects_probe="claude-decides",
            context_paths=context_paths_for_manifest,
            depends_on={
                "previous_response": bailout_sid,
                "previous_probe": None,
            },
        )

        # Build the tarball. context_entries is whatever the reading-plan
        # extraction produced (handoff.md first, then 0..N source files);
        # build_request_tarball doesn't care about the source-vs-repo
        # mixing because each entry carries its own source path. Per the
        # prior session's confirmed constraint, no prior-request material
        # is carried forward — context_entries holds only the bailout's
        # handoff.md and the files the reading plan named.
        tarball_out = repo / ".bale" / "outbox" / f"request-{new_sid}.tar.gz"
        try:
            build_request_tarball(
                new_sid,
                context_entries,
                new_manifest,
                tarball_out,
            )
        except Exception as e:
            if tarball_out.exists():
                tarball_out.unlink()
            fail(f"failed to build request tarball: {e}")
        log(f"wrote {tarball_out}")

        # Persist the new session and acquire its lock — same ordering
        # `bale pack` uses (persist before lock, lock last). The lock
        # acquired here is for the new sid; the bailout's lock was
        # cleared by `bale apply`'s bailout branch.
        persist_pack_session(repo, new_sid, new_manifest)
        write_lock(repo, new_sid)
        log(f"acquired session lock")

        # post_pack hook fires for handoff too — same lifecycle position
        # as in `bale pack` (after tarball-on-disk AND lock-acquired). A
        # hook that prepares the user's environment for a new request
        # is just as relevant for a handoff as for a pack; the hook
        # contract makes no distinction.
        run_hook(repo, bale_config.merged_config(repo), "post_pack", new_sid)

        print()
        print(f"  session id: {new_sid}")
        print(f"  tarball:    {tarball_out}")
        print(f"  inherited:  goal from {responds_to_sid}"
              + ("  (edited)" if args.edit_goal else "  (verbatim)"))
        if included_paths:
            plural = "s" if len(included_paths) != 1 else ""
            print(f"  context:    handoff.md + {len(included_paths)} "
                  f"reading-plan file{plural}:")
            for rel in included_paths:
                print(f"                {rel}")
        else:
            print(f"  context:    handoff.md  "
                  f"(no reading-plan files extracted)")
        print(f"  depends_on: previous_response = {bailout_sid}")
        print()
        print("Send the tarball to Claude. When the response comes back,")
        print("run: bale apply <response-tarball>")
        return 0


# ---------------------------------------------------------------------------
# 23. Hook invocation
# ---------------------------------------------------------------------------
#
# All hooks shell out to user-supplied scripts; bale never embeds install
# or copy logic. Every invocation prompts: the script can write outside
# the repo, install software, or perform any action its author chose, and
# bale can't know which. A non-zero exit from the hook is logged but does
# NOT fail the primary bale operation — by the time a hook runs, the
# operation that triggered it has already succeeded. Decline is silent
# (logged but not an error).

def confirm_yn(prompt: str, *, default_no: bool = True) -> bool:
    """Interactive y/N prompt. Returns True on y/yes, False otherwise.

    default_no=True biases toward declining — appropriate for hooks since
    they may have arbitrary side effects. EOF and ^C are treated as
    decline.
    """
    suffix = " [y/N]" if default_no else " [Y/n]"
    try:
        ans = input(f"{prompt}{suffix} ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    if not ans:
        return not default_no
    return ans in ("y", "yes")


def run_hook(repo: Path, cfg: dict, name: str, sid: str) -> None:
    """Run the named hook if configured. Silent no-op when absent.

    Expects the merged config (from merged_config), so the hook value is
    already an absolute path resolved against its owning layer. This function
    decides which layer the script came from (project vs global) for display
    purposes and runs it.

    Prompts the user before invoking. The user's decline is respected silently
    (no failure). A configured-but-missing or non-executable script is logged
    and skipped rather than failing — bale's primary work has already
    succeeded by the time this runs, and a broken hook shouldn't unwind it.
    """
    script = bale_config.get_hook(cfg, name)
    if script is None:
        return  # silent skip — opt-in mechanism

    script_path = Path(script)
    # Defense in depth: get_hook returns absolute paths from merged_config, but
    # if some caller hands us a raw config and a relative slips through, refuse
    # rather than guess what to resolve it against.
    if not script_path.is_absolute():
        log(f"[hook {name}] configured script {script!r} is not an absolute "
            f"path; this indicates a caller bug (pass merged_config, not "
            f"load_config). Skipping.")
        return

    if not script_path.is_file():
        log(f"[hook {name}] configured script {script_path} not found; "
            f"skipping. (Fix bale.toml or place the script there.)")
        return
    if not os.access(script_path, os.X_OK):
        log(f"[hook {name}] {script_path} is not executable; skipping. "
            f"(`chmod +x {script_path}` to enable.)")
        return

    # Identify which layer the script came from, for the prompt. We compare
    # against the install's user/ dir and the repo root; an absolute path that
    # falls inside one of those is from that layer. (Falls-inside-neither
    # shouldn't happen via the wizard, but is possible via hand-edits with an
    # absolute path; we label that "configured" and let the user inspect.)
    source_label = "configured"
    try:
        script_path.relative_to(bale_config.GLOBAL_USER_DIR.resolve())
        source_label = "global"
    except ValueError:
        try:
            script_path.relative_to(repo.resolve())
            source_label = "project"
        except ValueError:
            pass

    print()
    print(f"  hook:   {name} ({source_label})")
    print(f"  script: {script_path}")
    print(f"  cwd:    {repo}")
    print(f"  env:    BALE_HOOK={name}")
    print(f"          BALE_SESSION_ID={sid}")
    print(f"          BALE_REPO_ROOT={repo}")
    print(f"  This script runs as your user. It may write outside the repo,")
    print(f"  install software, or perform any action its author chose.")
    print(f"  Inspect the script before approving.")
    if not confirm_yn("  run this hook?", default_no=True):
        log(f"[hook {name}] declined; not invoking.")
        return

    env = {
        **os.environ,
        "BALE_HOOK": name,
        "BALE_SESSION_ID": sid,
        "BALE_REPO_ROOT": str(repo),
    }
    log(f"[hook {name}] invoking {script_path}")
    try:
        # No capture: stream the hook's stdout/stderr to the user's terminal
        # so a long-running install shows progress. The session log already
        # records the invocation; the hook's own output is the hook's
        # responsibility.
        result = subprocess.run(
            [str(script_path)],
            cwd=str(repo),
            env=env,
        )
    except OSError as e:
        log(f"[hook {name}] failed to launch: {e}")
        return
    if result.returncode != 0:
        log(f"[hook {name}] exited {result.returncode}. Bale's primary "
            f"operation already succeeded; this is a hook-side issue.")
    else:
        log(f"[hook {name}] succeeded")


# ---------------------------------------------------------------------------
# 24. CLI
# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="bale",
        description="Claude session orchestrator (v0.0.9 bootstrap).",
    )
    p.add_argument("--version", action="version", version=f"bale {VERSION}")

    sub = p.add_subparsers(dest="command", required=True, metavar="<command>")

    # pack
    p_pack = sub.add_parser(
        "pack",
        help="Build a request tarball from goal + included paths.",
    )
    p_pack.add_argument(
        "goal", nargs="?", default=None,
        help="One-sentence goal for the session. Omit on a TTY to enter "
             "the interactive wizard (BALE.md §7.3); required when piped.",
    )
    p_pack.add_argument(
        "--slug", default=None,
        help="Short kebab-case slug for the session ID. Omit on a TTY to "
             "enter the interactive wizard; required when piped.",
    )
    p_pack.add_argument(
        "--include", action="append", default=[], metavar="PATH",
        help="File or directory to include (repeatable). "
             "Defaults to the whole repo if omitted.",
    )
    p_pack.add_argument(
        "--exclude", action="append", default=[], metavar="PATTERN",
        help="gitignore-style pattern to exclude from this pack "
             "(repeatable). Composes with .baleignore — these are "
             "session-only, .baleignore is persistent (edit via "
             "`bale config init`). When the wizard runs, omitting "
             "this flag triggers the interactive 'anything to exclude' "
             "prompt; supplying it skips that prompt.",
    )
    p_pack.add_argument(
        "--constraint", action="append", default=[], metavar="TEXT",
        help="Add a constraint (repeatable). When the wizard runs, omitting "
             "this flag triggers an interactive multi-line prompt; supplying "
             "it skips that prompt.",
    )
    p_pack.add_argument(
        "--out-of-scope", action="append", default=[], metavar="TEXT",
        help="Add an out-of-scope item (repeatable). Same wizard interaction "
             "as --constraint.",
    )
    p_pack.add_argument(
        "--expects-probe", choices=("yes", "no", "claude-decides"),
        default="claude-decides",
        help="Whether the session expects a probe.",
    )
    p_pack.add_argument(
        "--no-edit", action="store_true",
        help="In the wizard's README step, skip the y/N prompt and $EDITOR "
             "entirely. Useful for non-interactive automation that still "
             "wants the wizard to walk the structured fields. No-op outside "
             "the wizard, since the non-wizard path has no $EDITOR step.",
    )
    # Threshold caps (BALE.md §7.4). Each --max-* sets the hard cap; the soft
    # caps (which drive the y/N prompt) stay at the defaults. --force
    # bypasses both threshold caps and the home-directory refusal; the
    # override is logged prominently to the session log.
    p_pack.add_argument(
        "--max-files", type=int, default=None, metavar="N",
        help=f"Hard cap on file count (default: {PACK_MAX_FILES_HARD:,}). "
             f"Soft cap is fixed at {PACK_MAX_FILES_SOFT:,}.",
    )
    p_pack.add_argument(
        "--max-size", type=str, default=None, metavar="BYTES",
        help=f"Hard cap on total bundled bytes. Accepts a raw count or a "
             f"K/M/G suffix, e.g. '500M', '1G'. "
             f"Default: {format_bytes(PACK_MAX_SIZE_HARD)}. "
             f"Soft cap is fixed at {format_bytes(PACK_MAX_SIZE_SOFT)}.",
    )
    p_pack.add_argument(
        "--max-depth", type=int, default=None, metavar="N",
        help=f"Hard cap on path depth in directory levels "
             f"(default: {PACK_MAX_DEPTH}).",
    )
    p_pack.add_argument(
        "--force", action="store_true",
        help="Bypass threshold caps AND the home-directory refusal. The "
             "override is logged prominently to the session log. Use for "
             "legitimate cases (dotfiles repo, deliberately large pack); "
             "do not use to silence a soft-breach prompt without thinking.",
    )
    p_pack.set_defaults(func=cmd_pack)

    # apply
    p_apply = sub.add_parser(
        "apply",
        help="Validate and apply a response tarball.",
        description=(
            "Validate and apply a response tarball. The tarball argument is "
            "resolved against apply.search_paths in bale.toml when set: "
            "relative names are tried against cwd first, then each "
            "configured directory in order, first match wins. Absolute "
            "paths bypass search. Configure via `bale config init`."
        ),
    )
    p_apply.add_argument("tarball", help="Path to response-NNN.tar.gz.")
    p_apply.add_argument(
        "--staging-dir", default=None,
        help="Where to stage the apply (default: <repo>/.bale/staging). "
             "An explicit path is resolved relative to cwd.",
    )
    p_apply.set_defaults(func=cmd_apply)

    # retry
    p_retry = sub.add_parser(
        "retry",
        help="Re-attempt a HOLDed session with a new response tarball "
             "(same session id, no repack).",
        description=(
            "Discard the HOLDed apply state for the currently locked "
            "session — reset the bale/<sid> branch, wipe the session's "
            "staging — and run the apply pipeline against a new response "
            "tarball, preserving the lock so the new attempt lands in "
            "the same session id. The new tarball's manifest.responds_to "
            "must match the locked sid (same as `bale apply`). The tarball "
            "argument is resolved against apply.search_paths in bale.toml "
            "the same way `bale apply` does."
        ),
    )
    p_retry.add_argument("tarball", help="Path to the new response-NNN.tar.gz.")
    p_retry.add_argument(
        "--staging-dir", default=None,
        help="Where to stage the apply (default: <repo>/.bale/staging). "
             "An explicit path is resolved relative to cwd.",
    )
    p_retry.set_defaults(func=cmd_retry)

    # revert
    p_revert = sub.add_parser(
        "revert",
        help="Discard a held bale branch.",
    )
    p_revert.add_argument("sid", help="Session ID to revert.")
    p_revert.set_defaults(func=cmd_revert)

    # unlock
    p_unlock = sub.add_parser(
        "unlock",
        help="Clear an abandoned session lock (no git side effects).",
        description=(
            "Clear the session lock for a `bale pack` that was never "
            "applied. Removes .bale/current_session and the matching "
            ".bale/sessions/<sid>/ directory; performs no git operations. "
            "Refuses if a bale/<sid> branch exists — that means `bale "
            "apply` ran far enough to create the branch but didn't reach "
            "a terminal state, and the right command for that state is "
            "`bale revert <sid>`. --force overrides the refusal but "
            "leaves the orphan branch in place; delete it with "
            "`git branch -D bale/<sid>` if you no longer want it."
        ),
    )
    p_unlock.add_argument(
        "--force", action="store_true",
        help="Clear the lock even if a bale/<sid> branch exists. The "
             "branch is left in place; you'll need to delete it manually. "
             "The override is logged with the FORCE: prefix.",
    )
    p_unlock.set_defaults(func=cmd_unlock)

    # handoff — repackage a bailout response into a fresh request tarball.
    # TARBALL.md §5.6.3: when `bale apply` encounters response_kind=bailout
    # it prints the handoff banner and stops; `bale handoff <tarball>`
    # then takes that bailout's handoff.md and ships it as the sole
    # context entry for a new session that inherits the original goal.
    p_handoff = sub.add_parser(
        "handoff",
        help="Repackage a bailout response into a fresh request tarball.",
        description=(
            "Take a bailout response tarball (response_kind=\"bailout\", "
            "TARBALL.md §5.6.3) and build a new request tarball that "
            "ships its handoff.md as the sole context entry, inheriting "
            "the original session's goal verbatim. The new session id "
            "keeps the slug and bumps the date/counter. Refuses if a "
            "session is already locked (bale pack/apply must be quiet "
            "first). Warns — but proceeds — if the bailout's predecessor "
            "was also a bailout; chained handoffs are a smell, and the "
            "warning is informational only (no flag suppresses or escalates "
            "it). With --edit-goal, opens $EDITOR on the inherited goal "
            "before packing. With --force, bypasses the home-directory "
            "refusal that all bale commands enforce — same semantics as "
            "`bale pack --force`."
        ),
    )
    p_handoff.add_argument(
        "tarball",
        help="Path to the bailout response tarball (resolved against "
             "apply.search_paths the same way `bale apply` resolves).",
    )
    p_handoff.add_argument(
        "--edit-goal", action="store_true",
        help="Open $EDITOR on the inherited goal text before packing. "
             "Useful when the original goal needs refining in light of "
             "what the bailout learned. Falls back to $VISUAL, then to "
             "/usr/bin/editor.",
    )
    p_handoff.add_argument(
        "--force", action="store_true",
        help="Bypass the home-directory refusal that all bale commands "
             "enforce — same semantics as `bale pack --force`. The "
             "override is logged with the FORCE: prefix. Has no effect "
             "on the chained-bailout lineage warning, which is "
             "informational only and prints regardless.",
    )
    p_handoff.set_defaults(func=cmd_handoff)

    # config — group for configurables-management subcommands. At v0.0.x
    # the only subcommand is `init`; set/get/edit land in later sessions.
    p_config = sub.add_parser(
        "config",
        help="Manage bale configurables (per-repo or global).",
    )
    config_sub = p_config.add_subparsers(
        dest="config_cmd", required=True, metavar="<subcommand>",
    )
    p_config_init = config_sub.add_parser(
        "init",
        help="Walk through every configurable at the chosen layer (project "
             "by default; pass --global for the install-wide layer). "
             "Idempotent.",
        description=(
            "Walk through every configurable on this repo (default) or "
            "for this install (--global), or re-confirm existing values. "
            "Idempotent: re-running shows current values and lets you keep, "
            "change, suppress, or clear each one. "
            "Default writes <repo>/bale.toml. With --global, writes "
            "<install>/user/bale.toml — the install-wide layer that every "
            "project using this bale install inherits per-key. Project "
            "values override globals when both are set."
        ),
    )
    p_config_init.add_argument(
        "--global", action="store_true", dest="global_layer",
        help="Walk the install-wide global layer at <install>/user/bale.toml "
             "instead of the per-repo layer at <repo>/bale.toml. Does not "
             "require a git repo.",
    )
    p_config_init.set_defaults(func=bale_config.cmd_config_init)

    return p


def main(argv: Optional[list[str]] = None) -> int:
    # tomllib (used by config loading) is stdlib only in Python 3.11+.
    # Fail loud and clear at startup rather than crashing on the first
    # config load. Bale's "stdlib only" claim now implies 3.11+.
    if sys.version_info < (3, 11):
        sys.stderr.write(
            f"[bale] error: requires Python 3.11+ for tomllib "
            f"(per-repo config support); running on Python "
            f"{sys.version_info.major}.{sys.version_info.minor}.\n"
        )
        return 1

    parser = build_parser()
    args = parser.parse_args(argv)

    # Sanity: the installation must have the global docs alongside.
    if args.command == "pack":
        missing = [d for d in GLOBAL_DOCS if not (DOCS_DIR / d).exists()]
        if missing:
            fail(
                f"installation is missing global docs in {DOCS_DIR}: "
                f"{', '.join(missing)}. Reinstall bale."
            )

    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
