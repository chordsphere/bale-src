# ---------------------------------------------------------------------------
# 2. Logging
# ---------------------------------------------------------------------------
#
# v0.0.1 logs to stdout with a [bale] prefix. When a session is open we
# also append to .bale/logs/<sid>.log. Structured logging proper is a
# later enhancement.

_log_file: Optional[Path] = None

# Pending log lines, replayed into the session log the first time set_log_file
# opens one. The pack pipeline emits --force override notes (home-directory
# refusal bypass, threshold-cap bypass) before the session ID is allocated and
# the per-session log file exists. Per the constraint that override events
# must reach the session log "prominently," log(..., force=True) routes
# through this buffer when no log file is open yet, and set_log_file() drains
# it on first attach. Buffer-on-stdout-only callers (the regular log() path)
# don't queue anything: a normal `[bale] foo` line emitted with no log file
# open is already visible on stdout and isn't worth journaling retroactively.
_pending_log_lines: list[str] = []


def set_log_file(p: Optional[Path]) -> None:
    """Set (or clear) the session log file. On first attach with a non-None
    path, drain any buffered --force lines into it so the session log has the
    override events even though they preceded sid allocation. A failed drain
    surfaces on stderr but does not raise — logging must never break pack."""
    global _log_file
    _log_file = p
    if p is None or not _pending_log_lines:
        return
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        with p.open("a", encoding="utf-8") as f:
            for line in _pending_log_lines:
                ts = datetime.now(timezone.utc).isoformat(timespec="seconds")
                f.write(f"{ts} {line}\n")
    except OSError as e:
        # Same shape as log()'s defensive path: surface and continue.
        print(f"[bale] (log-write failed: {e})", file=sys.stderr)
    _pending_log_lines.clear()


def log(msg: str, *, force: bool = False) -> None:
    """Emit a [bale] line to stdout, and (if a session log is open) journal it.

    `force=True` formats the line as a prominent FORCE: prefix and, if no
    session log is open yet, queues the line for replay once one is. Use it
    only for --force-override events (home-dir, threshold caps) where the
    journal entry is the audit trail; ordinary informational logs leave
    `force=False` so they don't clutter the FORCE: prefix or queue."""
    prefix = "[bale] FORCE: " if force else "[bale] "
    line = f"{prefix}{msg}"
    print(line)
    if _log_file is not None:
        try:
            _log_file.parent.mkdir(parents=True, exist_ok=True)
            with _log_file.open("a", encoding="utf-8") as f:
                ts = datetime.now(timezone.utc).isoformat(timespec="seconds")
                f.write(f"{ts} {line}\n")
        except OSError as e:
            # Logging must never raise; surface and continue.
            print(f"[bale] (log-write failed: {e})", file=sys.stderr)
    elif force:
        # No session log yet — buffer for replay when set_log_file() opens one.
        _pending_log_lines.append(line)


def fail(msg: str, code: int = 1) -> None:
    """Print a [bale] error to stderr, log it if a session is open, exit."""
    line = f"[bale] error: {msg}"
    print(line, file=sys.stderr)
    if _log_file is not None:
        try:
            _log_file.parent.mkdir(parents=True, exist_ok=True)
            with _log_file.open("a", encoding="utf-8") as f:
                ts = datetime.now(timezone.utc).isoformat(timespec="seconds")
                f.write(f"{ts} {line}\n")
        except OSError as e:
            # Logging must never raise; surface and continue (matches log()).
            # The primary error has already gone to stderr above; this second
            # line tells the user their fail wasn't journaled, which is the
            # kind of fact they'd want when debugging *why* bale broke.
            print(f"[bale] (log-write failed: {e})", file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------------------
# 3. Shell / git helpers
# ---------------------------------------------------------------------------

def run(cmd: list[str], *, cwd: Optional[Path] = None,
        check: bool = True, capture: bool = True) -> subprocess.CompletedProcess:
    """Wrapper around subprocess.run with consistent defaults.

    Captures stdout/stderr as text by default. Raises CalledProcessError
    on non-zero when check=True.
    """
    return subprocess.run(
        cmd,
        cwd=str(cwd) if cwd is not None else None,
        check=check,
        capture_output=capture,
        text=True,
    )


def git(args: list[str], *, cwd: Path,
        check: bool = True) -> subprocess.CompletedProcess:
    return run(["git", *args], cwd=cwd, check=check)


def repo_root(cwd: Path) -> Optional[Path]:
    """Return the repo root containing cwd, or None if not in a repo."""
    try:
        r = run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=cwd, check=True, capture=True,
        )
    except subprocess.CalledProcessError:
        return None
    except FileNotFoundError:
        fail("git not found on PATH; bale requires git.")
    return Path(r.stdout.strip())


def current_branch(repo: Path) -> str:
    """Return the current branch name (or 'HEAD' if detached — caller decides)."""
    r = git(["rev-parse", "--abbrev-ref", "HEAD"], cwd=repo)
    return r.stdout.strip()


def working_tree_clean(repo: Path) -> tuple[bool, str]:
    """Return (clean, status_output). Clean means git status --porcelain is empty."""
    r = git(["status", "--porcelain"], cwd=repo)
    return (not r.stdout.strip(), r.stdout)


# ---------------------------------------------------------------------------
# 4. Hashing
# ---------------------------------------------------------------------------

def sha256_file(p: Path) -> str:
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def sha256_bytes(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


# ---------------------------------------------------------------------------
# 5. Session IDs and the per-day counter
# ---------------------------------------------------------------------------
#
# Session ID format (TARBALL.md section 1): YYYY-MM-DD-<slug>-NNN
# where NNN is a per-day monotonic counter maintained in
# .bale/counter-YYYY-MM-DD.

def next_session_id(repo: Path, slug: str, today: Optional[date] = None) -> str:
    today = today or date.today()
    day = today.isoformat()
    counter_path = repo / ".bale" / f"counter-{day}"
    counter_path.parent.mkdir(parents=True, exist_ok=True)
    if counter_path.exists():
        try:
            n = int(counter_path.read_text().strip()) + 1
        except (OSError, ValueError):
            n = 1
    else:
        n = 1
    counter_path.write_text(f"{n}\n")
    return f"{day}-{slug}-{n:03d}"


def peek_session_id(repo: Path, slug: str, today: Optional[date] = None) -> str:
    """Compute the sid next_session_id WOULD allocate, without consuming
    the counter (v0.4.8, board 10 S7).

    Exists for the per-sid checkpoint pre-flight: a {sid}-bearing
    [validation] base resolves per session, and the resolved-existence
    refusal must fire BEFORE allocation — a post-allocation refusal
    burns an NNN, so the planner's remedy (commit the checkpoint the
    refusal named, repack) would chase a moving resolved path forever.
    Both request-building paths call this immediately before their
    next_session_id call, with nothing counter-touching in between and
    no cross-process lock (the same single-operator TOCTOU posture the
    scope gates already hold); a date rollover between peek and
    allocate would desync the pair, which the provenance stamp
    builder's post-allocation re-check catches as defense in depth.
    """
    today = today or date.today()
    day = today.isoformat()
    counter_path = repo / ".bale" / f"counter-{day}"
    n = 1
    if counter_path.exists():
        try:
            n = int(counter_path.read_text().strip()) + 1
        except (OSError, ValueError):
            n = 1
    return f"{day}-{slug}-{n:03d}"


def parse_session_id(sid: str) -> tuple[str, str, str]:
    """Split a session id into (date, slug, nnn). Inverse of next_session_id's
    formatter. Raises ValueError on a malformed input.

    Used by `bale handoff` to lift the slug off a bailout response's
    session_id so the follow-up session preserves it (TARBALL.md §1's
    format plus the explicit constraint from prior session that handoff
    keeps the slug, mints a new date+NNN).

    Format reminder: 'YYYY-MM-DD-<slug>-NNN' — date is fixed 10 chars,
    NNN is fixed 3 digits, slug is whatever sits in between (kebab-case,
    may itself contain hyphens). Splitting from the ends, not by
    rsplit('-'), is the way to handle slugs with hyphens correctly.
    """
    if len(sid) < 11 + 4:
        raise ValueError(f"session id too short: {sid!r}")
    date_part = sid[:10]
    if sid[10] != "-":
        raise ValueError(f"session id missing date separator: {sid!r}")
    if sid[-4] != "-":
        raise ValueError(f"session id missing NNN separator: {sid!r}")
    nnn = sid[-3:]
    if not nnn.isdigit():
        raise ValueError(f"session id NNN must be 3 digits: {sid!r}")
    slug = sid[11:-4]
    try:
        date.fromisoformat(date_part)
    except ValueError as e:
        raise ValueError(f"session id date is not ISO YYYY-MM-DD: {date_part!r} ({e})")
    if not is_valid_slug(slug):
        raise ValueError(f"session id slug is not kebab-case: {slug!r}")
    return date_part, slug, nnn


def is_valid_slug(s: str) -> bool:
    """Kebab-case: lowercase letters, digits, and single hyphens between them.

    Lives here (not in the pack module) because the slug is part of the
    session-id format this section owns: parse_session_id rejects a
    malformed slug with it, and the pack side (bale_pack's wizard and
    cmd_pack's --slug validation) imports it lazily from __main__ like
    the other shared helpers. Moved up from the old pack sections in
    v0.3.12 when the pack path was extracted.
    """
    if not s:
        return False
    if s.startswith("-") or s.endswith("-") or "--" in s:
        return False
    return all(c.islower() or c.isdigit() or c == "-" for c in s)


# ---------------------------------------------------------------------------
# 6. Session registry + locks
# ---------------------------------------------------------------------------
#
# ADR-0006 (claude/context/adr/0006-session-registry.md): the authoritative
# record of open sessions is a per-sid registry, not the single
# .bale/current_session sentinel. A session is open exactly while
# .bale/sessions/<sid>/open exists — the marker is written when pack (or
# handoff) opens the session and removed when the session closes (merge,
# walkthrough revert, bailout consumption, `bale revert`, `bale unlock`).
# The marker is what makes openness explicit: the sessions/<sid>/ directory
# itself is NOT a reliable proxy, because a consumed bailout deliberately
# leaves its directory behind for `bale handoff`'s lineage chase
# (bale_apply's _apply_bailout) while the session is closed.
#
# .bale/current_session survives as a COMPATIBILITY POINTER, kept in
# lockstep with the registry by the wrappers below. With ADR-0007's
# disjointness gate landed (v0.3.1), several sessions can be open at
# once, so the pointer's contract is now: EMPTY when no session is open,
# otherwise NAMING ONE OPEN SESSION — the most recently opened, with
# close_session repointing it to the oldest remaining open session when
# the named one closes. Since v0.3.2 every command resolves sessions
# through the registry (revert, retry, unlock, and handoff joined
# pack/apply/status via resolve_open_session below), so nothing
# operational reads the pointer any more: it is informational state for
# a human poking at .bale/, plus the one crash-debris case `bale
# unlock` still clears (a stale non-empty pointer with no open marker,
# the benign half-state register_session's ordering confines crashes
# to). ADR-0006 explicitly leaves the file's survival as an
# implementation choice; it survives as exactly that convenience.
#
# ADR-0007 (claude/context/adr/0007-scope-disjointness.md) added the
# third piece of registry state: PER-SESSION SCOPE, persisted at
# .bale/sessions/<sid>/scope.json. ADR-0015 reinterprets what pack
# writes into it — the session's resolved WRITE FORECAST (`--write`
# entries, defaulting to the resolved include set when the flag is
# absent), not the include set itself — same file, same JSON shape,
# same helpers; includes return to meaning exactly what they ship
# (read context, gating nothing). Two gates read the record. Pack
# pre-flight refuses a new pack whose forecast intersects any open
# session's recorded forecast; apply pre-flight rejects a response
# whose changes[] paths collide with ANOTHER open session's forecast —
# the real guard against the whole-file clobber, since bale's overlay
# is whole-file replacement, not a diff. Intersection is over paths,
# with directory entries covering their subtrees and "." covering
# everything. Both request-building paths record a forecast: `bale
# pack` records its resolved --write set (or the include-set default),
# and (since v0.3.2) `bale handoff` records the reading-plan files it
# pre-packed — or ["."] when the plan cited none. A session with no
# scope.json (opened by an older bale, or hand-rolled state) reads as
# ["."]: conservative, so it refuses concurrency rather than permit a
# clobber — and an open session packed pre-separation reads its old
# include set as an over-forecast, the same conservative direction,
# self-clearing at close. A recorded EMPTY
# forecast ([], v0.3.15 — `bale pack --read-only` or the wizard's
# read-only answer) is a distinct third state: it locks nothing (both
# disjointness gates see no intersection, so siblings pack and apply
# freely) and may land nothing (the own-forecast drift gate refuses
# every changes[] path such a session ships).
#
# The second piece of ADR-0006 state is the repo-level INTEGRATION LOCK:
# .bale/integration.lock, held only across the short git mutation window of
# apply (BALE.md §8.6–§8.8 — checkout, per-entry apply, commit, merge/tag or
# branch teardown). Integrations serialize under it; with one open session
# it is uncontended and unobservable. A crash inside the window leaves it
# held — the stale-lock story is the acquire-time failure message below,
# which names the holder, plus the dedicated clear surface: `bale unlock
# --integration` (v0.3.2) removes a stale lock through the tool itself,
# the integration-lock analogue of `bale unlock` for the session lock.
#
# See BALE.md section 3.4 and section 9.5 (per-session lifecycle).

def lock_path(repo: Path) -> Path:
    return repo / ".bale" / "current_session"


def sessions_root(repo: Path) -> Path:
    return repo / ".bale" / "sessions"


def open_marker_path(repo: Path, sid: str) -> Path:
    """The registry entry for sid: present ⇔ the session is open."""
    return sessions_root(repo) / sid / "open"


def register_session(repo: Path, sid: str) -> None:
    """Open `sid` in the session registry (ADR-0006).

    Writes the per-sid open marker (the authoritative record) and the
    .bale/current_session compatibility pointer in lockstep — pointer
    first, marker second. The ordering is deliberate: a crash between
    the two steps must only ever leave the benign inconsistency. A
    pointer without a marker is harmless (the registry says nothing is
    open, so pack proceeds and `bale unlock` can clear the pointer); a
    marker without a pointer would wedge pack (registry refuses) against
    an unlock that sees no session — so the marker, being authoritative,
    goes last here and first in close_session. The marker body is the
    ISO-8601 UTC open time — informational for a human poking at .bale/,
    not contract; presence alone is what the registry reads. Opening a
    session while others are open (admitted since ADR-0007's pack gate)
    overwrites the pointer, so it names the most recently opened session
    — the pointer contract close_session maintains from the other side.
    """
    p = lock_path(repo)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(f"{sid}\n")
    marker = open_marker_path(repo, sid)
    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.write_text(
        datetime.now(timezone.utc).isoformat(timespec="seconds") + "\n",
        encoding="utf-8",
    )


def close_session(repo: Path, sid: str) -> None:
    """Close `sid` in the registry; idempotent.

    Removes the open marker if present, then reconciles the
    compatibility pointer: when it names this sid, repoint it to the
    oldest remaining open session, or clear it when none remain. The
    repoint is what keeps the pointer's contract (empty ⇔ nothing open;
    otherwise names an open session) true now that ADR-0007's gate can
    admit several open sessions — without it, closing the pointer's
    session while a sibling stayed open would leave an empty pointer
    that `bale handoff`'s guard and the unthreaded commands would
    misread as "nothing open". A pointer naming some *other* sid is
    left alone. Marker first, pointer second, the mirror of
    register_session's ordering and for the same reason: a crash
    between the steps then leaves the benign pointer-without-marker
    state rather than a registry entry no unthreaded command can clear.
    Callers that also wipe .bale/sessions/<sid>/ (merge, revert,
    unlock) call this first so the close is explicit in the log of
    operations rather than a side effect of the rmtree.
    """
    marker = open_marker_path(repo, sid)
    if marker.exists():
        marker.unlink()
    p = lock_path(repo)
    if p.exists() and p.read_text().strip() == sid:
        remaining = open_sessions(repo)
        if remaining:
            p.write_text(f"{remaining[0]}\n")
            log(f"compatibility pointer repointed to {remaining[0]} "
                f"({len(remaining)} session(s) still open)")
        else:
            p.write_text("")


def open_sessions(repo: Path) -> list[str]:
    """All open sids per the registry, sorted (session ids are
    date-prefixed, so sorted order is oldest-first). Read-only."""
    root = sessions_root(repo)
    if not root.is_dir():
        return []
    return sorted(
        d.name for d in root.iterdir()
        if d.is_dir() and (d / "open").exists()
    )


def session_is_open(repo: Path, sid: str) -> bool:
    return open_marker_path(repo, sid).exists()


def resolve_open_session(repo: Path, requested: Optional[str], *,
                         command: str, require_open: bool = True,
                         none_open_hint: str = "") -> str:
    """Resolve which open session a command targets (ADR-0006 threading).

    The one sid-resolution path for the commands that act on "the"
    session (revert, retry, unlock): an explicit sid always wins; with
    none given, exactly one open session resolves implicitly — the
    single-session workflow keeps its zero-argument muscle memory —
    and two or more open sessions fail() demanding an explicit sid,
    listing the candidates. Zero open sessions fail() with the
    command-specific `none_open_hint` appended (cmd_unlock never
    reaches that arm: it pre-checks the empty registry for its benign
    no-op-and-exit-0 contract).

    `require_open` guards the explicit-sid arm. True (retry, unlock —
    surfaces whose sid argument is new in v0.3.2) rejects a sid the
    registry doesn't show open, listing what is. False (revert, whose
    positional sid predates the registry) passes the sid through
    untouched, preserving revert's pre-registry ability to act on
    metadata-only states its own checks then vet.
    """
    opens = open_sessions(repo)
    if requested is not None:
        if require_open and not session_is_open(repo, requested):
            listing = (f" Open session(s): {', '.join(opens)}."
                       if opens else " No sessions are open.")
            fail(f"session {requested} is not open; nothing to "
                 f"{command}.{listing}")
        return requested
    if not opens:
        hint = f" {none_open_hint}" if none_open_hint else ""
        fail(f"no session is open; nothing to {command}.{hint}")
    if len(opens) == 1:
        return opens[0]
    fail(
        f"{len(opens)} sessions are open; `bale {command}` needs an "
        f"explicit session id when more than one is open. "
        f"Open sessions (oldest first): {', '.join(opens)}."
    )


def sweep_commit(repo: Path, sid: str, event: str, paths: list,
                 enabled: Optional[bool] = None) -> Optional[dict]:
    """Config-gated auto-sweep commit of bale-written bookkeeping
    (v0.3.32; BALE.md §8.8): stage exactly `paths` — the telemetry
    record(s) and archive copies THIS invocation wrote — and commit
    them as `[bale sweep <sid>] <event>`.

    Gating: `[apply] sweep` in the merged config, resolved through the
    strict typed accessor. Unset/false returns None with no output of
    any kind — every path byte-identical to today. Callers on paths
    where a post-action fail() would be unacceptable (the apply
    pipeline, whose merge has already landed) resolve the key at
    pre-flight and pass `enabled`; other callers leave it None and the
    resolve happens here, wrapped so a malformed key degrades to a
    loud skip rather than converting an already-completed closure into
    a failure.

    Contract, when enabled:

    - **Stages only the enumerated paths.** `git add -- <paths>` then
      `git commit -m <msg> -- <paths>` — the pathspec form commits the
      named paths' working-tree state only, so an operator's unrelated
      dirty files (including content they had staged) are untouched by
      construction. Never a directory glob, never `git add -A`.
    - **Loud either way**: `sweep: committed <n> file(s) as
      <short-sha>` or `sweep: nothing to commit` (an event that wrote
      nothing sweeps nothing — the empty-paths case, and the case
      where the enumerated paths carry no uncommitted change).
    - **Degenerate states skip loudly, never fail the parent**: an
      in-progress merge, a detached HEAD, or a git identity that
      cannot commit logs the skip and leaves the files untracked for a
      manual sweep. Any unexpected git failure takes the same path —
      this function never raises, and a sweep failure after a
      successful apply must not convert the apply into a failure (the
      archive-dir loud-never-fatal precedent).
    - **Never interleaves with the merge**: every call site runs after
      the parent event's git mutation is durably complete (the merge
      commit, the revert commit, or a no-git closure), so the sweep is
      always its own commit on top.

    Returns None when the key is unset/false; otherwise a dict for the
    caller's optional banner row: {"status": "committed"|"nothing"|
    "skipped", "detail": <human string>, plus "sha"/"files" on the
    committed form}. The commit lands on the current branch — where
    the manual sweep this mechanizes would have landed it.
    """
    import bale_config  # lazy — sibling module, loaded by bin/bale
    try:
        if enabled is None:
            enabled = bale_config.get_apply_sweep(
                bale_config.merged_config(repo))
        if not enabled:
            return None

        real = [p for p in dict.fromkeys(paths or [])
                if p and (repo / p).exists()]
        if not real:
            log("sweep: nothing to commit")
            return {"status": "nothing", "detail": "nothing to commit"}

        # Anything to commit at all? Judged on exactly the enumerated
        # paths — an already-committed record (a retry after a swept
        # HOLD-close, say) is a legitimate nothing, not an error.
        status = git(["status", "--porcelain", "-uall", "--", *real],
                     cwd=repo, check=False)
        changed = [ln[3:].strip().strip('"')
                   for ln in status.stdout.splitlines() if ln.strip()]
        if status.returncode != 0 or not changed:
            log("sweep: nothing to commit")
            return {"status": "nothing", "detail": "nothing to commit"}

        def _skip(reason: str) -> dict:
            log(f"sweep: skipped — {reason}; {len(changed)} file(s) left "
                f"for a manual sweep ({', '.join(changed)})", force=True)
            return {"status": "skipped",
                    "detail": f"skipped — {reason}; files left for a "
                              f"manual sweep"}

        # Degenerate-state checks, each a named loud skip.
        if git(["rev-parse", "--verify", "--quiet", "MERGE_HEAD"],
               cwd=repo, check=False).returncode == 0:
            return _skip("a merge is in progress")
        if git(["symbolic-ref", "--quiet", "HEAD"],
               cwd=repo, check=False).returncode != 0:
            return _skip("detached HEAD")
        if git(["var", "GIT_COMMITTER_IDENT"],
               cwd=repo, check=False).returncode != 0:
            return _skip("git identity cannot commit (user.name/"
                         "user.email unset)")

        add = git(["add", "--", *real], cwd=repo, check=False)
        if add.returncode != 0:
            return _skip(f"git add failed "
                         f"({(add.stderr or add.stdout).strip()})")
        commit = git(["commit", "-m", f"[bale sweep {sid}] {event}",
                      "--", *real], cwd=repo, check=False)
        if commit.returncode != 0:
            # Best-effort unstage of what the add above staged, so a
            # failed sweep leaves the index as it found it.
            git(["reset", "-q", "HEAD", "--", *real], cwd=repo,
                check=False)
            return _skip(f"git commit failed "
                         f"({(commit.stderr or commit.stdout).strip()})")
        short = git(["rev-parse", "--short", "HEAD"],
                    cwd=repo, check=False).stdout.strip()
        log(f"sweep: committed {len(changed)} file(s) as {short}")
        return {"status": "committed", "sha": short, "files": changed,
                "detail": f"committed {len(changed)} file(s) as {short}"}
    except SystemExit:
        # A strict-accessor fail() already printed its error; the
        # parent event's state change stands, so degrade to a loud
        # skip rather than exiting after the fact.
        log("sweep: skipped — config error (see above); files left for "
            "a manual sweep", force=True)
        return {"status": "skipped",
                "detail": "skipped — config error; files left for a "
                          "manual sweep"}
    except Exception as e:  # never fail the parent — see docstring
        log(f"sweep: skipped — unexpected error ({e}); files left for "
            f"a manual sweep", force=True)
        return {"status": "skipped",
                "detail": "skipped — unexpected error; files left for "
                          "a manual sweep"}


def close_session_with_record(
    repo: Path,
    sid: str,
    *,
    closure_reason: str,
    command: str,
    scope: Optional[list] = None,
    log_path: Optional[str] = None,
) -> tuple[Optional[str], str]:
    """Close `sid` in the registry, wipe its session dir, and write the
    closure telemetry record — the one implementation of the
    close-with-record sequencing (v0.3.17; extracted from cmd_unlock so
    pack's supersession flow reuses it instead of duplicating it).

    Sequencing contract, in order:

    1. **Scope is read before the wipe** — the rmtree takes scope.json
       with it, and the record is what preserves what the wipe destroys.
       Callers that already read the scope (cmd_unlock reads it to infer
       its closure_reason) pass it in; `scope=None` reads it here, with
       the same read_session_scope semantics (missing → conservative
       whole-tree, recorded [] → read-only shape).
    2. close_session — registry marker removed, compatibility pointer
       reconciled (threaded, ADR-0006).
    3. rmtree of .bale/sessions/<sid>/ when present.
    4. write_telemetry_record — outcome "unlocked" (the registry-close
       outcome, whatever command produced it), `command` naming the
       producing command ("unlock", or "pack" for a supersession close —
       telemetry-record.schema.json's command enum), `closure_reason`
       from CLOSURE_REASONS, and the close-time `clarification` stamp
       every closing event carries (v0.3.23, board 5 D1) — computed
       here from `.bale/clarifications/<sid>/`, which deliberately
       survives both the session-dir wipe above and the close itself
       (BALE.md §8.10.2 step 3). Best-effort like every telemetry
       write: a failure is logged inside write_telemetry_record and
       never raises — the closure that already happened stands.
    5. sweep_commit (v0.3.32; BALE.md §8.8) — the config-gated
       auto-sweep of the record just written, event-stamped with the
       closure_reason. A no-op producing no output when [apply].sweep
       is unset/false; loud and never fatal when enabled.

    Returns (telemetry_rel, session_status, sweep_result): the record's
    repo-relative path (None on write failure), the human summary of the
    session-dir wipe, and the step-5 sweep_commit return (None when
    [apply].sweep is unset/false) — the third element added v0.3.34 so
    cmd_unlock's --json report can carry the sweep object; callers with
    no json surface discard it.
    """
    if scope is None:
        scope = read_session_scope(repo, sid)
    close_session(repo, sid)
    log(f"closed session {sid} in the registry")
    sessions_dir = repo / ".bale" / "sessions" / sid
    if sessions_dir.exists():
        shutil.rmtree(sessions_dir)
        log(f"wiped {sessions_dir}")
        session_status = f"wiped ({sessions_dir})"
    else:
        log(f"no session dir at {sessions_dir} to wipe")
        session_status = "not present"
    telemetry_rel = write_telemetry_record(
        repo, sid, build_telemetry_attempt(
            outcome="unlocked", command=command,
            scope=scope,
            closure_reason=closure_reason,
            log_path=log_path,
            clarification=read_clarification_summary(repo, sid),
        ))
    # 5. Auto-sweep (v0.3.32; BALE.md §8.8): config-gated, after the
    #    record exists on disk. No git mutation preceded this in the
    #    close-with-record sequencing, so the sweep commit interleaves
    #    with nothing. The one path this invocation wrote is the
    #    record; the event stamped in the commit message is the
    #    closure_reason (more informative than the uniform "unlocked"
    #    outcome across unlock, supersession, and read-only closes).
    sweep_result = sweep_commit(repo, sid, closure_reason,
                                [telemetry_rel] if telemetry_rel else [])
    return telemetry_rel, session_status, sweep_result


def read_lock(repo: Path) -> Optional[str]:
    """Read the .bale/current_session compatibility pointer.

    No command resolves sessions through the pointer any more — every
    lifecycle command reads the registry (resolve_open_session /
    open_sessions) since v0.3.2. The one remaining operational reader
    is `bale unlock`'s stale-pointer sweep, which uses this to detect
    the crash-debris pointer-without-marker state and clear it. The
    write_lock / clear_lock wrappers that once routed the unthreaded
    commands through the pointer were pruned with the threading (no
    remaining callers); register_session / close_session keep the
    pointer in lockstep with the registry directly.
    """
    p = lock_path(repo)
    if not p.exists():
        return None
    s = p.read_text().strip()
    return s or None


# --- Per-session scope (ADR-0007) --------------------------------------------

def scope_path(p: str) -> str:
    """Normalize one path for scope comparison.

    Repo-relative, forward-slash, no trailing slash, no leading `./`;
    the empty string and `.` both normalize to `.` (the whole tree).
    Used on both sides of every intersection check so pack-time
    includes and apply-time changes[] paths compare in one canonical
    form.
    """
    s = os.path.normpath(p.strip()).replace(os.sep, "/")
    return "." if s in ("", ".") else s


def resolved_scope(includes: list[str]) -> list[str]:
    """Resolve a declared path list into the gates' canonical scope form.

    Normalized, deduplicated, sorted entries; an empty input resolves
    to ["."], as does any list that names the repo root — "." covers
    everything, so listing siblings beside it would only blur the
    refusal messages the gates build from these entries.

    Two callers, same normal form (ADR-0015): the resolved include
    set (the read side — what ships in context/), and the resolved
    write forecast (`--write` — what the session forecasts landing,
    which is what the registry records and the gates read). A pack
    with no --write forecasts its resolved include set, so the
    empty-input → ["."] rule is exactly the pre-separation
    default-pack behavior on both surfaces.

    Declared entries — not a walked file list — are deliberately
    the recorded form: a directory entry covers files *created*
    under it later, which a snapshot of walked files could not, and
    the conservatism is the ADR's stated trade.
    """
    if not includes:
        return ["."]
    scope = sorted({scope_path(i) for i in includes})
    return ["."] if "." in scope else scope


def scope_paths_intersect(a: str, b: str) -> bool:
    """True when two normalized scope paths overlap.

    Overlap: either is ".", they are equal, or one is a directory
    ancestor of the other — directory entries cover their subtrees
    (ADR-0007). The check is symmetric because scope entries can be
    files or directories on both sides.
    """
    if a == "." or b == ".":
        return True
    return a == b or b.startswith(a + "/") or a.startswith(b + "/")


def scope_intersection(scope_a: list[str],
                       scope_b: list[str]) -> list[tuple[str, str]]:
    """Every colliding (entry_a, entry_b) pair between two scopes.

    Empty list ⇔ the scopes are disjoint. The pairs — not a bool — are
    the return value so refusal messages can name exactly which
    entries collide; scopes are include lists, small by construction,
    so the quadratic pairing is fine.
    """
    return [
        (a, b)
        for a in scope_a
        for b in scope_b
        if scope_paths_intersect(a, b)
    ]


def scope_covers_path(scope: list[str], path: str) -> bool:
    """True when `path` (a changes[] file path) lies inside `scope`.

    The own-scope drift gate's containment test (v0.3.10, board 2).
    Directional, unlike scope_paths_intersect: a scope entry covers the
    path when the entry is "." (the whole tree), equals the path, or is
    a directory ancestor of it. The converse — the path being an
    ancestor of a scope entry — is deliberately NOT coverage: changes[]
    paths are files (they mirror files/), and a path shaped like an
    ancestor of a scope entry sits outside that entry, not over it.
    Both sides normalize through scope_path so pack-time includes and
    apply-time changes[] paths compare in one canonical form. The
    ADR-0007 intersection helpers above are unchanged; this is a new,
    narrower question asked of the same recorded scope.
    """
    p = scope_path(path)
    return any(
        entry == "." or p == entry or p.startswith(entry + "/")
        for entry in scope
    )


def scope_file_path(repo: Path, sid: str) -> Path:
    return sessions_root(repo) / sid / "scope.json"


def persist_session_scope(repo: Path, sid: str, scope: list[str]) -> None:
    """Record `sid`'s resolved include set for the ADR-0007 gates.

    An empty `scope` ([]) records the read-only session shape
    (v0.3.15): read_session_scope reads it back as [] — locks nothing,
    may land nothing — distinct from a missing or malformed scope.json,
    which stays conservative whole-tree.
    """
    p = scope_file_path(repo, sid)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(scope, indent=2) + "\n", encoding="utf-8")
    rendered = ", ".join(scope) if scope else "(empty — read-only session)"
    log(f"recorded session scope for {sid}: {rendered}")


def read_session_scope(repo: Path, sid: str) -> list[str]:
    """Read `sid`'s recorded scope; degrade to ["."], never to permissive.

    Missing scope.json (a session opened by a pre-v0.3.2 bale, whose
    handoff path recorded no scope, or hand-rolled state) and malformed
    scope.json both read as the whole tree. The failure direction matters: a scope the gates
    can't read must widen to "collides with everything" — refusing a
    pack or an apply the architect can rescope — rather than narrow to
    "collides with nothing", which is exactly the silent whole-file
    clobber ADR-0007 exists to prevent. Both degradations are logged;
    neither is silent.

    A recorded EMPTY scope (`[]`, v0.3.15 — a read-only session packed
    with --read-only or the wizard's read-only answer) is a third,
    distinct state, not a degradation: it reads back as [] — "locks
    nothing, may land nothing". Deliberately opposite to the missing/
    malformed cases above: [] intersects no sibling scope (ADR-0007's
    gates admit packs and applies beside it) while covering no
    changes[] path (the own-scope drift gate refuses everything such a
    session ships). The conservative whole-tree fallback is reserved
    for scopes the gates cannot READ; a scope that was deliberately
    recorded empty is read exactly as recorded.
    """
    p = scope_file_path(repo, sid)
    if not p.exists():
        log(f"session {sid} has no recorded scope; treating its scope "
            f"as the whole tree (conservative)")
        return ["."]
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as e:
        log(f"session {sid}'s scope.json is unreadable ({e}); treating "
            f"its scope as the whole tree (conservative)")
        return ["."]
    if (not isinstance(data, list)
            or not all(isinstance(x, str) and x.strip() for x in data)):
        log(f"session {sid}'s scope.json is malformed (expected a "
            f"list of paths); treating its scope as the "
            f"whole tree (conservative)")
        return ["."]
    if not data:
        # Valid empty scope — the read-only session shape. No log line:
        # this is a recorded state read back as recorded, not a
        # degradation the operator needs flagged.
        return []
    return resolved_scope(data)


# --- Integration lock (ADR-0006) ---------------------------------------------

def integration_lock_path(repo: Path) -> Path:
    return repo / ".bale" / "integration.lock"


def read_integration_lock_info(repo: Path) -> Optional[dict]:
    """Read the integration lock's holder record; None when not held.

    When held, the dict always carries "path" and, when the lock file
    parses, whichever of sid/pid/acquired_at it recorded — the same
    degrade-to-presence contract _gather_status established: an
    unreadable lock file still means "held", so the fact is reported
    with just the path rather than dropped (CLAUDE.md §6: silent skips
    are bugs). Shared by the acquire-time refusal, `bale status`'s
    gather, and `bale unlock --integration`, so all three read one
    parse of the record.
    """
    p = integration_lock_path(repo)
    if not p.exists():
        return None
    info: dict = {"path": str(p)}
    try:
        parsed = json.loads(p.read_text(encoding="utf-8"))
        if isinstance(parsed, dict):
            for key in ("sid", "pid", "acquired_at"):
                if key in parsed:
                    info[key] = parsed[key]
    except (OSError, json.JSONDecodeError):
        log(f"could not parse {p}; reporting presence only")
    return info


def acquire_integration_lock(repo: Path, sid: str) -> None:
    """Take the repo-level integration lock for the §8.6–§8.8 git window.

    Atomic create (O_CREAT|O_EXCL): if the file already exists another
    integration holds it — or a crash mid-merge left it stale — and this
    apply fails before touching the checkout. The failure message is the
    stale-lock story: it names the holder recorded in the file and the
    manual clear (the lock guards concurrent integrations, not repo
    integrity, so removing a stale file is always safe once no apply is
    running).
    """
    p = integration_lock_path(repo)
    p.parent.mkdir(parents=True, exist_ok=True)
    payload = json.dumps(
        {
            "sid": sid,
            "pid": os.getpid(),
            "acquired_at": datetime.now(timezone.utc).isoformat(
                timespec="seconds"),
        },
        indent=2,
    ) + "\n"
    try:
        fd = os.open(str(p), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
    except FileExistsError:
        info = read_integration_lock_info(repo) or {"path": str(p)}
        holder = format_integration_holder(info)
        fail(
            f"integration lock is held ({holder}) at {p}. Another `bale "
            f"apply` may be integrating; if none is running, the lock is "
            f"stale from an interrupted apply — clear it with "
            f"`bale unlock --integration` (or remove the file: `rm {p}`) "
            f"and re-run."
        )
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(payload)
    log(f"acquired integration lock for {sid}")


def release_integration_lock(repo: Path) -> None:
    """Release the integration lock; idempotent (safe from a finally)."""
    p = integration_lock_path(repo)
    if p.exists():
        p.unlink()
        log("released integration lock")


# ---------------------------------------------------------------------------
# 7. .gitignore handling for the .bale/ directory
# ---------------------------------------------------------------------------

def ensure_bale_gitignored(repo: Path) -> bool:
    """Append .bale/ to repo's .gitignore if it isn't already there.

    Returns True if the file was modified (so the caller can decide whether
    to auto-commit), False if no change was needed.

    Per BALE.md section 7.1 step 6. v0.0.1 appends silently with a log line;
    interactive confirmation is a later enhancement.
    """
    gi = repo / ".gitignore"
    needle = ".bale/"
    if gi.exists():
        lines = [ln.rstrip("\n") for ln in gi.read_text().splitlines()]
        if needle in lines or ".bale" in lines:
            return False
        with gi.open("a", encoding="utf-8") as f:
            if lines and lines[-1] != "":
                f.write("\n")
            f.write(f"{needle}\n")
        log(f"appended '{needle}' to {gi}.")
    else:
        gi.write_text(f"{needle}\n")
        log(f"created {gi} with '{needle}'.")
    return True


# ---------------------------------------------------------------------------
# 8. Path safety + inbound path resolution
# ---------------------------------------------------------------------------

def refuse_system_dir(p: Path, *, force: bool = False) -> None:
    """Per BALE.md section 7.1 steps 1-2.

    Step 1 (SYSTEM_DIRS) has no override flag — `bale pack` at `/` is almost
    certainly a typo, and the spec is explicit that there's no escape hatch.
    Step 2 ($HOME) supports `--force` for the legitimate dotfiles-repo case.
    When forced, the bypass is logged prominently via log(force=True) so the
    session journal records it; the log-line is buffered until the session
    log file exists, since this check fires before sid allocation."""
    resolved = p.resolve()
    if str(resolved) in SYSTEM_DIRS:
        # No override here, by design (BALE.md §7.1 step 1).
        fail(
            f"refusing to operate at system directory {resolved}. "
            f"cd into a project directory and retry."
        )
    home = Path.home().resolve()
    if resolved == home:
        if force:
            log(
                f"bypassing home-directory refusal at {resolved} "
                f"(legitimate use: dotfiles repo)",
                force=True,
            )
            return
        fail(
            f"refusing to operate at $HOME ({resolved}). "
            f"Re-run with --force if this is a dotfiles repo and you know "
            f"what you're doing; otherwise cd into a subdirectory."
        )


def is_path_safe(rel: str) -> bool:
    """Reject path-traversal, absolute paths, and reserved prefixes."""
    if rel.startswith("/"):
        return False
    parts = Path(rel).parts
    if ".." in parts:
        return False
    if parts and parts[0] in (".git", ".bale"):
        return False
    return True


def resolve_inbound_path(arg: str, cwd: Path, search_paths: list[str],
                         *, kind: str = "tarball") -> Path:
    """Resolve a CLI file argument against the configured inbound
    directories (`apply.search_paths`).

    Used by `bale apply`, `bale retry`, and `bale handoff` for their
    tarball argument, and by `bale pack --readme-file` for its prose file
    (v0.3.6) — both kinds are
    files a worker produced and the user downloaded somewhere bale can be
    told about once, rather than paths the worker could know. `kind` is
    the noun the not-found error leads with ("tarball", "readme file");
    it changes wording only, never semantics. Renamed from
    resolve_tarball_path when the pack consumer landed — one resolver so
    the two surfaces can't drift.

    The semantics are layered so that a user with no search_paths
    configured sees identical behavior to the pre-search-paths era:

      1. Absolute path → returned as-is. Search is bypassed entirely (per
         the bale.toml contract). The caller checks existence and emits
         its normal "<kind> not found" error if the path doesn't exist.
      2. Relative path AND no search_paths configured → resolved against
         cwd. Same behavior as the original `Path(arg).resolve()` plus
         the caller's existence check.
      3. Relative path AND search_paths configured → cwd first, then each
         configured search path in order. First existing file wins. If
         none match, fail() here with a multi-line message naming every
         directory consulted (cwd plus each search path). Cwd is part
         of the search even though the user didn't configure it — a bare
         filename should still resolve from where the user invoked bale.

    Tilde and env var expansion on search_paths entries is handled upstream
    by get_apply_search_paths; entries arrive here already expanded. The
    cli-supplied `arg` itself is NOT expanded — the shell already does
    that, and a quoted `~/foo` arg almost certainly means the user
    explicitly didn't want expansion.

    The resolution itself lives in locate_inbound_path (v0.4.10, split
    out for `bale pack --checkpoint-file`'s wizard surface, which must
    re-prompt on a miss rather than exit); this wrapper adds only the
    fail() on the search-miss case, so every surface keeps one
    resolution implementation.
    """
    resolved = locate_inbound_path(arg, cwd, search_paths)
    if resolved is not None:
        return resolved

    # Nothing matched. The error names every directory that was searched —
    # per the explicit constraint, the user should never be left guessing
    # which paths bale consulted.
    lines = [f"{kind} not found: {arg}", "  searched:"]
    lines.append(f"    {cwd}  (cwd)")
    for sp in search_paths:
        lines.append(f"    {sp}")
    fail("\n".join(lines))


def locate_inbound_path(arg: str, cwd: Path,
                        search_paths: list[str]) -> Optional[Path]:
    """The non-failing core of resolve_inbound_path (v0.4.10): same
    layered semantics — absolute bypass, cwd-only when no search paths
    are configured, cwd-then-each-configured-directory otherwise — but
    a search miss returns None instead of exiting, so an interactive
    caller (the pack wizard's checkpoint prompt) can re-prompt. The
    absolute and no-search-path branches return the candidate without
    an existence check, exactly as before the split; the caller's read
    is the existence check there.
    """
    p = Path(arg)
    if p.is_absolute():
        return p
    if not search_paths:
        # No search configured — preserve pre-feature behavior verbatim.
        return (cwd / arg).resolve()

    cwd_candidate = cwd / arg
    if cwd_candidate.is_file():
        return cwd_candidate.resolve()
    for sp in search_paths:
        candidate = Path(sp) / arg
        if candidate.is_file():
            return candidate.resolve()
    return None
    # fail() does sys.exit; this return is unreachable but keeps mypy happy.
    return cwd_candidate  # pragma: no cover


# ---------------------------------------------------------------------------
# 9. Editor invocation
# ---------------------------------------------------------------------------

def open_in_editor(initial_text: str, *, abort_hint: str = "") -> str:
    """Open $EDITOR on a temporary .md file pre-populated with initial_text;
    return the user's edited contents stripped of trailing whitespace.

    Honors $EDITOR, falls back to $VISUAL, then to /usr/bin/editor (Debian
    convention; the alternatives system points at the user's selected editor
    on Debian/Ubuntu, which catches most no-EDITOR-set installs). $EDITOR
    may be a multi-word command (`code --wait`); we split with shlex but
    don't validate further — the same trust-the-user posture the rest of
    bale takes with subprocess invocations. A non-zero exit from the editor
    is logged but not fatal: the user may have :q'd deliberately to abort
    while still wanting whatever's in the buffer.

    Empty return is allowed: the caller decides whether empty means
    "abort" (cmd_handoff's --edit-goal) or "skip the optional artifact"
    (pack wizard's README step). The abort_hint string, when set, is
    appended to the no-editor-available fail() message so the user gets a
    caller-specific suggestion on what to do instead (e.g. "drop
    --edit-goal" or "answer 'n' to the README prompt").
    """
    editor_env = os.environ.get("EDITOR") or os.environ.get("VISUAL")
    if not editor_env:
        debian_alt = "/usr/bin/editor"
        if Path(debian_alt).exists():
            editor_env = debian_alt
        else:
            msg = (
                "$EDITOR is not set and /usr/bin/editor is not available. "
                "Set EDITOR (e.g. `export EDITOR=vim`) and retry"
            )
            if abort_hint:
                msg += f", or {abort_hint}"
            msg += "."
            fail(msg)

    with tempfile.NamedTemporaryFile(
        mode="w+", suffix=".md", delete=False, encoding="utf-8",
    ) as tf:
        tf.write(initial_text)
        if not initial_text.endswith("\n"):
            tf.write("\n")
        tmp_path = Path(tf.name)

    try:
        cmd = shlex.split(editor_env) + [str(tmp_path)]
        result = subprocess.run(cmd, check=False)
        if result.returncode != 0:
            log(f"$EDITOR ({editor_env!r}) exited {result.returncode}; "
                f"using whatever the file holds now")
        return tmp_path.read_text(encoding="utf-8").strip()
    finally:
        try:
            tmp_path.unlink()
        except OSError:
            pass


# ---------------------------------------------------------------------------
# 10. Baleignore matching (pack filter chain + apply rule 14)
# ---------------------------------------------------------------------------

# --- .baleignore (BALE.md §6.4) ---------------------------------------------
#
# `.baleignore` lives at the repo root and lets users add project-specific
# permanent exclusions on top of the baked-in dir/secret patterns and
# `.gitignore`. Used at both pack (filter chain) and apply (rule 14: a
# response cannot declare a path that matches `.baleignore`).
#
# Syntax: a documented subset of gitignore. Each non-blank, non-comment
# line is a pattern, normalized as follows:
#
#   - Leading `#` (after lstrip) → comment, skipped.
#   - Trailing `/` → directory-only: matches when any path component
#     equals the pattern's body (slash-less anchored variant matches the
#     leading component only).
#   - Leading `/` → anchored to repo root: pattern (minus the leading
#     slash) is matched against the full relative path.
#   - No slash → basename match against any path component (so `data`
#     excludes both `data/x.csv` and `nested/data/x.csv`).
#   - Slash in the middle → match against the full relative path
#     (anchored), with `fnmatch`-style globbing inside each segment.
#   - Leading `!` → unsupported; load_baleignore raises with a
#     helpful message. Negation has outsized semantic cost (multi-pass
#     evaluation, ordering matters) for limited real-world need; users
#     wanting it can narrow `--include` instead.
#
# Globs use `fnmatch.fnmatchcase` (case-sensitive — matches gitignore
# behavior on POSIX filesystems; Windows-case-insensitive variants would
# need their own flag). `**` is NOT a special token in the subset; treat
# it as a literal sequence of two stars, which won't match anything
# normal. If recursive matching is wanted, omit the slash entirely
# (basename match runs at every depth) or use multiple patterns.

class BaleignoreMatcher:
    """A loaded `.baleignore` pattern set. Stateless after construction;
    callers pre-build one matcher and run many paths through it.

    Constructed by `load_baleignore(repo)` from the on-disk file, or
    `BaleignoreMatcher.from_lines(lines)` for in-memory composition (the
    pack pipeline composes file patterns with session-extra patterns via
    `build_pack_matcher`).

    Pattern compilation is one-time at construction so per-path `matches`
    is a tight loop over pre-classified entries. Each entry is one of
    three shapes:

      - ("basename", body)      — match body against any single path
        component. Used for unanchored patterns with no slash in body
        (regardless of trailing slash). Covers `data`, `data/`, `*.csv`.
        Files-at-depth and dirs-at-depth both match because path
        components are checked at every depth — matches how gitignore
        treats a no-slash pattern as a basename-anywhere pattern that
        implicitly subtree-excludes matched directories.
      - ("path_or_under", body) — segment-wise fnmatch with subtree:
        matches when len(parts) >= len(body_segs) AND each body_segs[i]
        fnmatches parts[i]. Used for dir-only patterns (trailing slash)
        and for anchored bare names (`/build`). `/build/` matches both
        `build` and `build/x`; `src/legacy/` matches `src/legacy` and
        `src/legacy/sub/Bar.vue`.
      - ("path_exact",    body) — segment-wise fnmatch, strict: matches
        when len(parts) == len(body_segs) AND each segment fnmatches.
        Used for non-dir-only patterns containing an internal slash,
        like `src/legacy/*.vue`. The strict-depth rule is what stops
        `*.vue` from being greedy across slashes (Python's stdlib
        `fnmatch` itself does not respect `/` boundaries — `*` matches
        slashes — so segment-wise matching is how we restore the
        gitignore-style anchored-per-component semantics).

    The empty matcher (no patterns) returns False for every path.
    `load_baleignore` returns None on absent file specifically so callers
    can branch on "no matcher loaded" rather than always constructing
    an empty one — micro-optimization on the hot pack walk where most
    repos have no `.baleignore`.
    """

    __slots__ = ("_entries", "_patterns")

    def __init__(self, entries: list[tuple], patterns: list[str]):
        # entries: classified pattern list for matching. Each entry is
        # ("basename", body) or ("path_or_under"|"path_exact", body, segs)
        # where segs is body.split("/") pre-computed.
        # patterns: the raw normalized pattern lines, preserved so error
        # messages can name "which pattern matched" verbatim (apply rule 14
        # gives a much clearer rejection when it can echo the actual line).
        self._entries = entries
        self._patterns = patterns

    @classmethod
    def from_lines(cls, lines: list[str]) -> "BaleignoreMatcher":
        """Build a matcher from a list of pattern lines. Lines may include
        comments and blanks; they're stripped here. Raises ValueError on
        leading `!` (negation, unsupported) so the caller can fail
        with file context."""
        entries: list[tuple] = []
        patterns: list[str] = []
        for raw in lines:
            stripped = raw.strip()
            if not stripped or stripped.startswith("#"):
                continue
            if stripped.startswith("!"):
                raise ValueError(
                    f"negation patterns (lines starting with '!') are not "
                    f"supported in .baleignore at v0.1. Offending line: "
                    f"{stripped!r}. Narrow `--include` paths or remove "
                    f"the conflicting positive pattern instead."
                )
            patterns.append(stripped)

            # Directory-only marker (trailing slash).
            is_dir_only = stripped.endswith("/")
            body = stripped[:-1] if is_dir_only else stripped

            # Anchored to repo root (leading slash).
            anchored = body.startswith("/")
            if anchored:
                body = body[1:]
            if not body:
                # Pathological pattern like "/" or "//" — skip rather
                # than crash. A bare anchor matches nothing meaningful.
                continue

            has_slash = "/" in body

            # Classification:
            #
            # - Unanchored AND no slash in body → basename-anywhere.
            #   Covers `data`, `data/`, `*.csv`. Trailing-slash variant
            #   collapses into basename because the basename-anywhere
            #   rule already matches both the dir and everything under it
            #   (each component is checked, so `data` in parts wins for
            #   both `data` and `data/x`).
            #
            # - Dir-only (trailing slash) OR anchored-with-no-internal-
            #   slash → path_or_under. The former covers `src/legacy/`
            #   (which should subtree-match); the latter covers `/build`
            #   and `/build/` (where the bare anchored name conventionally
            #   excludes the named dir's whole subtree).
            #
            # - Else (non-dir-only with slash inside) → path_exact. This
            #   is the strict glob-at-fixed-depth case: `src/legacy/
            #   *.vue` matches only at depth 3, not deeper. Users wanting
            #   subtree from a glob-bearing path should add a trailing
            #   slash to make the intent explicit.
            if not anchored and not has_slash:
                entries.append(("basename", body))
            elif is_dir_only or (anchored and not has_slash):
                entries.append(("path_or_under", body, body.split("/")))
            else:
                entries.append(("path_exact", body, body.split("/")))
        return cls(entries, patterns)

    @property
    def patterns(self) -> list[str]:
        """The normalized pattern lines, for display in error messages and
        the wizard's preview. Returned as a fresh list — callers are free
        to mutate without affecting the matcher."""
        return list(self._patterns)

    def __bool__(self) -> bool:
        # Truthy when there's at least one effective pattern. The empty
        # matcher is falsy, which lets callers do `if matcher: ...`
        # to skip the per-path check when nothing was loaded.
        return bool(self._entries)

    @staticmethod
    def _matches_one(parts: list[str], entry: tuple) -> bool:
        """Single-entry match — extracted so matches() and first_match()
        share the per-entry logic. parts is rel.split('/') (passed in to
        avoid re-splitting on every entry)."""
        tag = entry[0]
        if tag == "basename":
            body = entry[1]
            for part in parts:
                if fnmatch.fnmatchcase(part, body):
                    return True
            return False
        # path_or_under or path_exact
        body_segs = entry[2]
        if tag == "path_exact":
            if len(parts) != len(body_segs):
                return False
        else:  # path_or_under
            if len(parts) < len(body_segs):
                return False
        for i, seg in enumerate(body_segs):
            if not fnmatch.fnmatchcase(parts[i], seg):
                return False
        return True

    def matches(self, rel: str) -> bool:
        """True if rel is matched by any pattern. rel is a repo-relative,
        forward-slash-separated path (matching git's convention). Always
        False for the empty matcher."""
        if not self._entries:
            return False
        parts = rel.split("/") if rel else []
        for entry in self._entries:
            if self._matches_one(parts, entry):
                return True
        return False

    def first_match(self, rel: str) -> Optional[str]:
        """The first pattern that matches rel, or None. Used by error
        messages that want to name which pattern caused a rejection (the
        apply-side rule-14 reject in particular reads better when it can
        echo the pattern verbatim)."""
        if not self._entries:
            return None
        parts = rel.split("/") if rel else []
        for entry, pat in zip(self._entries, self._patterns):
            if self._matches_one(parts, entry):
                return pat
        return None


def load_baleignore(repo: Path) -> Optional[BaleignoreMatcher]:
    """Load `<repo>/.baleignore` into a matcher, or return None if the file
    is absent. A present-but-empty file (only comments and blanks) returns
    an empty matcher, distinguishable from None — useful in messaging
    ("you have a .baleignore but it's empty") without re-stat'ing the file.

    Malformed patterns (negation) fail loudly: the file is the
    user's source of truth, and silently dropping unsupported syntax
    would mean Claude responses get apply-rejected for reasons that
    look correct on the page.
    """
    f = repo / BALEIGNORE_FILE
    if not f.is_file():
        return None
    try:
        text = f.read_text(encoding="utf-8")
    except OSError as e:
        fail(f"could not read {f}: {e}")
    try:
        return BaleignoreMatcher.from_lines(text.splitlines())
    except ValueError as e:
        fail(f"{f}: {e}")


def is_baleignore_match(rel: str, matcher: Optional[BaleignoreMatcher]) -> bool:
    """Convenience for apply-side rule 14: True when `rel` is matched.
    None matcher (no `.baleignore`) returns False. Kept as a free function
    so apply-side code reads as `is_baleignore_match(p, matcher)` parallel
    to `is_path_safe(p)`."""
    if matcher is None:
        return False
    return matcher.matches(rel)


# ---------------------------------------------------------------------------
# 19. Revert
# ---------------------------------------------------------------------------

def _discard_hold_state(repo: Path, sid: str, *,
                        verbose: bool = False) -> dict:
    """Discard the HOLD-applied state for sid.

    Switches off bale/<sid> if checked out (refusing loudly, WIP
    untouched, if the checkout is dirty and git refuses the switch),
    deletes the branch, wipes the session dir, wipes the recorded
    staging directory.
    The registry close is intentionally NOT performed here — callers
    manage it. cmd_revert closes the session (close_session) after
    calling this helper, capturing openness beforehand since the
    session-dir wipe below removes the open marker; cmd_retry leaves
    the session open for apply_pipeline to land the re-attempt in.

    fail()s if bale/<sid> is already merged into the recorded origin
    branch: that case means apply already PASSed, and either revert or
    retry would be undoing committed work — the right verb is
    `bale rollback <sid>` instead (v0.2+).

    Idempotent in the partial-state cases:
      - no bale branch → log and skip branch operations
      - no session dir → log and skip the wipe
      - no recorded staging → log and skip
    These cases arise legitimately from cmd_retry against a session
    that was packed but never applied (no apply attempt = no branch).

    Invariant: if bale/<sid> exists, the session dir's origin_branch
    metadata also exists, because the apply pipeline writes 8.2's
    metadata before creating the branch at 8.5.

    Returns a status dict for caller-side summary output:
        {
            "branch_existed": bool,
            "origin_branch": str | None,
            "staging_state": str,   # "wiped" | "unremovable" | "already-gone" | "not-recorded"
            "staging_path": str | None,  # the recorded staging path, when one was
            "staging_error": str | None, # rmtree failure text, "unremovable" only
        }
    Machine facts only (v0.3.35, the accepted session-008 fold-in): the
    human `staging` row is rendered from these keys by
    bale_report.format_staging_row at both discard consumers (cmd_revert's
    summary block and the apply walkthrough's revert branch) — derived
    here from the filesystem, never parsed back out of a display string
    (the same posture cmd_unlock's session_dir_wiped takes, now with the
    rendering residue gone from this path too). staging_error joins the
    facts because the "unremovable" row carries the OSError text, which
    the v0.3.19 pair (state, path) alone could not reproduce.

    `verbose` (v0.3.35, `bale revert --verbose` — BALE.md §5.4): echo the
    captured stdout/stderr of the git operations this discard runs
    (branch verification, the inspection-checkout switch, `branch -D`)
    live as they complete, prefixed per stream. Default keeps today's
    quiet path byte-identical — the [bale] log lines stay the whole
    trail. Echoes go through print(), so under `--json` they follow the
    stream discipline to stderr like every other informational line.
    """
    def _echo_git(label: str, r) -> None:
        # Verbose-only: surface the captured git output that the quiet
        # path discards. Both streams, prefixed, skipping empties.
        if not verbose:
            return
        for stream_name, text in (("stdout", r.stdout), ("stderr", r.stderr)):
            for ln in (text or "").splitlines():
                if ln.strip():
                    print(f"[bale] verbose: git {label} {stream_name}: {ln}")

    sessions_dir = repo / ".bale" / "sessions" / sid
    sid_branch = f"bale/{sid}"

    # Read staging path BEFORE wiping sessions_dir so the trail survives.
    recorded_staging: Optional[Path] = None
    staging_path_file = sessions_dir / "staging_path"
    if staging_path_file.is_file():
        s = staging_path_file.read_text().strip()
        if s:
            recorded_staging = Path(s)

    # Branch handling.
    branch_check = git(["rev-parse", "--verify", "--quiet", sid_branch],
                       cwd=repo, check=False)
    _echo_git(f"rev-parse --verify {sid_branch}", branch_check)
    branch_existed = branch_check.returncode == 0
    origin_branch: Optional[str] = None

    if branch_existed:
        # Per the invariant above, origin_branch metadata must exist.
        origin_branch_file = sessions_dir / "origin_branch"
        if not origin_branch_file.is_file():
            fail(f"{sid_branch} exists but session metadata at "
                 f"{sessions_dir} is missing. Resolve manually.")
        origin_branch = origin_branch_file.read_text().strip()
        if not origin_branch:
            fail(f"origin_branch file at {origin_branch_file} is empty")

        # Refuse if already merged into origin. Since ADR-0008 a HOLD is a
        # commit on the bale branch, and apply refuses stampless sessions,
        # so the pre-ADR-0008 HOLD shape — branch and origin pointing at
        # the same commit with nothing merged — can no longer arise. The
        # plain is-ancestor check is therefore the whole guard: it holds
        # for a merge commit and for a fast-forward alike (a branch is its
        # own ancestor), and in both cases deleting the branch would lose
        # history that's threaded through origin.
        ancestor = git(["merge-base", "--is-ancestor", sid_branch, origin_branch],
                       cwd=repo, check=False)
        if ancestor.returncode == 0:
            fail(f"{sid_branch} is already an ancestor of {origin_branch} — "
                 f"this session was already merged. Use "
                 f"`bale rollback {sid}` to undo a merged session.")

        # If on the bale branch, switch to origin before deleting it —
        # `branch -D` cannot delete the checked-out branch. Since ADR-0008
        # bale never puts the user on bale/<sid>; this path covers a
        # manual checkout during inspection. Switch only, never a reset:
        # if the checkout is dirty and git refuses to carry the changes
        # across, refuse loudly rather than clobber the user's WIP. (We
        # don't touch other branches' WIP because we don't check them
        # out.)
        current = current_branch(repo)
        if current == sid_branch:
            log(f"on {sid_branch}; switching to {origin_branch}")
            switched = git(["checkout", origin_branch], cwd=repo,
                           check=False)
            _echo_git(f"checkout {origin_branch}", switched)
            if switched.returncode != 0:
                detail = (switched.stderr or switched.stdout or "").strip()
                fail(f"cannot switch from {sid_branch} to {origin_branch}: "
                     f"the checkout has local changes git refuses to carry "
                     f"across, and bale will not discard them. Commit, "
                     f"stash, or reset your changes on {sid_branch}, then "
                     f"re-run."
                     + (f"\n  git: {detail}" if detail else ""))
        elif current != origin_branch:
            log(f"on {current}; deleting {sid_branch} without changing branch")

        # Force-delete the bale branch.
        deleted = git(["branch", "-D", sid_branch], cwd=repo)
        _echo_git(f"branch -D {sid_branch}", deleted)
        log(f"deleted branch {sid_branch}")
    else:
        log(f"no branch {sid_branch} to discard (no prior apply attempt)")

    # Session dir wipe.
    if sessions_dir.exists():
        shutil.rmtree(sessions_dir)
        log(f"wiped {sessions_dir}")

    # Staging cleanup. Idempotent: a missing directory is fine — the user
    # may have already removed it, or the session never made it past the
    # exists() pre-check at apply time. Don't fail the whole operation
    # for an unremovable staging dir; the git side is already reverted.
    staging_error: Optional[str] = None
    if recorded_staging is None:
        staging_state = "not-recorded"
        log("no recorded staging path; skipping staging cleanup")
    elif recorded_staging.exists():
        try:
            shutil.rmtree(recorded_staging)
            log(f"wiped staging at {recorded_staging}")
            staging_state = "wiped"
        except OSError as e:
            log(f"warning: could not remove {recorded_staging}: {e}")
            staging_state = "unremovable"
            staging_error = str(e)
    else:
        log(f"staging at {recorded_staging} already gone")
        staging_state = "already-gone"

    return {
        "branch_existed": branch_existed,
        "origin_branch": origin_branch,
        "staging_state": staging_state,
        "staging_path": (str(recorded_staging)
                         if recorded_staging is not None else None),
        "staging_error": staging_error,
    }


def cmd_revert(args: argparse.Namespace) -> int:
    cwd = Path.cwd().resolve()
    refuse_system_dir(cwd)

    repo = repo_root(cwd)
    if repo is None:
        fail("not in a git repo. `bale revert` requires the project repo.")
    refuse_system_dir(repo)

    # `bale revert --json` (v0.3.19) — stream discipline first, before any
    # line can print (matches cmd_unlock, v0.3.18): stdout carries exactly
    # the one JSON line format_revert_json owns; `[bale] ` lines and the
    # human summary block go to stderr as the reference trail. Human mode
    # is byte-identical: when the swap never happens, no code path below
    # differs. Refusal paths exit through fail() — stderr, non-zero,
    # nothing on stdout — like every other json surface's error paths.
    if args.json:
        enable_json_mode()

    # ADR-0006 threading: the sid is optional. With exactly one open
    # session it resolves implicitly (the zero-argument single-session
    # flow); with several open an explicit sid is required. An explicit
    # sid passes through unvetted (require_open=False) — revert's own
    # metadata and branch checks below have always been its gate, and
    # they still let it clean up states the registry no longer shows
    # open.
    sid = resolve_open_session(repo, args.sid, command="revert",
                               require_open=False)
    sid_branch = f"bale/{sid}"
    sessions_dir = repo / ".bale" / "sessions" / sid

    set_log_file(repo / ".bale" / "logs" / f"{sid}.log")
    log(f"revert: {sid}")

    # Revert-specific contract: refuse when there's nothing to revert.
    # cmd_retry is more permissive (it can run against a packed-but-not-
    # applied session) — that policy stays out of _discard_hold_state.

    # 9.1 step 1: metadata must exist.
    if not (sessions_dir / "origin_branch").is_file():
        fail(f"no session metadata for {sid} at {sessions_dir}. Either the "
             f"sid is wrong or the session was already cleaned up.")

    # The bale branch must exist. If it doesn't, the session was already
    # applied (PASS path deletes the branch after merge) — direct the user
    # to git revert, since v0.0.1 has no `bale rollback` yet.
    branch_check = git(["rev-parse", "--verify", "--quiet", sid_branch],
                       cwd=repo, check=False)
    if branch_check.returncode != 0:
        fail(f"no branch {sid_branch}. If the session was already applied, "
             f"use `bale rollback {sid}` to undo a merged session (v0.2+).")

    # Capture registry openness BEFORE the shared cleanup: the session
    # dir wipe inside _discard_hold_state removes the open marker along
    # with everything else, so checking afterwards would always read
    # closed and leave the compatibility pointer stale.
    was_open = session_is_open(repo, sid)

    # Telemetry inputs (v0.3.9, B2), read BEFORE the shared cleanup for the
    # same reason as was_open: _discard_hold_state wipes the session dir,
    # taking the stamped response manifest and scope.json with it. Best
    # effort — a session reverted before any apply stamped a manifest
    # records feedback: null.
    stamped_manifest: Optional[dict] = None
    stamped_path = sessions_dir / "response-manifest.json"
    if stamped_path.is_file():
        try:
            stamped_manifest = json.loads(
                stamped_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as e:
            log(f"telemetry: stamped response manifest unreadable ({e}); "
                f"recording the revert without it")
    revert_scope = read_session_scope(repo, sid)

    # Shared cleanup (9.1 steps 2-5, plus staging cleanup). --verbose
    # (v0.3.35) rides into the helper: the captured git output of the
    # discard streams live; the default path is byte-identical.
    status = _discard_hold_state(repo, sid, verbose=args.verbose)

    # 9.1 step 6: close this sid in the registry if it was open. Threaded
    # (ADR-0006): the close targets the reverted session itself, never
    # whichever session the compatibility pointer happened to name — with
    # one open session the two were always the same sid, so the
    # single-session behavior is unchanged. close_session is idempotent
    # over the already-gone marker; what this call does post-wipe is
    # reconcile the pointer (repoint to the oldest remaining open
    # session, or clear it).
    lock_cleared = was_open
    if lock_cleared:
        close_session(repo, sid)
        log(f"closed session {sid} in the registry")

    # Telemetry record (v0.3.9, B2 — BALE.md §8.9). command="revert" and
    # validation null: no validation ran in THIS invocation — the HOLD
    # attempt that preceded a typical revert already recorded its own
    # state/exit/reconciliation in the same file. closure_reason
    # (v0.3.16) is --reason when given and null otherwise — outcome
    # "reverted" already names the event, and a null reason is honest
    # rather than a guessed one.
    telemetry_rel = write_telemetry_record(
        repo, sid, build_telemetry_attempt(
            outcome="reverted", command="revert",
            manifest=stamped_manifest, scope=revert_scope,
            log_path=f".bale/logs/{sid}.log",
            closure_reason=args.reason,
            clarification=read_clarification_summary(repo, sid),
        ))
    # Auto-sweep (v0.3.32; BALE.md §8.8): revert is a closing event and
    # this invocation's git mutation (_discard_hold_state) is complete,
    # so the sweep commit interleaves with nothing. Config-gated;
    # silent when unset, loud and never fatal when enabled. The return
    # rides the --json report's sweep key (v0.3.34).
    sweep_result = sweep_commit(repo, sid, "reverted",
                                [telemetry_rel] if telemetry_rel else [])

    # End-of-run summary through the shared formatter (see the
    # "Shared end-of-run summary formatting" section) so `bale revert`
    # ends on the same [STATUS] sid shape as apply/handoff — and in
    # particular matches the apply pipeline's own walkthrough-revert
    # banner (status="REVERT", branch/lock/staging rows), since both
    # paths run the same _discard_hold_state cleanup. The crisp block is
    # the last thing printed; the operational [bale] log lines above it
    # are the reference trail that precedes it.
    print(format_summary_block(
        [
            ("branch", f"{status['origin_branch']} ({sid_branch} deleted)"),
            ("lock", "cleared" if lock_cleared else "unchanged"),
            # v0.3.35: the human row is a projection of the machine facts
            # (bale_report.format_staging_row owns the rendering — the
            # accepted session-008 fold-in).
            ("staging", format_staging_row(
                state=status["staging_state"],
                path=status["staging_path"],
                error=status["staging_error"])),
            ("telemetry",
             f"recorded {telemetry_rel}" if telemetry_rel
             else "write failed — see log"),
        ],
        status="REVERT",
        sid=sid,
    ))
    # --json (v0.3.19): the one stdout line, emitted last so the human
    # block above (now on stderr under the stream discipline) stays the
    # reference trail. Key contract: format_revert_json's docstring.
    if args.json:
        emit_json_line(format_revert_json(
            sid=sid,
            log_path=str(repo / ".bale" / "logs" / f"{sid}.log"),
            closure_reason=args.reason,
            origin_branch=status["origin_branch"],
            branch_deleted=sid_branch,
            lock_cleared=lock_cleared,
            staging_state=status["staging_state"],
            staging_path=status["staging_path"],
            telemetry=telemetry_rel,
            # v0.3.34, additive: the sweep_commit return from above —
            # null when [apply].sweep is unset/false.
            sweep=sweep_result,
        ))
    return 0


# ---------------------------------------------------------------------------
# 20. Retry
# ---------------------------------------------------------------------------
#
# Re-attempt a HOLDed session with a corrected response tarball, in the
# same session id. Without this command the user must `bale revert` + re-
# `pack` + `apply`, which mints a fresh sid and forces `corrects` to
# point across sessions even though the intent and goal didn't change.
# Retry keeps the session open in the registry so the new apply lands in
# the same session id. Threaded (ADR-0006, v0.3.2): the target resolves
# through resolve_open_session — implicit with one session open, --sid
# with several.

def cmd_retry(args: argparse.Namespace) -> int:
    cwd = Path.cwd().resolve()
    refuse_system_dir(cwd)

    repo = repo_root(cwd)
    if repo is None:
        fail("not in a git repo. `bale retry` requires the project repo.")
    refuse_system_dir(repo)

    # Same search-path resolution as `bale apply` — retry takes a tarball
    # path argument with the same semantics, so it honors the same merged
    # global+project config.
    cfg = bale_config.merged_config(repo)
    search_paths = bale_config.get_apply_search_paths(cfg)
    tarball_path = resolve_inbound_path(args.tarball, cwd, search_paths)
    if not tarball_path.is_file():
        fail(f"tarball not found: {tarball_path}")

    # json output mode (v0.3.14, retry parity): same two-part contract as
    # `bale apply --json` (v0.2.8) — stdout carries exactly the one-line
    # machine report the pipeline emits at its terminal reporting point,
    # everything else lands on stderr. Enabled here, before the session
    # resolution and set_log_file below, mirroring cmd_apply's
    # after-inspection placement (retry has no inspection branch, so
    # after tarball resolution is the direct analog). The pipeline's
    # emission points are already gated on bale_report.json_mode(), so
    # nothing threads through apply_pipeline's signature.
    if args.json:
        enable_json_mode()

    # Retry requires an open session, same as apply. Threaded (ADR-0006):
    # the registry identifies which session this retry is for — implicit
    # with exactly one open, --sid required with several, and an explicit
    # --sid must name an open session (retry preserves the open session
    # and re-runs the pipeline inside it, so a closed sid has nothing to
    # retry into).
    locked_sid = resolve_open_session(
        repo, args.sid, command="retry",
        none_open_hint=(
            "`bale retry` is for re-attempting a packed session. If you "
            "have a tarball but no open session, run `bale pack` first "
            "and then `bale apply`."
        ),
    )

    # Wire logging to the same session log apply/revert use.
    set_log_file(repo / ".bale" / "logs" / f"{locked_sid}.log")
    log(f"retrying session {locked_sid} with {tarball_path.name}")

    # Non-interactive mode: same resolution and logging contract as
    # cmd_apply — retry reruns the same pipeline with the same two prompt
    # points, so it takes the same flag and honors the same config keys.
    no_interact, no_interact_source = resolve_no_interact(
        repo, cfg, args.no_interact)
    if no_interact:
        log(f"non-interactive apply mode active ({no_interact_source})")

    # Preserve the session's durable records across the HOLD cleanup.
    # _discard_hold_state wipes .bale/sessions/<sid>/ wholesale — the
    # right cleanup for the per-attempt state (staging_path and the prior
    # response manifest, both re-stamped by the pipeline) but it also
    # takes the open marker, the stamped request manifest, the ADR-0007
    # scope, and — since ADR-0008 made it the session's fixed integration
    # target rather than per-attempt state — the origin_branch stamp with
    # it. Pre-threading that gap
    # was papered over by the compatibility pointer, which still named
    # the sid; with resolution registry-based, a retry window whose
    # marker is gone would read as "no session open" to every command
    # (and to a concurrent pack's disjointness gate). So: read the two
    # durable records first, discard, then re-persist and re-open.
    sessions_dir = repo / ".bale" / "sessions" / locked_sid
    stamped_manifest: Optional[dict] = None
    mpath = sessions_dir / "manifest.json"
    if mpath.is_file():
        try:
            stamped_manifest = json.loads(mpath.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as e:
            log(f"could not read stamped request manifest at {mpath} "
                f"({e}); it will not survive the retry cleanup")
    preserved_scope: Optional[list] = None
    spath = scope_file_path(repo, locked_sid)
    if spath.is_file():
        try:
            raw_scope = json.loads(spath.read_text(encoding="utf-8"))
            if (isinstance(raw_scope, list) and raw_scope
                    and all(isinstance(x, str) and x.strip()
                            for x in raw_scope)):
                preserved_scope = raw_scope
            else:
                log(f"scope.json at {spath} is malformed; not preserved "
                    f"across the retry (the session will read as "
                    f"whole-tree, conservative)")
        except (OSError, json.JSONDecodeError) as e:
            log(f"could not read {spath} ({e}); scope not preserved "
                f"across the retry (the session will read as "
                f"whole-tree, conservative)")

    # ADR-0008 (v0.3.5): origin_branch joins the records preserved across
    # the discard. It is durable — the session's integration target, fixed
    # at pack — but 8.2 historically stamped it per-attempt, so the wipe
    # takes it and the re-persist below restores it. Read it before the
    # discard.
    preserved_origin: Optional[str] = None
    opath = sessions_dir / "origin_branch"
    if opath.is_file():
        stamped_origin = opath.read_text().strip()
        if stamped_origin:
            preserved_origin = stamped_origin

    # 8.1 step 5 — the same ADR-0008 narrow rule cmd_apply runs: refuse
    # tracked changes on the target branch itself, before any HOLD state
    # is discarded. The old blanket guard was skipped here because a HOLD
    # dirtied the worktree by construction; a HOLD is a committed branch
    # now, so retry runs the guard like apply does. (A manual inspection
    # checkout of bale/<sid> is not the target, so it passes this guard;
    # _discard_hold_state handles switching off it.)
    refuse_dirty_on_target(repo, resolve_target_branch(repo, locked_sid))

    # Cleanup is no-op if there's no HOLD to discard (e.g. user packed but
    # never tried apply). In that case retry behaves like apply. --verbose
    # (v0.4.0, the accepted 005 rider) rides into the helper the same way
    # cmd_revert's call does: the discard's captured git output streams
    # live; the default path is byte-identical.
    status = _discard_hold_state(repo, locked_sid, verbose=args.verbose)
    if not status["branch_existed"]:
        log("no prior apply attempt for this session; retry equivalent to apply")

    # Re-persist the durable records and re-open the session, so the
    # registry never shows a mid-retry session as closed. Whatever the
    # new attempt does — PASS (close_session at merge), HOLD (stays
    # open for inspect/revert/another retry), or a pre-flight rejection
    # (stays open, exactly the packed/held state the user can act on) —
    # the registry now tells the truth throughout.
    if stamped_manifest is not None:
        persist_pack_session(repo, locked_sid, stamped_manifest,
                             scope=preserved_scope)
    elif preserved_scope is not None:
        persist_session_scope(repo, locked_sid, preserved_scope)
    if preserved_origin is not None:
        # Written directly (not via persist_pack_session's origin_branch
        # param) so it restores in every branch above, including the
        # no-stamped-manifest case.
        sessions_dir.mkdir(parents=True, exist_ok=True)
        (sessions_dir / "origin_branch").write_text(preserved_origin + "\n")
        log(f"preserved integration target {preserved_origin!r} across "
            f"the retry")
    register_session(repo, locked_sid)
    log(f"re-opened session {locked_sid} in the registry for the retry")

    # Same rejected-path telemetry wrapper as cmd_apply (BALE.md §8.9);
    # invoked_by="retry" so the record's attempts distinguish the commands.
    #
    # Flag parity (v0.3.14): verbose and allow_out_of_scope thread through
    # exactly as cmd_apply passes them. The override is per-invocation and
    # per-path by contract (BALE.md §8.1 step 14) — args.allow_out_of_scope
    # is whatever THIS retry invocation named, never state carried from the
    # failed apply attempt. Nothing here reads a prior attempt's admitted
    # paths back; a retry that needs the override re-states it, and a retry
    # that omits it hits the drift gate like any un-overridden apply would.
    try:
        return apply_pipeline(repo, tarball_path, locked_sid,
                              args.staging_dir,
                              verbose=args.verbose,
                              no_interact=no_interact,
                              no_interact_source=no_interact_source,
                              invoked_by="retry",
                              allow_out_of_scope=args.allow_out_of_scope,
                              allow_missing_required_check=(
                                  args.allow_missing_required_check),
                              accept_checkpoint_change=(
                                  args.accept_checkpoint_change),
                              no_sandbox=args.no_sandbox)
    except SystemExit as e:
        record_rejected_attempt(repo, locked_sid, "retry",
                                tarball_path.name, e)
        raise


# ---------------------------------------------------------------------------
# 28. Amend-checkpoint
# ---------------------------------------------------------------------------
#
# `bale amend-checkpoint` — the operator half of the bad-oracle correction
# flow (PLANNER.md section 5, steps 4-5) as a first-class verb (board 53,
# v0.4.17). Mechanizes the transport, never the deliberateness: resolve the
# open session, read the desk's amendment file LF-normalized, verify it
# against the desk-published sha256, commit it at the session's per-sid
# checkpoint path (bale-prefixed subject, pathspec-limited), and end the
# report with the paste-ready `bale retry ... --accept-checkpoint-change`
# line as the named successor. The provenance gate downstream is untouched:
# it still refuses at retry, the accept stays per-invocation, and
# stamp_matched: false remains the truthful record.
#
# The section sits physically between 20 (Retry) and 21 (Unlock) — beside
# the lifecycle verbs it corrects for — with a fresh number, per the
# stable-numbering rule the 26/27 ordering already exercises.


def _amend_base_or_refuse(repo: Path) -> str:
    """The amend-side config gate: the merged config must pin a
    {sid}-bearing [validation] base, or the verb refuses — never a
    silent ignore. Returns the base.

    The same two-refusal shape as pack's --checkpoint-file gate
    (bale_pack.checkpoint_file_base_or_refuse), with amend's own
    wording so each refusal names this verb's real state and remedy:

    - **Unconfigured**: no blind checkpoint is pinned, so there is no
      oracle for an amendment to revise.
    - **Literal base**: a literal base's oracle is project-wide, not
      per-session; the planner amends it by committing the new bytes
      at the literal path directly — no session resolution, no verb.
    """
    base = bale_config.get_validation_base(bale_config.merged_config(repo))
    if base is None:
        fail("`bale amend-checkpoint` requires a configured per-session "
             "blind checkpoint, but bale.toml pins no [validation] base — "
             "there is no oracle for an amendment to revise. Configure a "
             "{sid}-bearing base via `bale config init` ([validation] "
             "base, e.g. claude/checkpoints/{sid}.sh).")
    if "{sid}" not in base:
        fail(f"`bale amend-checkpoint` is per-session ({{sid}} bases) "
             f"only, but [validation] base is the literal path {base!r}. "
             f"A literal base's oracle is project-wide: the planner "
             f"commits the amended bytes at {base!r} directly (edit, "
             f"commit — no verb involved).")
    return base


def resolve_scoped_open_session(repo: Path, requested: Optional[str]) -> str:
    """Resolve which open SCOPED session `bale amend-checkpoint` targets.

    The board-51 posture applied to this verb's candidate set: a
    read-only session (deliberately recorded forecast `[]`) is
    structurally invisible — its empty forecast waived the checkpoint
    at pack (BALE.md section 8.5), so it carries no oracle to amend and
    never competes with the scoped session the amendment is for. Only a
    deliberate `[]` is excluded: read_session_scope returns the
    conservative whole-tree scope for a missing or malformed record, so
    a legacy session stays a candidate rather than silently vanishing.

    An explicit --sid always wins, vetted: it must be open, and it must
    be scoped — naming a read-only session refuses with the waiver
    named, not a dangling-path surprise later. With no --sid, exactly
    one scoped open session resolves implicitly; zero or several refuse
    loudly naming every candidate (a case the resolution rule cannot
    separate never guesses).
    """
    opens = open_sessions(repo)
    scoped = [s for s in opens if read_session_scope(repo, s) != []]
    if requested is not None:
        if not session_is_open(repo, requested):
            listing = (f" Open session(s): {', '.join(opens)}."
                       if opens else " No sessions are open.")
            fail(f"session {requested} is not open; nothing to "
                 f"amend.{listing}")
        if read_session_scope(repo, requested) == []:
            listing = (f" Scoped open session(s): {', '.join(scoped)}."
                       if scoped else "")
            fail(f"session {requested} is read-only (empty write "
                 f"forecast): its pack waived the blind checkpoint "
                 f"(BALE.md \u00a78.5), so it carries no oracle to "
                 f"amend.{listing}")
        return requested
    if not scoped:
        ro = [s for s in opens if s not in scoped]
        ro_note = (f" Open session(s) {', '.join(ro)} are read-only — "
                   f"empty forecast, checkpoint waived — and are not "
                   f"candidates." if ro else "")
        fail(f"no scoped session is open; nothing to amend. `bale "
             f"amend-checkpoint` revises an open session's committed "
             f"blind checkpoint.{ro_note}")
    if len(scoped) == 1:
        return scoped[0]
    fail(f"{len(scoped)} scoped sessions are open; `bale "
         f"amend-checkpoint` needs an explicit --sid when more than one "
         f"is a candidate. Scoped open sessions (oldest first): "
         f"{', '.join(scoped)}.")
    raise AssertionError("unreachable")  # fail() exits


def cmd_amend_checkpoint(args: argparse.Namespace) -> int:
    """`bale amend-checkpoint <file> --sha256 <hex> [--sid] [--accept-
    unaccounted-oracle]` — commit a desk-published amendment over an
    open session's blind checkpoint and name the retry as successor.

    The flow, each step loud (board-53 ruling, (b)-as-adjusted):

    1. Config gate: a {sid}-bearing [validation] base, or refuse.
    2. Published-hash shape gate: --sha256 must be 64 hex chars — a
       truncated paste is the transport defect the mandatory hash
       exists to catch, refused before anything else runs.
    3. Session resolution: the sole open scoped session, or --sid;
       read-only sessions are structurally invisible.
    4. Read the amendment: locate_inbound_path over apply.search_paths
       (cwd first, absolute bypasses — a desk-downloaded amendment
       resolves by bare name), bytes CRLF-normalized at read
       (bale_pack.normalize_crlf, board 50 — the operator's hand-run
       strip step no longer exists as a concept), empty refused.
    5. Verify the normalized bytes' sha256 against the published hash;
       a mismatch refuses naming both hashes and the resolved source
       path (first-match resolution picks stale near-duplicates
       silently — evidence 45's class; the echo exists to be compared).
    6. The accounting rung against the committed oracle at the
       session's resolved per-sid path:
       - committed bytes == the amendment → the idempotent re-run:
         no new commit, successor still emitted;
       - committed bytes == the session's pack-time
         provenance.checkpoint stamp → the amendment proper: commit;
       - no stamp to account against (hand-rolled or pre-0.3.28
         request, or explicit-null: packed with no checkpoint
         configured) → degrade to the published-hash deliberateness
         alone, loudly, per the provenance gate's own "verify nothing,
         stamp_matched: null" precedent (BALE.md \u00a78.5);
       - committed bytes match NEITHER → refuse loudly naming all
         three hashes, unless --accept-unaccounted-oracle (per
         invocation, FORCE-logged) deliberately admits the
         replacement. Never silent either way.
    7. The working-tree rung: uncommitted bytes at the resolved path
       differing from both HEAD and the amendment refuse — the verb
       never clobbers local edits it cannot account for.
    8. Commit the amendment bytes at the resolved path — its own
       pathspec-limited commit on the current branch, subject
       `bale: amend per-session checkpoint for <sid>` — and end the
       report with the paste-ready retry line: after an amendment the
       stamp mismatch holds by construction, so the successor
       pre-composes --accept-checkpoint-change (the deliberateness was
       spent here, published hash in hand; ratified board 53).
    """
    cwd = Path.cwd().resolve()
    refuse_system_dir(cwd)
    repo = repo_root(cwd)
    if repo is None:
        fail("not in a git repo. `bale amend-checkpoint` requires the "
             "project repo.")
    refuse_system_dir(repo)

    # Step 2 first among the argument gates: pure and cheap, so a
    # mangled hash refuses before any config or registry read.
    published = args.sha256.strip().lower()
    if not re.fullmatch(r"[0-9a-f]{64}", published):
        fail(f"--sha256 must be the desk-published sha256 as 64 hex "
             f"characters; got {args.sha256!r} "
             f"({len(args.sha256.strip())} chars). A truncated or "
             f"mangled hash is the transport defect this check exists "
             f"to catch — re-copy the published hash and re-run.")

    base = _amend_base_or_refuse(repo)
    sid = resolve_scoped_open_session(repo, args.sid)
    set_log_file(repo / ".bale" / "logs" / f"{sid}.log")
    log(f"amend-checkpoint: session {sid}")

    # Step 4: locate + read + normalize. Resolution is the shared
    # locate_inbound_path core (one resolver, every inbound surface);
    # the read posture and refusal wording are this verb's own, the
    # same per-surface split pack's --checkpoint-file established.
    cfg = bale_config.merged_config(repo)
    search = bale_config.get_apply_search_paths(cfg)
    src = locate_inbound_path(args.file, cwd, search)
    if src is None:
        lines = [f"amendment file not found: {args.file}", "  searched:",
                 f"    {cwd}  (cwd)"]
        lines += [f"    {sp}" for sp in search]
        fail("\n".join(lines))
    if not src.is_file():
        # The absolute / no-search-path branches return their candidate
        # unchecked; the read is the existence check there.
        fail(f"amendment file not found: {src}")
    try:
        data = src.read_bytes()
    except OSError as e:
        fail(f"could not read amendment file {src}: {e}")
    data = normalize_crlf(data)
    if not data.strip():
        fail(f"amendment file {src} is empty. An empty oracle would "
             f"grade nothing; the desk's amendment carries the corrected "
             f"checkpoint's full bytes.")

    # Step 5: the mandatory published-hash comparison, over the same
    # LF-normalized bytes every downstream surface hashes and runs.
    delivered_sha = hashlib.sha256(data).hexdigest()
    log(f"amendment read: {src} (sha256 {delivered_sha[:12]}, "
        f"LF-normalized)")
    if delivered_sha != published:
        fail(f"amendment hash mismatch: the delivered file's "
             f"LF-normalized bytes hash to {delivered_sha}, but the "
             f"published sha256 is {published}.\n"
             f"  resolved file: {src}\n"
             f"First-match resolution picks stale near-duplicates in a "
             f"downloads directory silently — check that the resolved "
             f"path above is the amendment the desk published, then "
             f"re-run with the matching file and hash.")

    # Step 6: the accounting rung. The committed oracle is read
    # binary-exact from HEAD, the same extraction every checkpoint
    # surface performs, so accounting and execution hash the same bytes.
    resolved = bale_config.resolve_checkpoint_path(base, sid)
    shown = subprocess.run(["git", "show", f"HEAD:{resolved}"],
                           cwd=str(repo), capture_output=True)
    if shown.returncode != 0:
        fail(f"no committed blind checkpoint at {resolved} in HEAD — "
             f"nothing to amend. An amendment revises a session's "
             f"committed oracle; this session has none at its resolved "
             f"path (the pack-time install is `bale pack "
             f"--checkpoint-file`, or the planner commits it directly).")
    committed = shown.stdout
    committed_sha = hashlib.sha256(committed).hexdigest()

    amend_commit_made = False
    if committed == data:
        log(f"{resolved} is already committed with identical bytes "
            f"(sha256 {committed_sha[:12]}) — the idempotent re-run; "
            f"proceeding without a new commit")
        accounting = "idempotent re-run — no new commit"
    else:
        stamp_present, stamp = read_request_checkpoint_stamp(repo, sid)
        if not stamp_present or stamp is None:
            # No stamp to account against — degrade to the working
            # half of the flow loudly, mirroring the provenance gate's
            # "verify nothing, stamp_matched: null" posture.
            why = ("the request carried no provenance.checkpoint key "
                   "(hand-rolled, or packed pre-0.3.28)"
                   if not stamp_present else
                   "the request's checkpoint stamp is the explicit "
                   "null (packed with no checkpoint configured)")
            log(f"no pack-time stamp to account the committed oracle "
                f"against — {why}; the accounting rung is skipped and "
                f"the amendment proceeds on the published-hash "
                f"deliberateness alone (committed sha256 "
                f"{committed_sha[:12]} \u2192 delivered "
                f"{delivered_sha[:12]})", force=True)
            accounting = "no pack-time stamp — accounting skipped, loud"
        elif (stamp.get("path") == resolved
                and stamp.get("sha256") == committed_sha):
            log(f"committed oracle matches the pack-time stamp (sha256 "
                f"{committed_sha[:12]}) — amending the session's "
                f"original oracle to {delivered_sha[:12]}")
            accounting = "committed == pack-time stamp"
        elif not args.accept_unaccounted_oracle:
            stamped_desc = (f"{stamp.get('path')} sha256 "
                            f"{str(stamp.get('sha256'))[:12]}")
            fail(f"`bale amend-checkpoint` refuses to replace committed "
                 f"oracle bytes it cannot account for: {resolved} at "
                 f"HEAD (sha256 {committed_sha[:12]}) matches neither "
                 f"the session's pack-time stamp ({stamped_desc}) nor "
                 f"the delivered amendment (sha256 "
                 f"{delivered_sha[:12]}). A prior amendment or an edit "
                 f"outside this flow landed there. If replacing it is "
                 f"deliberate, re-run with --accept-unaccounted-oracle "
                 f"(per-invocation; FORCE-logged naming all three "
                 f"hashes).")
        else:
            log(f"--accept-unaccounted-oracle — replacing committed "
                f"oracle bytes that match neither the pack-time stamp "
                f"nor the delivered amendment: committed "
                f"{committed_sha[:12]}, pack-time stamp "
                f"{str(stamp.get('sha256'))[:12]} at "
                f"{stamp.get('path')}, delivered {delivered_sha[:12]} "
                f"(per-invocation admission)", force=True)
            accounting = ("unaccounted committed bytes — replacement "
                          "admitted by --accept-unaccounted-oracle")

        # Step 7: the working-tree rung — never clobber uncommitted
        # edits the flow cannot account for. Working tree == HEAD is
        # the normal checked-out state; == the amendment is a hand-copy
        # already in place; anything else is local work.
        target = repo / resolved
        if target.exists():
            try:
                existing = target.read_bytes()
            except OSError as e:
                fail(f"could not read the working-tree file at "
                     f"{resolved}: {e}")
            if existing != committed and existing != data:
                fail(f"`bale amend-checkpoint` refuses to overwrite "
                     f"uncommitted working-tree edits at {resolved}: "
                     f"its bytes (sha256 "
                     f"{hashlib.sha256(existing).hexdigest()[:12]}) "
                     f"match neither HEAD ({committed_sha[:12]}) nor "
                     f"the amendment ({delivered_sha[:12]}). Commit, "
                     f"stash, or remove the local edits, then re-run.")
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(data)

        # Step 8: the pathspec-limited amend commit, the same commit
        # hygiene as pack's --checkpoint-file install — other staged
        # work is untouched.
        for cmd, what in (
                (["git", "add", "--", resolved], "stage"),
                (["git", "commit", "-m",
                  f"bale: amend per-session checkpoint for {sid}",
                  "--", resolved], "commit")):
            r = subprocess.run(cmd, cwd=str(repo), capture_output=True,
                               text=True)
            if r.returncode != 0:
                fail(f"amend-checkpoint: could not {what} {resolved} "
                     f"(exit {r.returncode}): "
                     f"{(r.stderr or r.stdout).strip()}")
        amend_commit_made = True
        log(f"amended {resolved} on the current branch: committed "
            f"sha256 {committed_sha[:12]} \u2192 {delivered_sha[:12]} "
            f"(pathspec-limited commit; the provenance gate at retry "
            f"still reads the original pack-time stamp and refuses — "
            f"the accept below is the deliberate, per-invocation "
            f"acknowledgment)")

    # The end-of-run report. The trailer's last line is the paste-ready
    # successor — the report ends with it, per the board-53 constraint;
    # --accept-checkpoint-change is pre-composed because after an
    # amendment the stamp mismatch holds by construction and the
    # deliberateness was already spent at this verb's invocation.
    print(format_summary_block(
        [
            ("session", sid),
            ("oracle", resolved),
            ("committed", f"sha256 {committed_sha[:12]}"
                          + ("" if amend_commit_made
                             else " (unchanged)")),
            ("delivered", f"sha256 {delivered_sha[:12]} ({src.name})"),
            ("accounting", accounting),
            ("commit", (f"bale: amend per-session checkpoint for {sid}"
                        if amend_commit_made
                        else "none — identical bytes already committed")),
        ],
        status="AMENDED",
        sid=sid,
        trailer=[
            "Next step — retry the held response against the amended "
            "oracle (the stamp refusal is expected; the accept is the "
            "deliberate acknowledgment):",
            f"bale retry <response-tarball> --accept-checkpoint-change "
            f"--sid {sid}",
        ],
    ))
    return 0


# ---------------------------------------------------------------------------
# 21. Unlock
# ---------------------------------------------------------------------------
#
# Clear an abandoned session — the "open, no branch" state from
# BALE.md §9.5 (user ran `bale pack`, never applied, never reverted).
# Threaded through the ADR-0006 registry (v0.3.2): the sid is optional,
# resolving implicitly with exactly one open session and required with
# several; the close removes the target session's open marker and
# reconciles the compatibility pointer via close_session, then wipes
# `.bale/sessions/<sid>/`. No git is touched. Refuses on the
# HOLD-with-branch state (a `bale/<sid>` branch exists) — that's
# `bale revert` territory; `--force` overrides the refusal but leaves
# the branch in place, since deleting branches is precisely what
# `bale revert` exists to do safely. The `--force` path is logged with
# the FORCE: prefix so the override is auditable alongside other
# --force events in the session log.
#
# `bale unlock --integration` (v0.3.2) is the second unlock surface:
# it clears the repo-level integration lock (ADR-0006), the stale-lock
# story the acquire-time refusal promises. A different object from a
# session — the two forms don't combine.

def _unlock_integration(repo: Path) -> int:
    """Clear the repo-level integration lock (`bale unlock --integration`).

    The lock is held only across apply's §8.6–§8.8 git window, so
    outside a running apply any sighting is stale debris from an
    interrupted integration. Clearing it is always safe once no apply
    is running — the lock guards concurrent integrations, not repo
    integrity — and that caveat is the one thing the summary insists
    on. Benign no-op (exit 0) when the lock is not held, matching the
    session form's nothing-to-unlock contract.
    """
    info = read_integration_lock_info(repo)
    if info is None:
        print()
        print("  integration lock is not held; nothing to unlock.")
        return 0
    holder = format_integration_holder(info)
    release_integration_lock(repo)
    log(f"cleared integration lock (was {holder})")
    # The [UNLOCK] <sid> headline needs a sid; an unparseable lock file
    # yields none, and format_summary_block (correctly) refuses half a
    # headline — so degrade to rows-only in that case rather than crash
    # while clearing the very debris the command exists to clear.
    headline_kwargs = (
        {"status": "UNLOCK", "sid": info["sid"]}
        if info.get("sid") else {}
    )
    print(format_summary_block(
        [
            ("integration lock", f"cleared (was held by {holder})"),
        ],
        trailer=[
            "Only clear this while no `bale apply` is running; a live",
            "integration whose lock vanishes will fail loudly mid-merge.",
        ],
        **headline_kwargs,
    ))
    return 0


def cmd_unlock(args: argparse.Namespace) -> int:
    cwd = Path.cwd().resolve()
    refuse_system_dir(cwd)

    repo = repo_root(cwd)
    if repo is None:
        fail("not in a git repo. `bale unlock` requires the project repo.")
    refuse_system_dir(repo)

    # --integration clears the repo-level integration lock (ADR-0006's
    # stale-lock story) — a different object from a session, so
    # combining it with a sid is a contradiction, not a combination.
    if args.integration and args.sid is not None:
        fail("`bale unlock --integration` clears the repo-level "
             "integration lock and takes no session id. Run the two "
             "forms separately: `bale unlock [sid]` for a session, "
             "`bale unlock --integration` for the integration lock.")
    # --reason is a session-closure fact; the integration lock is
    # repo-level state, not a session, and its unlock writes no
    # telemetry record (BALE.md §9.3). Combining them is the same
    # contradiction as --integration with a sid.
    if args.integration and args.reason is not None:
        fail("`bale unlock --integration` clears the repo-level "
             "integration lock; it closes no session, so there is no "
             "closure to give a --reason for.")
    # --json (v0.3.18) is session-shaped: its key contract
    # (format_unlock_json) reports sid, closure_reason, and the telemetry
    # record — facts the integration lock, being repo-level state and not
    # a session, does not have. Refused loudly rather than emitting a
    # second, hollow key shape; honest keys for the combination can be
    # added later, additively, if a consumer appears.
    if args.integration and args.json:
        fail("`bale unlock --integration --json` is not supported: the "
             "json report is session-shaped (sid, closure_reason, "
             "telemetry) and the integration lock is repo-level state "
             "with none of those facts. Run `bale unlock --integration` "
             "without --json.")
    if args.integration:
        return _unlock_integration(repo)

    # `bale unlock --json` (v0.3.18) — stream discipline first, before any
    # line can print (matches cmd_pack / cmd_apply / cmd_status): stdout
    # carries exactly the one JSON line format_unlock_json owns; `[bale] `
    # lines and the human summary block go to stderr as the reference
    # trail. Human mode is byte-identical: when the swap never happens, no
    # code path below differs.
    if args.json:
        enable_json_mode()

    # BALE.md §9.3 step 1: read the registry (ADR-0006 threading).
    opens = open_sessions(repo)

    # BALE.md §9.3 step 2: nothing open and no sid asked for → benign
    # no-op, with one cleanup duty first: a non-empty compatibility
    # pointer with no open marker is the crash-debris half-state
    # register_session's write ordering confines interruptions to, and
    # clearing it is exactly the job that function's docstring promises
    # `bale unlock` performs. The named sid's session directory — if one
    # even exists — is deliberately left alone: with no open marker it
    # is either the same crash debris (inert) or a consumed bailout's
    # record, which `bale handoff`'s lineage chase still reads.
    if args.sid is None and not opens:
        # Debris facts captured for the --json report (v0.3.18): null when
        # no stale pointer was swept, else the sid it named and where (or
        # whether) its crash-debris record landed.
        debris: Optional[dict] = None
        stale = read_lock(repo)
        if stale is not None:
            lock_path(repo).write_text("")
            log(f"cleared stale compatibility pointer (named {stale}; "
                f"no session is open)")
            # Telemetry (v0.3.16, BALE.md §8.9/§9.3): the cleared
            # pointer named a sid, so a session's registry trace just
            # ended — record it as closed for crash-debris, best-effort.
            # Everything beyond the closure itself is null/empty: no
            # tarball, no validation, no change paths, and the scope
            # only when the debris sid actually recorded one (the
            # conservative whole-tree widening read_session_scope
            # applies to a MISSING scope would fabricate a scope this
            # session never declared, so an absent scope.json records
            # as []: "no scope recorded", per the schema). A write
            # failure is logged and swallowed inside
            # write_telemetry_record — the benign no-op contract of
            # this path is untouchable. An empty pointer records
            # nothing: there is no session to record.
            debris_scope = (read_session_scope(repo, stale)
                            if scope_file_path(repo, stale).exists()
                            else [])
            debris_rel = write_telemetry_record(
                repo, stale, build_telemetry_attempt(
                    outcome="unlocked", command="unlock",
                    scope=debris_scope,
                    closure_reason="crash-debris",
                    clarification=read_clarification_summary(repo, stale),
                ))
            if debris_rel:
                log(f"telemetry: recorded {debris_rel} (crash-debris "
                    f"closure for {stale})")
            # Auto-sweep (v0.3.32): the debris record is a closure
            # record like any other; config-gated, silent when unset.
            # The return rides the debris object (v0.3.34) so the
            # --json no-op report carries it — normalized inside
            # format_unlock_json, raw here.
            debris_sweep = sweep_commit(repo, stale, "crash-debris",
                                        [debris_rel] if debris_rel else [])
            debris = {"sid": stale, "telemetry": debris_rel,
                      "sweep": debris_sweep}
        print()
        print("  no open session; nothing to unlock.")
        if args.json:
            emit_json_line(format_unlock_json(outcome="no-op",
                                              debris=debris))
        return 0

    # Resolve which open session to unlock: explicit sid (which must be
    # open — the argument is new in v0.3.2, so strictness costs no
    # compatibility), or the single open session, or a refusal listing
    # the candidates when several are open.
    sid = resolve_open_session(repo, args.sid, command="unlock")

    # Wire logging into the session log now that we have a sid. The log
    # file at .bale/logs/<sid>.log lives outside .bale/sessions/<sid>/,
    # so wiping the session dir below doesn't disturb the running log.
    set_log_file(repo / ".bale" / "logs" / f"{sid}.log")
    log(f"unlock: {sid}")

    sid_branch = f"bale/{sid}"

    # BALE.md §9.3 step 3: refuse if the bale branch exists. The branch's
    # presence means apply ran far enough to create it but didn't reach a
    # terminal state (PASS would have deleted the branch after merge;
    # revert would have force-deleted it). The right command for that
    # state is `bale revert`, which knows about origin_branch metadata and
    # handles the branch + staging cleanup. --force overrides for the
    # unusual cases (corrupted session dir, manually-edited state) where
    # the user wants bale out of the way regardless.
    branch_check = git(["rev-parse", "--verify", "--quiet", sid_branch],
                       cwd=repo, check=False)
    branch_exists = branch_check.returncode == 0

    if branch_exists and not args.force:
        fail(
            f"branch {sid_branch} exists — this session reached HOLD. "
            f"Use `bale revert {sid}` to discard the branch and clear "
            f"the lock together, or `bale unlock --force` to clear only "
            f"the lock (the branch would be left in place for you to "
            f"delete manually)."
        )

    if branch_exists and args.force:
        log(
            f"--force; clearing lock for {sid} while branch {sid_branch} "
            f"still exists. Branch is preserved.",
            force=True,
        )

    # Telemetry inputs (v0.3.16, BALE.md §8.9), read BEFORE
    # close_session and the rmtree below — the same read-before-wipe
    # ordering cmd_revert documents for its own telemetry inputs: the
    # wipe takes scope.json with it, and the record is what preserves
    # what the wipe destroys. The closure_reason stamps always: an
    # explicit --reason beats the read-only inference (the operator
    # knows more than the heuristic — a read-only session can itself
    # be superseded or abandoned-in-fact); else `closed-read-only`
    # when the recorded scope reads exactly [] — keyed on [], never on
    # a missing scope, which read_session_scope deliberately widens to
    # ["."] (its third-state contract: [] is the deliberately recorded
    # read-only shape, distinct from missing/malformed); else
    # `abandoned`, the plain never-applied case this command exists
    # for.
    unlock_scope = read_session_scope(repo, sid)
    if args.reason is not None:
        closure_reason = args.reason
    elif unlock_scope == []:
        closure_reason = "closed-read-only"
    else:
        closure_reason = "abandoned"

    # BALE.md §9.3 step 4: close the session in the registry, wipe the
    # session dir, write the closure record — the shared
    # close-with-record sequencing (close_session_with_record, v0.3.17;
    # this command's inline block was extracted into it so pack's
    # supersession flow reuses one implementation). No git operations —
    # that's the whole point of unlock vs revert. Threaded (ADR-0006):
    # close_session inside the helper removes this sid's open marker
    # and reconciles the compatibility pointer (repointing to the
    # oldest remaining open session, or clearing it) — with one open
    # session, observably identical to the old pointer truncate. The
    # telemetry write is best-effort and records the scope read above,
    # before the wipe destroyed scope.json. The --force variant records
    # identically — branch-preserved is a summary-row fact, not a
    # closure reason.
    # The wiped-or-not fact for the --json report is checked here, before
    # the helper wipes — a machine key derived from the filesystem, not
    # parsed back out of the human session_status wording.
    session_dir_existed = (repo / ".bale" / "sessions" / sid).exists()
    telemetry_rel, session_status, sweep_result = close_session_with_record(
        repo, sid,
        closure_reason=closure_reason,
        command="unlock",
        scope=unlock_scope,
        log_path=f".bale/logs/{sid}.log",
    )

    # End-of-run summary through the shared formatter, same [STATUS] sid
    # shape as apply/handoff/revert. UNLOCK joins PASS/HOLD/REVERT as a
    # terminal-state headline. The --force "branch preserved" note is an
    # extra row only when a branch was actually left behind. As with
    # revert, the operational [bale] log lines above are the reference
    # trail and this block is the last thing printed. The telemetry row
    # is the same row revert's summary carries, formatted by
    # bale_report per the one-home rendering contract.
    rows = [
        ("lock", "cleared"),
        ("session", session_status),
    ]
    if branch_exists:
        rows.append((
            "branch",
            f"{sid_branch} preserved (--force); "
            f"`git branch -D {sid_branch}` to remove",
        ))
    rows.append((
        "telemetry",
        f"recorded {telemetry_rel}" if telemetry_rel
        else "write failed — see log",
    ))
    print(format_summary_block(rows, status="UNLOCK", sid=sid))
    # --json (v0.3.18): the one stdout line, emitted last so the human
    # block above (now on stderr under the stream discipline) stays the
    # reference trail. Key contract: format_unlock_json's docstring.
    if args.json:
        emit_json_line(format_unlock_json(
            outcome="unlocked",
            sid=sid,
            log_path=str(repo / ".bale" / "logs" / f"{sid}.log"),
            closure_reason=closure_reason,
            session_dir_wiped=session_dir_existed,
            branch_preserved=branch_exists,
            telemetry=telemetry_rel,
            # v0.3.34, additive: the closure record's sweep_commit
            # return from close_session_with_record — null when
            # [apply].sweep is unset/false.
            sweep=sweep_result,
        ))
    return 0


# ---------------------------------------------------------------------------
# 22. Handoff
# ---------------------------------------------------------------------------
#
# `bale handoff <bailout-tarball>` packs a fresh request from a bailed
# session — the safety net for CLAUDE.md §11 context exhaustion. Inherits
# the bailed-on session's goal verbatim, auto-includes handoff.md plus any
# source files extracted from handoff.md's `## Reading plan for the next
# session` section (TARBALL.md §5.7) in the new request's context/, sets
# depends_on.previous_response to the bailout's session_id, and allocates
# a new session id per TARBALL.md §5.6.2: same slug as the bailout,
# today's date, next NNN.
#
# Pre-pack of source files (v0.0.7+): extract_paths_from_reading_plan
# parses backtick-inline tokens from the reading-plan section,
# gather_files_for_pack applies the standard exclusion / .gitignore
# filter chain, and the surviving files are added to context_entries
# alongside handoff.md. An empty / absent reading plan or one that
# cites no path-shaped tokens degrades cleanly to handoff.md-only —
# the v0.0.6 behavior — so existing bailout tarballs keep working.
#
# The handoff.md heading slicers below (first_section_of_handoff,
# reading_plan_section) and the reading-plan path extractor moved here from
# the old apply-helpers section when the apply path was extracted to
# bale_apply.py (v0.3.13): this command and bale_report's bailout banner
# (which reaches first_section_of_handoff lazily from __main__) are their
# consumers, so the handoff section is their home.

def first_section_of_handoff(handoff_md_text: str) -> str:
    """Return the first '## …' section of a handoff.md document, header line
    included, up to (but not including) the next '## …' heading or EOF.

    TARBALL.md §5.7 mandates a fixed section order in handoff.md, and the
    first one is `## Original goal`. §5.6.3 requires this section be
    printed at apply time so the architect sees the goal that bailed out
    without opening the tarball. Returns "" if no `## ` heading is found —
    the apply path treats that as an empty banner section rather than a
    fatal error, because the §5.6.3 contract is "print the first section"
    and a missing one is content-level, not a tarball-shape violation.
    """
    lines = handoff_md_text.splitlines(keepends=True)
    start = None
    for i, line in enumerate(lines):
        if line.startswith("## "):
            start = i
            break
    if start is None:
        return ""
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if lines[j].startswith("## "):
            end = j
            break
    return "".join(lines[start:end]).rstrip("\n")


def reading_plan_section(handoff_md_text: str) -> str:
    """Return the text of handoff.md's `## Reading plan for the next session`
    section, header line included, up to (but not including) the next `## `
    heading or EOF. Returns "" if no matching section is found.

    Mirrors first_section_of_handoff in shape — both slice the same document
    by `##` heading. Kept separate rather than parameterized because the
    callers want different things from the same text (the bailout banner
    wants whichever section is first; `bale handoff` wants the specific
    reading-plan section), and the section title is locked by TARBALL.md
    §5.7. If a third heading-scoped extractor lands, a shared helper
    earns its place.
    """
    target = "## Reading plan for the next session"
    lines = handoff_md_text.splitlines(keepends=True)
    start = None
    for i, line in enumerate(lines):
        if line.rstrip("\n") == target:
            start = i
            break
    if start is None:
        return ""
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if lines[j].startswith("## "):
            end = j
            break
    return "".join(lines[start:end]).rstrip("\n")


# Regex for backtick-wrapped inline tokens. Single-backtick spans only:
# `\`([^`\n]+)\`` — content between two backticks on the same line, content
# non-empty, no embedded backticks. Triple-backticks (fenced code blocks)
# and double-backticks (rare) are intentionally NOT matched — reading plans
# cite files as inline-code spans, the markdown convention for paths.
_BACKTICK_INLINE = re.compile(r"`([^`\n]+)`")

# Extensions we treat as "path-shaped" when a token has no slash. Without
# this set, a backtick-wrapped bare filename like `BALE.md` would be
# rejected for lacking a slash — but it's a real path in a flat repo
# root. Conversely, a backtick-wrapped English word like `pass` has
# neither slash nor known extension and is correctly skipped. The set is
# permissive on purpose; the asymmetry in extract_paths_from_reading_plan's
# docstring justifies inclusion over precision.
_PATH_LIKE_EXTENSIONS = frozenset((
    ".md", ".py", ".toml", ".json", ".yml", ".yaml", ".sh", ".bash",
    ".txt", ".html", ".css", ".js", ".ts", ".jsx", ".tsx", ".vue",
    ".rs", ".go", ".rb", ".java", ".c", ".cc", ".cpp", ".h", ".hpp",
))


def extract_paths_from_reading_plan(plan_text: str) -> list[str]:
    """Pull repo-relative file paths out of a reading-plan markdown section.

    Heuristic: scan every backtick-inline span (`like-this`), keep the first
    whitespace-delimited token, strip a trailing `:NNN` line-reference, and
    accept the token as a candidate path when (a) it contains `/` OR has a
    known code/doc extension (per _PATH_LIKE_EXTENSIONS), AND (b) it is
    path-safe per is_path_safe (no leading `/`, no `..`, no `.git/` /
    `.bale/` prefix). The four bale-injected global docs are filtered out
    here too — they ship at the request's top level on every pack, so a
    duplicate under context/ would be noise.

    Output preserves first-appearance order and is deduped. No filesystem
    access — that's gather_files_for_pack's job downstream.

    Deliberately permissive: a false positive becomes a tracked file the
    next session sees unnecessarily (cheap — gather_files_for_pack's
    own filters will drop it if it doesn't exist or matches an exclusion);
    a false negative becomes a file the next session has to ask for
    (expensive — the friction the pre-pack is meant to remove). The
    asymmetry argues for inclusion.
    """
    seen: set[str] = set()
    out: list[str] = []
    for match in _BACKTICK_INLINE.finditer(plan_text):
        # First whitespace-delimited token. A backtick span like
        # `BALE.md §8.7` yields `BALE.md`; the section ref is dropped.
        token = match.group(1).strip().split(None, 1)
        if not token:
            continue
        token = token[0]
        # Strip a `:NNN` line-ref suffix (e.g. `bin/bale:2296` -> `bin/bale`).
        # File paths don't legitimately contain `:` in this project's
        # conventions; if a future filename does, the split needs
        # reworking.
        if ":" in token:
            token = token.split(":", 1)[0]
        if not token:
            continue
        has_slash = "/" in token
        ext = Path(token).suffix.lower()
        if not has_slash and ext not in _PATH_LIKE_EXTENSIONS:
            continue
        if not is_path_safe(token):
            continue
        # Filter out bale-injected global docs (bare-filename match against
        # GLOBAL_DOCS). A reading plan that says "re-read `BALE.md` §8.7"
        # is informational; bale already ships BALE.md at the top level.
        if Path(token).name in GLOBAL_DOCS:
            continue
        if token in seen:
            continue
        seen.add(token)
        out.append(token)
    return out


def edit_goal_in_editor(initial_goal: str) -> str:
    """Open $EDITOR on the inherited goal and return the user's edit, with
    the goal-specific contract that an empty result is fatal.

    Thin wrapper over open_in_editor (section 9). The editor-launch
    mechanics — $EDITOR / $VISUAL / /usr/bin/editor fallback, tempfile,
    shlex, non-zero-exit-but-keep-the-buffer — moved there in v0.0.9
    when the pack wizard's README step became the second caller. The
    only goal-specific behavior is the empty-after-strip check: an empty
    goal would fail the request manifest's goal-must-be-non-empty rule
    downstream, and surfacing that here gives a clearer message.
    """
    edited = open_in_editor(
        initial_goal,
        abort_hint="drop --edit-goal to inherit the goal verbatim",
    )
    if not edited:
        fail("goal is empty after --edit-goal; aborting. "
             "Drop --edit-goal to inherit the original goal verbatim.")
    return edited


def warn_repeat_bailout(repo: Path, responds_to_sid: str) -> None:
    """Warn (no fail) if the bailed-on session was itself packed from a
    prior bailout. Two bailouts in a row is a scoping signal — see
    CLAUDE.md §11.4 — and the next handoff session is unlikely to
    succeed without narrower scope. We do not block: the architect may
    have already narrowed, or may be deliberately trying again.

    Chain walk:
      1. The request manifest of the bailed-on session lives at
         `.bale/sessions/<responds_to_sid>/manifest.json` (written by
         `bale pack` or `bale handoff`).
      2. Its `depends_on.previous_response`, if set, names the prior
         response in the chain. In v0.0.6, only `bale handoff` sets
         this field, so a non-null value strongly implies the prior
         response was a bailout — but we verify by inspecting the
         prior response's manifest under
         `.bale/sessions/<prev_resp_sid>/response-manifest.json`,
         which `bale_apply`'s `_apply_bailout` preserves precisely for
         this lookup.
      3. If the previous response's `response_kind` is "bailout",
         warn. Silent otherwise.

    Every link in the chain may be missing — the request manifest could
    be cleaned up, the previous response's session dir might have been
    pruned by hand, JSON might be malformed. Any of those cases yield a
    silent skip: warning on incomplete data would be noise. The chase is
    a best-effort comfort signal, not a correctness check.
    """
    req_manifest_path = repo / ".bale" / "sessions" / responds_to_sid / "manifest.json"
    if not req_manifest_path.is_file():
        return
    try:
        req_manifest = json.loads(req_manifest_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return
    prev_resp_sid = (req_manifest.get("depends_on") or {}).get("previous_response")
    if not prev_resp_sid or not isinstance(prev_resp_sid, str):
        return

    prev_resp_manifest_path = (
        repo / ".bale" / "sessions" / prev_resp_sid / "response-manifest.json"
    )
    if not prev_resp_manifest_path.is_file():
        return
    try:
        prev_resp_manifest = json.loads(
            prev_resp_manifest_path.read_text(encoding="utf-8")
        )
    except (OSError, json.JSONDecodeError):
        return
    if prev_resp_manifest.get("response_kind") != "bailout":
        return

    # The previous response in this chain was also a bailout. Warn via
    # log(force=True) so the message lands in stdout AND will be drained
    # to the session log once next_session_id allocates one (force=True
    # buffers when no log file is open).
    log(
        f"repeat bailout in lineage: prior bailout {prev_resp_sid} → "
        f"this bailout's predecessor {responds_to_sid} → current handoff. "
        f"Two bailouts in a row is usually a scoping signal (CLAUDE.md §11.4): "
        f"consider narrowing the goal rather than asking the next session to "
        f"absorb the same scope. Proceeding anyway.",
        force=True,
    )


def cmd_handoff(args: argparse.Namespace) -> int:
    cwd = Path.cwd().resolve()
    refuse_system_dir(cwd, force=args.force)

    repo = repo_root(cwd)
    if repo is None:
        fail("not in a git repo. `bale handoff` requires the project repo.")
    refuse_system_dir(repo, force=args.force)

    # Detached-HEAD refusal (BALE.md §7.1 step 4a extended to handoff;
    # §11 row 24). cmd_handoff stamps the new session's integration
    # target from current_branch(repo) at persist time exactly as pack
    # does (ADR-0008), and apply hard-refuses a session without the
    # stamp (BALE.md §8.1 step 5) — a handoff run from a detached
    # checkout would create a stampless session doomed to refuse at
    # apply forever, discovered only after the fresh request shipped
    # and its response came back. Fail here instead: before the
    # tarball resolves, before any prompt, before any session state.
    # Same fail-fast posture and no-override rule as pack's refusal —
    # there is no session state a detached handoff could produce that
    # apply would accept. The persist_pack_session HEAD-sentinel guard
    # stays downstream as defense in depth.
    if current_branch(repo) == "HEAD":
        fail(
            "HEAD is detached — bale handoff stamps the currently "
            "checked-out branch as the new session's integration target "
            "(ADR-0008), and a session packed without that stamp can "
            "never be applied. Check out the branch the new session "
            "should integrate into, then re-run the handoff."
        )

    # Resolve the bailout tarball through apply.search_paths — same
    # semantics as `bale apply`. The bailout the user just applied is the
    # natural input (handoff's job is precisely to follow up on that
    # application), so re-resolving against the same search paths matches
    # the muscle memory.
    cfg = bale_config.merged_config(repo)
    search_paths = bale_config.get_apply_search_paths(cfg)
    tarball_path = resolve_inbound_path(args.tarball, cwd, search_paths)
    if not tarball_path.is_file():
        fail(f"tarball not found: {tarball_path}")

    # Handoff opens a new session; refuse while any session is open.
    # Threaded (ADR-0006): the guard reads the registry rather than the
    # compatibility pointer, so with several sessions open it names them
    # all instead of whichever one the pointer happened to record. The
    # refusal itself is unchanged — `bale apply` on the bailout already
    # closed its session, so the normal workflow doesn't trip this; a
    # user who skipped apply and invoked handoff directly does, and the
    # failure message points at the right next step. (Admitting a
    # handoff beside a scope-disjoint open session — pack's ADR-0007
    # gate — is deliberately not extended here; see this session's
    # notes.)
    opens = open_sessions(repo)
    if opens:
        if len(opens) == 1:
            fail(
                f"a session is already open: {opens[0]}. "
                f"Apply its response with `bale apply <tarball>`, or run "
                f"`bale unlock` if the session was abandoned."
            )
        fail(
            f"{len(opens)} sessions are already open: {', '.join(opens)}. "
            f"Apply their responses with `bale apply <tarball>`, or run "
            f"`bale unlock <sid>` for any that were abandoned."
        )

    # Same .bale/ gitignore guard `bale pack` runs. handoff writes under
    # .bale/ before there's any session id, so the directory must already
    # be excluded; otherwise our staging artifacts leak into the user's
    # next commit.
    gitignore_changed = ensure_bale_gitignored(repo)
    if gitignore_changed:
        r = git(["status", "--porcelain"], cwd=repo)
        other_dirty = [
            ln for ln in r.stdout.splitlines()
            if ln and not ln.endswith(" .gitignore")
        ]
        if other_dirty:
            log("note: working tree has other uncommitted changes; "
                ".gitignore was modified but not auto-committed. "
                "Commit it before `bale apply` or apply will refuse.")
        else:
            git(["add", ".gitignore"], cwd=repo)
            git(["commit", "-m", "bale: ignore .bale/"], cwd=repo)
            log("auto-committed the .gitignore change")

    # Extract and validate the bailout tarball. Same tarball-shape and
    # manifest-validation guards as `bale apply` — sharing them keeps the
    # two ingestion surfaces' expectations identical, so the user can't
    # land in a state where apply accepts a tarball that handoff would
    # reject (or vice versa).
    with tempfile.TemporaryDirectory() as tmpdir:
        try:
            tf = tarfile.open(tarball_path, "r:gz")
        except (tarfile.TarError, OSError) as e:
            fail(f"tarball is unreadable: {e}")
        try:
            for member in tf.getmembers():
                name = member.name
                if name.startswith("/") or ".." in Path(name).parts:
                    fail(f"tarball contains unsafe path: {name}")
            tf.extractall(tmpdir)
        finally:
            tf.close()

        entries = [p for p in Path(tmpdir).iterdir()]
        if len(entries) != 1 or not entries[0].is_dir():
            fail(f"tarball must contain exactly one top-level directory; "
                 f"found {[e.name for e in entries]}")
        response_dir = entries[0]
        if not response_dir.name.startswith("response-"):
            fail(f"top-level directory must be named response-NNN/, "
                 f"got {response_dir.name}/")

        try:
            manifest = json.loads(
                (response_dir / "manifest.json").read_text(encoding="utf-8")
            )
        except (OSError, json.JSONDecodeError) as e:
            fail(f"manifest.json is not valid JSON: {e}")
        validate_response_manifest(manifest)

        # Must be a bailout. A normal response doesn't carry handoff.md
        # and there's nothing to "hand off" — direct the user to apply.
        response_kind = manifest.get("response_kind", "normal")
        if response_kind != "bailout":
            fail(
                f"`bale handoff` is for bailout responses only; this "
                f"tarball's manifest has response_kind={response_kind!r}. "
                f"Run `bale apply {tarball_path.name}` instead."
            )

        handoff_path = response_dir / "handoff.md"
        if not handoff_path.is_file():
            fail("bailout response is missing handoff.md (TARBALL.md §5.6.1)")

        bailout_sid = manifest["session_id"]
        responds_to_sid = manifest["responds_to"]

        # Lineage chase — warn if this is a second bailout in the same
        # chain. Best-effort; silent on incomplete data.
        warn_repeat_bailout(repo, responds_to_sid)

        # Derive the new session id per TARBALL.md §5.6.2: same slug as
        # the bailout, today's date, next NNN.
        try:
            _date, slug, _nnn = parse_session_id(bailout_sid)
        except ValueError as e:
            fail(f"could not parse bailout session_id {bailout_sid!r}: {e}")

        # Inherit the bailed-on request's goal verbatim. The request
        # manifest is stored at .bale/sessions/<request-sid>/manifest.json
        # by `bale pack` / `bale handoff` at pack time; we need it here to
        # pick up the original goal so the user doesn't have to retype it.
        request_manifest_path = (
            repo / ".bale" / "sessions" / responds_to_sid / "manifest.json"
        )
        if not request_manifest_path.is_file():
            fail(
                f"cannot inherit goal: request manifest not found at "
                f"{request_manifest_path}. The bailed-on session's record "
                f"may have been cleaned up. Run `bale pack` to start a "
                f"fresh session and re-state the goal manually."
            )
        try:
            request_manifest = json.loads(
                request_manifest_path.read_text(encoding="utf-8")
            )
        except (OSError, json.JSONDecodeError) as e:
            fail(f"could not parse request manifest at "
                 f"{request_manifest_path}: {e}")
        inherited_goal = (request_manifest.get("goal") or "").strip()
        if not inherited_goal:
            fail(f"inherited goal from {request_manifest_path} is empty; "
                 f"cannot proceed.")

        # Optional pre-pack edit. The fail path inside edit_goal_in_editor
        # already covers empty-after-edit, so we trust its return.
        if args.edit_goal:
            inherited_goal = edit_goal_in_editor(inherited_goal)

        # Pre-pack source files from handoff.md's `## Reading plan for the
        # next session` section (TARBALL.md §5.7). The bailing Claude's
        # reading plan typically names the files the next session should
        # read; bundling them in context/ here removes the
        # apply-bailout-then-manually-repack step the architect would
        # otherwise have to run. Three layers of degradation keep this
        # robust:
        #
        #   1. If handoff.md has no reading-plan section, or the section
        #      cites no path-shaped tokens, extract_paths_from_reading_plan
        #      returns []. Fall back to handoff.md-only (the v0.0.6 shape).
        #   2. If a cited path doesn't resolve to a tracked file (typo,
        #      since-renamed, ignored by .gitignore), gather_files_for_pack
        #      silently drops it. The dropped list is logged so the
        #      architect can audit without the handoff failing.
        #   3. If a cited path is unsafe (escape, .git/, .bale/) or matches
        #      a baked-in secret pattern, the same filters drop it. Same
        #      cleanup contract — bale never refuses a handoff over a
        #      single bad reference in a Claude-authored doc.
        #
        # Done before sid allocation so a (hypothetical) error doesn't
        # burn an NNN. The implementation only logs and reads; it cannot
        # fail() at this point.
        try:
            handoff_text = handoff_path.read_text(encoding="utf-8")
        except OSError as e:
            fail(f"could not read handoff.md from bailout tarball: {e}")
        plan_text = reading_plan_section(handoff_text)
        extracted_paths = extract_paths_from_reading_plan(plan_text)
        if extracted_paths:
            included_paths = gather_files_for_pack(repo, extracted_paths)
        else:
            included_paths = []

        # The session's recorded write forecast (ADR-0015), computed
        # here — before the blindness gate below and before sid
        # allocation — so the gate, the manifest stamp, and the
        # registry record at persist all share one value (board 33,
        # v0.3.21): the resolved set of reading-plan files pre-packed
        # above; ["."] (whole tree) when the plan cited none. On the
        # handoff path the read set and the forecast coincide by
        # construction — the reading-plan files are exactly what ships
        # AND the conservative forecast of where the resumed work
        # lands (an over-forecast in the usual case, the safe
        # direction) — so the blindness gate's read-side check below
        # is covered by the same value and no separate include set is
        # passed.
        handoff_scope = resolved_scope(included_paths)

        # Checkpoint blindness pre-flight (v0.3.33; BALE.md §11 row 30)
        # — the pack-time covering refusal run against the handoff's
        # reading-plan scope, same gate implementation, second caller.
        # A handoff whose reading plan covers the configured blind
        # checkpoint re-opens the self-oracle hole the pack-side gate
        # closes (a bailed session with the oracle in scope was
        # admitted once by pack's flag; the handoff must not renew
        # that admission silently). Sited pre-sid, mirroring pack's
        # pre-sid refusal, so a refused handoff burns no NNN and
        # leaves no session state; sited after the reading-plan
        # resolution because the scope does not exist before it. Note
        # the ["."] fallback above: a plan citing no files resolves to
        # whole-tree scope, which covers any configured checkpoint —
        # such a handoff refuses without the flag, the same way a
        # default whole-tree pack does.
        checkpoint_scope_admitted = checkpoint_blindness_preflight(
            repo, handoff_scope, allow=args.allow_checkpoint_in_scope,
            caller="handoff")

        # Per-sid resolved-existence pre-flight (v0.4.8, board 10 S7):
        # same gate cmd_pack runs immediately before allocation — when
        # [validation] base carries {sid}, resolve against the sid this
        # handoff is about to allocate (peeked, not consumed) and
        # refuse a resolved path absent from HEAD while nothing is
        # burned. A literal or unconfigured base is a no-op.
        checkpoint_resolved_preflight(repo, peek_session_id(repo, slug))

        # Allocate the new session id NOW (after all the validation
        # gates) so the per-day counter doesn't burn an NNN on a pack
        # that was about to fail anyway. Same staging-then-allocate
        # ordering `bale pack` uses.
        new_sid = next_session_id(repo, slug)
        set_log_file(repo / ".bale" / "logs" / f"{new_sid}.log")
        log(f"handoff from bailout {bailout_sid} -> new session {new_sid}")
        log(f"inherited goal from request {responds_to_sid}")
        # Reading-plan pre-pack accounting goes to the session log so an
        # architect investigating later can see exactly which candidates
        # came out of handoff.md and which survived the filter. Logged
        # AFTER set_log_file so the lines land in the right log file
        # rather than the unbuffered preamble.
        if extracted_paths:
            log(f"reading plan: {len(extracted_paths)} candidate(s) "
                f"extracted, {len(included_paths)} included after filter")
            log(f"  candidates: {extracted_paths}")
            log(f"  included:   {included_paths}")
        else:
            log("reading plan: no path-shaped tokens (section missing, "
                "empty, or cited no files); context = handoff.md only")

        # Build the (context_relative_path, source_absolute_path) entries
        # for build_request_tarball. handoff.md's source lives in the
        # extracted-bailout tmpdir; each pre-packed source file's source
        # lives in the repo. Parallel context_paths list goes into the
        # manifest so the next Claude sees the full inventory in
        # manifest.context_included per TARBALL.md §3.2.
        context_entries: list[tuple[str, Path]] = [
            ("handoff.md", handoff_path),
        ]
        context_paths_for_manifest: list[str] = ["handoff.md"]
        for rel in included_paths:
            context_entries.append((rel, repo / rel))
            context_paths_for_manifest.append(rel)

        # Build the new request manifest. depends_on.previous_response
        # points at the bailout — this is the ONLY path in v0.0.6 that
        # populates previous_response, which is what makes the lineage
        # chase reliable. Constraints/out_of_scope reset to empty; the
        # architect can re-add via a future `bale pack` if needed (no
        # CLI surface for them on handoff yet, deliberately — keeping
        # the command's surface narrow until the use case argues for
        # more).
        # (handoff_scope was computed above the blindness gate — one
        # value shared by the gate, the manifest stamp below, and the
        # registry record at persist.)
        new_manifest = build_request_manifest(
            sid=new_sid,
            project_name=repo.name,
            goal=inherited_goal,
            constraints=[],
            out_of_scope=[],
            expects_probe="claude-decides",
            context_paths=context_paths_for_manifest,
            depends_on={
                "previous_response": bailout_sid,
                "previous_probe": None,
            },
            # Handoff is the second request-building path, so it stamps
            # provenance too (v0.3.8, B1) — same identity resolution,
            # with a deliberately narrow flag surface (like
            # constraints/out_of_scope above): packer from [identity].
            # packer, work_class at its "mixed" default. The one
            # mirrored flag is --allow-checkpoint-in-scope (v0.3.33),
            # whose admission from the blindness gate above stamps
            # through the shared builder exactly as pack's does.
            provenance=build_provenance_block(
                repo,
                sid=new_sid,
                checkpoint_scope_admitted=checkpoint_scope_admitted,
            ),
            # Board-33 scope stamp (v0.3.21): the same value persisted
            # to the registry below — one source, never a re-derivation.
            resolved_scope=handoff_scope,
        )

        # Same pre-flight schema check as `bale pack` (BALE.md §11 row 6,
        # request side). `bale handoff` is a second request-building path, so
        # it gets the same defense-in-depth guard against a construction bug
        # producing an off-shape request.
        validate_request_manifest(new_manifest)
        log("request manifest schema validation passed")

        # Build the tarball. context_entries is whatever the reading-plan
        # extraction produced (handoff.md first, then 0..N source files);
        # build_request_tarball doesn't care about the source-vs-repo
        # mixing because each entry carries its own source path. Per the
        # prior session's confirmed constraint, no prior-request material
        # is carried forward — context_entries holds only the bailout's
        # handoff.md and the files the reading plan named.
        tarball_out = repo / ".bale" / "outbox" / f"request-{new_sid}.tar.gz"
        try:
            build_request_tarball(
                new_sid,
                context_entries,
                new_manifest,
                tarball_out,
                # --verbose (v0.4.3, the accepted 005 fold-in): stream the
                # build trail through the same default-off kwarg pack
                # threads (v0.3.35). Sited post-sid — set_log_file already
                # ran — so the trail lands on the terminal AND in the
                # session log, same as pack's call site.
                verbose=args.verbose,
            )
        except Exception as e:
            if tarball_out.exists():
                tarball_out.unlink()
            fail(f"failed to build request tarball: {e}")
        log(f"wrote {tarball_out}")

        # Persist the new session — with its scope (ADR-0007, v0.3.2) —
        # and open it in the registry, the same persist-then-open
        # ordering `bale pack` uses. The session's scope is the resolved
        # set of reading-plan files pre-packed above: the handoff
        # analogue of pack's include set, since those files are what the
        # next session is shown. A plan that cited no files resolves to
        # ["."] (whole tree) — conservative, exactly what a missing
        # scope.json would have read as, so pre-v0.3.2 bailout tarballs
        # degrade to the old behavior rather than to a permissive gate.
        # The session opened here is for the new sid; the bailout's own
        # session was closed by `bale apply`'s bailout branch.
        # (handoff_scope was computed above the manifest build so the
        # board-33 stamp and this registry record share one value.)
        persist_pack_session(repo, new_sid, new_manifest,
                             scope=handoff_scope,
                             origin_branch=current_branch(repo))
        register_session(repo, new_sid)
        log(f"opened session {new_sid} in the registry")

        # post_pack hook fires for handoff too — same lifecycle position
        # as in `bale pack` (after tarball-on-disk AND lock-acquired). A
        # hook that prepares the user's environment for a new request
        # is just as relevant for a handoff as for a pack; the hook
        # contract makes no distinction.
        run_hook(repo, bale_config.merged_config(repo), "post_pack", new_sid)

        # Reading-plan file list (reference detail) first, crisp summary last —
        # the same eye-lands-last shape as pack/apply. The crisp block carries
        # the count; the per-file list (which can run several lines) sits above
        # it rather than between the summary and the next-step instruction.
        if included_paths:
            plural = "s" if len(included_paths) != 1 else ""
            print()
            print(f"  reading-plan file{plural} packed into context/:")
            for rel in included_paths:
                print(f"    {rel}")
            context_val = (f"handoff.md + {len(included_paths)} "
                           f"reading-plan file{plural}")
        else:
            context_val = "handoff.md (no reading-plan files extracted)"

        print(format_summary_block(
            [
                ("session id", new_sid),
                ("tarball", str(tarball_out)),
                ("inherited", f"goal from {responds_to_sid} "
                              + ("(edited)" if args.edit_goal else "(verbatim)")),
                ("context", context_val),
                ("depends_on", f"previous_response = {bailout_sid}"),
            ],
            trailer=[
                "Send the tarball to Claude. When the response comes back,",
                "run: bale apply <response-tarball>",
            ],
        ))
        return 0


# ---------------------------------------------------------------------------
# 23. Hook invocation
# ---------------------------------------------------------------------------
#
# All hooks shell out to user-supplied scripts; bale never embeds install
# or copy logic. Every invocation prompts: the script can write outside
# the repo, install software, or perform any action its author chose, and
# bale can't know which. A non-zero exit from the hook is logged but does
# NOT fail the primary bale operation — by the time a hook runs, the
# operation that triggered it has already succeeded. Decline is silent
# (logged but not an error).

def confirm_yn(prompt: str, *, default_no: bool = True) -> bool:
    """Interactive y/N prompt. Returns True on y/yes, False otherwise.

    default_no=True biases toward declining — appropriate for hooks since
    they may have arbitrary side effects. EOF and ^C are treated as
    decline.
    """
    suffix = " [y/N]" if default_no else " [Y/n]"
    try:
        ans = input(f"{prompt}{suffix} ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    if not ans:
        return not default_no
    return ans in ("y", "yes")


def run_hook(repo: Path, cfg: dict, name: str, sid: str, *,
             no_interact: bool = False, no_interact_source: str = "") -> None:
    """Run the named hook if configured. Silent no-op when absent.

    Expects the merged config (from merged_config), so the hook value is
    already an absolute path resolved against its owning layer. This function
    decides which layer the script came from (project vs global) for display
    purposes and runs it.

    Prompts the user before invoking. The user's decline is respected silently
    (no failure). A configured-but-missing or non-executable script is logged
    and skipped rather than failing — bale's primary work has already
    succeeded by the time this runs, and a broken hook shouldn't unwind it.

    `no_interact` (BALE.md §5.4 / §8.7) replaces the prompt with a configured
    decision: apply.hook_auto_accept = true accepts; anything else declines,
    matching the prompt's decline default (default_no=True). Either way the
    bypassed prompt logs the decision taken and its source — the mode source
    in `no_interact_source` plus where the hook_auto_accept value came from
    (config layer, or the built-in default when unset). The apply pipeline is
    the only caller that passes the mode; pack- and handoff-side post_pack
    invocations keep the interactive contract unchanged.
    """
    script = bale_config.get_hook(cfg, name)
    if script is None:
        return  # silent skip — opt-in mechanism

    script_path = Path(script)
    # Defense in depth: get_hook returns absolute paths from merged_config, but
    # if some caller hands us a raw config and a relative slips through, refuse
    # rather than guess what to resolve it against.
    if not script_path.is_absolute():
        log(f"[hook {name}] configured script {script!r} is not an absolute "
            f"path; this indicates a caller bug (pass merged_config, not "
            f"load_config). Skipping.")
        return

    if not script_path.is_file():
        log(f"[hook {name}] configured script {script_path} not found; "
            f"skipping. (Fix bale.toml or place the script there.)")
        return
    if not os.access(script_path, os.X_OK):
        log(f"[hook {name}] {script_path} is not executable; skipping. "
            f"(`chmod +x {script_path}` to enable.)")
        return

    # Identify which layer the script came from, for the prompt. We compare
    # against the install's user/ dir and the repo root; an absolute path that
    # falls inside one of those is from that layer. (Falls-inside-neither
    # shouldn't happen via the wizard, but is possible via hand-edits with an
    # absolute path; we label that "configured" and let the user inspect.)
    source_label = "configured"
    try:
        script_path.relative_to(bale_config.GLOBAL_USER_DIR.resolve())
        source_label = "global"
    except ValueError:
        try:
            script_path.relative_to(repo.resolve())
            source_label = "project"
        except ValueError:
            pass

    print()
    print(f"  hook:   {name} ({source_label})")
    print(f"  script: {script_path}")
    print(f"  cwd:    {repo}")
    print(f"  env:    BALE_HOOK={name}")
    print(f"          BALE_SESSION_ID={sid}")
    print(f"          BALE_REPO_ROOT={repo}")
    print(f"  This script runs as your user. It may write outside the repo,")
    print(f"  install software, or perform any action its author chose.")
    print(f"  Inspect the script before approving.")
    if no_interact:
        # Non-interactive mode: the pre-hook confirmation resolves from
        # config instead of a prompt. The banner above still printed, so the
        # terminal (and any CI capture) carries what would have run; the log
        # lines below carry the decision and its source per the mode's
        # contract. Unset hook_auto_accept declines — the same bias as the
        # interactive prompt's default_no=True.
        if bale_config.get_apply_hook_auto_accept(cfg):
            layer = bale_config.apply_bool_source(repo, "hook_auto_accept") or "config"
            log(f"[hook {name}] prompt skipped ({no_interact_source}): "
                f"auto-accepted per apply.hook_auto_accept=true "
                f"({layer} bale.toml)")
        else:
            layer = bale_config.apply_bool_source(repo, "hook_auto_accept")
            if layer:
                reason = f"apply.hook_auto_accept=false ({layer} bale.toml)"
            else:
                reason = "built-in default (apply.hook_auto_accept unset)"
            log(f"[hook {name}] prompt skipped ({no_interact_source}): "
                f"declined per {reason}; not invoking.")
            return
    elif not confirm_yn("  run this hook?", default_no=True):
        log(f"[hook {name}] declined; not invoking.")
        return

    env = {
        **os.environ,
        "BALE_HOOK": name,
        "BALE_SESSION_ID": sid,
        "BALE_REPO_ROOT": str(repo),
    }
    log(f"[hook {name}] invoking {script_path}")
    try:
        # No capture: stream the hook's stdout/stderr to the user's terminal
        # so a long-running install shows progress. The session log already
        # records the invocation; the hook's own output is the hook's
        # responsibility. Under json output mode (v0.2.8) the hook child's
        # stdout is routed to stderr: the child inherits the process's real
        # file descriptors, which bale_report.enable_json_mode's sys-level
        # stream swap cannot reach, and json mode reserves stdout for the
        # one-line report. Human mode passes None — inherit, as always.
        result = subprocess.run(
            [str(script_path)],
            cwd=str(repo),
            env=env,
            stdout=(sys.stderr if json_mode() else None),
        )
    except OSError as e:
        log(f"[hook {name}] failed to launch: {e}")
        return
    if result.returncode != 0:
        log(f"[hook {name}] exited {result.returncode}. Bale's primary "
            f"operation already succeeded; this is a hook-side issue.")
    else:
        log(f"[hook {name}] succeeded")


# ---------------------------------------------------------------------------
# 24. Help and completion
# ---------------------------------------------------------------------------
#
# `bale help [<cmd>]` and `bale completion bash` are two projections of the
# same source of truth: the argparse parser `build_parser()` (section 26)
# returns. The parser is the canonical command/flag registry — every
# subcommand, flag, choice, and help string lives there exactly once, and
# both surfaces here read it through a small introspection layer
# (`_get_subparsers_action`, `_iter_flag_actions`, `_classify_flag`).
#
# A separate COMMAND_REGISTRY dict that `build_parser()` consumed in
# parallel was considered and rejected: argparse already encodes the data,
# so the parallel dict would double the bookkeeping for every new command
# and let drift creep in silently (a flag added to argparse and forgotten
# in the dict would just stop appearing in completion or help, with no
# error). Reading argparse's `_SubParsersAction.choices` and each
# subparser's `_actions` is a stable, widely-used idiom; the leading
# underscore on `_actions` is more pep8-stylistic than a stability marker.
#
# `cmd_help` dispatches argparse's own `format_help()` after walking
# `_SubParsersAction.choices` to the named command. The walk supports
# `config init` (two-level nesting) and `help` (which itself shows its
# usage when run as `bale help help`).
#
# `cmd_completion` walks the parser once and emits a self-contained bash
# function that does pure-shell dispatch at Tab-press time — no subprocess
# back to bale per Tab press. When the parser changes (new command, new
# flag, new --expects-probe choice), the user re-runs the command and
# re-sources. Bale itself never touches the user's shell rc.

def _get_subparsers_action(parser: argparse.ArgumentParser):
    """Return the parser's `_SubParsersAction`, or `None` if it has none.

    argparse exposes subparsers as an action in `_actions`; this is the
    only stable way to enumerate them programmatically. `bin/bale` builds
    each parser with exactly one subparsers action (`bale <cmd>` for the
    top-level, `bale config <sub>` for the config group), so the function
    returns the first match.
    """
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            return action
    return None


def _iter_flag_actions(subparser: argparse.ArgumentParser):
    """Yield non-positional actions on `subparser`.

    Includes argparse's auto-added `-h`/`--help`, since that's a real flag
    the user can pass and completion should surface it. Excludes
    positional arguments and the subparsers action (positionals have an
    empty `option_strings`).
    """
    for action in subparser._actions:
        if action.option_strings:
            yield action


def _classify_flag(action: argparse.Action) -> tuple[bool, Optional[list[str]]]:
    """Classify a flag action for completion purposes.

    Returns `(takes_value, choices_or_None)`:
        takes_value — True if the flag expects a value argument after it
                      (so completion of the next word is value-flavored,
                      not flag-flavored).
        choices     — non-None when argparse's `choices=` was set, giving
                      the literal value list to suggest. None when any
                      string/int/path is acceptable.

    The valueless action types (`store_true`, `store_false`, `store_const`,
    `count`, `version`, `help`) cover argparse's built-in surface here.
    """
    valueless = (
        argparse._StoreTrueAction,
        argparse._StoreFalseAction,
        argparse._StoreConstAction,
        argparse._CountAction,
        argparse._VersionAction,
        argparse._HelpAction,
    )
    if isinstance(action, valueless):
        return (False, None)
    choices = list(action.choices) if action.choices else None
    return (True, choices)


# --- bale help [<cmd> [<sub>]] -----------------------------------------------

def cmd_help(args) -> int:
    """Print help for bale, a command, or a nested subcommand.

    `bale help`                  → top-level usage (commands + one-liners).
    `bale help <cmd>`            → that command's full --help output.
    `bale help <cmd> <sub>`      → nested subcommand's --help (e.g.
                                   `bale help config init`).
    `bale help <unknown>`        → fails with the available command list.

    Implementation is just argparse's own `format_help()` invoked at the
    right level — no duplicated help strings.
    """
    parser = build_parser()
    names = list(args.command_path or [])

    if not names:
        parser.print_help()
        return 0

    # Walk the chain. At each step, the current parser must have a
    # _SubParsersAction whose .choices includes the next name.
    current: argparse.ArgumentParser = parser
    for i, name in enumerate(names):
        sub = _get_subparsers_action(current)
        if sub is None:
            qualified = "bale " + " ".join(names[:i])
            fail(
                f"`{qualified}` has no subcommands; "
                f"try `bale help {' '.join(names[:i])}` for its flags."
            )
        if name not in sub.choices:
            qualified = "bale" if i == 0 else "bale " + " ".join(names[:i])
            available = ", ".join(sorted(sub.choices))
            fail(
                f"no such command: `{name}` under `{qualified}`. "
                f"Available: {available}."
            )
        current = sub.choices[name]

    current.print_help()
    return 0


# --- bale completion bash ----------------------------------------------------

def _generate_bash_completion(parser: argparse.ArgumentParser) -> str:
    """Generate a self-contained bash completion script for `bale`.

    The output is a complete bash file: header comment, one
    `_bale_complete` function that does pure-shell dispatch (no subprocess
    back to bale per Tab press), and the `complete -F` line that
    registers it. The user sources the output once per shell session
    (`source <(bale completion bash)`) or installs it persistently under
    `~/.local/share/bash-completion/completions/bale`.

    Generation walks the parser once at runtime, so the script is in sync
    with whatever surface bale exposes the moment the user generated it.
    """
    sub_action = _get_subparsers_action(parser)
    if sub_action is None:
        fail("internal: top-level parser has no subcommands")

    cmd_names = list(sub_action.choices.keys())

    # nested_map[cmd] = [list of subcommand names] for two-level commands.
    # Right now only `config` has subcommands; the structure scales when
    # more do. Used both for completing `bale config <TAB>` and for
    # completing the second positional of `bale help <cmd> <TAB>`.
    nested_map: dict[str, list[str]] = {}
    for cn in cmd_names:
        nested = _get_subparsers_action(sub_action.choices[cn])
        if nested is not None:
            nested_map[cn] = list(nested.choices.keys())

    lines: list[str] = []
    lines.append("# bash completion for bale.")
    lines.append("# Generated by `bale completion bash` — regenerate when bale's CLI changes.")
    lines.append("#")
    lines.append("# Usage:")
    lines.append("#   source <(bale completion bash)")
    lines.append("# Or, persistently:")
    lines.append("#   bale completion bash > ~/.local/share/bash-completion/completions/bale")
    lines.append("")
    lines.append("_bale_complete() {")
    lines.append("    local cur prev cword")
    lines.append('    cur="${COMP_WORDS[COMP_CWORD]}"')
    lines.append('    prev="${COMP_WORDS[COMP_CWORD-1]}"')
    lines.append("    cword=$COMP_CWORD")
    lines.append("")
    lines.append("    # Find the first non-flag word after `bale` — that's the subcommand.")
    lines.append('    local sub="" i')
    lines.append("    for (( i=1; i<cword; i++ )); do")
    lines.append('        case "${COMP_WORDS[i]}" in')
    lines.append("            -*) ;;")
    lines.append('            *) sub="${COMP_WORDS[i]}"; break ;;')
    lines.append("        esac")
    lines.append("    done")
    lines.append("")
    lines.append('    if [ -z "$sub" ]; then')
    lines.append('        case "$cur" in')
    lines.append('            -*) COMPREPLY=( $(compgen -W "--version --help" -- "$cur") ) ;;')
    lines.append(f'            *) COMPREPLY=( $(compgen -W "{" ".join(cmd_names)}" -- "$cur") ) ;;')
    lines.append("        esac")
    lines.append("        return 0")
    lines.append("    fi")
    lines.append("")
    lines.append('    case "$sub" in')

    for cn in cmd_names:
        _emit_subcommand_branch(lines, cn, sub_action.choices[cn], cmd_names, nested_map)

    lines.append("        *)")
    lines.append("            COMPREPLY=()")
    lines.append("            ;;")
    lines.append("    esac")
    lines.append("}")
    lines.append("")
    lines.append("complete -F _bale_complete bale")
    lines.append("")
    return "\n".join(lines)


def _emit_subcommand_branch(
    lines: list[str],
    name: str,
    subparser: argparse.ArgumentParser,
    all_cmd_names: list[str],
    nested_map: dict[str, list[str]],
) -> None:
    """Emit one `case "$sub" in <name>) ... ;;` branch.

    Per branch, the dispatch order is:
      1. If `$prev` was a value-taking flag, complete its value (choices
         literal, or fall through to filename completion).
      2. If this command has a nested subparser (e.g. `config init`),
         dispatch on the next positional.
      3. If `$cur` starts with `-`, complete from this command's flag list.
      4. Otherwise, complete the positional — command names for `help`,
         choices for `completion`, filenames for tarball/sid commands,
         else nothing.
    """
    lines.append(f"        {name})")

    # Collect flags and classify each.
    flag_actions = list(_iter_flag_actions(subparser))
    all_flag_strings: list[str] = []
    value_flag_strings: list[str] = []   # any flag that takes a value
    choice_flags: list[tuple[list[str], list[str]]] = []  # (option_strings, choices)
    for action in flag_actions:
        all_flag_strings.extend(action.option_strings)
        takes_value, choices = _classify_flag(action)
        if takes_value:
            value_flag_strings.extend(action.option_strings)
            if choices:
                choice_flags.append((action.option_strings, [str(c) for c in choices]))

    # 1. Previous-word dispatch for value-taking flags.
    if value_flag_strings:
        lines.append('            case "$prev" in')
        choice_flag_strings = {s for opts, _ in choice_flags for s in opts}
        for opt_strings, choices in choice_flags:
            pat = "|".join(opt_strings)
            words = " ".join(choices)
            lines.append(f"                {pat})")
            lines.append(f'                    COMPREPLY=( $(compgen -W "{words}" -- "$cur") )')
            lines.append("                    return 0 ;;")
        other_value_flags = [s for s in value_flag_strings if s not in choice_flag_strings]
        if other_value_flags:
            pat = "|".join(other_value_flags)
            lines.append(f"                {pat})")
            lines.append("                    compopt -o default 2>/dev/null")
            lines.append("                    COMPREPLY=()")
            lines.append("                    return 0 ;;")
        lines.append("            esac")

    # 2. Two-level commands: dispatch on the second positional.
    if name in nested_map:
        nested_names = nested_map[name]
        lines.append('            local subsub="" j')
        lines.append("            for (( j=i+1; j<cword; j++ )); do")
        lines.append('                case "${COMP_WORDS[j]}" in')
        lines.append("                    -*) ;;")
        lines.append('                    *) subsub="${COMP_WORDS[j]}"; break ;;')
        lines.append("                esac")
        lines.append("            done")
        lines.append('            if [ -z "$subsub" ]; then')
        lines.append('                case "$cur" in')
        lines.append(
            f'                    -*) COMPREPLY=( $(compgen -W "{" ".join(all_flag_strings)}" -- "$cur") ) ;;'
        )
        lines.append(
            f'                    *) COMPREPLY=( $(compgen -W "{" ".join(nested_names)}" -- "$cur") ) ;;'
        )
        lines.append("                esac")
        lines.append("                return 0")
        lines.append("            fi")
        lines.append('            case "$subsub" in')
        nested_action = _get_subparsers_action(subparser)
        for nname in nested_names:
            nsp = nested_action.choices[nname]
            n_flag_strings: list[str] = []
            for a in _iter_flag_actions(nsp):
                n_flag_strings.extend(a.option_strings)
            lines.append(f"                {nname})")
            lines.append('                    case "$cur" in')
            lines.append(
                f'                        -*) COMPREPLY=( $(compgen -W "{" ".join(n_flag_strings)}" -- "$cur") ) ;;'
            )
            lines.append("                        *) COMPREPLY=() ;;")
            lines.append("                    esac")
            lines.append("                    return 0 ;;")
        lines.append("            esac")
        lines.append("            ;;")
        return

    # 3/4. Single-positional command: flag-or-positional dispatch.
    # Determine positional completion strategy:
    #   - `bale help` → top-level command names AND, on the second
    #     positional, that command's nested subcommand names (so
    #     `bale help config <TAB>` suggests `init`).
    #   - argparse `choices=` on the positional → those choices.
    #   - positional dest is `tarball` → filename completion.
    #   - else → no positional completion.
    positional_words: Optional[str] = None
    positional_is_filename = False

    if name == "help":
        # Two-positional shape: command + optional sub.
        # First positional: top-level commands. Second positional: that
        # command's subcommands (if any). Track how many positionals are
        # already in the line.
        lines.append('            local helped="" k seen_pos=0')
        lines.append("            for (( k=i+1; k<cword; k++ )); do")
        lines.append('                case "${COMP_WORDS[k]}" in')
        lines.append("                    -*) ;;")
        lines.append("                    *)")
        lines.append("                        seen_pos=$((seen_pos+1))")
        lines.append('                        if [ -z "$helped" ]; then')
        lines.append('                            helped="${COMP_WORDS[k]}"')
        lines.append("                        fi")
        lines.append("                        ;;")
        lines.append("                esac")
        lines.append("            done")
        lines.append('            case "$cur" in')
        lines.append('                -*) COMPREPLY=( $(compgen -W "--help" -- "$cur") ) ;;')
        lines.append("                *)")
        lines.append('                    if [ -z "$helped" ]; then')
        lines.append(
            f'                        COMPREPLY=( $(compgen -W "{" ".join(all_cmd_names)}" -- "$cur") )'
        )
        lines.append("                    else")
        lines.append('                        case "$helped" in')
        for parent_cmd, child_cmds in nested_map.items():
            lines.append(
                f'                            {parent_cmd}) COMPREPLY=( $(compgen -W "{" ".join(child_cmds)}" -- "$cur") ) ;;'
            )
        lines.append("                            *) COMPREPLY=() ;;")
        lines.append("                        esac")
        lines.append("                    fi")
        lines.append("                    ;;")
        lines.append("            esac")
        lines.append("            ;;")
        return

    # General single-positional handling: read the positional's argparse
    # spec to decide.
    for action in subparser._actions:
        if action.option_strings:
            continue
        if isinstance(action, argparse._SubParsersAction):
            # Already handled above by nested_map; defensive in case the
            # parser shape changes.
            continue
        if action.choices:
            positional_words = " ".join(str(c) for c in action.choices)
        elif action.dest == "tarball":
            # The only path-shaped positional in bale today.
            positional_is_filename = True
        break

    lines.append('            case "$cur" in')
    lines.append(
        f'                -*) COMPREPLY=( $(compgen -W "{" ".join(all_flag_strings)}" -- "$cur") ) ;;'
    )
    if positional_words is not None:
        lines.append(
            f'                *) COMPREPLY=( $(compgen -W "{positional_words}" -- "$cur") ) ;;'
        )
    elif positional_is_filename:
        lines.append("                *) compopt -o default 2>/dev/null; COMPREPLY=() ;;")
    else:
        lines.append("                *) COMPREPLY=() ;;")
    lines.append("            esac")
    lines.append("            ;;")


def cmd_completion(args) -> int:
    """Print a shell completion script for `bale` to stdout.

    Only bash is supported at v0.2.2; the subparser's `choices=` enforces
    that, so this function only ever sees `args.shell == "bash"`. The
    defensive check below is for if a future session adds zsh/fish to
    `choices` without wiring the generator branch — the failure mode
    should be a loud error, not a silent empty file.
    """
    if args.shell != "bash":
        fail(
            f"shell '{args.shell}' is in argparse's choices list but its "
            f"completion generator hasn't been wired yet."
        )
    sys.stdout.write(_generate_bash_completion(build_parser()))
    return 0


# ---------------------------------------------------------------------------
# 25. Status
# ---------------------------------------------------------------------------
#
# `bale status` is a read-only dashboard for the working directory's bale: the
# tool version, the repo and whether its working tree is clean, the open
# session (if any) and which lifecycle state it sits in — with the staging
# posture in effect for it (v0.3.11, board 12) — the outbox, a light
# pointer at applied history, and what's configured. It takes no lock, makes no
# git or filesystem writes, and degrades gracefully outside a git repo or in a
# not-yet-initialised one — the whole point is to answer "where does this repo
# stand with bale, and what's the next move?" without any side effects.
#
# Structure follows the file's existing "build a string, the caller prints it"
# split (format_summary_block, format_walkthrough_summary): _gather_status reads
# the world into a StatusReport, _render_status turns that report into the
# canonical summary block, and cmd_status wires the two and prints. That seam is
# also the test seam ADR 0003 (claude/context/adr/0003-selftest-dogfood-depth.md)
# anticipates — _session_state_and_hint and _render_status are pure and
# unit-testable without a TTY or a real repo, and the CLI E2E drives `bale
# status` end to end. Tests themselves are deferred to the v0.4 harness (see
# this session's notes.md and ADR 0001), the standing deferral every v0.1–v0.3
# session has carried.

# Open-session lifecycle states, matching BALE.md §9.5 and the commands that
# act on each. The constants exist so the classifier, the renderer, and a
# future selftest all name the states identically rather than passing bare
# strings around.
SESSION_STATE_IDLE = "idle"
SESSION_STATE_PACKED = "packed"
SESSION_STATE_HELD = "held"
SESSION_STATE_ORPHAN = "orphan"
# Clarification-suspended (v0.3.22, board 32): the session received a
# clarification response (BALE.md §8.10.2) — lock held, no branch, blocking
# questions preserved under .bale/clarifications/<sid>/ — and is awaiting the
# architect's answers. Without this state the classifier misread the
# suspension as `packed` (the request tarball usually still sits in the
# outbox) or, with the outbox cleaned, as `orphan` — whose hint is
# `bale unlock`, the one command that would discard a suspended session.
SESSION_STATE_CLARIFICATION = "clarification"

# How many outbox tarballs `bale status` lists by name before collapsing the
# remainder into a "+N more" pointer. A busy outbox (the case that prompted
# this — every tarball joined onto one line ran clean off the screen) is now
# capped to the most recent few; `ls .bale/outbox/` remains the full view. A
# module constant rather than a literal so the renderer and a future selftest
# (ADR 0003) name the same number, matching the SESSION_STATE_* pattern above.
STATUS_OUTBOX_LIST_CAP = 6


def _session_state_and_hint(
    lock_sid: Optional[str],
    has_branch: bool,
    has_outbox: bool,
    has_clarification: bool = False,
    awaiting: Optional[str] = None,
    rounds: int = 0,
) -> tuple[str, str, str]:
    """Classify the open-session lifecycle state from the already-gathered facts.

    Pure by design: every filesystem/git probe happens in _gather_status, and
    this maps the resulting booleans to (state, human-readable description,
    next-step hint). Keeping it pure makes it the cheap unit-test target ADR
    0003 names — the five states are exhaustively checkable without touching
    disk.

    The states (BALE.md §9.5) and the command that acts on each:
      - idle    no lock; nothing open.                  → `bale pack`
      - packed  lock set, request tarball still in the   → send it, `bale apply`
                outbox, no bale/<sid> branch yet.
      - held    lock set and a bale/<sid> branch exists: → `bale apply` /
                `bale apply` ran far enough to create       `bale retry` /
                the branch but hasn't reached a terminal    `bale revert`
                state (a HOLD verdict, or held for review).
      - clarification  lock set, no branch, and a         → relay the
                preserved clarification record exists       answer, then
                (.bale/clarifications/<sid>/ — BALE.md      `bale apply`
                §8.10.2): the session is suspended on
                the exchange thread (§8.11). `awaiting`
                (v0.4.18) is the side the thread waits on
                — "planner" after a worker record,
                "worker" after a planner record, None when
                the latest record's side is unreadable —
                and `rounds` the thread length; both only
                shape the description and hint, never the
                state.
      - orphan  lock set, no branch, no outbox tarball:  → `bale unlock`
                an abandoned lock with no git footprint.

    Precedence when several facts hold: branch beats clarification —
    a bale/<sid> branch means a normal response later applied and hit
    HOLD, so the clarification round is history, not the live state —
    and clarification beats the outbox reading, because "awaiting a
    response" is exactly what a suspended session is NOT doing (a
    response arrived; it was questions). Clarification also beats
    orphan: a suspended session with a cleaned outbox must never read
    as an abandoned lock, whose hint (`bale unlock`) would discard it.
    """
    if lock_sid is None:
        return (
            SESSION_STATE_IDLE,
            "idle — no open session",
            'start one with `bale pack "<goal>" --include <paths>`',
        )
    if has_branch:
        return (
            SESSION_STATE_HELD,
            f"held — branch bale/{lock_sid} exists; apply not yet terminal",
            f"inspect, then `bale apply <response>`, `bale retry <response>`, "
            f"or `bale revert {lock_sid}`",
        )
    if has_clarification:
        round_note = f"round {rounds}" if rounds else "the thread"
        if awaiting == "planner":
            return (
                SESSION_STATE_CLARIFICATION,
                f"clarification-suspended — the worker asked in "
                f"{round_note}; session open, awaiting the planner",
                f"answer the questions as an exchange record (records "
                f"under .bale/clarifications/{lock_sid}/), record it with "
                f"`bale relay {lock_sid} <answer.json|->` to emit the "
                f"worker's paste block, then `bale apply <response>` when "
                f"the follow-up normal response arrives",
            )
        if awaiting == "worker":
            return (
                SESSION_STATE_CLARIFICATION,
                f"clarification-suspended — the planner answered in "
                f"{round_note}; session open, awaiting the worker",
                f"carry {round_note}'s paste block to the worker (records "
                f"under .bale/clarifications/{lock_sid}/), then "
                f"`bale apply <response>` when the follow-up normal "
                f"response arrives (a further round enters via "
                f"`bale relay {lock_sid} <file|->`)",
            )
        return (
            SESSION_STATE_CLARIFICATION,
            "clarification-suspended — session open on an exchange "
            "thread whose latest record's side could not be read",
            f"inspect the latest record under "
            f".bale/clarifications/{lock_sid}/, relay the next round with "
            f"`bale relay {lock_sid} <file|->`, then `bale apply <response>` "
            f"when the follow-up normal response arrives",
        )
    if has_outbox:
        return (
            SESSION_STATE_PACKED,
            "packed — request tarball awaiting a response, then apply",
            "send the outbox tarball to Claude, then `bale apply <response>`",
        )
    return (
        SESSION_STATE_ORPHAN,
        "open — lock held with no branch and no outbox (abandoned)",
        "clear it with `bale unlock` (or `bale unlock --force`)",
    )


@dataclass
class StatusReport:
    """Everything `bale status` reports, gathered once and rendered once.

    A field left at its None / empty default means "not applicable" and is
    omitted from the rendered block — session_* are None outside an open
    session, repo_root is None outside a git repo, and so on. Keeping the report
    a plain data holder (no I/O, no formatting) is what lets _render_status stay
    pure and lets the future selftest assert against the gathered facts directly
    rather than scraping rendered text.
    """

    version: str
    repo_root: Optional[Path] = None
    branch: Optional[str] = None
    tree_clean: Optional[bool] = None
    tree_change_count: int = 0
    bale_initialised: bool = False
    session_sid: Optional[str] = None
    session_state: Optional[str] = None
    session_desc: Optional[str] = None
    session_goal: Optional[str] = None
    session_expects_probe: Optional[str] = None
    next_hint: Optional[str] = None
    outbox_tarballs: list[str] = field(default_factory=list)
    applied_count: int = 0
    applied_latest: Optional[str] = None
    project_config: Optional[Path] = None
    global_config: Optional[Path] = None
    hooks_wired: list[str] = field(default_factory=list)
    search_path_count: int = 0
    config_summary_failed: bool = False
    baleignore: bool = False
    # Default staging state (v0.2.9; per-session since v0.3.3): staging_path
    # is the default staging ROOT, <repo>/.bale/staging — the same literal
    # path v0.2.9 reported when the root itself was the staging directory —
    # and staging_present is whether it exists, the same computation as
    # before. staging_sessions maps each open sid to its per-session default
    # staging directory ({"path": Path, "present": bool}); staging_stale
    # lists the root's top-level entries no open session owns (closed
    # sessions' preserved-for-inspection leftovers, bare pre-v0.3.3 trees) —
    # exactly what the next default-path apply will remove. Gathered here so
    # all of status's I/O stays in _gather_status (the ADR 0003 seam), but
    # consumed only by the json renderer (bale_report.format_status_json) —
    # _render_status deliberately does not read these fields, which is what
    # keeps human-mode status output unchanged. A --staging-dir override on
    # a past apply is invisible to status; this reports the default layout,
    # the same layout cmd_apply resolves through default_staging_root /
    # default_staging_dir.
    staging_path: Optional[Path] = None
    staging_present: bool = False
    staging_sessions: dict = field(default_factory=dict)
    staging_stale: list[str] = field(default_factory=list)
    # Effective staging posture (v0.3.11, board 12 — display only):
    # staging_strategy is the [staging].strategy the merged config
    # resolves to (BALE.md §8.3 step 2) — "working-tree" or
    # "target-base" — and staging_untracked_inputs is the declared
    # [staging].untracked_inputs in effect: non-empty only under
    # target-base, where the declaration is load-bearing (under
    # working-tree the stage step ignores it, so reporting it as in
    # effect would misstate what validation will overlay). The strategy
    # is config-derived at use time, not stamped per session, so the
    # single effective pair here is fanned out per open sid by the
    # renderers — the same values apply and retry would resolve at
    # stage time. Gathered in _summarise_config (the one place merged
    # config is already read with degradation): strategy is None —
    # unknown, not known-default — when the config summary failed, and
    # None outside a git repo, where no session can be open. Unlike the
    # v0.3.3 fields above, these ARE read by the human renderer: the
    # classified session's `staging` row and the 2+ listing's per-sid
    # suffix (board 12's whole point is operator visibility).
    staging_strategy: Optional[str] = None
    staging_untracked_inputs: list[str] = field(default_factory=list)
    # ADR-0006 session registry (v0.3.0): every open sid, oldest-first.
    # With at most one session open this is [] or [session_sid], so the
    # single-session human block is unchanged; the human renderer adds a
    # listing row only for the 2+ case — reachable since ADR-0007's pack
    # gate landed (v0.3.1) — and the json report always carries the full
    # list under its additive key.
    open_sids: list[str] = field(default_factory=list)
    # ADR-0007 per-session scope (v0.3.2): sid → recorded scope entries,
    # one entry per open sid, read via read_session_scope (so a missing
    # or malformed scope.json reads as ["."], the same conservative
    # degradation the gates use). Rendered as a `scope` row for the
    # classified session, per-sid in the 2+ open-sessions listing, and
    # under the json report's additive `scopes` key — the visibility an
    # architect needs to plan the next concurrent pack's includes.
    session_scopes: dict = field(default_factory=dict)
    # Clarification suspension (v0.3.22, board 32): facts read from
    # .bale/clarifications/<sid>/ for the CLASSIFIED session (the oldest
    # open sid, matching the session/goal rows). rounds is the count of
    # preserved records (0 = none, and the other two fields then stay at
    # their defaults); questions is the questions[] length of the latest
    # record, or None when that record would not read or parse (unknown
    # rather than guessed — the same degradation posture as the stamped
    # manifest's goal above); latest_record is the latest record's
    # repo-relative path, the pointer the architect opens to re-read the
    # questions. Populated whenever records exist, independent of the
    # classified state: a held session that clarified earlier still
    # carries the facts (they are history worth a row), while the
    # lifecycle state above says whether the suspension is live.
    clarification_rounds: int = 0
    clarification_questions: Optional[int] = None
    clarification_latest: Optional[str] = None
    # v0.4.18 (the exchange thread, BALE.md §8.11): the latest record's
    # side ("worker" / "planner" per exchange_record_view — a preserved
    # clarification manifest reads as "worker"; None when unreadable or
    # naming neither side) and its answers[] length (None when absent).
    # Which side the thread waits on derives from the side
    # (awaiting_side) and drives the state description and hint.
    clarification_from: Optional[str] = None
    clarification_answers: Optional[int] = None
    # ADR-0006 integration lock: None when not held (the normal state —
    # it is held only across apply's §8.6–§8.8 git window, or left stale
    # by an interrupted apply). When held, a dict with whatever of
    # sid/pid/acquired_at the lock file yielded, plus "path"; a lock file
    # that won't parse still reports {"path": ...} so the held fact is
    # never silently dropped.
    integration_lock: Optional[dict] = None


def _branch_exists(repo: Path, branch: str) -> bool:
    """True if `branch` is a local branch in `repo`. Read-only; never raises on
    a missing ref — `git rev-parse --verify --quiet` exits non-zero for that and
    we report it as absence."""
    r = git(["rev-parse", "--verify", "--quiet", f"refs/heads/{branch}"],
            cwd=repo, check=False)
    return r.returncode == 0


def applied_tags(repo: Path) -> tuple[int, Optional[str]]:
    """Return (count, most-recent-sid) for applied/<sid> tags in `repo`.

    Most-recent is by tag creation date (matching how `bale rollback` reasons
    about applied history), reported as the bare sid with the `applied/` prefix
    stripped. This is a deliberately light touch: `bale rollback --list` is the
    full applied/reverted/re-applied view, and its consumers only point at it.

    Two consumers, one source (v0.3.31): the status applied row, and pack's
    tree-position echo (BALE.md §7.7) — the echo exists precisely because it
    renders the same fact status does, so both read it here. Public since
    v0.3.31 (was `_applied_tags`) for exactly that cross-module share;
    behavior unchanged.
    """
    r = git(["for-each-ref", "--sort=-creatordate",
             "--format=%(refname:short)", "refs/tags/applied/"],
            cwd=repo, check=False)
    if r.returncode != 0:
        return (0, None)
    tags = [ln.strip() for ln in r.stdout.splitlines() if ln.strip()]
    if not tags:
        return (0, None)
    latest = tags[0]
    prefix = "applied/"
    if latest.startswith(prefix):
        latest = latest[len(prefix):]
    return (len(tags), latest)


def _summarise_config(repo: Optional[Path], report: StatusReport) -> None:
    """Fill the config-related fields of `report`, best-effort.

    Presence is reported by path existence alone (no parse): a malformed
    bale.toml must not stop `bale status` the way it (correctly) stops pack and
    apply — status is a diagnostic and should still render. The richer summary
    (which hooks are wired, how many apply search paths) goes through
    bale_config.merged_config, wrapped so that ANY failure — including a
    fail()-driven SystemExit on a malformed file — degrades to
    config_summary_failed=True with the presence facts intact, rather than
    aborting the report. The degradation is reported, not swallowed (CLAUDE.md
    §6: silent skips are bugs).

    Also fills the effective staging posture (v0.3.11, board 12 —
    staging_strategy / staging_untracked_inputs; the StatusReport field
    comment carries the semantics) here rather than in _gather_status,
    because this is the one place the merged config is already read with
    the degradation story the posture needs: default when unconfigured,
    effective value when readable, unknown (None) when malformed.
    """
    report.project_config = (
        repo / bale_config.BALE_CONFIG
        if repo is not None and (repo / bale_config.BALE_CONFIG).exists()
        else None
    )
    report.global_config = (
        bale_config.GLOBAL_CONFIG_PATH
        if bale_config.GLOBAL_CONFIG_PATH.exists()
        else None
    )
    if repo is not None:
        report.baleignore = (repo / BALEIGNORE_FILE).exists()
        # Effective staging posture (v0.3.11, board 12): seed the
        # no-config default up front — get_staging_strategy({}) is the
        # accessor's own "working-tree" default, named through the
        # accessor rather than a duplicated literal — so an entirely
        # unconfigured repo reports the real effective strategy instead
        # of unknown. Overridden from the merged config below when a
        # layer exists; reset to unknown (None) if the summary fails.
        # Repo-only: outside a git repo no session can be open, so the
        # per-session posture has nothing to attach to.
        report.staging_strategy = bale_config.get_staging_strategy({})

    # Nothing to summarise if neither layer has a file.
    if report.project_config is None and report.global_config is None:
        return
    try:
        cfg = bale_config.merged_config(repo) if repo is not None \
            else bale_config.load_global_config()
        report.hooks_wired = [
            name for name in bale_config.HOOK_NAMES
            if bale_config.get_hook(cfg, name) is not None
        ]
        report.search_path_count = len(bale_config.get_apply_search_paths(cfg))
        if repo is not None:
            # The effective pair the renderers fan out per open sid —
            # the same merged-config resolution apply and retry perform
            # at stage time (BALE.md §8.3 step 2). Untracked inputs are
            # reported only under target-base, where the declaration is
            # load-bearing; under working-tree the stage step ignores
            # it, so the effective list is empty (the StatusReport
            # field comment carries the reasoning).
            report.staging_strategy = bale_config.get_staging_strategy(cfg)
            if report.staging_strategy == "target-base":
                report.staging_untracked_inputs = \
                    bale_config.get_staging_untracked_inputs(cfg)
    except SystemExit:
        # merged_config / the typed accessors route malformed config through
        # fail(), which sys.exit()s. Catch it so status survives a broken
        # config and still reports the presence facts above.
        report.config_summary_failed = True
        # A malformed layer could hold any staging posture; the seeded
        # default would be a confident guess, so report unknown — the
        # same "unknown rather than known-absent" posture hooks_wired /
        # search_paths take on this path.
        report.staging_strategy = None
        report.staging_untracked_inputs = []
    except Exception:  # noqa: BLE001 — status must never crash on config shape
        report.config_summary_failed = True
        report.staging_strategy = None
        report.staging_untracked_inputs = []


def _gather_status(cwd: Path) -> StatusReport:
    """Read repo, session, outbox, applied-history, and config state into a
    StatusReport. All I/O lives here; the classifier and renderer are pure.

    Read-only throughout: git is only ever queried, never mutated, and no
    filesystem path is written. Works with no git repo (repo_root is None and
    the git-derived fields stay None) and with a repo that has never run bale
    (bale_initialised False, everything else empty).
    """
    report = StatusReport(version=VERSION)

    repo = repo_root(cwd)
    report.repo_root = repo
    if repo is None:
        # Outside a git repo there's no per-repo state to read; only the global
        # config layer and the tool version are meaningful.
        _summarise_config(None, report)
        return report

    report.branch = current_branch(repo)
    clean, status_output = working_tree_clean(repo)
    report.tree_clean = clean
    report.tree_change_count = len(
        [ln for ln in status_output.splitlines() if ln.strip()]
    )
    report.bale_initialised = (repo / ".bale").is_dir()

    # Open session(s) + lifecycle state, read from the ADR-0006 session
    # registry. The lifecycle classification below stays a single-session
    # concern: it classifies the OLDEST open session (open_sids[0]) — with
    # at most one open, the registry's sole entry, exactly what the
    # current_session pointer used to say; with several open (reachable
    # since ADR-0007's pack gate landed) the remainder ride in open_sids
    # for the listing row, unclassified.
    report.open_sids = open_sessions(repo)
    lock_sid = report.open_sids[0] if report.open_sids else None
    report.session_sid = lock_sid
    has_branch = _branch_exists(repo, f"bale/{lock_sid}") if lock_sid else False

    # Per-session scope (ADR-0007, v0.3.2), one read per open sid.
    # read_session_scope owns the degradation story: a missing or
    # malformed scope.json logs and reads as ["."], so legacy sessions
    # surface as whole-tree here exactly as the gates see them.
    report.session_scopes = {
        sid: read_session_scope(repo, sid) for sid in report.open_sids
    }

    # Default staging layout (v0.2.9; per-session since v0.3.3 — json mode
    # consumes all of this; the human renderer does not, see the
    # StatusReport field comment). Gathered after open_sids because the
    # per-session and stale classifications read the registry. The path
    # helpers are the same ones the apply pipeline resolves through, so
    # what status reports is by construction what apply uses.
    report.staging_path = default_staging_root(repo)
    report.staging_present = report.staging_path.is_dir()
    report.staging_sessions = {
        sid: {"path": default_staging_dir(repo, sid),
              "present": default_staging_dir(repo, sid).is_dir()}
        for sid in report.open_sids
    }
    if report.staging_present:
        owned = set(report.open_sids)
        report.staging_stale = sorted(
            entry.name for entry in report.staging_path.iterdir()
            if not (entry.is_dir() and not entry.is_symlink()
                    and entry.name in owned)
        )

    # Integration lock (ADR-0006): held only across apply's git window, so
    # any sighting here is either a concurrent apply mid-merge or a stale
    # lock from an interrupted one — both worth a row. The read (and its
    # report-presence-on-unparseable degradation) lives in
    # read_integration_lock_info, shared with the acquire-time refusal
    # and `bale unlock --integration`.
    report.integration_lock = read_integration_lock_info(repo)

    outbox_dir = repo / ".bale" / "outbox"
    if outbox_dir.is_dir():
        report.outbox_tarballs = sorted(
            p.name for p in outbox_dir.glob("request-*.tar.gz")
        )
    has_outbox = (
        lock_sid is not None
        and f"request-{lock_sid}.tar.gz" in report.outbox_tarballs
    )

    # Clarification suspension (v0.3.22, board 32): a preserved record under
    # .bale/clarifications/<sid>/ (written by apply's §8.10.2 handler, which
    # keeps the session open) marks the classified session suspended on
    # blocking questions. Presence drives the state; the round/question
    # facts feed the dedicated row and the json report. Read-only,
    # best-effort like the stamped-manifest read below: a record that won't
    # parse still counts as a round (presence is the suspension fact), only
    # the question count degrades to unknown — logged, never silent.
    if lock_sid is not None:
        clar_dir = clarifications_dir(repo, lock_sid)
        if clar_dir.is_dir():
            records = sorted(clar_dir.glob("*.json"))
            if records:
                report.clarification_rounds = len(records)
                latest = records[-1]
                report.clarification_latest = str(latest.relative_to(repo))
                try:
                    cm = json.loads(latest.read_text(encoding="utf-8"))
                    # The shared reading (bale_report.exchange_record_view):
                    # a preserved clarification manifest is a `from:
                    # worker` record; an exchange record names its side.
                    view = exchange_record_view(cm, len(records))
                    report.clarification_questions = (
                        len(view["questions"])
                        if view["questions"] is not None else None
                    )
                    report.clarification_answers = (
                        len(view["answers"])
                        if view["answers"] is not None else None
                    )
                    report.clarification_from = view["from"]
                except (OSError, json.JSONDecodeError):
                    log(f"status: could not read {latest}; "
                        f"omitting question count and thread direction")
    has_clarification = report.clarification_rounds > 0

    state, desc, hint = _session_state_and_hint(
        lock_sid, has_branch, has_outbox, has_clarification,
        awaiting=awaiting_side(report.clarification_from),
        rounds=report.clarification_rounds)
    report.session_state = state
    report.session_desc = desc
    report.next_hint = hint

    # Pull goal + expects_probe off the stamped request manifest when one is
    # open. Best-effort: a hand-created or partial lock may have no manifest, in
    # which case the goal line is simply omitted.
    if lock_sid is not None:
        manifest_path = repo / ".bale" / "sessions" / lock_sid / "manifest.json"
        if manifest_path.exists():
            try:
                m = json.loads(manifest_path.read_text(encoding="utf-8"))
                goal = (m.get("goal") or "").strip()
                report.session_goal = goal or None
                report.session_expects_probe = m.get("expects_probe")
            except (OSError, json.JSONDecodeError):
                # A stamped manifest that won't parse is worth surfacing, but
                # not worth aborting status over; leave the fields None so the
                # rows drop out, and let pack/apply be the ones to hard-fail on
                # a corrupt manifest.
                log(f"status: could not read {manifest_path}; "
                    f"omitting goal", )

    report.applied_count, report.applied_latest = applied_tags(repo)
    _summarise_config(repo, report)
    return report


def _render_status(report: StatusReport) -> str:
    """Render a StatusReport as the canonical summary block (format_summary_block).

    Pure: builds and returns a string, prints nothing. Rows are emitted only for
    facts that apply, so the block stays tight across the idle / packed / held /
    no-repo shapes. When a session is open the block gets a `[STATUS] <sid>`
    headline (the same eye-catching form pack/apply use); otherwise it is rows
    only. The next-step hint becomes the trailer — the actionable last line.

    Long values are kept legible rather than left to flood the terminal: the
    outbox is capped (STATUS_OUTBOX_LIST_CAP) and listed one tarball per line
    instead of joined onto a single line, and every value is wrapped to the
    terminal width via format_summary_block's wrap_width. The width read is the
    one impurity-adjacent call (shutil.get_terminal_size, env/tty-derived);
    everything else here is a pure function of `report`, so the renderer stays
    the cheap unit-test target ADR 0003 names — a test can pin $COLUMNS for a
    deterministic width.
    """
    rows: list[tuple[str, str]] = [("bale version", report.version)]

    if report.repo_root is None:
        rows.append(("repo", "(not inside a git repository)"))
    else:
        tree = "clean" if report.tree_clean else \
            f"{report.tree_change_count} uncommitted change(s)"
        rows.append(("repo", f"{report.repo_root}  (branch {report.branch}, {tree})"))
        if not report.bale_initialised:
            rows.append(("bale", "not yet initialised here (no .bale/ — runs on first `bale pack`)"))

    if report.repo_root is not None:
        rows.append(("session", report.session_desc or "idle — no open session"))
        if len(report.open_sids) > 1:
            # ADR-0006: the registry can hold several open sessions; list
            # them all, each with its recorded scope (ADR-0007, v0.3.2) —
            # the fact that decides what a next concurrent pack may
            # include. With 0 or 1 open the single "session" row above IS
            # the list; the classified session's own scope renders as the
            # dedicated `scope` row below. Value rendering lives in
            # bale_report (format_open_sessions_value) with the other
            # status surfaces.
            rows.append(
                ("open sessions",
                 format_open_sessions_value(
                     report.open_sids,
                     scopes=report.session_scopes,
                     staging_strategy=report.staging_strategy,
                     staging_untracked_inputs=report.staging_untracked_inputs)))
        if report.integration_lock is not None:
            # Held only across apply's git window (or stale from an
            # interrupted apply), so this row is absent from every normal
            # status run. Rendering lives in bale_report.
            rows.append(
                ("integration lock",
                 format_integration_lock_value(report.integration_lock)))
        if report.session_goal:
            rows.append(("goal", report.session_goal))
        if report.session_expects_probe:
            rows.append(("expects probe", report.session_expects_probe))
        if report.session_sid is not None:
            # Per-session recorded forecast (ADR-0007 gates, ADR-0015
            # semantics) for the classified
            # session — with several open, the oldest, matching the
            # session/goal rows above; the per-sid listing carries the
            # rest. The row label says what the recorded set IS
            # post-separation — the write forecast the gates enforce
            # (an old open session's include set reads as an
            # over-forecast, the same conservative fact). Rendering
            # lives in bale_report (format_scope_value); the --json
            # `scopes` key contract is unchanged, deliberately.
            rows.append(
                ("write forecast",
                 format_scope_value(
                     report.session_scopes.get(report.session_sid, ["."]))))
            # Effective staging posture (v0.3.11, board 12) for the
            # classified session, same convention as the scope row: the
            # per-sid listing carries the rest when 2+ are open. One
            # line in the common case (bare strategy); target-base with
            # declared untracked inputs appends the list, wrapped by
            # format_summary_block like any long value. Omitted — not
            # guessed — when the strategy is unknown (config summary
            # failed; the config row already says so). Rendering lives
            # in bale_report (format_staging_value).
            if report.staging_strategy is not None:
                rows.append(
                    ("staging",
                     format_staging_value(
                         report.staging_strategy,
                         report.staging_untracked_inputs)))
            # Clarification facts (v0.3.22, board 32) for the classified
            # session: rendered whenever records exist — under the
            # clarification-suspended state this is the distinct row the
            # suspension earns (the state description and the trailing
            # next-step hint carry the "answer, then apply" framing);
            # under `held` it is history worth seeing (the session
            # clarified before its normal response hit HOLD). The value
            # stays purely factual either way — rounds, blocking-question
            # count, latest record path — so it never contradicts the
            # state row. Rendering lives in bale_report
            # (format_clarification_value), with the other status
            # surfaces.
            if report.clarification_rounds:
                rows.append(
                    ("clarification",
                     format_clarification_value(
                         report.clarification_rounds,
                         report.clarification_questions,
                         report.clarification_latest,
                         latest_from=report.clarification_from,
                         answers=report.clarification_answers)))

        if report.outbox_tarballs:
            # Newest first (session IDs are date-prefixed, so a reverse sort is
            # newest-first), one tarball per line, capped: the old single-line
            # `, `-join is exactly what flooded the screen on a busy outbox. The
            # open session's own request tarball is the most operationally
            # relevant one, so it is pinned to the front — always shown and
            # marked, never lost to the +N more overflow even on an outbox where
            # other tarballs happen to sort newer. The count headline stays on
            # the label line; the names wrap below it via format_summary_block's
            # wrap_width handling.
            n = len(report.outbox_tarballs)
            noun = "tarball" if n == 1 else "tarballs"
            ordered = sorted(report.outbox_tarballs, reverse=True)
            current = (
                f"request-{report.session_sid}.tar.gz"
                if report.session_sid is not None else None
            )
            if current is not None and current in ordered:
                ordered = [current] + [name for name in ordered if name != current]
            shown = ordered[:STATUS_OUTBOX_LIST_CAP]
            listed = [
                f"{name} (current session)" if name == current else name
                for name in shown
            ]
            overflow = n - len(shown)
            if overflow:
                listed.append(
                    f"+{overflow} more (ls .bale/outbox/ to see all)"
                )
            rows.append(
                ("outbox", f"{n} request {noun}:\n" + "\n".join(listed))
            )
        else:
            rows.append(("outbox", "empty"))

        if report.applied_count:
            rows.append((
                "applied",
                f"{report.applied_count} session(s); latest {report.applied_latest} "
                f"(`bale rollback --list` for full status)",
            ))
        else:
            rows.append(("applied", "none yet"))

    # Config (both layers; same shape in or out of a repo).
    config_bits: list[str] = []
    if report.project_config is not None:
        config_bits.append("project bale.toml")
    if report.global_config is not None:
        config_bits.append("global bale.toml")
    if not config_bits:
        config_bits.append("none (run `bale config init`)")
    config_value = ", ".join(config_bits)
    if report.config_summary_failed:
        config_value += " — could not summarise (malformed? run `bale config init`)"
    else:
        detail: list[str] = []
        if report.hooks_wired:
            detail.append(f"{', '.join(report.hooks_wired)} wired")
        if report.search_path_count:
            detail.append(f"{report.search_path_count} apply search path(s)")
        if report.baleignore:
            detail.append(".baleignore present")
        if detail:
            config_value += f"; {'; '.join(detail)}"
    rows.append(("config", config_value))

    headline_kwargs = {}
    if report.session_sid is not None:
        headline_kwargs = {"status": "STATUS", "sid": report.session_sid}

    trailer = ["Next: " + report.next_hint] if report.next_hint else None
    # Wrap long values (a wordy goal, the outbox listing) to the terminal.
    # shutil.get_terminal_size consults $COLUMNS, then the tty, then a (80, 24)
    # fallback — so piped/non-tty output wraps at a stable 80 rather than not at
    # all. Floored so a pathologically narrow terminal still leaves room for a
    # value column.
    wrap_width = max(shutil.get_terminal_size().columns, 40)
    return format_summary_block(
        rows, trailer=trailer, wrap_width=wrap_width, **headline_kwargs
    )


def cmd_status(args) -> int:
    """`bale status` — print a read-only summary of the working directory's bale.

    No lock, no git or filesystem writes, no clean-tree requirement. Always
    exits 0 on a successful read: status reports problems (an abandoned lock, a
    malformed config) as rows rather than as a non-zero exit, so it stays usable
    as the first thing you run when a repo's bale state is unclear.

    --json (v0.2.9) swaps the human summary block for one line of JSON on
    stdout, rendered by bale_report.format_status_json (which owns the key
    contract), under the shared json-mode stream discipline: enable_json_mode
    engages before _gather_status can log anything, so the `[bale] ` lines
    gathering can emit (e.g. an unreadable stamped manifest) go to stderr and
    stdout carries exactly the JSON line. Exit semantics are unchanged in
    both modes.
    """
    # Stream discipline first, before any line can print (matches cmd_pack /
    # cmd_apply).
    if args.json:
        enable_json_mode()
    report = _gather_status(Path.cwd())
    if args.json:
        emit_json_line(format_status_json(report))
    else:
        print(_render_status(report))
    return 0


# ---------------------------------------------------------------------------
# 27. Stats
# ---------------------------------------------------------------------------
# Wiring only (board 5 D6): aggregation is bale_stats.compute_stats, the
# renderers are bale_report's format_stats_json / format_stats_report.
# Numbered 27 but placed here, before section 26, so the CLI section stays
# the file's tail — the same stable-numbers-over-physical-order posture
# the 11-18 extraction gap already established.

# The --work-class filter's choice list: the pack-side vocabulary
# (BALE.md §7's work classes) plus the ledger's own bucket for sessions
# with no feedback-bearing attempt. Sourced from bale_stats (top-of-file
# sibling import) so the filter surface and the classifier can only
# drift in one place.
STATS_CLASS_CHOICES = (*WORK_CLASSES, UNCLASSED)


def cmd_stats(args) -> int:
    """`bale stats` — the trust ledger's read side (BALE.md §5.6).

    Read-only: no lock, no git or filesystem writes, no clean-tree
    requirement, exit 0 on a successful read (the `bale status`
    posture). Reads tracked `claude/telemetry/` ONLY — never `.bale/`
    (board 5 D1: the transient side varies by checkout and would poison
    the rates) — and degrades gracefully when the directory is absent
    or empty: an honest empty report, exit 0, not an error. Outside a
    git repository the working directory itself is the base, matching
    status's degrade-outside-a-repo posture.

    --json swaps the human report for one line of JSON on stdout under
    the shared stream discipline; bale_report.format_stats_json's
    docstring owns the key contract. The `[bale] stats:` diagnostic
    lines (skipped corrupt records, filtered future versions) go to
    stderr in BOTH modes — see bale_stats's module docstring.
    """
    # Stream discipline first, before any line can print (matches
    # cmd_pack / cmd_apply / cmd_status).
    if args.json:
        enable_json_mode()
    since = None
    if args.since:
        try:
            date.fromisoformat(args.since)
        except ValueError:
            fail(f"--since must be an ISO date (YYYY-MM-DD); got "
                 f"{args.since!r}")
        since = args.since
    base = repo_root(Path.cwd()) or Path.cwd()
    stats = compute_stats(base / "claude" / "telemetry",
                          work_class=args.work_class, since=since)
    if args.json:
        emit_json_line(format_stats_json(stats))
    else:
        print(format_stats_report(stats))
    return 0


# ---------------------------------------------------------------------------
# 26. CLI
# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="bale",
        description=f"Claude session orchestrator (v{VERSION}).",
    )
    p.add_argument("--version", action="version", version=f"bale {VERSION}")

    sub = p.add_subparsers(dest="command", required=True, metavar="<command>")

    # pack
    # Flag/format surface is canonical in TARBALL.md §3.4 — cite it when
    # authoring or emitting this command (single-line, no backslash
    # continuations); don't reconstruct it from this parser.
    p_pack = sub.add_parser(
        "pack",
        help="Build a request tarball from goal + included paths.",
    )
    p_pack.add_argument(
        "goal", nargs="?", default=None,
        help="One-sentence goal for the session. Omit on a TTY to enter "
             "the interactive wizard (BALE.md §7.3); required when piped.",
    )
    p_pack.add_argument(
        "--slug", default=None,
        help="Short kebab-case slug for the session ID. Omit on a TTY to "
             "enter the interactive wizard; required when piped.",
    )
    p_pack.add_argument(
        "--include", action="extend", nargs="+", default=[], metavar="PATH",
        help="File or directory to include. Accepts multiple paths per "
             "flag (e.g. --include src lib README.md) and is itself "
             "repeatable; all paths flatten into one list. Defaults to "
             "the whole repo if omitted.",
    )
    p_pack.add_argument(
        "--write", action="extend", nargs="+", default=[], metavar="PATH",
        help="Declare the session's write forecast (ADR-0015): the paths "
             "this session is expected to land changes under. Same grammar "
             "as --include — accepts multiple paths per flag, repeatable, "
             "directory entries cover their subtrees — and entries must "
             "name existing paths (forecasting the response's new-file "
             "layout is the worker's job, ADR-0014; forecast the directory "
             "instead). The forecast — not the include set — is what the "
             "concurrency gates read: it is recorded in the registry "
             "(sessions/<sid>/scope.json), stamped into the manifest as "
             "resolved_scope, and enforced by the disjointness, "
             "sibling-collision, and own-forecast drift gates. It is a "
             "forecast, not a wall: out-of-forecast work ships enumerated "
             "and is admitted per path at apply. Absent --write, the "
             "forecast defaults to the resolved include set — "
             "byte-for-byte pre-separation behavior; separation is opt-in "
             "per pack. Requires at least one path; the empty forecast is "
             "spelled --read-only, and combining the two flags is refused "
             "as contradictory.",
    )
    p_pack.add_argument(
        "--exclude", action="extend", nargs="+", default=[], metavar="PATTERN",
        help="gitignore-style pattern to exclude from this pack. Accepts "
             "multiple patterns per flag (e.g. --exclude 'data/*' 'tmp/*') "
             "and is itself repeatable. Composes with .baleignore — these "
             "are session-only, .baleignore is persistent (edit via "
             "`bale config init`). When the wizard runs, omitting "
             "this flag triggers the interactive 'anything to exclude' "
             "prompt; supplying it skips that prompt.",
    )
    p_pack.add_argument(
        "--constraint", action="append", default=[], metavar="TEXT",
        help="Add a constraint (repeatable). When the wizard runs, omitting "
             "this flag triggers an interactive multi-line prompt; supplying "
             "it skips that prompt.",
    )
    p_pack.add_argument(
        "--out-of-scope", action="append", default=[], metavar="TEXT",
        help="Add an out-of-scope item (repeatable). Same wizard interaction "
             "as --constraint.",
    )
    p_pack.add_argument(
        "--expects-probe", choices=("yes", "no", "claude-decides"),
        default="claude-decides",
        help="Whether the session expects a probe. The default, "
             "claude-decides, has the worker probe whenever an "
             "environment gap surfaces rather than guess around it "
             "(TARBALL.md section 4.1).",
    )
    p_pack.add_argument(
        "--readme-file", default=None, metavar="PATH",
        help="Read the request README's prose from PATH (UTF-8 text) "
             "instead of the wizard's $EDITOR step — the non-interactive "
             "way to ship prose context. A relative PATH resolves like "
             "apply's tarball argument: cwd first, then each configured "
             "apply.search_paths directory in order (absolute paths "
             "bypass search; not-found names every directory consulted). "
             "Fails loudly on a missing, unreadable, or empty file (omit "
             "the flag to pack without a README). Combines with --edit "
             "to review the file in $EDITOR before packing.",
    )
    p_pack.add_argument(
        "--checkpoint-file", default=None, metavar="PATH",
        dest="checkpoint_file",
        help="Commit PATH's bytes as this session's per-sid blind "
             "checkpoint and pack in the same invocation (v0.4.10) — the "
             "one-command install retiring the two-run commit-and-re-pack "
             "loop. A relative PATH resolves exactly like --readme-file "
             "(cwd first, then each configured apply.search_paths "
             "directory; absolute paths bypass search); a missing, "
             "unreadable, or empty file fails loudly. Requires a "
             "{sid}-bearing [validation] base: bale peeks the sid, "
             "resolves the base against it, commits the file's bytes at "
             "the resolved path as its own commit on the current branch "
             "(subject naming the sid), and proceeds. Idempotent: a "
             "resolved path already committed with identical bytes "
             "proceeds (the re-run of an aborted pack); differing bytes "
             "refuse — the flag never silently replaces a ratified "
             "oracle. A literal base refuses (commit the literal path "
             "directly), an unconfigured base refuses rather than "
             "ignoring the flag, and --read-only contradicts it at "
             "arg-parse (the 0.4.9 waiver means there is nothing to "
             "install). The checkpoint stays planner-authored: the flag "
             "moves the planner's file into place; it does not author "
             "one. On the wizard path a {sid}-based scoped pack prompts "
             "for this path when the flag is absent (typed flag skips "
             "the prompt).",
    )
    p_pack.add_argument(
        "--edit", action="store_true",
        help="Force the README $EDITOR step even when goal and --slug are "
             "fully specified on the command line (where the wizard never "
             "engages). Seeded with --readme-file's content when given, "
             "with the standard scaffold otherwise; saving an empty buffer "
             "omits the README. Needs a TTY; conflicts with --no-edit.",
    )
    p_pack.add_argument(
        "--no-edit", action="store_true",
        help="In the wizard's README step, skip the y/N prompt and $EDITOR "
             "entirely. Useful for non-interactive automation that still "
             "wants the wizard to walk the structured fields. Compatible "
             "with --readme-file (the file's prose still ships — no editor "
             "opens); conflicts with --edit. No-op on the fully specified "
             "path, which has no $EDITOR step unless --edit asks for one.",
    )
    p_pack.add_argument(
        "--no-readme", action="store_true",
        help="Declare the pack deliberately ships no README prose. Without "
             "it, a pack that resolves no prose warns on a TTY and refuses "
             "when piped — an accidental prose-less request should never "
             "look like a deliberate one. Skips the wizard's README prompt "
             "(the flag is the answer); conflicts with --readme-file and "
             "--edit.",
    )
    p_pack.add_argument(
        "--packer", default=None, metavar="NAME",
        help="Packer identity stamped into the request manifest's "
             "provenance block for this pack only. Precedence: this flag > "
             "[identity].packer in <repo>/bale.toml > the global "
             "bale.toml's [identity].packer (set either via `bale config "
             "init`) > the literal 'unconfigured' (logged with a hint).",
    )
    p_pack.add_argument(
        "--work-class", choices=("code", "doc", "contract-doc", "meta", "mixed"),
        default=None,
        help="Coarse class of the session's intended work, stamped into "
             "the provenance block. Defaults to 'mixed' rather than being "
             "required; the enum is a seed set — extend via schema edit. "
             "On the wizard path the session-shape question asks for it "
             "when this flag is absent (v0.3.15); on the fully specified "
             "path omission still stamps 'mixed', as before.",
    )
    p_pack.add_argument(
        "--supersedes", default=None, metavar="SID",
        help="Declare this pack a split supersession of the named session "
             "(v0.3.17): close SID as superseded-by-split — after a y/N "
             "confirmation naming the cost (decline default; piped stdin "
             "takes the decline without a prompt, so a non-interactive "
             "supersession never closes anything) — write its closure "
             "record (command 'pack'), stamp "
             "depends_on.superseded_session in the new request's "
             "manifest, and clear exactly that one collision at the "
             "scope-disjointness gate; every other open session still "
             "gates as usual. A SID that is not open is accepted only "
             "when its telemetry history shows a superseded-by-split "
             "closure (the idempotent re-run of a supersession pack "
             "that aborted after the close); anything else refuses. By "
             "contract this flag is worker-authored only — it appears "
             "in worker-emitted rescope commands (TARBALL.md §3.4) "
             "that the architect pastes.",
    )
    p_pack.add_argument(
        "--allow-checkpoint-in-scope", action="store_true",
        dest="allow_checkpoint_in_scope",
        help="Admit a pack whose resolved include set covers the "
             "project's blind checkpoint path ([validation] base in "
             "bale.toml), past the pack-time blindness refusal (v0.3.28, "
             "board 6 session C; BALE.md §7.1 step 4b). Without it, pack "
             "refuses such a scope: the checkpoint is the planner's "
             "oracle, and a session shown or scoped over its own oracle "
             "is the self-oracle shape the refusal exists to close. The "
             "sanctioned ordinary update path needs no session at all — "
             "the planner edits and commits the checkpoint directly. "
             "Per-invocation only, flag-only — deliberately no config "
             "key, per the ratified override contract (a standing "
             "opt-out is the rejected self-oracle-adjacent silent "
             "bypass). Every use is logged prominently (FORCE: line) "
             "and the admission is stamped into the request manifest's "
             "provenance (checkpoint_scope_admitted), so the session's "
             "telemetry carries it via the response's provenance echo.",
    )
    p_pack.add_argument(
        "--no-include-group", default=None, metavar="NAME",
        dest="no_include_group",
        help="Opt this pack out of the project's configured include "
             "group ([pack] include_group in bale.toml; board 64). NAME "
             "must be the group's exact configured name — a mismatch or "
             "an unconfigured group refuses, so a typo cannot silently "
             "skip the pull. The opt-out is loud: pack logs a FORCE "
             "line naming the group and the flag, and the report "
             "carries an 'include group' row. Without the flag, the "
             "group engages automatically whenever the resolved "
             "includes touch a configured trigger path, pulling the "
             "group's paths into shipped context (read side only — the "
             "write forecast is never widened).",
    )
    p_pack.add_argument(
        "--read-only", action="store_true",
        help="Open the session with an EMPTY recorded write forecast "
             "(v0.3.15; the degenerate forecast under ADR-0015): "
             "the read-only session shape for discussion, orchestration, "
             "or audit. The session opens normally in the registry — sid, "
             "origin-branch stamp, lock — but its forecast locks nothing "
             "(the ADR-0007 disjointness gates admit sibling packs and "
             "applies alongside it) and may land nothing (the own-scope "
             "drift gate refuses every changes[] path a response under "
             "this sid ships; `bale apply --allow-out-of-scope` can still "
             "admit named paths deliberately, per invocation). --include "
             "still selects what ships in context/ — a read-only session "
             "reads files; it just cannot land changes to them.",
    )
    # Threshold caps (BALE.md §7.4). Each --max-* sets the hard cap; the soft
    # caps (which drive the y/N prompt) stay at the defaults. --force
    # bypasses both threshold caps and the home-directory refusal; the
    # override is logged prominently to the session log.
    p_pack.add_argument(
        "--max-files", type=int, default=None, metavar="N",
        help=f"Hard cap on file count (default: {PACK_MAX_FILES_HARD:,}). "
             f"Soft cap is fixed at {PACK_MAX_FILES_SOFT:,}.",
    )
    p_pack.add_argument(
        "--max-size", type=str, default=None, metavar="BYTES",
        help=f"Hard cap on total bundled bytes. Accepts a raw count or a "
             f"K/M/G suffix, e.g. '500M', '1G'. "
             f"Default: {format_bytes(PACK_MAX_SIZE_HARD)}. "
             f"Soft cap is fixed at {format_bytes(PACK_MAX_SIZE_SOFT)}.",
    )
    p_pack.add_argument(
        "--max-depth", type=int, default=None, metavar="N",
        help=f"Hard cap on path depth in directory levels "
             f"(default: {PACK_MAX_DEPTH}).",
    )
    p_pack.add_argument(
        "--force", action="store_true",
        help="Bypass threshold caps AND the home-directory refusal. The "
             "override is logged prominently to the session log. Use for "
             "legitimate cases (dotfiles repo, deliberately large pack); "
             "do not use to silence a soft-breach prompt without thinking.",
    )
    p_pack.add_argument(
        "--verbose", action="store_true",
        help="Stream pack's quiet phases live (BALE.md §5.4): a per-path "
             "line for every file the filter chain drops (naming which "
             "filter — baked-in dir, secret pattern, .baleignore/session "
             "exclude, outside --include) and the tarball build trail "
             "(injected docs and tools, manifest, README, each context "
             "copy, the tar step). Hook output already streams live with "
             "or without the flag. Walk lines run pre-session and reach "
             "the terminal only; build lines also land in "
             ".bale/logs/<sid>.log. Default output is unchanged.",
    )
    p_pack.add_argument(
        "--json", action="store_true",
        help="Emit the end-of-run pack report as one line of JSON on stdout "
             "instead of the human summary block. Keys are a stable contract "
             "for downstream tooling: outcome, sid, tarball, log, "
             "session_dir, context_files. Packing behavior, prompts, caps, "
             "and hooks are unchanged; json mode's stream discipline sends "
             "the informational '[bale] ' lines and any prompts to stderr, "
             "so stdout carries exactly the JSON line on exit 0 (tail -n 1 "
             "recipes from v0.2.7 keep working).",
    )
    p_pack.set_defaults(func=cmd_pack)

    # apply
    p_apply = sub.add_parser(
        "apply",
        help="Validate and apply a response tarball.",
        description=(
            "Validate and apply a response tarball. The tarball argument is "
            "resolved against apply.search_paths in bale.toml when set: "
            "relative names are tried against cwd first, then each "
            "configured directory in order, first match wins. Absolute "
            "paths bypass search. Configure via `bale config init`.\n\n"
            "The tarball argument may be omitted entirely (bare `bale "
            "apply`, v0.4.16): with exactly one session open, bale scans "
            "cwd and each apply.search_paths directory for the newest "
            "response tarball whose manifest answers that session, echoes "
            "the resolved identity (path, session, sha256, mtime), and "
            "asks y/N before applying — decline is the default, and piped "
            "stdin declines without a prompt. Ambiguity (no candidate, a "
            "modification-time tie, or more than one open session) refuses "
            "with a remedy rather than guessing; request tarballs are "
            "never candidates.\n\n"
            "Inspection flags (--show-validator, --show-apply-script, "
            "--dry-run) look without applying: the first two print a script "
            "from the tarball and need no open session (and therefore "
            "require the tarball named — they don't compose with the bare "
            "form); --dry-run runs the read-only validation half against "
            "the open session and prints the plan, touching neither the "
            "worktree nor git."
        ),
    )
    p_apply.add_argument(
        "tarball", nargs="?", default=None,
        help="Path to response-NNN.tar.gz. Omit it (bare `bale apply`) to "
             "resolve the newest response tarball answering the open "
             "session across cwd and apply.search_paths, with an identity "
             "echo and a decline-default y/N before anything applies; "
             "ambiguity refuses loudly rather than guessing.")
    p_apply.add_argument(
        "--staging-dir", default=None,
        help="Where to stage the apply (default: <repo>/.bale/staging/<sid>, "
             "per open session). An explicit path is resolved relative to "
             "cwd, is used verbatim (no <sid> suffix), and is refused if it "
             "already exists.",
    )
    p_apply.add_argument(
        "--show-validator", action="store_true",
        help="Print the tarball's validation.sh and exit, without applying. "
             "Resolves the tarball through apply.search_paths like a real "
             "apply but needs no open session and no clean working tree. "
             "Combine with --show-apply-script to print both.",
    )
    p_apply.add_argument(
        "--show-apply-script", action="store_true",
        help="Print the tarball's apply.sh and exit, without applying. Same "
             "no-session, no-clean-tree semantics as --show-validator; when "
             "both are given, apply.sh prints first.",
    )
    p_apply.add_argument(
        "--dry-run", action="store_true",
        help="Validate the tarball against the open session and print what "
             "apply would do (the change set and the checks validation.sh "
             "would run), then stop. Requires an open session (for the "
             "responds_to check) but no clean working tree: no branch is "
             "created, nothing is staged into the worktree, nothing is "
             "committed.",
    )
    p_apply.add_argument(
        "--verbose", action="store_true",
        help="Stream validation.sh output live to the terminal in addition "
             "to the session log (BALE.md §8.5). Without it, validation "
             "output goes to .bale/logs/<sid>.log only and the walkthrough "
             "summary carries the verdict. No effect with --dry-run, which "
             "does not run validation.sh.",
    )
    p_apply.add_argument(
        "--no-interact", action="store_true",
        help="Run without prompting (BALE.md §5.4/§8.7): the walkthrough "
             "takes its default action (merge on PASS; hold for inspection "
             "on HOLD, exiting non-zero) and the post-apply hook "
             "confirmation resolves from apply.hook_auto_accept in "
             "bale.toml (unset/false = decline). Every bypassed prompt "
             "logs the decision taken and its source to the terminal and "
             "the session log. The mode can also be enabled per config "
             "via apply.no_interact = true; run `bale config init`.",
    )
    p_apply.add_argument(
        "--allow-out-of-scope", action="append", default=None,
        metavar="PATH", dest="allow_out_of_scope",
        help="Admit one changes[] path that lies outside the session's own "
             "declared scope, past the own-scope drift gate (BALE.md §8.1 "
             "step 14, §11 row 22). Repeat the flag per path; any "
             "out-of-scope path NOT named still refuses. Per-invocation "
             "only — there is deliberately no config key. Every use is "
             "logged prominently (FORCE: line in the session log) and the "
             "admitted paths are stamped into the session's telemetry "
             "record.",
    )
    p_apply.add_argument(
        "--allow-missing-required-check", action="append", default=None,
        metavar="NAME", dest="allow_missing_required_check",
        help="Admit one required check name past the required-check "
             "superset gate (BALE.md §8.1 step 15, §11 row 26) despite "
             "its absence from the manifest's validation_will_run. "
             "Repeat the flag per name; any missing required name NOT "
             "named still refuses. Per-invocation only — there is "
             "deliberately no config key, per the ratified override "
             "contract (a standing opt-out is the rejected "
             "self-oracle-adjacent silent bypass). Every effective use "
             "is logged prominently (FORCE: line in the session log) "
             "and the admitted names are stamped into the session's "
             "telemetry record.",
    )
    p_apply.add_argument(
        "--accept-checkpoint-change", action="store_true",
        dest="accept_checkpoint_change",
        help="Accept a blind checkpoint that changed between pack and "
             "apply (v0.3.28, board 6 session C; BALE.md §8.5): the "
             "request's pack-time provenance stamp no longer matches "
             "the base-tree bytes about to run, and without this flag "
             "apply refuses — the oracle changed, a legitimate planner "
             "edit or interference, and either is worth stopping for. "
             "With it, apply executes the CURRENT base-tree version — "
             "the planner's latest committed oracle, never the stale "
             "stamped bytes — logs a FORCE: line, and records "
             "stamp_matched: false in the attempt's telemetry stamp. "
             "Per-invocation only — deliberately no config key, per "
             "the ratified override contract.",
    )
    p_apply.add_argument(
        "--no-sandbox", action="store_true",
        help="Run the response scripts (apply.sh, the blind checkpoint, "
             "validation.sh) UNCONFINED for this invocation — no "
             "namespace sandbox, operator privileges, inherited "
             "environment, network on (v0.4.4, ADR-0016; BALE.md §8.5). "
             "The sandbox is default-on for every apply; this escape "
             "exists for debugging the sandbox itself, not for routine "
             "convenience. Per-invocation only — deliberately no config "
             "key, per the ratified override contract — and every use "
             "is logged prominently (FORCE: line in the session log) "
             "and stamped sandbox_escaped: true into the attempt's "
             "telemetry record (v0.4.5, board 10 S2; BALE.md §8.9).",
    )
    p_apply.add_argument(
        "--json", action="store_true",
        help="Emit the end-of-run apply report as one line of JSON on "
             "stdout. Keys are a stable contract for downstream tooling: "
             "outcome (applied|held|reverted|bailout|clarification|"
             "dry-run|scope-drift-refused|required-check-refused), sid, log, "
             "verdict (validation.sh state/exit_code/claims; null when it "
             "did not run), merge (walkthrough action/merged/tag/"
             "origin_branch; null when no walkthrough ran), drift (the "
             "own-scope refusal detail; null otherwise), required_checks "
             "(the required-check refusal detail; null otherwise). Stream "
             "discipline: '[bale] ' lines, prompts, and the human banners "
             "go to stderr; stdout carries exactly the JSON line on the "
             "reporting paths — exit 0, plus the held/reverted/"
             "scope-drift-refused/required-check-refused exit-1 outcomes. "
             "Error paths exit "
             "through stderr with nothing on "
             "stdout. Pair with --no-interact for scripted runs. No effect "
             "with --show-validator/--show-apply-script, whose whole "
             "output is a script body on stdout.",
    )
    p_apply.set_defaults(func=cmd_apply)

    # retry
    p_retry = sub.add_parser(
        "retry",
        help="Re-attempt a HOLDed session with a new response tarball "
             "(same session id, no repack).",
        description=(
            "Discard the HOLDed apply state for an open session — reset "
            "the bale/<sid> branch, wipe the session's staging — and run "
            "the apply pipeline against a new response tarball, keeping "
            "the session open so the new attempt lands in the same "
            "session id. With exactly one session open it is the target; "
            "with several open, --sid picks which (ADR-0006). The new "
            "tarball's manifest.responds_to must match the target session "
            "(same as `bale apply`). The tarball argument is resolved "
            "against apply.search_paths in bale.toml the same way `bale "
            "apply` does.\n\n"
            "The per-attempt flags mirror `bale apply`'s (--verbose, "
            "--no-interact, --allow-out-of-scope, "
            "--allow-missing-required-check, --accept-checkpoint-change, "
            "--json), since retry "
            "reruns the same pipeline. Apply's inspection flags "
            "(--show-validator, --show-apply-script, --dry-run) are "
            "deliberately absent here: they read the tarball or the open "
            "session without touching the HOLD state, so they work "
            "verbatim through `bale apply` at any point, retry pending or "
            "not."
        ),
    )
    p_retry.add_argument("tarball", help="Path to the new response-NNN.tar.gz.")
    p_retry.add_argument(
        "--sid", default=None,
        help="Session id to retry. Optional with exactly one session "
             "open (it resolves implicitly); required when several are "
             "open. Must name an open session.",
    )
    p_retry.add_argument(
        "--staging-dir", default=None,
        help="Where to stage the apply (default: <repo>/.bale/staging/<sid>, "
             "per open session). An explicit path is resolved relative to "
             "cwd, is used verbatim (no <sid> suffix), and is refused if it "
             "already exists.",
    )
    p_retry.add_argument(
        "--verbose", action="store_true",
        help="Stream validation.sh output live to the terminal in addition "
             "to the session log (BALE.md §8.5) — same semantics as `bale "
             "apply --verbose` (retry reruns the same pipeline). Without "
             "it, validation output goes to .bale/logs/<sid>.log only and "
             "the walkthrough summary carries the verdict.",
    )
    p_retry.add_argument(
        "--no-interact", action="store_true",
        help="Run without prompting — same semantics as `bale apply "
             "--no-interact` (retry reruns the same pipeline): walkthrough "
             "takes its default action, the post-apply hook confirmation "
             "resolves from apply.hook_auto_accept, and every bypassed "
             "prompt logs its decision and source.",
    )
    p_retry.add_argument(
        "--allow-out-of-scope", action="append", default=None,
        metavar="PATH", dest="allow_out_of_scope",
        help="Admit one changes[] path that lies outside the session's own "
             "declared scope, past the own-scope drift gate (BALE.md §8.1 "
             "step 14, §11 row 22) — same semantics as `bale apply "
             "--allow-out-of-scope`. Repeat the flag per path; any "
             "out-of-scope path NOT named still refuses. Per-invocation "
             "only — there is deliberately no config key, and the override "
             "is never carried forward from a failed apply attempt: a "
             "retry that needs it re-states it. Every use is logged "
             "prominently (FORCE: line in the session log) and the "
             "admitted paths are stamped into the session's telemetry "
             "record.",
    )
    p_retry.add_argument(
        "--allow-missing-required-check", action="append", default=None,
        metavar="NAME", dest="allow_missing_required_check",
        help="Admit one required check name past the required-check "
             "superset gate (BALE.md §8.1 step 15, §11 row 26) — same "
             "semantics as `bale apply --allow-missing-required-check`. "
             "Repeat the flag per name; any missing required name NOT "
             "named still refuses. Per-invocation only — no config key, "
             "and the override is never carried forward from a failed "
             "apply attempt: a retry that needs it re-states it. Every "
             "effective use is logged prominently (FORCE: line) and the "
             "admitted names are stamped into the session's telemetry "
             "record.",
    )
    p_retry.add_argument(
        "--accept-checkpoint-change", action="store_true",
        dest="accept_checkpoint_change",
        help="Accept a blind checkpoint that changed between pack and "
             "apply — same semantics as `bale apply "
             "--accept-checkpoint-change` (retry reruns the same "
             "pipeline): the current base-tree version runs, the use is "
             "FORCE-logged, and the attempt's telemetry stamp records "
             "stamp_matched: false. Per-invocation only — no config "
             "key, and the override is never carried forward from a "
             "failed apply attempt: a retry that needs it re-states it.",
    )
    p_retry.add_argument(
        "--no-sandbox", action="store_true",
        help="Run the response scripts unconfined for this invocation — "
             "same semantics as `bale apply --no-sandbox` (retry reruns "
             "the same pipeline). Per-invocation only — no config key, "
             "and the bypass is never carried forward from a failed "
             "apply attempt: a retry that needs it re-states it. Every "
             "use is FORCE-logged in the session log. `bale revert` "
             "executes no response scripts and takes no such flag.",
    )
    p_retry.add_argument(
        "--json", action="store_true",
        help="Emit the end-of-run report as one line of JSON on stdout — "
             "same key contract and stream discipline as `bale apply "
             "--json` (retry reruns the same pipeline): '[bale] ' lines, "
             "prompts, and the human banners go to stderr; stdout carries "
             "exactly the JSON line on the reporting paths. Pair with "
             "--no-interact for scripted retries.",
    )
    p_retry.set_defaults(func=cmd_retry)

    # amend-checkpoint
    p_amend = sub.add_parser(
        "amend-checkpoint",
        help="Commit a desk-published checkpoint amendment over an open "
             "session's blind oracle and emit the retry line "
             "(PLANNER.md \u00a75 steps 4\u20135).",
        description=(
            "The operator half of the bad-oracle correction flow "
            "(PLANNER.md \u00a75, steps 4\u20135) as one command: resolve "
            "the open scoped session (read-only sessions are not "
            "candidates \u2014 their empty forecast waived the "
            "checkpoint), read the desk's amendment file LF-normalized "
            "(CRLF\u2192LF at the ingest edge, board 50), verify it "
            "against the desk-published sha256, commit the bytes at the "
            "session's per-sid checkpoint path as a pathspec-limited "
            "bale-prefixed commit, and end the report with the "
            "paste-ready `bale retry ... --accept-checkpoint-change` "
            "line as the named successor. The verb mechanizes the "
            "transport, never the deliberateness: the provenance gate "
            "still refuses at retry, the accept stays per-invocation, "
            "and stamp_matched: false remains the truthful record. "
            "Identical committed bytes are the idempotent re-run; "
            "committed bytes matching neither the pack-time stamp nor "
            "the amendment refuse unless --accept-unaccounted-oracle "
            "deliberately admits the replacement."
        ),
    )
    p_amend.add_argument(
        "file",
        help="Path to the planner's amendment file. A relative path "
             "resolves like apply's tarball argument: cwd first, then "
             "each configured apply.search_paths directory in order; an "
             "absolute path bypasses the search. Bytes are "
             "CRLF-normalized at read, so the hash check, the commit, "
             "and every downstream surface see the LF oracle the desk "
             "published.",
    )
    p_amend.add_argument(
        "--sha256", required=True, metavar="HEX",
        help="The desk-published sha256 of the amendment (64 hex "
             "chars), verified against the file's LF-normalized bytes "
             "before anything is committed. Mandatory \u2014 the "
             "published-hash comparison is part of the flow, not an "
             "option: it is what catches a stale near-duplicate that "
             "first-match resolution picked up silently.",
    )
    p_amend.add_argument(
        "--sid", default=None,
        help="Session id to amend. Optional with exactly one scoped "
             "session open (it resolves implicitly; read-only sessions "
             "are structurally invisible \u2014 empty forecast, "
             "checkpoint waived); required when several scoped sessions "
             "are open. Must name an open scoped session.",
    )
    p_amend.add_argument(
        "--accept-unaccounted-oracle", action="store_true",
        dest="accept_unaccounted_oracle",
        help="Replace committed oracle bytes that match neither the "
             "session's pack-time provenance stamp nor the delivered "
             "amendment (a prior amendment, or an edit outside this "
             "flow). Per-invocation only \u2014 deliberately no config "
             "key, never carried forward \u2014 and every use is "
             "FORCE-logged naming all three hashes (committed, "
             "pack-time stamp, delivered). Without it, that case "
             "refuses loudly naming the same three hashes.",
    )
    p_amend.set_defaults(func=cmd_amend_checkpoint)

    # relay
    p_relay = sub.add_parser(
        "relay",
        help="Record one exchange in a suspended session's clarification "
             "thread and emit the counterpart's paste block; with no "
             "file, re-emit the latest recorded round "
             "(BALE.md \u00a78.11).",
        description=(
            "The exchange thread's recording verb (ADR-0017, v0.4.18). "
            "Ingests one exchange from either side \u2014 a clarification "
            "manifest, an exchange record, or the BALE EXCHANGE paste "
            "block wrapping either \u2014 verifies a block's sha256 "
            "trailer against its body before trusting it, validates the "
            "record (exchange-record.schema.json; the question rows by "
            "reference to response-manifest.schema.json), refuses a "
            "session_id other than <sid>, a round that is not the "
            "thread's next NNN, a planner record as round one, or an "
            "answer that does not resolve to a preserved question, then "
            "preserves the record as the next NNN under "
            ".bale/clarifications/<sid>/ (the same write apply's "
            "clarification ingest uses), retains the lock \u2014 the "
            "session stays suspended \u2014 and emits the "
            "counterpart-facing paste block on stdout with every "
            "[bale] line on stderr. Direction is read from the record's "
            "`from`, never from a flag. Executes nothing and stages "
            "nothing. With no file argument (v0.4.22), re-emits the "
            "paste block for the thread's latest recorded round, "
            "byte-identical to the original emission, and records "
            "nothing; a sid with no recorded rounds refuses loudly."
        ),
    )
    p_relay.add_argument(
        "sid",
        help="The suspended session's id (full form "
             "YYYY-MM-DD-<slug>-NNN). Must be open in the registry with "
             "no bale/<sid> branch; the record's session_id must match.",
    )
    p_relay.add_argument(
        "file",
        nargs="?",
        default=None,
        help="Path to the exchange \u2014 an exchange record, a "
             "clarification manifest, or the paste block wrapping either "
             "\u2014 or `-` to read it from stdin. A relative path "
             "resolves like apply's tarball argument: cwd first, then "
             "each configured apply.search_paths directory; an absolute "
             "path bypasses the search. CRLF line endings are normalized "
             "at read. Omitted entirely, the no-file form re-emits the "
             "paste block for the thread's latest recorded round, "
             "byte-identical to the original emission, and records "
             "nothing (v0.4.22).",
    )
    p_relay.set_defaults(func=cmd_relay)

    # revert
    p_revert = sub.add_parser(
        "revert",
        help="Discard a held bale branch.",
        description=(
            "Discard a held bale branch and close its session. The sid "
            "is optional with exactly one session open (it resolves "
            "implicitly, ADR-0006) and required when several are open; "
            "an explicit sid may also name an already-closed session "
            "whose branch or metadata needs cleaning up."
        ),
    )
    p_revert.add_argument(
        "sid", nargs="?", default=None,
        help="Session ID to revert. Optional with exactly one session "
             "open; required when several are open.",
    )
    p_revert.add_argument(
        "--reason", choices=CLOSURE_REASONS, default=None,
        help="Why this session is being discarded, stamped into its "
             "telemetry record as closure_reason (BALE.md §8.9). "
             "Optional: omitted records null — the 'reverted' outcome "
             "already names the event.",
    )
    p_revert.add_argument(
        "--verbose", action="store_true",
        help="Stream the captured output of the git operations the "
             "discard runs (branch verification, the inspection-checkout "
             "switch, branch -D) live as they complete (BALE.md §5.4). "
             "Default output is unchanged — the [bale] log lines remain "
             "the whole trail. Under --json the verbose lines follow the "
             "stream discipline to stderr; stdout still carries exactly "
             "the one JSON line.",
    )
    p_revert.add_argument(
        "--json", action="store_true",
        help="Emit the end-of-run revert report as one line of JSON on "
             "stdout — the machine-readable surface for an orchestrator "
             "discarding HOLDs. Stream discipline matches pack/apply/"
             "status/unlock --json: '[bale] ' lines and the human summary "
             "block go to stderr, stdout carries exactly the JSON line; "
             "human mode is unchanged. Emitted on the discard path "
             "(outcome 'reverted'); refusals exit through fail() with "
             "nothing on stdout. The key contract is owned by "
             "format_revert_json's docstring in bin/bale_report.py.",
    )
    p_revert.set_defaults(func=cmd_revert)

    # rollback — git revert an applied (merged) session. BALE.md §9.2.
    # The third "undo" verb (§9.4): revert discards a not-yet-merged branch,
    # unlock clears a lock with no git effect, rollback undoes a *merged*
    # session via history-preserving `git revert` and is itself reversible
    # with --undo. Command logic lives in the sibling bale_rollback module.
    p_rollback = sub.add_parser(
        "rollback",
        help="git revert an applied (merged) session. Defaults to the most "
             "recent; --undo reverses a rollback; --list shows status.",
        description=(
            "Undo an applied (merged) bale via `git revert`, history-"
            "preserving and itself reversible. With no sid, targets the most "
            "recent applied/<sid> tag reachable from HEAD. Detects whether the "
            "tagged commit is a merge (the usual case — apply merges --no-ff) "
            "and reverts the mainline parent accordingly. Refuses on a dirty "
            "working tree; --stash stashes around the revert, --force proceeds "
            "anyway. Refuses if reverted/<sid> already exists unless --force. "
            "On conflict, leaves the revert in progress and prints the affected "
            "files. Tags reverted/<sid> on success. --undo reverts that revert "
            "(re-applying) and tags re-applied/<sid>; --list shows applied "
            "sessions with rollback status and changes nothing."
        ),
    )
    p_rollback.add_argument(
        "sid", nargs="?", default=None,
        help="Session ID to roll back (or, with --undo, to re-apply). "
             "Omit to target the most recent applied (or, with --undo, "
             "reverted) session reachable from HEAD.",
    )
    p_rollback.add_argument(
        "--undo", action="store_true",
        help="Reverse a prior rollback: revert the reverted/<sid> commit "
             "(re-applying the original change) and tag re-applied/<sid>.",
    )
    p_rollback.add_argument(
        "--list", action="store_true", dest="list",
        help="List applied sessions reachable from HEAD with rollback status "
             "(applied / reverted / re-applied). Read-only; takes no sid.",
    )
    p_rollback.add_argument(
        "--stash", action="store_true",
        help="Stash a dirty working tree (including untracked files) before "
             "the revert and pop it after. Without this, a dirty tree is "
             "refused (or use --force to proceed onto dirty state).",
    )
    p_rollback.add_argument(
        "--force", action="store_true",
        help="Bypass the dirty-tree refusal (without stashing) and the "
             "reverted/<sid>-already-exists / re-applied/<sid>-already-exists "
             "refusals. Overrides are logged with the FORCE: prefix.",
    )
    p_rollback.set_defaults(func=cmd_rollback)

    # unlock
    p_unlock = sub.add_parser(
        "unlock",
        help="Clear an abandoned session (no git side effects), or "
             "--integration for a stale integration lock.",
        description=(
            "Close an abandoned session — a `bale pack` that was never "
            "applied. Removes the session's registry entry (its open "
            "marker, reconciling the .bale/current_session pointer) and "
            "the matching .bale/sessions/<sid>/ directory; performs no "
            "git operations. The sid is optional with exactly one "
            "session open and required when several are open "
            "(ADR-0006). Refuses if a bale/<sid> branch exists — that "
            "means `bale apply` ran far enough to create the branch but "
            "didn't reach a terminal state, and the right command for "
            "that state is `bale revert <sid>`. --force overrides the "
            "refusal but leaves the orphan branch in place; delete it "
            "with `git branch -D bale/<sid>` if you no longer want it. "
            "--integration instead clears the repo-level integration "
            "lock left stale by an interrupted apply (ADR-0006); it "
            "takes no sid and touches no session."
        ),
    )
    p_unlock.add_argument(
        "sid", nargs="?", default=None,
        help="Session ID to unlock. Optional with exactly one session "
             "open; required when several are open. Must name an open "
             "session.",
    )
    p_unlock.add_argument(
        "--reason", choices=CLOSURE_REASONS, default=None,
        help="Why this session is closing, stamped into its telemetry "
             "record as closure_reason (BALE.md §8.9). Omitted, unlock "
             "infers: 'closed-read-only' when the session's recorded "
             "scope is empty (a --read-only pack), 'abandoned' "
             "otherwise. An explicit --reason beats the inference.",
    )
    p_unlock.add_argument(
        "--force", action="store_true",
        help="Clear the session even if a bale/<sid> branch exists. The "
             "branch is left in place; you'll need to delete it manually. "
             "The override is logged with the FORCE: prefix.",
    )
    p_unlock.add_argument(
        "--json", action="store_true",
        help="Emit the end-of-run unlock report as one line of JSON on "
             "stdout — the machine-readable surface for an orchestrator "
             "closing sessions. Stream discipline matches pack/apply/"
             "status --json: '[bale] ' lines and the human summary block "
             "go to stderr, stdout carries exactly the JSON line; human "
             "mode is unchanged. Emitted on the session-close path and "
             "the benign no-op (outcome 'unlocked' / 'no-op'); the key "
             "contract is owned by format_unlock_json's docstring in "
             "bin/bale_report.py. Session form only: combining with "
             "--integration is refused.",
    )
    p_unlock.add_argument(
        "--integration", action="store_true",
        help="Clear the repo-level integration lock "
             "(.bale/integration.lock) instead of a session — the "
             "stale-lock recovery for an interrupted apply. Only safe "
             "while no `bale apply` is running. Takes no sid.",
    )
    p_unlock.set_defaults(func=cmd_unlock)

    # handoff — repackage a bailout response into a fresh request tarball.
    # open — planner-bundle consumption (board 49a-ii; BALE.md §6.7).
    # Verifies both member hashes, dry-runs the checkpoint read-only
    # against the live base (expected-HOLD proof; exit 2 refuses as a
    # defective oracle), then replays the stored pack argv with the
    # delivery flags injected from member presence and the bundle's
    # pre-answered intents on the in-process channel.
    p_open = sub.add_parser(
        "open",
        help="Consume a planner bundle: verify, dry-run the checkpoint, "
             "pack.",
        description=(
            "Consume a planner bundle (.bale-bundle; BALE.md §6.7): gate "
            "bundle.json through validate_bundle_manifest before trusting "
            "anything else, verify each member's published sha256 against "
            "its LF-normalized bytes, dry-run the checkpoint member "
            "read-only against a scratch copy of the live base and echo "
            "the expected-HOLD proof (exit 1 expected; exit 2 refuses the "
            "whole open as a defective oracle; exit 0 proceeds with a "
            "vacuous-oracle warning), then replay the stored pack argv "
            "with --readme-file/--no-readme and --checkpoint-file "
            "injected from member presence and the bundle's pre_answered "
            "intents riding the in-process channel — routed through every "
            "decline-default exchange, never around it."
        ),
    )
    p_open.add_argument(
        "bundle",
        help="Path to the planner bundle (.bale-bundle). A relative path "
             "resolves like apply's tarball argument: cwd first, then "
             "each configured apply.search_paths directory in order; an "
             "absolute path bypasses the search.",
    )
    p_open.add_argument(
        "--verbose", action="store_true",
        help="Stream the checkpoint dry-run's output live instead of "
             "capturing it and echoing the probe-verdict lines.",
    )
    p_open.add_argument(
        "--no-sandbox", action="store_true",
        help="Run the checkpoint dry-run UNCONFINED for this invocation "
             "(ADR-0016 escape; same semantics as `bale apply "
             "--no-sandbox`, scoped here to the dry-run — the replayed "
             "pack executes no scripts). Per-invocation only — "
             "deliberately no config key — and every use is FORCE-logged.",
    )
    p_open.set_defaults(func=cmd_open)

    # TARBALL.md §5.6.3: when `bale apply` encounters response_kind=bailout
    # it prints the handoff banner and stops; `bale handoff <tarball>`
    # then takes that bailout's handoff.md and ships it as the sole
    # context entry for a new session that inherits the original goal.
    p_handoff = sub.add_parser(
        "handoff",
        help="Repackage a bailout response into a fresh request tarball.",
        description=(
            "Take a bailout response tarball (response_kind=\"bailout\", "
            "TARBALL.md §5.6.3) and build a new request tarball that "
            "ships its handoff.md plus the source files its reading "
            "plan cites as the context entries, inheriting "
            "the original session's goal verbatim. The new session id "
            "keeps the slug and bumps the date/counter. Refuses while "
            "any session is open in the registry (apply or unlock them "
            "first). Warns — but proceeds — if the bailout's predecessor "
            "was also a bailout; chained handoffs are a smell, and the "
            "warning is informational only (no flag suppresses or escalates "
            "it). With --edit-goal, opens $EDITOR on the inherited goal "
            "before packing. With --verbose, streams the tarball build "
            "trail live, same as `bale pack --verbose`. With --force, "
            "bypasses the home-directory refusal that all bale commands "
            "enforce — same semantics as `bale pack --force`."
        ),
    )
    p_handoff.add_argument(
        "tarball",
        help="Path to the bailout response tarball (resolved against "
             "apply.search_paths the same way `bale apply` resolves).",
    )
    p_handoff.add_argument(
        "--edit-goal", action="store_true",
        help="Open $EDITOR on the inherited goal text before packing. "
             "Useful when the original goal needs refining in light of "
             "what the bailout learned. Falls back to $VISUAL, then to "
             "/usr/bin/editor.",
    )
    p_handoff.add_argument(
        "--force", action="store_true",
        help="Bypass the home-directory refusal that all bale commands "
             "enforce — same semantics as `bale pack --force`. The "
             "override is logged with the FORCE: prefix. Has no effect "
             "on the chained-bailout lineage warning, which is "
             "informational only and prints regardless.",
    )
    p_handoff.add_argument(
        "--verbose", action="store_true",
        help="Stream handoff's tarball build trail live (BALE.md §5.4): "
             "injected docs and tools, manifest, each context copy "
             "(handoff.md and every reading-plan file), the tar step — "
             "the same build-trail machinery `bale pack --verbose` "
             "streams, on the second request-building path. Default "
             "output is unchanged — the [bale] log lines remain the "
             "whole trail.",
    )
    p_handoff.add_argument(
        "--allow-checkpoint-in-scope", action="store_true",
        dest="allow_checkpoint_in_scope",
        help="Admit a handoff whose reading-plan scope — the resolved "
             "set of files the bailout's reading plan pre-packs, or "
             "the whole tree when the plan cites none — covers the "
             "project's blind checkpoint path ([validation] base in "
             "bale.toml), past the blindness refusal the gate shares "
             "with `bale pack` (v0.3.33; BALE.md §11 row 30). Without "
             "it, handoff refuses such a scope pre-sid, exactly as "
             "pack does: a bailed checkpoint-maintenance session was "
             "admitted once at pack, and the handoff must renew that "
             "admission deliberately, not inherit it silently. "
             "Per-invocation only, flag-only — deliberately no config "
             "key, per the ratified override contract. Every use is "
             "logged prominently (FORCE: line) and the admission is "
             "stamped into the new request manifest's provenance "
             "(checkpoint_scope_admitted) through the shared builder, "
             "so the session's telemetry carries it via the response's "
             "provenance echo — the same posture as pack's flag.",
    )
    p_handoff.set_defaults(func=cmd_handoff)

    # config — group for configurables-management subcommands. At v0.0.x
    # the only subcommand is `init`; set/get/edit land in later sessions.
    p_config = sub.add_parser(
        "config",
        help="Manage bale configurables (per-repo or global).",
    )
    config_sub = p_config.add_subparsers(
        dest="config_cmd", required=True, metavar="<subcommand>",
    )
    p_config_init = config_sub.add_parser(
        "init",
        help="Walk through every configurable at the chosen layer (project "
             "by default; pass --global for the install-wide layer). "
             "Idempotent.",
        description=(
            "Walk through every configurable on this repo (default) or "
            "for this install (--global), or re-confirm existing values. "
            "Idempotent: re-running shows current values and lets you keep, "
            "change, suppress, or clear each one. "
            "Default writes <repo>/bale.toml. With --global, writes "
            "<install>/user/bale.toml — the install-wide layer that every "
            "project using this bale install inherits per-key. Project "
            "values override globals when both are set."
        ),
    )
    p_config_init.add_argument(
        "--global", action="store_true", dest="global_layer",
        help="Walk the install-wide global layer at <install>/user/bale.toml "
             "instead of the per-repo layer at <repo>/bale.toml. Does not "
             "require a git repo.",
    )
    p_config_init.set_defaults(func=bale_config.cmd_config_init)

    # help — inline discovery (BALE.md §5.1). Renders argparse's own
    # format_help() at the right level after walking the parser to the
    # named command. `bale help` and `bale --help` produce the same
    # top-level output; the subcommand form (`bale help pack`,
    # `bale help config init`) is what justifies a dedicated command —
    # `bale <cmd> --help` already works per-subparser but isn't
    # discoverable from the top-level help text the way a named
    # subcommand is.
    p_help = sub.add_parser(
        "help",
        help="Show help for bale or a specific command.",
        description=(
            "Show help. With no arguments, prints the top-level usage "
            "and the list of commands. With a command name, prints that "
            "command's full --help output. Two-level commands accept a "
            "subcommand: `bale help config init` shows `bale config "
            "init`'s flags."
        ),
    )
    p_help.add_argument(
        "command_path",
        nargs="*",
        metavar="<cmd>",
        help="Command (and optional subcommand) to show help for. Omit "
             "for the top-level usage.",
    )
    p_help.set_defaults(func=cmd_help)

    # completion — print a bash completion script to stdout. Source it
    # from your shell rc (BALE.md §3.1: "Source a bash-completion script
    # in shell rc"). The script is generated by walking this very parser,
    # so it stays in sync with whatever surface bale exposes at the
    # moment of generation; re-run when commands or flags change.
    p_completion = sub.add_parser(
        "completion",
        help="Print a shell completion script (bash) to stdout.",
        description=(
            "Print a shell completion script to stdout for the chosen "
            "shell. Only bash is supported in v0.2.2. The output is a "
            "self-contained function that does pure-shell dispatch at "
            "Tab-press time — no subprocess back to bale per Tab press. "
            "Source it from your shell rc:\n\n"
            "    source <(bale completion bash)\n\n"
            "Or install persistently:\n\n"
            "    bale completion bash > ~/.local/share/bash-completion/completions/bale\n\n"
            "Re-generate when bale's CLI surface changes."
        ),
    )
    p_completion.add_argument(
        "shell",
        choices=("bash",),
        metavar="<shell>",
        help="Which shell to emit completion for. Currently only 'bash'.",
    )
    p_completion.set_defaults(func=cmd_completion)

    # status — read-only dashboard for the working directory's bale (section
    # 25). No lock, no git/filesystem writes; degrades gracefully outside a git
    # repo. Since v0.2.9 it carries one flag, --json; like every other flag it
    # needs no special-casing in the completion generator (section 24) — it
    # surfaces in `bale help`, `bale help status`, and `bale completion bash`
    # for free, the whole point of those two reading from this one parser.
    p_status = sub.add_parser(
        "status",
        help="Show a read-only summary of this repo's bale state.",
        description=(
            "Print a read-only summary of the working directory's bale: the "
            "tool version, the repo and whether its working tree is clean, the "
            "open session (if any) and its lifecycle state, the outbox, a light "
            "pointer at applied history, and what's configured. Takes no lock, "
            "makes no git or filesystem changes, and works outside a git repo "
            "or in a not-yet-initialised one. Always exits 0 on a successful "
            "read — problems are reported as rows, not as a failing exit code."
        ),
    )
    p_status.add_argument(
        "--json", action="store_true",
        help="Emit the status report as one line of JSON on stdout instead "
             "of the human summary block. Keys are a stable contract for "
             "downstream tooling: outcome ('status'), version, sid (the "
             "lock state; null when no session is open), repo, session "
             "(lifecycle state, goal, expects_probe), staging (the default "
             ".bale/staging root plus per-open-session staging state and "
             "stale entries), outbox, applied, "
             "config. Stream discipline matches pack/apply --json: "
             "'[bale] ' lines go to stderr and stdout carries exactly the "
             "JSON line. Gathering is unchanged — still read-only, still "
             "exit 0 on a successful read.",
    )
    p_status.set_defaults(func=cmd_status)

    # stats
    p_stats = sub.add_parser(
        "stats",
        help="Aggregate the claude/telemetry/ corpus into trust-ledger "
             "rates.",
        description=(
            "Read-only aggregation over the tracked claude/telemetry/ "
            "corpus (BALE.md \u00a75.6): per-work-class claim/verdict "
            "agreement, HOLD, drift-refusal, bailout, and clarification "
            "rates, the closure mix, epoch and coverage rows, and the "
            "dual-stream cross-checks. Takes no lock, writes nothing, "
            "never reads .bale/, and exits 0 on a successful read — an "
            "absent or empty corpus is an honest empty report, not an "
            "error."
        ),
    )
    p_stats.add_argument(
        "--work-class", choices=STATS_CLASS_CHOICES, default=None,
        help="Filter the classed rows to one resolved work class "
             "('unclassed' selects sessions with no feedback-bearing "
             "attempt).",
    )
    p_stats.add_argument(
        "--since", default=None, metavar="DATE",
        help="ISO date (YYYY-MM-DD), inclusive, against each record's "
             "created_at: restrict membership to records on or after it.",
    )
    p_stats.add_argument(
        "--json", action="store_true",
        help="Emit the stats report as one line of JSON on stdout "
             "instead of the human report. The format_stats_json "
             "docstring in bin/bale_report.py owns the key contract "
             "(stable keys, additions only). Stream discipline matches "
             "pack/apply --json: '[bale] ' lines go to stderr and "
             "stdout carries exactly the JSON line.",
    )
    p_stats.set_defaults(func=cmd_stats)

    return p


def main(argv: Optional[list[str]] = None) -> int:
    # bale's floor is Python 3.10. TOML parsing (config loading) needs a
    # parser that stdlib only ships from 3.11+ (`tomllib`); on 3.10 bale falls
    # back to a vendored pure-Python parser via the `_bale_toml` shim, so 3.10
    # is fully supported. Anything older lacks language/stdlib features bale
    # relies on — fail loud and clear at startup rather than crashing later.
    if sys.version_info < (3, 10):
        sys.stderr.write(
            f"[bale] error: requires Python 3.10+; running on Python "
            f"{sys.version_info.major}.{sys.version_info.minor}.\n"
        )
        return 1

    parser = build_parser()
    args = parser.parse_args(argv)

    # Sanity: the installation must have the global docs and the injected
    # worker tools alongside. Both request-building commands (pack,
    # handoff) inject them via build_request_tarball; a missing file
    # would otherwise surface as a mid-build copy failure — on handoff,
    # after sid allocation and session state already exist. Fail loud
    # up front instead, with the same message on both commands.
    if args.command in ("pack", "handoff", "open"):
        # open is in the tuple because it replays pack in-process
        # (board 49a-ii): the missing-file failure would otherwise
        # surface mid-replay, after the dry-run already spent its cost.
        missing = [d for d in GLOBAL_DOCS if not (DOCS_DIR / d).exists()]
        missing += [f"tools/{t}" for t in INJECTED_TOOLS
                    if not (TOOLS_DIR / t).exists()]
        if missing:
            fail(
                f"installation is missing injected files under "
                f"{INSTALL_ROOT}: {', '.join(missing)}. Reinstall bale."
            )

    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
